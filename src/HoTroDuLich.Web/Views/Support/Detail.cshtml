@model TinhHuongPhatSinh
@{ViewData["Title"]="Xử lý tình huống";var opts=(List<PhuongAnXuLy>)ViewBag.Options;}<div class="container-narrow"><a class="back" href="/Support?planId=@Model.MaKeHoach">← Các tình huống của chuyến đi</a><div class="page-head"><div><h1>@DanhMuc.Ten(Model.LoaiTinhHuong)</h1><p>@Model.ViTri</p></div><div class="actions"></div></div><div class="panel"><span class="badge @Labels.Badge(Model.TrangThaiXuLy.ToString())">@Labels.Status(Model.TrangThaiXuLy.ToString())</span><p class="prose mt-3">@Model.MoTa</p>@if(Model.KetQuaXuLy!=null){<h3>Kết quả thực tế</h3><p>@Model.KetQuaXuLy</p>}<h3>Lịch sử phương án xử lý</h3>@foreach(var o in opts){<div class="notice">@(o.LaHienHanh?"Hiện hành · ":"")@o.NoiDung</div>}</div>@if(!new[]{"DaGiaiQuyet","DungXuLy"}.Contains(Model.TrangThaiXuLy.ToString())){<div class="panel"><h2>Cập nhật xử lý</h2><form action="/Support/Action" method="post" >@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" name="Id" value="@Model.MaTinhHuong"/><input type="hidden" name="Version" value="@TravelService.Token(Model.RowVersion)"/><div class="field full"><label for="field-Text-1">Phương án hoặc kết quả thực tế</label><textarea id="field-Text-1" name="Text" class="form-control" maxlength="2000"></textarea></div><div class="form-actions"><button class="btn btn-dark" name="Decision" value="PhuongAn" type="submit">Chọn phương án</button><button class="btn btn-outline" name="Decision" value="ChuaGiaiQuyet" type="submit">Chưa giải quyết</button><button class="btn btn-outline" name="Decision" value="GiaiQuyetMotPhan" type="submit">Giải quyết một phần</button><button class="btn btn-outline" name="Decision" value="DaGiaiQuyet" type="submit">Đã giải quyết</button><button class="btn btn-outline" name="Decision" value="DungXuLy" type="submit">Dừng xử lý</button></div></form><p class="help mt-3">Sau khi thực hiện phương án, hãy cập nhật kết quả để theo dõi tiến độ xử lý.</p></div>}</div>