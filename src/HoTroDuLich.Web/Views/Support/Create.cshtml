@model IncidentInput
@{ViewData["Title"]="Báo cáo sự cố";var plan=(KeHoachChuyenDi)ViewBag.Plan;var activities=(List<HoatDongLichTrinh>)ViewBag.Activities;}
<div class="container-narrow"><a class="back" href="/Support?planId=@plan.MaKeHoach">← Danh sách sự cố</a><div class="page-head"><div><h1>Báo cáo sự cố</h1><p>Chuyến đi: @plan.TenKeHoach</p></div></div><div class="panel"><form action="/Support/Create" method="post" >@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" name="PlanId" value="@plan.MaKeHoach"/><div class="field"><label for="field-Type-1">Loại sự cố</label><select id="field-Type-1" class="form-select" asp-for="Type">@foreach(var type in DanhMuc.LoaiTinhHuong){<option value="@type">@DanhMuc.Ten(type)</option>}</select></div><div class="field full"><label for="field-Description-2">Mô tả sự việc</label><textarea id="field-Description-2" name="Description" class="form-control" maxlength="2000"></textarea></div><div class="field"><label for="field-Location-3">Vị trí</label><input id="field-Location-3" class="form-control" name="Location" type="text" /></div><div class="field mt-3"><label for="field-ActivityId-4">Hoạt động bị ảnh hưởng</label><select id="field-ActivityId-4" name="ActivityIds" class="form-select" multiple aria-describedby="activities-help">@foreach(var a in activities){<option value="@a.MaHoatDong">@a.NoiDung</option>}</select><small id="activities-help">Có thể chọn nhiều hoạt động bị ảnh hưởng.</small></div><div class="form-actions"><button class="btn btn-dark" type="submit">Báo cáo sự cố</button></div></form></div></div>