@model List<TinhHuongPhatSinh>
@{ViewData["Title"]="Tình huống phát sinh";var plans=(List<KeHoachChuyenDi>)ViewBag.Plans;var plan=ViewBag.Plan as KeHoachChuyenDi;}<div class="container-wide"><div class="page-head"><div><h1>Hỗ trợ trong chuyến đi</h1><p>Ghi lại sự cố, phương án xử lý và kết quả trong chuyến đi của bạn.</p></div>@if(plan!=null){<a class="btn btn-dark" href="/Support/Create?planId=@plan.MaKeHoach">@Ui.Icon("plus") Báo cáo sự cố</a>}</div><div class="notice">Bạn có thể lưu thông tin sự cố và theo dõi cách xử lý tại đây. Với việc cần hỗ trợ trực tiếp, hãy liên hệ nhà cung cấp hoặc đơn vị phù hợp.</div><form method="get" class="panel inline-form"><label for="planId">Chuyến đi của tôi</label><select class="form-select w-auto" id="planId" name="planId" required><option value="">Chọn chuyến đi</option>@foreach(var p in plans){<option value="@p.MaKeHoach" selected="@(p.MaKeHoach==plan?.MaKeHoach)">@p.TenKeHoach</option>}</select><button class="btn btn-dark" type="submit">Xem tình huống</button></form>@if(plan!=null){<section>@foreach(var t in Model){<a class="list-card" href="/Support/Detail/@t.MaTinhHuong"><div><span class="badge @Labels.Badge(t.TrangThaiXuLy.ToString())">@Labels.Status(t.TrangThaiXuLy.ToString())</span><h3>@t.LoaiTinhHuong</h3><p>@t.MoTa</p><span class="help">@t.ViTri</span></div><span>↗</span></a>}@if(Model.Count==0){<div class="empty"><span class="eyebrow">Thông tin</span><h3>Chưa có sự cố nào được ghi nhận</h3><p>Bạn chưa ghi nhận tình huống nào cho kế hoạch này.</p></div>}</section>}else{<div class="empty"><span class="eyebrow">Thông tin</span><h3>Chọn chuyến đi để tiếp tục</h3><p>Nếu chưa có kế hoạch, hãy tạo kế hoạch chuyến đi trước.</p><a class="btn btn-dark" href="/Plans">Chuyến đi của tôi</a></div>}</div>