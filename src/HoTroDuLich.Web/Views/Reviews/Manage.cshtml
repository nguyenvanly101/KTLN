@model ReviewManagementPage
@{var admin=User.IsInRole(TravelService.AdminRole);ViewData["Title"]=admin?"Kiểm duyệt đánh giá":"Đánh giá dịch vụ của bạn";var route=admin?"/Reviews/Moderation":"/Reviews/Partner";var rejected=ViewData["ReplyInput"] as ReviewReplyInput;var moderation=ViewData["ModerationInput"] as ReviewModerationInput;}
<div class="container-wide journey-page"><header class="product-heading"><div><span class="eyebrow">@(admin?"QUẢN TRỊ / NỘI DUNG TRẢI NGHIỆM":"ĐỐI TÁC / LẮNG NGHE KHÁCH HÀNG")</span><h1>@ViewData["Title"]</h1><p>Đánh giá và phản hồi có trạng thái xét duyệt riêng. Nội dung chỉ hiển thị công khai sau khi được duyệt.</p></div></header><partial name="/Views/Shared/_JourneyErrors.cshtml"/><form class="review-filter" action="@route" method="get"><input type="hidden" name="serviceId" value="@Model.ServiceId"/><label for="review-status">Trạng thái nội dung hoặc phản hồi</label><select class="form-control" name="status" id="review-status">@foreach(var state in new[]{"","ChoDuyet","DaDuyet","An"}){<option value="@state" selected="@(Model.Status==state)">@(state==""?"Tất cả":ReviewStates.Label(state))</option>}</select><button class="btn btn-outline" type="submit">Lọc</button></form><p class="help">@Model.Total đánh giá · Trang @Model.Page</p>
@if(Model.Items.Count==0){<div class="empty"><h2>Chưa có nội dung trong danh sách này</h2><p>Chọn trạng thái khác để xem các nội dung đã xử lý.</p></div>}
@foreach(var item in Model.Items){var r=item.Review;<article class="managed-review panel"><div class="section-head"><div><span class="eyebrow">ĐÁNH GIÁ #@r.MaDanhGia</span><h2>@item.ServiceName</h2><p>@r.SoSao / 5 · <span class="badge journey-status">@ReviewStates.Label(r.TrangThai)</span></p></div></div><p class="prose">@r.NoiDung</p>@if(!string.IsNullOrWhiteSpace(r.LyDoKiemDuyet)){<p class="help">Lý do kiểm duyệt: @r.LyDoKiemDuyet</p>}
@if(admin){<form class="moderation-form" action="/Reviews/Moderate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="Part" value="Review"/><label for="reason-review-@r.MaDanhGia">Lý do / ghi chú xét duyệt đánh giá</label><input class="form-control" name="Reason" id="reason-review-@r.MaDanhGia" maxlength="500" value="@(moderation?.Id==r.MaDanhGia&&moderation.Part=="Review"?moderation.Reason:"")"/><div class="actions"><button class="btn btn-dark btn-small" type="submit" name="Decision" value="DaDuyet">Công bố đánh giá</button><button class="btn btn-outline btn-small" type="submit" name="Decision" value="An">Ẩn đánh giá</button></div></form>}
@if(r.PhanHoiNCC!=null){<section class="provider-reply"><h3>Phản hồi của nhà cung cấp</h3><span class="badge journey-status">@ReviewStates.Label(r.TrangThaiPhanHoi)</span><p class="prose">@r.PhanHoiNCC</p>@if(!string.IsNullOrWhiteSpace(r.LyDoPhanHoi)){<p class="help">Lý do kiểm duyệt: @r.LyDoPhanHoi</p>}@if(admin){<form class="moderation-form" action="/Reviews/Moderate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="Part" value="Reply"/><label for="reason-reply-@r.MaDanhGia">Lý do / ghi chú xét duyệt phản hồi</label><input class="form-control" name="Reason" id="reason-reply-@r.MaDanhGia" maxlength="500" value="@(moderation?.Id==r.MaDanhGia&&moderation.Part=="Reply"?moderation.Reason:"")"/><div class="actions"><button class="btn btn-dark btn-small" type="submit" name="Decision" value="DaDuyet" disabled="@(r.TrangThai!="DaDuyet")">Công bố phản hồi</button><button class="btn btn-outline btn-small" type="submit" name="Decision" value="An">Ẩn phản hồi</button></div></form>}</section>}
@if(!admin&&r.TrangThai=="DaDuyet"){<form class="moderation-form" action="/Reviews/Reply" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="ServiceId" value="@Model.ServiceId"/><label for="reply-@r.MaDanhGia">Phản hồi đánh giá #@r.MaDanhGia</label><textarea class="form-control" id="reply-@r.MaDanhGia" name="Text" rows="3" maxlength="2000" required>@(rejected?.Id==r.MaDanhGia?rejected.Text:r.PhanHoiNCC)</textarea><button class="btn btn-outline" type="submit">Gửi phản hồi để duyệt</button></form>}</article>}
<nav class="actions" aria-label="Phân trang đánh giá">@if(Model.Page>1){<a class="btn btn-outline" href="@route?status=@Model.Status&serviceId=@Model.ServiceId&page=@(Model.Page-1)">← Trang trước</a>}@if(Model.Page*20<Model.Total){<a class="btn btn-outline" href="@route?status=@Model.Status&serviceId=@Model.ServiceId&page=@(Model.Page+1)">Trang sau →</a>}</nav></div>
