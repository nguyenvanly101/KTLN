@model ReviewManagementPage
@{var admin=User.IsInRole(TravelService.AdminRole);ViewData["Title"]=admin?"Kiểm duyệt đánh giá":"Đánh giá dịch vụ của bạn";var route=admin?"/Reviews/Moderation":"/Reviews/Partner";var rejected=ViewData["ReplyInput"] as ReviewReplyInput;var moderation=ViewData["ModerationInput"] as ReviewModerationInput;}
<div class="container-wide journey-page"><header class="product-heading"><div><span class="eyebrow">@(admin?"QUẢN TRỊ / NỘI DUNG TRẢI NGHIỆM":"ĐỐI TÁC / LẮNG NGHE KHÁCH HÀNG")</span><h1>@ViewData["Title"]</h1><p>@(admin?"Đánh giá và phản hồi chỉ hiện công khai sau khi được duyệt.":"Khách đánh giá sau khi dùng dịch vụ. Bạn phản hồi được khi đánh giá đã công bố.")</p></div></header><partial name="/Views/Shared/_JourneyErrors.cshtml"/><nav class="bk-chips" aria-label="Lọc theo trạng thái">@foreach(var state in new[]{"ChoDuyet","DaDuyet","An",""}){<a class="@(Model.Status==state?"on":"")" aria-current="@(Model.Status==state?"page":null)" href="@route?status=@state&serviceId=@Model.ServiceId">@(state==""?"Tất cả":ReviewStates.Label(state))</a>}</nav><p class="help">@Model.Total đánh giá@(Model.Total>20?" · Trang "+Model.Page:"")</p>
@if(Model.Items.Count==0){<div class="empty"><h2>Chưa có nội dung trong danh sách này</h2><p>Chọn trạng thái khác để xem các nội dung đã xử lý.</p></div>}
@foreach(var item in Model.Items){var r=item.Review;<article class="managed-review panel"><div class="section-head"><div><span class="eyebrow">ĐÁNH GIÁ CỦA KHÁCH</span><h2>@item.ServiceName</h2><p class="review-meta"><partial name="/Views/Shared/_Stars.cshtml" model="r.SoSao"/> <span class="badge journey-status">@ReviewStates.Label(r.TrangThai)</span> <time>@Ui.LocalTime(r.ThoiDiemCapNhat).ToString("dd/MM/yyyy")</time></p></div></div><p class="prose">@r.NoiDung</p>@if(!string.IsNullOrWhiteSpace(r.LyDoKiemDuyet)){<p class="help">Lý do kiểm duyệt: @r.LyDoKiemDuyet</p>}
@if(admin){<form class="moderation-form" action="/Reviews/Moderate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="Part" value="Review"/><label for="reason-review-@r.MaDanhGia">Lý do ẩn đánh giá (chỉ cần khi bấm Ẩn)</label><input class="form-control" name="Reason" id="reason-review-@r.MaDanhGia" maxlength="500" value="@(moderation?.Id==r.MaDanhGia&&moderation.Part=="Review"?moderation.Reason:"")"/><div class="actions"><button class="btn btn-dark btn-small" type="submit" name="Decision" value="DaDuyet">Công bố đánh giá</button><button class="btn btn-outline btn-small" type="submit" name="Decision" value="An" data-need-reason>Ẩn đánh giá</button></div></form>}
@if(r.PhanHoiNCC!=null){<section class="provider-reply"><h3>Phản hồi của nhà cung cấp</h3><span class="badge journey-status">@ReviewStates.Label(r.TrangThaiPhanHoi)</span><p class="prose">@r.PhanHoiNCC</p>@if(!string.IsNullOrWhiteSpace(r.LyDoPhanHoi)){<p class="help">Lý do kiểm duyệt: @r.LyDoPhanHoi</p>}@if(admin){<form class="moderation-form" action="/Reviews/Moderate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="Part" value="Reply"/><label for="reason-reply-@r.MaDanhGia">Lý do ẩn phản hồi (chỉ cần khi bấm Ẩn)</label><input class="form-control" name="Reason" id="reason-reply-@r.MaDanhGia" maxlength="500" value="@(moderation?.Id==r.MaDanhGia&&moderation.Part=="Reply"?moderation.Reason:"")"/><div class="actions"><button class="btn btn-dark btn-small" type="submit" name="Decision" value="DaDuyet" disabled="@(r.TrangThai!="DaDuyet")">Công bố phản hồi</button><button class="btn btn-outline btn-small" type="submit" name="Decision" value="An" data-need-reason>Ẩn phản hồi</button></div></form>}</section>}
@if(!admin&&r.TrangThai=="DaDuyet"){<form class="moderation-form" action="/Reviews/Reply" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="ServiceId" value="@Model.ServiceId"/><label for="reply-@r.MaDanhGia">@(r.PhanHoiNCC==null?"Phản hồi khách":"Sửa phản hồi")</label><textarea class="form-control" id="reply-@r.MaDanhGia" name="Text" rows="3" maxlength="2000" required>@(rejected?.Id==r.MaDanhGia?rejected.Text:r.PhanHoiNCC)</textarea><button class="btn btn-dark" type="submit">Gửi phản hồi</button><small class="help">Phản hồi hiện dưới đánh giá sau khi quản trị viên duyệt.</small></form>}</article>}
<nav class="actions" aria-label="Phân trang đánh giá">@if(Model.Page>1){<a class="btn btn-outline" href="@route?status=@Model.Status&serviceId=@Model.ServiceId&page=@(Model.Page-1)">← Trang trước</a>}@if(Model.Page*20<Model.Total){<a class="btn btn-outline" href="@route?status=@Model.Status&serviceId=@Model.ServiceId&page=@(Model.Page+1)">Trang sau →</a>}</nav></div>
