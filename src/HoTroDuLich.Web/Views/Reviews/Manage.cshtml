@model ReviewManagementPage
@{var admin=User.IsInRole(TravelService.AdminRole);ViewData["Title"]=admin?"Đánh giá dịch vụ":"Đánh giá dịch vụ của bạn";var route=admin?"/Reviews/Moderation":"/Reviews/Partner";var rejected=ViewData["ReplyInput"] as ReviewReplyInput;var moderation=ViewData["ModerationInput"] as ReviewModerationInput;}
<div class="container-wide journey-page"><header class="product-heading"><div><span class="eyebrow">@(admin?"QUẢN TRỊ / NỘI DUNG TRẢI NGHIỆM":"ĐỐI TÁC / LẮNG NGHE KHÁCH HÀNG")</span><h1>@ViewData["Title"]</h1><p>@(admin?"Đánh giá và phản hồi hiện ngay khi được gửi. Ẩn những nội dung không phù hợp (kèm lý do); có thể hiện lại sau.":"Khách đánh giá sau khi dùng dịch vụ. Phản hồi của bạn hiện ngay dưới đánh giá.")</p></div></header><partial name="/Views/Shared/_JourneyErrors.cshtml"/><nav class="bk-chips" aria-label="Lọc theo trạng thái">@foreach(var state in new[]{"","DaDuyet","An"}){<a class="@(Model.Status==state?"on":"")" aria-current="@(Model.Status==state?"page":null)" href="@route?status=@state&serviceId=@Model.ServiceId">@(state==""?"Tất cả":ReviewStates.Label(state))</a>}</nav><p class="help">@Model.Total đánh giá@(Model.Total>20?" · Trang "+Model.Page:"")</p>
@if(Model.Items.Count==0){<div class="empty"><h2>Chưa có nội dung trong danh sách này</h2><p>Chọn trạng thái khác để xem các nội dung đã xử lý.</p></div>}
@foreach(var item in Model.Items){var r=item.Review;<article class="managed-review panel"><div class="section-head"><div><span class="eyebrow">ĐÁNH GIÁ CỦA KHÁCH</span><h2>@item.ServiceName</h2><p class="review-meta"><partial name="/Views/Shared/_Stars.cshtml" model="r.SoSao"/> @if(r.TrangThai=="An"){<span class="badge badge-warning">Đã ẩn</span>} <time>@Ui.LocalTime(r.ThoiDiemCapNhat).ToString("dd/MM/yyyy")</time></p></div></div><p class="prose">@r.NoiDung</p>@if(!string.IsNullOrWhiteSpace(r.LyDoKiemDuyet)){<p class="help">Lý do ẩn: @r.LyDoKiemDuyet</p>}
@if(admin){<form class="moderation-form" action="/Reviews/Moderate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="Part" value="Review"/>@if(r.TrangThai=="An"){<div class="actions"><button class="btn btn-outline btn-small" type="submit" name="Decision" value="DaDuyet">Hiện lại đánh giá</button></div>}else{<details class="hide-box"><summary>Ẩn đánh giá này</summary><label for="reason-review-@r.MaDanhGia">Lý do ẩn (khách sẽ thấy)</label><input class="form-control" name="Reason" id="reason-review-@r.MaDanhGia" maxlength="500" value="@(moderation?.Id==r.MaDanhGia&&moderation.Part=="Review"?moderation.Reason:"")"/><button class="btn btn-danger btn-small" type="submit" name="Decision" value="An" data-need-reason>Ẩn đánh giá</button></details>}</form>}
@if(r.PhanHoiNCC!=null){<section class="provider-reply"><h3>Phản hồi của nhà cung cấp</h3>@if(r.TrangThaiPhanHoi=="An"){<span class="badge badge-warning">Đã ẩn</span>}<p class="prose">@r.PhanHoiNCC</p>@if(!string.IsNullOrWhiteSpace(r.LyDoPhanHoi)){<p class="help">Lý do ẩn: @r.LyDoPhanHoi</p>}@if(admin){<form class="moderation-form" action="/Reviews/Moderate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="Part" value="Reply"/>@if(r.TrangThaiPhanHoi=="An"){<div class="actions"><button class="btn btn-outline btn-small" type="submit" name="Decision" value="DaDuyet">Hiện lại phản hồi</button></div>}else{<details class="hide-box"><summary>Ẩn phản hồi này</summary><label for="reason-reply-@r.MaDanhGia">Lý do ẩn (nhà cung cấp sẽ thấy)</label><input class="form-control" name="Reason" id="reason-reply-@r.MaDanhGia" maxlength="500" value="@(moderation?.Id==r.MaDanhGia&&moderation.Part=="Reply"?moderation.Reason:"")"/><button class="btn btn-danger btn-small" type="submit" name="Decision" value="An" data-need-reason>Ẩn phản hồi</button></details>}</form>}</section>}
@if(!admin&&r.TrangThai!="An"){@if(r.PhanHoiNCC==null){<form class="moderation-form" action="/Reviews/Reply" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="ServiceId" value="@Model.ServiceId"/><label for="reply-@r.MaDanhGia">@(r.PhanHoiNCC==null?"Phản hồi khách":"Sửa phản hồi")</label><textarea class="form-control" id="reply-@r.MaDanhGia" name="Text" rows="3" maxlength="2000" required>@(rejected?.Id==r.MaDanhGia?rejected.Text:r.PhanHoiNCC)</textarea><button class="btn btn-dark" type="submit">Gửi phản hồi</button><small class="help">Phản hồi hiện ngay dưới đánh giá, khách được báo.</small></form>}else{<details class="hide-box reply-edit"><summary>Sửa phản hồi</summary><form class="moderation-form" action="/Reviews/Reply" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaDanhGia"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="ServiceId" value="@Model.ServiceId"/><label for="reply-@r.MaDanhGia">@(r.PhanHoiNCC==null?"Phản hồi khách":"Sửa phản hồi")</label><textarea class="form-control" id="reply-@r.MaDanhGia" name="Text" rows="3" maxlength="2000" required>@(rejected?.Id==r.MaDanhGia?rejected.Text:r.PhanHoiNCC)</textarea><button class="btn btn-dark" type="submit">Gửi phản hồi</button><small class="help">Phản hồi hiện ngay dưới đánh giá, khách được báo.</small></form></details>}}</article>}
<nav class="actions" aria-label="Phân trang đánh giá">@if(Model.Page>1){<a class="btn btn-outline" href="@route?status=@Model.Status&serviceId=@Model.ServiceId&page=@(Model.Page-1)">← Trang trước</a>}@if(Model.Page*20<Model.Total){<a class="btn btn-outline" href="@route?status=@Model.Status&serviceId=@Model.ServiceId&page=@(Model.Page+1)">Trang sau →</a>}</nav></div>
