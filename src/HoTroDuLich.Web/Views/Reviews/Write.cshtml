@model ReviewWritePage
@{ViewData["Title"]="Đánh giá trải nghiệm";var input=Model.Input;}
<div class="container-narrow journey-page"><a class="back" href="/Reviews/Mine">← Đánh giá của tôi</a><header class="page-head"><div><span class="eyebrow">ĐÁNH GIÁ DỊCH VỤ</span><h1>@Model.ServiceName</h1><p>Ngày dùng @BookingUi.Dates(Model.Booking)</p></div></header><section class="panel"><form action="/Reviews/Write" method="post">@Html.AntiForgeryToken()<partial name="/Views/Shared/_JourneyErrors.cshtml"/><input type="hidden" name="Id" value="@input.Id"/><input type="hidden" name="BookingId" value="@input.BookingId"/>@if(input.Id>0){<input type="hidden" name="Version" value="@input.Version"/>}<fieldset class="field star-input"><legend>Bạn hài lòng đến đâu?</legend><div class="star-pick">@foreach(var value in new[]{5,4,3,2,1}){<input type="radio" id="star-@value" name="Stars" value="@value" checked="@(input.Stars==value)" required/><label for="star-@value" title="@value sao">★<span class="sr-only">@value sao</span></label>}</div><small class="help star-caption" data-star-caption></small>@Html.ValidationMessage("Stars")</fieldset><div class="field"><label for="Content">Kể ngắn trải nghiệm của bạn</label><textarea class="form-control" id="Content" name="Content" maxlength="2000" rows="6" required>@input.Content</textarea>@Html.ValidationMessage("Content")</div><p class="help">Đánh giá hiện ngay trên trang dịch vụ, bạn sửa lại được bất cứ lúc nào. Không ghi số điện thoại hay thông tin riêng của người khác.</p><div class="form-actions"><button class="btn btn-dark" type="submit">Gửi đánh giá</button><a class="text-link" href="/Reviews/Mine">Quay lại</a></div></form></section></div>
