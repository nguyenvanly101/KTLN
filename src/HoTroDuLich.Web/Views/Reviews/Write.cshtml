@model ReviewWritePage
@{ViewData["Title"]="Đánh giá trải nghiệm";var input=Model.Input;}
<div class="container-narrow journey-page"><a class="back" href="/Reviews/Mine">← Đánh giá của tôi</a><header class="page-head"><div><span class="eyebrow">TRẢI NGHIỆM TỪ YÊU CẦU ĐÃ CÓ KẾT QUẢ</span><h1>@Model.ServiceName</h1><p>Ngày phục vụ @Model.Booking.NgayBatDau.ToString("dd/MM/yyyy") · Yêu cầu #@Model.Booking.MaYeuCau</p></div></header><section class="panel"><form action="/Reviews/Write" method="post">@Html.AntiForgeryToken()<partial name="/Views/Shared/_JourneyErrors.cshtml"/><input type="hidden" name="Id" value="@input.Id"/><input type="hidden" name="BookingId" value="@input.BookingId"/>@if(input.Id>0){<input type="hidden" name="Version" value="@input.Version"/>}<div class="field"><label for="Stars">Mức hài lòng của bạn</label><select class="form-control" id="Stars" name="Stars">@foreach(var value in new[]{5,4,3,2,1}){<option value="@value" selected="@(input.Stars==value)">@value / 5</option>}</select>@Html.ValidationMessage("Stars")</div><div class="field"><label for="Content">Trải nghiệm thực tế</label><textarea class="form-control" id="Content" name="Content" maxlength="2000" rows="6" required>@input.Content</textarea>@Html.ValidationMessage("Content")</div><div class="notice">Nội dung sẽ được xét duyệt trước khi công bố. Khi sửa, đánh giá tạm trở về chờ duyệt. Tránh đưa số điện thoại, giấy tờ hoặc thông tin riêng của người khác vào đánh giá.</div><div class="form-actions"><button class="btn btn-dark" type="submit">Gửi đánh giá</button><a class="text-link" href="/Reviews/Mine">Quay lại</a></div></form></section></div>
