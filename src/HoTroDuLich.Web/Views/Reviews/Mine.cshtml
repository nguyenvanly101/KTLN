@model MyReviewsPage
@{
 ViewData["Title"]="Đánh giá của tôi";
 var todo=Model.Bookings.Where(b=>!Model.Reviews.ContainsKey(b.MaYeuCau)).ToList();
 var done=Model.Bookings.Where(b=>Model.Reviews.ContainsKey(b.MaYeuCau)).OrderByDescending(b=>Model.Reviews[b.MaYeuCau].ThoiDiemCapNhat).ToList();
}
<div class="container-narrow journey-page reviews-mine">
 <header class="page-head"><div><h1>Đánh giá của tôi</h1><p>Đánh giá giúp người đi sau chọn dịch vụ. Bạn đánh giá được sau ngày dùng dịch vụ.</p></div></header>
 @if(Model.Bookings.Count==0){<div class="empty"><h2>Chưa có dịch vụ để đánh giá</h2><p>Sau ngày dùng một dịch vụ đã đặt, bạn sẽ thấy nó ở đây.</p><a class="btn btn-outline" href="/Bookings">Xem dịch vụ đã đặt</a></div>}
 @if(todo.Count>0)
 {
  <h2 class="reviews-title">Chờ bạn đánh giá <small>@todo.Count</small></h2>
  <div class="review-list">@foreach(var b in todo){<article class="review-own-row"><div class="review-own-main"><strong>@Model.Names[b.MaDichVu]</strong><small>Ngày dùng @BookingUi.Dates(b)</small></div><a class="btn btn-dark" href="/Reviews/Write?bookingId=@b.MaYeuCau">Viết đánh giá</a></article>}</div>
 }
 @if(done.Count>0)
 {
  <h2 class="reviews-title">Đã đánh giá <small>@done.Count</small></h2>
  <div class="review-list">@foreach(var b in done){var r=Model.Reviews[b.MaYeuCau];<article class="review-own-row is-done"><div class="review-own-main"><strong>@Model.Names[b.MaDichVu]</strong><p class="review-meta"><partial name="/Views/Shared/_Stars.cshtml" model="r.SoSao"/>@if(r.TrangThai=="An"){<span class="badge badge-warning">Đã ẩn</span>}</p><p class="review-text">@r.NoiDung</p>@if(!string.IsNullOrWhiteSpace(r.LyDoKiemDuyet)&&r.TrangThai=="An"){<p class="notice">Đánh giá đang bị ẩn: @r.LyDoKiemDuyet. Sửa lại để hiện lại.</p>}@if(r.PhanHoiNCC!=null&&r.TrangThaiPhanHoi=="DaDuyet"){<div class="provider-reply"><strong>Cơ sở phản hồi</strong><p>@r.PhanHoiNCC</p></div>}</div><a class="btn btn-outline" href="/Reviews/Write?bookingId=@b.MaYeuCau">Sửa</a></article>}</div>
 }
</div>
