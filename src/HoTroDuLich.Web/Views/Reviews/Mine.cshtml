@model MyReviewsPage
@{ViewData["Title"]="Đánh giá của tôi";}
<div class="container-wide journey-page"><header class="product-heading"><div><span class="eyebrow">SAU MỖI TRẢI NGHIỆM</span><h1>Chia sẻ điều bạn đã trải qua.</h1><p>Đánh giá giúp người đi sau có thêm thông tin lựa chọn dịch vụ.</p></div></header><partial name="/Views/Shared/_BookingWorkspaceTabs.cshtml"/>
@if(Model.Bookings.Count==0){<div class="empty"><h2>Chưa có dịch vụ đủ điều kiện đánh giá</h2><p>Sau ngày phục vụ, yêu cầu của bạn cần có kết quả hoàn tất và không còn đối chiếu đang chờ. Bạn có thể theo dõi ở phần Kết quả phục vụ.</p><a class="btn btn-outline" href="/Bookings/Results">Xem kết quả phục vụ</a></div>}
@foreach(var booking in Model.Bookings){var review=Model.Reviews.GetValueOrDefault(booking.MaYeuCau);<article class="review-own-row"><div><span class="eyebrow">YÊU CẦU #@booking.MaYeuCau</span><h2>@Model.Names[booking.MaDichVu]</h2><p class="help">@booking.NgayBatDau.ToString("dd/MM/yyyy") · @Labels.Status(booking.TrangThai.ToString())</p>@if(review!=null){<span class="review-rating">@review.SoSao / 5</span><span class="badge journey-status">@ReviewStates.Label(review.TrangThai)</span><p class="prose">@review.NoiDung</p>@if(!string.IsNullOrWhiteSpace(review.LyDoKiemDuyet)){<p class="notice">Lý do kiểm duyệt: @review.LyDoKiemDuyet</p>}}</div><div class="actions"><a class="btn btn-outline" href="/Reviews/Write?bookingId=@booking.MaYeuCau">@(review==null?"Viết đánh giá":"Sửa đánh giá")</a><a class="text-link" href="/Bookings/Outcome/@booking.MaYeuCau">Xem kết quả</a></div></article>}</div>
