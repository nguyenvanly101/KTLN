@model ReviewFeed
<section class="public-reviews panel" aria-label="Đánh giá trải nghiệm dịch vụ"><div class="section-head"><div><h2>Đánh giá của khách</h2></div>@if(Model.Average is double value){<div class="review-score"><strong>@value.ToString("0.0")</strong><partial name="/Views/Shared/_Stars.cshtml" model="(int)Math.Round(value)"/><small>@Model.Total đánh giá</small></div>}</div><p class="help">Chỉ khách đã đặt và dùng dịch vụ mới viết được đánh giá.</p>
@if(Model.Items.Count==0){<p class="review-empty">Chưa có đánh giá nào. Khách đặt dịch vụ qua Hành Trình sẽ được mời đánh giá sau khi dùng.</p>}
@foreach(var review in Model.Items){<article class="public-review"><div class="review-byline"><strong>Khách đã dùng dịch vụ</strong><partial name="/Views/Shared/_Stars.cshtml" model="review.SoSao"/><time>@Ui.LocalTime(review.ThoiDiemTao).ToString("dd/MM/yyyy")</time></div><p class="prose">@review.NoiDung</p>@if(review.PhanHoiNCC!=null){<div class="provider-reply"><strong>Phản hồi từ nhà cung cấp</strong><p class="prose">@review.PhanHoiNCC</p></div>}</article>}
<div class="actions">@if(Model.Page>1){<a class="text-link" href="/Reviews/Service/@Model.Service.MaDichVu?page=@(Model.Page-1)">← Trang trước</a>}@if(Model.Page*20<Model.Total){<a class="text-link" href="/Reviews/Service/@Model.Service.MaDichVu?page=@(Model.Page+1)">Xem đánh giá tiếp theo →</a>}</div></section>
