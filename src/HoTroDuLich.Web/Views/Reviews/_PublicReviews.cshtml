@model ReviewFeed
<section class="public-reviews panel" aria-label="Đánh giá trải nghiệm dịch vụ"><div class="section-head"><div><span class="eyebrow">NGƯỜI ĐI TRƯỚC CHIA SẺ</span><h2>Đánh giá trải nghiệm</h2></div><span class="review-rating">@(Model.Average is double value?value.ToString("0.0")+" / 5":"Chưa có điểm")</span></div><p class="help">@Model.Total đánh giá được công bố · Chỉ từ tài khoản có yêu cầu đã có kết quả, qua ngày phục vụ và không còn đối chiếu đang chờ.</p>
@if(Model.Items.Count==0){<p>Dịch vụ chưa có đánh giá được công bố.</p>}
@foreach(var review in Model.Items){<article class="public-review"><div class="review-byline"><strong>Khách đã có yêu cầu dịch vụ</strong><span>@review.SoSao / 5</span><time>@Ui.LocalTime(review.ThoiDiemTao).ToString("dd/MM/yyyy")</time></div><p class="prose">@review.NoiDung</p>@if(review.PhanHoiNCC!=null){<div class="provider-reply"><strong>Phản hồi từ nhà cung cấp</strong><p class="prose">@review.PhanHoiNCC</p></div>}</article>}
<div class="actions">@if(Model.Page>1){<a class="text-link" href="/Reviews/Service/@Model.Service.MaDichVu?page=@(Model.Page-1)">← Trang trước</a>}@if(Model.Page*20<Model.Total){<a class="text-link" href="/Reviews/Service/@Model.Service.MaDichVu?page=@(Model.Page+1)">Xem đánh giá tiếp theo →</a>}</div></section>
