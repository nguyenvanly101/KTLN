@model CompanionWorkspace
@{var g=Model.Group;var me=Model.Me.MaTaiKhoan;var net=Model.Balances.GetValueOrDefault(me);var active=Model.Members.Where(x=>x.TrangThai=="DaThamGia").OrderBy(x=>x.MaTaiKhoan).ToList();var latestDate=TravelService.Today<=g.NgayKetThuc?TravelService.Today:g.NgayKetThuc;var canAdd=!g.AnBoiQuanTri&&g.TrangThai is "Mo" or "DaChot" or "DaKetThuc"&&g.NgayBatDau<=TravelService.Today;}
<div class="section-head"><div><span class="eyebrow">RÕ TỪNG KHOẢN, THOẢI MÁI ĐI CÙNG</span><h2>Chi phí chung của nhóm</h2><p>Khoản chi dùng chung được ghi riêng. Chi tiêu cá nhân trong chuyến đi không tự xuất hiện ở đây.</p></div>@if(canAdd){<a class="btn btn-outline" href="#expense-form">Ghi khoản tôi đã trả</a>}</div>
<section class="together-balance-card"><div><small>SỐ DƯ CỦA BẠN</small><strong>@(net<0?"Cần hoàn trả":net>0?"Được nhận lại":"Đã cân bằng")</strong></div><b>@Ui.ActualMoney(Math.Abs(net))</b><p>Chỉ khoản hoàn trả đã được người nhận xác nhận mới làm thay đổi số dư.</p></section>
<div class="together-columns"><section><article class="panel"><h2>Số dư các thành viên</h2>@if(Model.Balances.Count==0){<p>Nhóm chưa có khoản chi chung.</p>}@foreach(var balance in Model.Balances.OrderBy(x=>Model.Names.GetValueOrDefault(x.Key))){<div class="together-balance-row"><strong>@Model.Names.GetValueOrDefault(balance.Key,"Thành viên")</strong><span>@(balance.Value<0?"Cần trả ":balance.Value>0?"Được nhận ":"Cân bằng ")@Ui.ActualMoney(Math.Abs(balance.Value))</span></div>}</article>
<h2>Các khoản đã ghi</h2>@if(Model.Expenses.Count==0){<p>Chưa có khoản chi trong trang này.</p>}@foreach(var item in Model.Expenses){var c=item.Cost;<article class="panel together-expense" id="expense-@c.MaKhoanChi"><span class="eyebrow">@c.NgayChi.ToString("dd/MM/yyyy") · @(c.DaHuy?"ĐÃ HỦY GHI NHẬN":"KHOẢN CHI CHUNG")</span><h3>@c.NoiDung</h3><strong>@Ui.ActualMoney(c.SoTien)</strong><p>@Model.Names.GetValueOrDefault(c.MaNguoiTra,"Thành viên") đã ghi khoản mình trả · @(c.ChiaDeu?"Chia đều":"Chia theo số tiền")</p><details><summary>Phần chia của từng người</summary>@foreach(var s in item.Shares){<div class="together-balance-row"><span>@Model.Names.GetValueOrDefault(s.MaTaiKhoan,"Thành viên")</span><strong>@Ui.ActualMoney(s.SoTien)</strong></div>}</details>@if(c.MaNguoiTra==me&&!c.DaHuy){<form action="/Together/CancelExpense" method="post" data-confirm="Hủy ghi nhận khoản chi này? Số dư của nhóm sẽ được tính lại và lịch sử vẫn được giữ.">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Id" value="@c.MaKhoanChi"/><input type="hidden" name="Version" value="@TravelService.Token(c.RowVersion)"/><input type="hidden" name="Tab" value="expenses"/><button class="quiet-button" type="submit">Hủy ghi nhận khoản chi</button></form>}</article>}
<h2>Đối chiếu hoàn trả</h2><p class="help">Đây là ghi nhận tiền đã hoàn trả bên ngoài website. Người nhận kiểm tra rồi xác nhận.</p>@if(Model.Payments.Count==0){<p>Chưa có khoản hoàn trả được ghi.</p>}@foreach(var p in Model.Payments){<article class="panel together-payment"><span class="together-status">@CompanionLabels.State(p.TrangThai)</span><h3>@Model.Names.GetValueOrDefault(p.MaNguoiGui,"Thành viên") → @Model.Names.GetValueOrDefault(p.MaNguoiNhan,"Thành viên")</h3><strong>@Ui.ActualMoney(p.SoTien)</strong><p class="prose">@p.GhiChu</p>@if(p.TrangThai=="ChoXacNhan"&&(p.MaNguoiGui==me||p.MaNguoiNhan==me)){<form action="/Together/PaymentAction" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Id" value="@p.MaHoanTra"/><input type="hidden" name="Version" value="@TravelService.Token(p.RowVersion)"/><input type="hidden" name="Tab" value="expenses"/><div class="actions">@if(p.MaNguoiNhan==me){<button class="btn btn-dark" name="Decision" value="Confirm" type="submit">Xác nhận tôi đã nhận tiền</button><button class="btn btn-outline" name="Decision" value="Reject" type="submit">Chưa nhận / không khớp</button>}else{<button class="btn btn-outline" name="Decision" value="Cancel" type="submit">Rút ghi nhận đang chờ</button>}</div></form>}</article>}
<nav class="actions" aria-label="Phân trang khoản hoàn trả">@if(Model.PaymentPage>1){<a class="text-link" href="/Together/Group/@g.MaNhom?tab=expenses&page=@Model.Page&paymentPage=@(Model.PaymentPage-1)">← Hoàn trả trang trước</a>}@if(Model.MorePayments){<a class="text-link" href="/Together/Group/@g.MaNhom?tab=expenses&page=@Model.Page&paymentPage=@(Model.PaymentPage+1)">Hoàn trả trang sau →</a>}</nav></section><aside>@if(canAdd){<section class="panel" id="expense-form"><h2>Khoản tiền tôi đã trả</h2><form action="/Together/Expense" method="post" data-group-expense>@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="PayerId" value="@me"/><input type="hidden" name="SubmissionId" value="@Guid.NewGuid()"/><input type="hidden" name="Tab" value="expenses"/><div class="field"><label for="Title">Chi cho việc gì?</label><input class="form-control" id="Title" name="Title" maxlength="200" required/></div><div class="field"><label for="Amount">Tổng tiền bạn đã trả (VND)</label><input class="form-control" id="Amount" name="Amount" type="number" min="0.01" max="1000000000" step="0.01" required/></div><div class="field"><label for="Date">Ngày chi</label><input class="form-control" id="Date" name="Date" type="date" value="@latestDate.ToString("yyyy-MM-dd")" min="@g.NgayBatDau.ToString("yyyy-MM-dd")" max="@latestDate.ToString("yyyy-MM-dd")" required/></div><div class="field"><label for="Equal">Cách chia</label><select class="form-control" id="Equal" name="Equal"><option value="true">Chia đều cho người được chọn</option><option value="false">Nhập số tiền từng người</option></select></div><fieldset><legend>Những ai cùng chia khoản này?</legend>@for(var n=0;n<active.Count;n++){var person=active[n];<div class="together-share-person"><label class="product-checkbox"><input type="checkbox" name="Participants" value="@person.MaTaiKhoan" checked/> @Model.Names.GetValueOrDefault(person.MaTaiKhoan,"Thành viên")</label><input type="hidden" name="Shares[@n].UserId" value="@person.MaTaiKhoan"/><label class="help" for="share-amount-@person.MaTaiKhoan">Phần tiền nếu chia theo số tiền</label><input class="form-control" id="share-amount-@person.MaTaiKhoan" name="Shares[@n].Amount" type="number" min="0.01" max="1000000000" step="0.01"/></div>}</fieldset><p class="help">Chia đều chỉ tính những người được chọn. Nếu chia theo số tiền, tổng các phần phải bằng đúng số tiền bạn đã trả.</p><button class="btn btn-dark" type="submit">Ghi khoản chi chung</button></form></section>}
@if(net<0){<section class="panel"><h2>Ghi khoản tôi đã hoàn trả</h2><p>Bạn đã trả tiền ngoài website? Gửi ghi nhận để người nhận xác nhận.</p><form action="/Together/Payment" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="SubmissionId" value="@Guid.NewGuid()"/><input type="hidden" name="Tab" value="expenses"/><div class="field"><label for="ReceiverId">Người nhận</label><select class="form-control" id="ReceiverId" name="ReceiverId">@foreach(var person in active.Where(x=>Model.Balances.GetValueOrDefault(x.MaTaiKhoan)>0&&x.MaTaiKhoan!=me)){<option value="@person.MaTaiKhoan">@Model.Names.GetValueOrDefault(person.MaTaiKhoan,"Thành viên")</option>}</select></div><div class="field"><label for="payment-amount">Số tiền đã hoàn trả (VND)</label><input class="form-control" id="payment-amount" name="Amount" type="number" min="0.01" max="@((-net).ToString(System.Globalization.CultureInfo.InvariantCulture))" step="0.01" required/></div><div class="field"><label for="Note">Ghi chú (tùy chọn)</label><input class="form-control" id="Note" name="Note" maxlength="300"/></div><button class="btn btn-outline" type="submit">Gửi ghi nhận hoàn trả</button></form></section>}
</aside></div>

