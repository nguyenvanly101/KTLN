@model CompanionReportPage
@{ViewData["Title"]="Báo cáo nội dung đồng hành";}
<div class="container-narrow together-page"><a class="back" href="/Together/Mine">← Không gian đồng hành</a><header class="product-heading"><div><span class="eyebrow">ĐỒNG HÀNH / GỬI NỘI DUNG CẦN XEM XÉT</span><h1>Báo cáo nội dung</h1><p>Nhóm: @Model.GroupName</p></div></header><partial name="_Errors"/><section class="panel"><h2>Nội dung đang báo cáo</h2><blockquote class="prose">@Model.Evidence</blockquote><form action="/Together/Report" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@Model.Input.GroupId"/><input type="hidden" name="MessageId" value="@Model.Input.MessageId"/><div class="field"><label for="Category">Vấn đề bạn gặp</label><select class="form-control" id="Category" name="Category">@foreach(var option in new Dictionary<string,string>{{"Spam","Tin rác"},{"QuayRoi","Quấy rối"},{"LuaDao","Nghi ngờ lừa đảo"},{"Khac","Vấn đề khác"}}){<option value="@option.Key" selected="@(Model.Input.Category==option.Key)">@option.Value</option>}</select></div><div class="field"><label for="Description">Mô tả để quản trị xem xét</label><textarea class="form-control" id="Description" name="Description" rows="4" maxlength="2000" required>@Model.Input.Description</textarea></div><p class="help">Nội dung báo cáo và đoạn bằng chứng được gửi cho quản trị; không hiển thị trong nhóm.</p><button class="btn btn-dark" type="submit">Gửi báo cáo</button></form></section></div>
