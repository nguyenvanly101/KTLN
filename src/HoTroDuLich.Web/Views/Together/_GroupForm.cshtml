@model CompanionGroupInput
@{var plans=(List<KeHoachChuyenDi>)ViewBag.CompanionPlans;}
<input asp-for="Id" type="hidden"/><input asp-for="Version" type="hidden"/><input asp-for="ConnectionId" type="hidden"/>
<div class="field"><label asp-for="Name">Tên lời rủ / chuyến đi</label><input class="form-control" asp-for="Name" maxlength="150" required placeholder="Một buổi sáng săn mây ở Đà Lạt"/></div><div class="field"><label asp-for="Description">Cùng nhau làm gì?</label><textarea class="form-control" asp-for="Description" rows="4" maxlength="2000" required></textarea><p class="help">Phần này có thể công khai. Để số điện thoại, địa chỉ riêng và điểm hẹn cụ thể ở ngoài nội dung giới thiệu.</p></div>
<div class="together-form-grid"><div class="field"><label asp-for="Kind">Hình thức đồng hành</label><select class="form-control" asp-for="Kind"><option value="HoatDong">Một hoạt động trong ngày</option><option value="ChuyenDi">Chuyến đi nhiều ngày</option></select></div><div class="field"><label asp-for="Region">Khu vực</label><input class="form-control" asp-for="Region" maxlength="100" required/></div><div class="field"><label asp-for="Start">Ngày bắt đầu</label><input class="form-control" asp-for="Start" type="date" required/></div><div class="field"><label asp-for="End">Ngày kết thúc</label><input class="form-control" asp-for="End" type="date" required/></div><div class="field"><label asp-for="Capacity">Số người tối đa (gồm bạn)</label><input class="form-control" asp-for="Capacity" type="number" min="2" max="30" required/></div><div class="field"><label asp-for="Budget">Ngân sách dự kiến/người (tùy chọn)</label><input class="form-control" asp-for="Budget" type="number" min="0" max="1000000000" step="0.01"/></div><div class="field"><label asp-for="Style">Phong cách trải nghiệm</label><select class="form-control" asp-for="Style">@foreach(var item in CompanionLabels.Styles){<option value="@item.Key">@item.Value</option>}</select></div><div class="field"><label asp-for="Pace">Nhịp đi</label><select class="form-control" asp-for="Pace">@foreach(var item in CompanionLabels.Paces){<option value="@item.Key">@item.Value</option>}</select></div></div>
<fieldset><legend>Điểm hẹn dành cho thành viên</legend><div class="field"><label asp-for="Meeting">Địa điểm tập trung (tùy chọn)</label><input class="form-control" asp-for="Meeting" maxlength="300"/></div><div class="field"><label asp-for="MeetTime">Giờ tập trung ngày bắt đầu (tùy chọn)</label><input class="form-control" asp-for="MeetTime" type="time"/></div><p class="help">Khi đổi ngày bắt đầu, địa điểm hoặc giờ hẹn, các thành viên cần xác nhận lại.</p></fieldset>
@if(Model.Id==0){<div class="field"><label asp-for="PlanId">Gắn với chuyến riêng của bạn (tùy chọn)</label><select class="form-control" asp-for="PlanId"><option value="">Nhóm hoạt động độc lập</option>@foreach(var plan in plans){<option value="@plan.MaKeHoach">@plan.TenKeHoach</option>}</select><p class="help">Liên kết giúp bạn tổ chức nhóm. Lịch riêng, chi tiêu và dữ liệu đặt dịch vụ không tự được chia sẻ.</p></div>}else{<input asp-for="PlanId" type="hidden"/>}
@if(Model.Id==0||!Model.Publish){<label class="product-checkbox"><input asp-for="Publish"/> Công bố tên, giới thiệu, khu vực, ngày và ngân sách dự kiến để nhận thành viên</label><p class="help">Bỏ chọn để lưu bản nháp. Bạn có thể công bố sau.</p>}
<div class="actions"><button class="btn btn-dark" type="submit">@(Model.Id==0?"Lưu lời rủ":"Lưu thay đổi")</button><a class="btn btn-outline" href="/Together/Mine">Quay lại</a></div>
