@model CompanionMinePage
@{ViewData["Title"]="Nhóm đồng hành của tôi";var me=long.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);}
<div class="container-wide together-page"><header class="product-heading"><div><span class="eyebrow">ĐỒNG HÀNH / NHỮNG CUỘC HẸN CỦA BẠN</span><h1>Nhóm đồng hành của tôi</h1><p>Lời mời, đề nghị tham gia và những nhóm bạn cùng lên đường.</p></div><a class="btn btn-dark" href="/Together/Edit">@Ui.Icon("plus") Tạo lời rủ</a></header><partial name="_Nav"/><partial name="_Errors"/>
@if(Model.Groups.Count==0){<div class="empty"><h2>Bắt đầu từ một lời rủ</h2><p>Khám phá một trải nghiệm bạn muốn tham gia hoặc mời mọi người đi cùng.</p><a class="btn btn-dark" href="/Together">Khám phá lời rủ</a></div>}
<div class="together-mine-list">@foreach(var g in Model.Groups){var m=Model.Memberships[g.MaNhom];<article class="panel together-mine-card"><img src="@Ui.DestinationImage(g.KhuVuc)" alt="Ảnh minh họa @g.KhuVuc" width="300" height="200" loading="lazy"/><div><span class="eyebrow">@g.KhuVuc · @g.NgayBatDau.ToString("dd/MM/yyyy")</span><h2>@g.TenNhom</h2><div class="together-tags"><span>@CompanionLabels.State(m.TrangThai)</span><span>@CompanionLabels.State(g.TrangThai)</span>@if(g.AnBoiQuanTri){<span>Đang bị ẩn</span>}</div>@if(m.PhanHoi!=null){<p>@m.PhanHoi</p>}<div class="actions">@if(m.TrangThai=="DaThamGia"){<a class="btn btn-dark" href="/Together/Group/@g.MaNhom">Vào nhóm</a>}
else if(m.TrangThai is "DuocMoi" or "ChoDuyet"){<form action="/Together/Member" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="UserId" value="@me"/><input type="hidden" name="Version" value="@TravelService.Token(m.RowVersion)"/>@if(m.TrangThai=="DuocMoi"){<button class="btn btn-dark" name="Decision" value="Accept" type="submit">Đồng ý tham gia</button><button class="btn btn-outline" name="Decision" value="Decline" type="submit">Từ chối</button>}else{<button class="btn btn-outline" name="Decision" value="Withdraw" type="submit">Rút đề nghị</button>}</form>}
@if(g.TrangThai is "Mo" or "DaChot"&&!g.AnBoiQuanTri){<a class="text-link" href="/Together/Detail/@g.MaNhom">Xem lời rủ công khai</a>}</div></div></article>}</div><nav class="actions" aria-label="Phân trang nhóm của tôi">@if(Model.Page>1){<a class="btn btn-outline" href="/Together/Mine?page=@(Model.Page-1)">← Trang trước</a>}@if(Model.Page*20<Model.Total){<a class="btn btn-outline" href="/Together/Mine?page=@(Model.Page+1)">Trang sau →</a>}</nav></div>
