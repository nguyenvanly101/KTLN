@model CompanionWorkspace
@{var g=Model.Group;}
<div class="section-head"><div><span class="eyebrow">ĐỂ MỌI NGƯỜI CÙNG NẮM THÔNG TIN</span><h2>Trao đổi trong nhóm</h2><p>Tin nhắn chỉ dành cho thành viên đang tham gia.</p></div><a class="btn btn-outline" href="/Together/Group/@g.MaNhom?tab=chat">@Ui.Icon("clock") Làm mới tin nhắn</a></div>
<p data-thread-notice hidden role="status" aria-live="polite"><a class="btn btn-outline" href="/Together/Group/@g.MaNhom?tab=chat">Có tin nhắn mới. Xem cập nhật</a></p>
<section class="together-chat" aria-label="Tin nhắn nhóm" data-thread-group="@(Model.Page==1?g.MaNhom:0)" data-thread-after="@(Model.Messages.Count>0?Model.Messages.Max(x=>x.MaTinNhan):0)">@if(Model.Messages.Count==0){<div class="empty"><h3>Bắt đầu cuộc trò chuyện</h3><p>Chào mọi người và chia sẻ điều bạn mong chờ trong chuyến đi.</p></div>}@foreach(var m in Model.Messages){<article class="together-message @(m.MaNguoiGui==Model.Me.MaTaiKhoan?"is-mine":"") @(m.LaThongBao?"is-notice":"")" id="message-@m.MaTinNhan"><header><strong>@Model.Names.GetValueOrDefault(m.MaNguoiGui,"Thành viên")</strong><time datetime="@m.ThoiDiemTao.ToString("O")">@TimeZoneInfo.ConvertTimeBySystemTimeZoneId(m.ThoiDiemTao,"SE Asia Standard Time").ToString("dd/MM HH:mm")</time></header>@if(m.LaThongBao){<span class="eyebrow">THÔNG BÁO ĐƯỢC GHIM</span>}<p class="prose">@m.NoiDung</p><div class="actions">@if(m.LaThongBao){if(Model.ReadNotices.Contains(m.MaTinNhan)){<span class="together-status">Bạn đã xác nhận đọc</span>}else{<form action="/Together/Read" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Id" value="@m.MaTinNhan"/><input type="hidden" name="Tab" value="chat"/><button class="btn btn-outline btn-small" type="submit">Tôi đã đọc thông báo</button></form>}}
<a class="text-link" href="/Together/Report?groupId=@g.MaNhom&messageId=@m.MaTinNhan">Báo cáo</a>@if(Model.Host||m.MaNguoiGui==Model.Me.MaTaiKhoan){<form action="/Together/HideMessage" method="post" data-confirm="Ẩn tin nhắn này khỏi cuộc trò chuyện? Lịch sử vẫn được lưu.">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Id" value="@m.MaTinNhan"/><input type="hidden" name="Version" value="@TravelService.Token(m.RowVersion)"/><input type="hidden" name="Tab" value="chat"/><button class="quiet-button" type="submit">Ẩn tin nhắn</button></form>}</div></article>}</section>
@if(Model.Writable){<section class="panel together-composer"><h2>Gửi lời nhắn</h2><form action="/Together/Message" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Tab" value="chat"/><input type="hidden" name="SubmissionId" value="@Guid.NewGuid()"/><div class="field"><label for="Content">Nội dung</label><textarea class="form-control" id="Content" name="Content" rows="3" maxlength="2000" required placeholder="Một lời chào, câu hỏi hay cập nhật cho cả nhóm…"></textarea></div>@if(Model.Host){<label class="product-checkbox"><input type="checkbox" name="Notice" value="true"/> Ghim thành thông báo cần xác nhận đã đọc</label>}<button class="btn btn-dark" type="submit">Gửi vào nhóm @Ui.Icon("arrow")</button></form></section>}else{<p class="notice">Nhóm hiện chỉ xem lại nội dung. Bạn vẫn có thể báo cáo tin nhắn.</p>}
