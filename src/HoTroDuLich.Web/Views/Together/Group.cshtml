@model CompanionWorkspace
@{var g=Model.Group;ViewData["Title"]=g.TenNhom;}
<div class="container-wide together-page"><a class="back" href="/Together/Mine">← Nhóm đồng hành của tôi</a><header class="together-group-heading"><div><span class="eyebrow">ĐỒNG HÀNH / @(g.Loai=="HoatDong"?"CÙNG MỘT TRẢI NGHIỆM":"CÙNG MỘT HÀNH TRÌNH")</span><h1>@g.TenNhom</h1><p>@g.KhuVuc · @g.NgayBatDau.ToString("dd/MM/yyyy")@(g.NgayKetThuc!=g.NgayBatDau?" – "+g.NgayKetThuc.ToString("dd/MM/yyyy"):"")</p><div class="together-tags"><span>@CompanionLabels.State(g.TrangThai)</span><span>@Model.Members.Count(x=>x.TrangThai=="DaThamGia") / @g.SoNguoiToiDa người</span><span>@CompanionLabels.Paces[g.NhipDo]</span></div></div>@if(Model.Host&&!g.AnBoiQuanTri&&g.TrangThai is "Nhap" or "Mo" or "DaChot"){<a class="btn btn-outline" href="/Together/Edit/@g.MaNhom">Chỉnh sửa nhóm @Ui.Icon("arrow")</a>}</header>
@if(g.AnBoiQuanTri){<div class="notice warning"><strong>Nhóm đang bị ẩn</strong><p>@g.LyDoAn</p><p>Thành viên vẫn xem được lịch sử và đối chiếu khoản hoàn trả.</p></div>}
<nav class="together-tabs" aria-label="Trong nhóm đồng hành">@foreach(var tab in CompanionLabels.Tabs){<a class="@(Model.Tab==tab.Key?"selected":"")" aria-current="@(Model.Tab==tab.Key?"page":null)" href="/Together/Group/@g.MaNhom?tab=@tab.Key">@tab.Value</a>}</nav><partial name="_Errors"/>
@switch(Model.Tab){case "overview":<partial name="_Overview" model="Model"/>break;case "members":<partial name="_Members" model="Model"/>break;case "chat":<partial name="_Chat" model="Model"/>break;case "schedule":<partial name="_Schedule" model="Model"/>break;case "tasks":<partial name="_Tasks" model="Model"/>break;case "expenses":<partial name="_Expenses" model="Model"/>break;}
@if(Model.Tab is "chat" or "schedule" or "tasks" or "expenses"){<nav class="actions together-pagination" aria-label="Phân trang nội dung nhóm">@if(Model.Page>1){<a class="btn btn-outline" href="/Together/Group/@g.MaNhom?tab=@Model.Tab&page=@(Model.Page-1)">← Trang trước</a>}@if(Model.HasMore){<a class="btn btn-outline" href="/Together/Group/@g.MaNhom?tab=@Model.Tab&page=@(Model.Page+1)">@(Model.Tab=="chat"?"Tin nhắn cũ hơn":"Trang sau") →</a>}</nav>}
</div>
