@model CompanionWorkspace
@{var g=Model.Group;var me=Model.Me;var attendance=me.PhienDiemHen==g.PhienDiemHen?me.DiemDanh:"ChuaXacNhan";}
<div class="together-columns"><section><article class="panel"><span class="eyebrow">CÙNG NHAU THỐNG NHẤT</span><h2>Chuyến đi của nhóm</h2><p class="prose">@g.MoTa</p><div class="together-facts"><div><small>NGƯỜI TỔ CHỨC</small><strong>@Model.Names.GetValueOrDefault(g.MaChuNhom,"Người tổ chức")</strong></div><div><small>DỰ KIẾN / NGƯỜI</small><strong>@(g.NganSachThamKhao is decimal money?Labels.Money(money):"Cùng trao đổi")</strong></div></div><div class="actions"><a class="btn btn-dark" href="/Together/Group/@g.MaNhom?tab=schedule">Xem lịch và bình chọn</a><a class="btn btn-outline" href="/Together/Group/@g.MaNhom?tab=chat">Trao đổi với nhóm</a></div></article>
<article class="panel"><h2>Những người cùng bạn lên đường</h2><div class="together-people-strip">@foreach(var m in Model.Members.Where(x=>x.TrangThai=="DaThamGia")){var name=Model.Names.GetValueOrDefault(m.MaTaiKhoan,"Thành viên");<span><span class="avatar">@Ui.Initial(name)</span><strong>@name</strong><small>@(m.MaTaiKhoan==g.MaChuNhom?"Người tổ chức":"Thành viên")</small></span>}</div><a class="text-link" href="/Together/Group/@g.MaNhom?tab=members">Xem thành viên & xác nhận điểm hẹn @Ui.Icon("arrow")</a></article>
@if(Model.ConnectionId!=null){<article class="notice"><h3>Thỏa thuận đồng hành hiện có</h3><p>Hai bên của kết nối gốc tiếp tục xem và xác nhận thỏa thuận riêng theo đúng quyền.</p><a class="text-link" href="/Companions/Agreement/@Model.ConnectionId">Mở thỏa thuận giữa hai bên</a></article>}
</section><aside><section class="panel together-meeting"><span class="eyebrow">HẸN NHAU Ở ĐÂY</span><h2>Điểm tập trung</h2>@if(g.DiemHen!=null){<p class="prose"><strong>@g.DiemHen</strong></p><p>@g.NgayBatDau.ToString("dd/MM/yyyy") · @(g.GioHen?.ToString("HH:mm")??"Chưa chốt giờ")</p><p class="together-status">Bạn: @CompanionLabels.State(attendance)</p>@if(me.PhienDiemHen!=g.PhienDiemHen){<p class="help">Xem kỹ điểm hẹn hiện tại rồi xác nhận. Điểm hẹn có thể đã thay đổi.</p>}@if(Model.Writable){<form action="/Together/Attendance" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Version" value="@TravelService.Token(me.RowVersion)"/><input type="hidden" name="MeetingRevision" value="@g.PhienDiemHen"/><div class="actions"><button class="btn btn-dark" name="Decision" value="SeDen" type="submit">Tôi sẽ đến</button><button class="btn btn-outline" name="Decision" value="DenMuon" type="submit">Tôi đến muộn</button>@if(g.NgayBatDau<=TravelService.Today){<button class="btn btn-outline" name="Decision" value="DaDen" type="submit">Tôi đã đến</button>}</div></form>}}else{<p>Người tổ chức chưa thêm điểm hẹn cụ thể.</p>}</section>
@if(Model.Host){<section class="panel"><h2>Quản lý nhóm</h2>@if(g.MaKeHoach!=null){<a class="text-link" href="/Plans/Detail/@g.MaKeHoach">Mở chuyến đi riêng của bạn @Ui.Icon("arrow")</a><p class="help">Dữ liệu riêng không tự đưa vào nhóm.</p>}@if(g.TrangThai is "Nhap" or "Mo" or "DaChot"){<form action="/Together/State" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Version" value="@TravelService.Token(g.RowVersion)"/><div class="together-stack">@if(!g.AnBoiQuanTri&&(g.TrangThai=="Nhap"||g.TrangThai=="DaChot")){<button class="btn btn-dark" name="Decision" value="Mo" type="submit">Mở nhận thành viên</button>}@if(!g.AnBoiQuanTri&&g.TrangThai=="Mo"){<button class="btn btn-outline" name="Decision" value="DaChot" type="submit">Chốt nhóm, dừng nhận thêm</button>}@if(g.NgayBatDau<=TravelService.Today){<button class="btn btn-outline" name="Decision" value="DaKetThuc" type="submit">Kết thúc nhóm</button>}<button class="quiet-button" name="Decision" value="DaHuy" type="submit" data-confirm="Hủy nhóm và dừng nhận thành viên? Lịch sử, chi phí và khoản hoàn trả vẫn được giữ.">Hủy nhóm</button></div></form>}</section>}
else{<section class="panel"><h2>Tham gia và riêng tư</h2><a class="text-link" href="/Together/Report?groupId=@g.MaNhom">Báo cáo nội dung nhóm</a><form action="/Together/Member" method="post" data-confirm="Rời nhóm? Bạn cần hoàn tất đối chiếu chi phí và khoản hoàn trả đang chờ trước.">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="UserId" value="@me.MaTaiKhoan"/><input type="hidden" name="Version" value="@TravelService.Token(me.RowVersion)"/><input type="hidden" name="Decision" value="Leave"/><button class="quiet-button" type="submit">Rời nhóm đồng hành</button></form></section>}
</aside></div>
