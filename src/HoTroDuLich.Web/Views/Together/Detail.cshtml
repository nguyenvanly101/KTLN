@model CompanionPublicPage
@{var g=Model.Group;ViewData["Title"]=g.TenNhom;var mine=Model.Membership;var traveler=User.IsInRole(TravelService.Traveler);}
<div class="container-wide together-page"><a class="back" href="/Together">← Những lời rủ đi cùng</a><div class="together-public-cover"><img src="@Ui.DestinationImage(g.KhuVuc)" alt="Ảnh minh họa @g.KhuVuc" width="1200" height="400"/><span class="together-kind">@(g.Loai=="HoatDong"?"MỘT HOẠT ĐỘNG, THÊM NGƯỜI BẠN":"CÙNG NHAU LÊN ĐƯỜNG")</span></div><div class="together-public-layout"><section><span class="eyebrow">@g.KhuVuc · @CompanionLabels.State(g.TrangThai)</span><h1>@g.TenNhom</h1><p class="prose">@g.MoTa</p><div class="together-facts"><div><small>NGÀY THAM GIA</small><strong>@g.NgayBatDau.ToString("dd/MM/yyyy")@(g.NgayKetThuc!=g.NgayBatDau?" – "+g.NgayKetThuc.ToString("dd/MM/yyyy"):"")</strong></div><div><small>NHỊP ĐI</small><strong>@CompanionLabels.Paces[g.NhipDo]</strong></div><div><small>SỞ THÍCH</small><strong>@CompanionLabels.Styles[g.PhongCach]</strong></div></div><article class="panel"><h2>Người khởi xướng</h2><strong>@Model.Host</strong>@if(Model.HostProfile!=null){<p class="prose">@Model.HostProfile.GioiThieu</p><div class="together-tags"><span>@CompanionLabels.Styles[Model.HostProfile.PhongCach]</span><span>@CompanionLabels.Paces[Model.HostProfile.NhipDo]</span></div>}<p class="help">Điểm hẹn cụ thể, trao đổi và lịch chung xuất hiện sau khi bạn được chấp nhận vào nhóm.</p></article></section><aside class="panel together-join"><span class="eyebrow">CÙNG MỘT ĐIỂM ĐẾN</span><h2>@Model.Count / @g.SoNguoiToiDa người</h2><p>Ngân sách dự kiến mỗi người:<br/><strong>@(g.NganSachThamKhao is decimal amount?Labels.Money(amount):"Cùng trao đổi trong nhóm")</strong></p><partial name="_Errors"/>
@if(mine?.TrangThai=="DaThamGia"){<a class="btn btn-dark" href="/Together/Group/@g.MaNhom">Vào không gian nhóm @Ui.Icon("arrow")</a>}
else if(mine?.TrangThai is "ChoDuyet" or "DuocMoi"){<p class="notice">@CompanionLabels.State(mine.TrangThai)</p><a class="btn btn-outline" href="/Together/Mine">Xem yêu cầu và lời mời</a>}
else if(!User.Identity?.IsAuthenticated??true){<a class="btn btn-dark" href="/Together/Mine">Đăng nhập để tham gia</a>}
else if(traveler&&g.TrangThai=="Mo"&&Model.Count<g.SoNguoiToiDa){<form action="/Together/Join" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Version" value="@TravelService.Token(g.RowVersion)"/><input type="hidden" name="MemberVersion" value="@(mine!=null?TravelService.Token(mine.RowVersion):"")"/><div class="field"><label for="Message">Một lời giới thiệu (tùy chọn)</label><textarea class="form-control" id="Message" name="Message" maxlength="500" rows="3" placeholder="Bạn muốn cùng trải nghiệm điều gì?"></textarea></div><button class="btn btn-dark" type="submit">Gửi đề nghị tham gia</button><p class="help">Người tổ chức xem và chấp nhận trước khi bạn trở thành thành viên.</p></form>}
else if(traveler){<p class="notice">Nhóm đã chốt hoặc đủ người. Bạn có thể chọn lời rủ khác.</p>}
@if(traveler){<a class="text-link" href="/Together/Report?groupId=@g.MaNhom">Báo cáo lời rủ</a>}</aside></div></div>
