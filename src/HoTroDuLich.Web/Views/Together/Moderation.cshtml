@model CompanionModerationPage
@{var admin=User.IsInRole(TravelService.AdminRole);ViewData["Title"]=admin?"Báo cáo đồng hành":"Báo cáo của tôi";var route=admin?"/Together/Moderation":"/Together/Reports";var rejected=ViewData["CompanionInput"] as CompanionModerationInput;}
<div class="container-wide together-page"><header class="product-heading"><div><span class="eyebrow">@(admin?"QUẢN TRỊ / NỘI DUNG ĐỒNG HÀNH":"ĐỒNG HÀNH / THEO DÕI PHẢN HỒI")</span><h1>@ViewData["Title"]</h1><p>@(admin?"Xem nội dung được báo cáo, ghi lý do và xử lý đúng đối tượng. Báo cáo không cấp quyền truy cập toàn bộ trao đổi riêng của nhóm.":"Nội dung bạn đã gửi và kết quả xem xét từ quản trị.")</p></div></header><partial name="_Errors"/>@if(admin){<form action="@route" method="get" class="review-filter"><label for="report-status">Trạng thái báo cáo</label><select class="form-control" name="status" id="report-status"><option value="ChoXuLy" selected="@(Model.Status=="ChoXuLy")">Chờ xử lý</option><option value="DaXuLy" selected="@(Model.Status=="DaXuLy")">Đã xử lý</option><option value="" selected="@(Model.Status=="")">Tất cả</option></select><button class="btn btn-outline" type="submit">Lọc</button></form>}<p class="help">@Model.Total báo cáo · Trang @Model.Page</p>@if(Model.Items.Count==0){<div class="empty"><h2>Chưa có báo cáo trong danh sách này</h2></div>}
@foreach(var item in Model.Items){var r=item.Report;<article class="panel together-report" id="report-@r.MaBaoCao"><span class="eyebrow">BÁO CÁO #@r.MaBaoCao · @CompanionLabels.State(r.TrangThai)</span><h2>@item.GroupName</h2><p class="prose">@r.MoTa</p><details><summary>Xem đoạn nội dung được báo cáo</summary><blockquote class="prose">@r.BangChung</blockquote></details>@if(r.LyDo!=null){<p class="notice">Kết quả: @r.LyDo</p>}@if(admin&&r.TrangThai=="ChoXuLy"){<form action="/Together/Moderate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaBaoCao"/><input type="hidden" name="GroupId" value="@r.MaNhom"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="TargetVersion" value="@item.GroupVersion"/><div class="field"><label for="report-decision-@r.MaBaoCao">Quyết định</label><select class="form-control" id="report-decision-@r.MaBaoCao" name="Decision"><option value="KhongViPham">Chưa xác định vi phạm</option><option value="DaNhacNho">Ghi nhận đã nhắc nhở</option>@if(r.MaTinNhan!=null){<option value="AnNoiDung">Ẩn tin nhắn được báo cáo</option>}<option value="AnNhom">Ẩn nhóm khỏi công bố và tạm dừng hoạt động</option></select></div><div class="field"><label for="report-reason-@r.MaBaoCao">Lý do xử lý</label><textarea class="form-control" id="report-reason-@r.MaBaoCao" name="Reason" rows="2" maxlength="500" required>@(rejected?.Id==r.MaBaoCao?rejected.Reason:"")</textarea></div><button class="btn btn-dark" type="submit">Lưu quyết định xử lý</button></form>}
@if(admin&&item.Hidden){<details><summary>Khôi phục hiển thị nhóm sau xem xét</summary><form action="/Together/Restore" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaBaoCao"/><input type="hidden" name="GroupId" value="@r.MaNhom"/><input type="hidden" name="TargetVersion" value="@item.GroupVersion"/><div class="field"><label for="restore-reason-@r.MaBaoCao">Lý do khôi phục</label><input class="form-control" id="restore-reason-@r.MaBaoCao" name="Reason" maxlength="500" required/></div><button class="btn btn-outline" type="submit">Khôi phục nhóm</button></form></details>}</article>}
<nav class="actions" aria-label="Phân trang báo cáo">@if(Model.Page>1){<a class="btn btn-outline" href="@route?page=@(Model.Page-1)&status=@Model.Status">← Trang trước</a>}@if(Model.Page*20<Model.Total){<a class="btn btn-outline" href="@route?page=@(Model.Page+1)&status=@Model.Status">Trang sau →</a>}</nav></div>
