@model CompanionWorkspace
@{var g=Model.Group;var active=Model.Members.Where(x=>x.TrangThai=="DaThamGia").ToList();}
<div class="section-head"><div><span class="eyebrow">CHIA NHAU CHUẨN BỊ, CÙNG NHAU NHẸ VIỆC</span><h2>Việc chuẩn bị của nhóm</h2><p>Mỗi việc có người phụ trách và hạn rõ ràng.</p></div>@if(Model.Writable){<a class="btn btn-outline" href="#group-task-form">Thêm việc chuẩn bị</a>}</div>
<div class="together-columns"><section>@if(Model.Tasks.Count==0){<div class="empty"><h3>Nhóm chưa có việc chuẩn bị</h3><p>Bắt đầu bằng việc tìm đường, liên hệ địa điểm hoặc chuẩn bị dụng cụ.</p></div>}@foreach(var task in Model.Tasks){<article class="panel together-task @(task.DaXong?"is-complete":"")"><span class="together-status">@(task.DaXong?"Đã hoàn thành":"Cần chuẩn bị")</span><h3>@task.NoiDung</h3><p>Phụ trách: <strong>@(task.MaPhuTrach is long assigned?Model.Names.GetValueOrDefault(assigned,"Thành viên đã rời nhóm"):"Chưa phân công")</strong>@if(task.Han!=null){<span> · Hạn @task.Han.Value.ToString("dd/MM/yyyy")</span>}</p>@if(Model.Writable&&(Model.Host||task.MaPhuTrach==Model.Me.MaTaiKhoan||task.MaNguoiTao==Model.Me.MaTaiKhoan)){<form action="/Together/TaskAction" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Id" value="@task.MaViec"/><input type="hidden" name="Version" value="@TravelService.Token(task.RowVersion)"/><input type="hidden" name="Tab" value="tasks"/><div class="actions"><button class="btn btn-outline" name="Decision" value="@(task.DaXong?"Undo":"Done")" type="submit">@(task.DaXong?"Mở lại việc":"Đánh dấu xong")</button>@if(Model.Host||task.MaNguoiTao==Model.Me.MaTaiKhoan){<button class="quiet-button" name="Decision" value="Cancel" type="submit">Hủy việc</button>}</div></form>}
@if(Model.Writable&&(Model.Host||task.MaNguoiTao==Model.Me.MaTaiKhoan)){<details><summary>Sửa nội dung và phân công</summary><form action="/Together/Task" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Id" value="@task.MaViec"/><input type="hidden" name="Version" value="@TravelService.Token(task.RowVersion)"/><input type="hidden" name="Tab" value="tasks"/><div class="field"><label for="task-title-@task.MaViec">Nội dung</label><input class="form-control" id="task-title-@task.MaViec" name="Title" value="@task.NoiDung" maxlength="200" required/></div><div class="field"><label for="task-person-@task.MaViec">Người phụ trách</label><select class="form-control" id="task-person-@task.MaViec" name="AssigneeId"><option value="">Chưa phân công</option>@foreach(var m in active.Where(x=>Model.Host||x.MaTaiKhoan==Model.Me.MaTaiKhoan)){<option value="@m.MaTaiKhoan" selected="@(m.MaTaiKhoan==task.MaPhuTrach)">@Model.Names.GetValueOrDefault(m.MaTaiKhoan,"Thành viên")</option>}</select></div><div class="field"><label for="task-due-@task.MaViec">Hạn chuẩn bị</label><input class="form-control" id="task-due-@task.MaViec" name="Due" type="date" value="@task.Han?.ToString("yyyy-MM-dd")"/></div><button class="btn btn-outline" type="submit">Lưu việc chuẩn bị</button></form></details>}</article>}</section>
@if(Model.Writable){<aside class="panel" id="group-task-form"><h2>Thêm một việc</h2><form action="/Together/Task" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Tab" value="tasks"/><div class="field"><label for="Title">Việc cần làm</label><input class="form-control" id="Title" name="Title" maxlength="200" required placeholder="Chuẩn bị dụng cụ cho buổi đi bộ"/></div><div class="field"><label for="AssigneeId">Người phụ trách</label><select class="form-control" id="AssigneeId" name="AssigneeId"><option value="">Chưa phân công</option>@foreach(var m in active.Where(x=>Model.Host||x.MaTaiKhoan==Model.Me.MaTaiKhoan)){<option value="@m.MaTaiKhoan">@Model.Names.GetValueOrDefault(m.MaTaiKhoan,"Thành viên")</option>}</select></div><div class="field"><label for="Due">Hạn (tùy chọn)</label><input class="form-control" id="Due" name="Due" type="date" min="@TravelService.Today.ToString("yyyy-MM-dd")" max="@g.NgayKetThuc.ToString("yyyy-MM-dd")"/></div><button class="btn btn-dark" type="submit">Thêm việc cho nhóm</button></form></aside>}</div>
