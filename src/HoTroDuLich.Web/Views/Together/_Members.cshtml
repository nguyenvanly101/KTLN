@model CompanionWorkspace
@{var g=Model.Group;var availableInvitees=Model.Invitees.Where(x=>!Model.Members.Any(m=>m.MaTaiKhoan==x.Id)).ToList();var active=Model.Members.Where(x=>x.TrangThai=="DaThamGia").ToList();}
<div class="section-head"><div><span class="eyebrow">CÙNG MỘT NHỊP ĐI</span><h2>Thành viên & lời mời</h2><p>@active.Count / @g.SoNguoiToiDa người đã tham gia</p></div>@if(Model.Host&&Model.Writable&&g.TrangThai=="Mo"){<a class="btn btn-outline" href="#invite-form">Mời người đã kết nối</a>}</div>
<div class="together-member-grid">@foreach(var m in active){var name=Model.Names.GetValueOrDefault(m.MaTaiKhoan,"Thành viên");var p=Model.Profiles.GetValueOrDefault(m.MaTaiKhoan);<article class="panel together-member"><span class="avatar">@Ui.Initial(name)</span><h3>@name</h3><p>@(m.MaTaiKhoan==g.MaChuNhom?"Người tổ chức":"Thành viên")</p><span class="together-status">@(m.PhienDiemHen==g.PhienDiemHen?CompanionLabels.State(m.DiemDanh):"Chưa xác nhận điểm hẹn hiện tại")</span>@if(p!=null){<div class="together-tags"><span>@CompanionLabels.Styles[p.PhongCach]</span><span>@CompanionLabels.Paces[p.NhipDo]</span></div><p class="prose">@p.GioiThieu</p>}@if(m.MaTaiKhoan!=Model.Me.MaTaiKhoan){<details><summary>Thao tác thành viên</summary><form action="/Together/Block" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="UserId" value="@m.MaTaiKhoan"/><input type="hidden" name="Version" value="@Model.BlockVersions.GetValueOrDefault(m.MaTaiKhoan)"/><input type="hidden" name="Decision" value="Block"/><button class="quiet-button" type="submit">Chặn kết nối và ẩn tin nhắn</button></form>@if(Model.Host&&m.MaTaiKhoan!=g.MaChuNhom){<form action="/Together/Member" method="post" data-confirm="Đưa thành viên khỏi nhóm? Cần hoàn tất đối chiếu chi phí trước.">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="UserId" value="@m.MaTaiKhoan"/><input type="hidden" name="Version" value="@TravelService.Token(m.RowVersion)"/><input type="hidden" name="Decision" value="Remove"/><button class="quiet-button" type="submit">Đưa khỏi nhóm</button></form>}</details>}</article>}</div>
@if(Model.Host){<section class="panel"><h2>Yêu cầu và lịch sử tham gia</h2>@foreach(var m in Model.Members.Where(x=>x.TrangThai!="DaThamGia")){<article class="together-request"><h3>@Model.Names.GetValueOrDefault(m.MaTaiKhoan,"Thành viên")</h3><span class="together-status">@CompanionLabels.State(m.TrangThai)</span><p class="prose">@m.LoiNhan</p>@if(Model.Writable&&g.TrangThai=="Mo"&&m.TrangThai is "TuChoi" or "DaRut" or "DaXoa"&&Model.Invitees.Any(x=>x.Id==m.MaTaiKhoan)){<form action="/Together/Invite" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="UserId" value="@m.MaTaiKhoan"/><input type="hidden" name="MemberVersion" value="@TravelService.Token(m.RowVersion)"/><input type="hidden" name="Tab" value="members"/><button class="btn btn-outline" type="submit">Mời tham gia lại</button></form>}@if(m.TrangThai=="ChoDuyet"){<form action="/Together/Member" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="UserId" value="@m.MaTaiKhoan"/><input type="hidden" name="Version" value="@TravelService.Token(m.RowVersion)"/><input type="hidden" name="Tab" value="members"/><div class="field"><label for="member-reply-@m.MaTaiKhoan">Lời phản hồi (tùy chọn)</label><input class="form-control" id="member-reply-@m.MaTaiKhoan" name="Message" maxlength="500"/></div><div class="actions"><button class="btn btn-dark" name="Decision" value="Approve" type="submit">Chấp nhận tham gia</button><button class="btn btn-outline" name="Decision" value="Reject" type="submit">Từ chối yêu cầu</button></div></form>}</article>}@if(Model.Members.All(x=>x.TrangThai=="DaThamGia")){<p>Chưa có yêu cầu hoặc lời mời đang chờ.</p>}<nav class="actions" aria-label="Phân trang yêu cầu thành viên">@if(Model.Page>1){<a class="text-link" href="/Together/Group/@g.MaNhom?tab=members&page=@(Model.Page-1)">← Trang trước</a>}@if(Model.HasMore){<a class="text-link" href="/Together/Group/@g.MaNhom?tab=members&page=@(Model.Page+1)">Trang sau →</a>}</nav></section>
@if(Model.Writable&&g.TrangThai=="Mo"){<section class="panel" id="invite-form"><h2>Mời người đã kết nối</h2><p>Chọn người đã đồng ý kết nối. Người nhận vẫn cần chấp nhận lời mời vào nhóm.</p>@if(availableInvitees.Count==0){<p>Chưa có kết nối mới để mời. Người đã tham gia hoặc đang chờ trả lời được hiển thị ở trên.</p><a class="text-link" href="/Companions/Connections">Xem kết nối đồng hành</a>}else{<form action="/Together/Invite" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Tab" value="members"/><div class="field"><label for="invite-user">Người bạn muốn mời</label><select class="form-control" id="invite-user" name="UserId">@foreach(var person in availableInvitees){<option value="@person.Id">@person.Name</option>}</select></div><div class="field"><label for="invite-message">Lời mời (tùy chọn)</label><textarea class="form-control" name="Message" id="invite-message" maxlength="500" rows="2"></textarea></div><button class="btn btn-dark" type="submit">Gửi lời mời vào nhóm</button></form>}</section>}}
