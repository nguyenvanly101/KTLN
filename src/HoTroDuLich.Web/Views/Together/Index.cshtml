@model CompanionDiscoverPage
@{ViewData["Title"]="Rủ nhau lên đường";var canJoin=User.Identity?.IsAuthenticated!=true||User.IsInRole(TravelService.Traveler);}
<div class="container-wide together-page"><section class="together-hero"><div><span class="eyebrow">ĐỒNG HÀNH / MỘT LỜI RỦ, THÊM NIỀM VUI</span><h1>Điều hay hơn một chuyến đi?<br/><em>Có người cùng trải nghiệm.</em></h1><p>Một buổi cà phê, sáng săn mây hay vài ngày khám phá.<br/>Tìm lời rủ hợp nhịp đi của bạn.</p>@if(canJoin){<a class="btn btn-lime" href="/Together/Edit">@Ui.Icon("plus") Tạo lời rủ đi cùng</a>}<a class="together-hero-link" href="#together-search">Khám phá lời rủ @Ui.Icon("arrow")</a></div><div class="together-hero-photo"><img src="/images/dalat.jpg" alt="Ảnh minh họa thiên nhiên Đà Lạt cho hành trình cùng bạn bè" width="600" height="500"/><span>Gặp nhau từ một sở thích.<br/>Cùng nhau viết một hành trình.</span></div></section>
<partial name="_Nav"/><partial name="_Errors"/>
<form action="/Together" method="get" id="together-search" class="together-search"><div class="field"><label for="region">Bạn muốn gặp ở đâu?</label><input class="form-control" id="region" name="region" value="@Model.Region" maxlength="100" placeholder="Ví dụ: Đà Lạt"/></div><div class="field"><label for="kind">Cùng tham gia</label><select class="form-control" id="kind" name="kind"><option value="">Mọi lời rủ</option><option value="HoatDong" selected="@(Model.Kind=="HoatDong")">Một hoạt động trong ngày</option><option value="ChuyenDi" selected="@(Model.Kind=="ChuyenDi")">Chuyến đi nhiều ngày</option></select></div><div class="field"><label for="start">Từ ngày</label><input class="form-control" id="start" name="start" type="date" value="@Model.Start?.ToString("yyyy-MM-dd")"/></div><div class="field"><label for="end">Đến ngày</label><input class="form-control" id="end" name="end" type="date" value="@Model.End?.ToString("yyyy-MM-dd")"/></div><div class="field"><label for="budget">Ngân sách/người tối đa</label><input class="form-control" id="budget" name="budget" type="number" min="0" max="1000000000" step="0.01" value="@Model.Budget?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="Không giới hạn"/></div>@if(canJoin){<label class="product-checkbox"><input type="checkbox" name="matching" value="true" checked="@Model.Matching"/> Ưu tiên hợp phong cách của tôi</label>}<button class="btn btn-dark" type="submit">@Ui.Icon("search") Tìm lời rủ</button></form>
<div class="section-head"><div><span class="eyebrow">CHỌN MỘT TRẢI NGHIỆM, GẶP THÊM NGƯỜI BẠN</span><h2>Những lời rủ đang chờ bạn</h2><p>@Model.Total kết quả · Trang @Model.Page</p></div>@if(canJoin){<a class="text-link" href="/Together/Profile">Chọn phong cách để nhận gợi ý</a>}</div>
@if(Model.Items.Count==0){<div class="empty"><h2>Chưa có lời rủ phù hợp</h2><p>Thử khu vực hoặc ngày khác, hoặc bắt đầu bằng một lời rủ của bạn.</p><a class="btn btn-outline" href="/Together">Xem tất cả</a></div>}
<div class="together-cards">@foreach(var card in Model.Items){var g=card.Group;<article class="together-card"><a class="together-card-image" href="/Together/Detail/@g.MaNhom"><img src="@Ui.DestinationImage(g.KhuVuc)" alt="Ảnh minh họa @g.KhuVuc" loading="lazy" width="600" height="360"/><span class="together-kind">@(g.Loai=="HoatDong"?"Cùng một trải nghiệm":"Cùng một chuyến đi")</span></a><div class="together-card-content"><span class="eyebrow">@g.KhuVuc · @g.NgayBatDau.ToString("dd/MM")@(g.NgayKetThuc!=g.NgayBatDau?" – "+g.NgayKetThuc.ToString("dd/MM"):"")</span><h3><a href="/Together/Detail/@g.MaNhom">@g.TenNhom</a></h3><p class="together-description">@g.MoTa</p><div class="together-tags"><span>@CompanionLabels.Styles[g.PhongCach]</span><span>@CompanionLabels.Paces[g.NhipDo]</span></div>@if(card.Reasons.Count>0){<p class="together-match">@string.Join(" · ",card.Reasons)</p>}<div class="together-card-footer"><span>@Ui.Icon("users") @card.Count / @g.SoNguoiToiDa người<br/><small>@card.Host tổ chức</small></span><span><small>Dự kiến / người</small><strong>@(g.NganSachThamKhao is decimal money?Labels.Money(money):"Cùng trao đổi")</strong></span></div><a class="text-link" href="/Together/Detail/@g.MaNhom">Xem lời rủ @Ui.Icon("arrow")</a></div></article>}</div>
<nav class="actions" aria-label="Phân trang lời rủ">@if(Model.Page>1){<a class="btn btn-outline" asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-region="@Model.Region" asp-route-kind="@Model.Kind" asp-route-start="@Model.Start?.ToString("yyyy-MM-dd")" asp-route-end="@Model.End?.ToString("yyyy-MM-dd")" asp-route-budget="@Model.Budget" asp-route-matching="@Model.Matching">← Trang trước</a>}@if(Model.Page*20<Model.Total){<a class="btn btn-outline" asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-region="@Model.Region" asp-route-kind="@Model.Kind" asp-route-start="@Model.Start?.ToString("yyyy-MM-dd")" asp-route-end="@Model.End?.ToString("yyyy-MM-dd")" asp-route-budget="@Model.Budget" asp-route-matching="@Model.Matching">Trang sau →</a>}</nav></div>
