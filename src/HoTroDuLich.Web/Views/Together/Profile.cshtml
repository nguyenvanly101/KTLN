@model CompanionSettingsPage
@{ViewData["Title"]="Phong cách & riêng tư";var p=Model.Input;}
<div class="container-wide together-page"><header class="product-heading"><div><span class="eyebrow">ĐỒNG HÀNH / HỢP NHAU TỪ NHỊP ĐI</span><h1>Phong cách & riêng tư</h1><p>Chọn cách bạn muốn trải nghiệm để lời rủ phù hợp dễ tìm thấy hơn.</p></div></header><partial name="_Nav"/><partial name="_Errors"/><div class="together-columns"><section class="panel"><h2>Phong cách của bạn</h2><form action="/Together/Profile" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@p.Version"/><div class="field"><label for="Style">Trải nghiệm bạn yêu thích</label><select class="form-control" id="Style" name="Style">@foreach(var item in CompanionLabels.Styles){<option value="@item.Key" selected="@(p.Style==item.Key)">@item.Value</option>}</select></div><div class="field"><label for="Pace">Nhịp đi phù hợp</label><select class="form-control" id="Pace" name="Pace">@foreach(var item in CompanionLabels.Paces){<option value="@item.Key" selected="@(p.Pace==item.Key)">@item.Value</option>}</select></div><div class="field"><label for="Budget">Ngân sách mong muốn/người (tùy chọn)</label><input class="form-control" id="Budget" name="Budget" type="number" min="0" max="1000000000" step="0.01" value="@p.Budget?.ToString(System.Globalization.CultureInfo.InvariantCulture)"/><p class="help">Dùng để gợi ý cho riêng bạn, không hiển thị cho thành viên khác.</p></div><div class="field"><label for="Bio">Một chút về cách bạn đi du lịch</label><textarea class="form-control" name="Bio" id="Bio" rows="3" maxlength="500">@p.Bio</textarea></div><label class="product-checkbox"><input type="checkbox" name="Visible" value="true" checked="@p.Visible"/> Chia sẻ phong cách và giới thiệu của tôi</label><p class="help">Thành viên cùng nhóm được xem phong cách, nhịp đi và giới thiệu. Ngoài nhóm, các nội dung này chỉ hiện khi hồ sơ cơ bản của bạn công khai. Ngân sách mong muốn luôn được giữ riêng.</p><input type="hidden" name="Visible" value="false"/><button class="btn btn-dark" type="submit">Lưu phong cách</button></form></section><aside><section class="panel"><h2>Danh sách đã chặn</h2><p class="help">Chặn ngăn kết nối/lời mời mới và ẩn tin nhắn giữa hai người. Trong nhóm đang tham gia, danh sách thành viên, lịch và chi phí vẫn được giữ.</p>@if(Model.Blocks.Count==0){<p>Chưa có tài khoản trong danh sách chặn.</p>}@foreach(var b in Model.Blocks){<div class="together-block-row"><strong>@Model.Names.GetValueOrDefault(b.MaBiChan,"Thành viên")</strong><form action="/Together/Block" method="post">@Html.AntiForgeryToken()<input type="hidden" name="UserId" value="@b.MaBiChan"/><input type="hidden" name="Version" value="@TravelService.Token(b.RowVersion)"/><input type="hidden" name="Decision" value="Unblock"/><button class="btn btn-outline btn-small" type="submit">Bỏ chặn</button></form></div>}</section><section class="panel"><h2>Nội dung bạn đã báo cáo</h2><p>Theo dõi phản hồi của quản trị cho các báo cáo đã gửi.</p><a class="text-link" href="/Together/Reports">Xem báo cáo của tôi @Ui.Icon("arrow")</a></section></aside></div></div>
