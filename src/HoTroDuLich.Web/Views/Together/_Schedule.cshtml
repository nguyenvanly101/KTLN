@model CompanionWorkspace
@{var g=Model.Group;var localNow=TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow,"SE Asia Standard Time");var latestDeadline=g.NgayKetThuc.ToDateTime(new TimeOnly(23,59));var defaultDeadline=localNow.AddHours(4)<latestDeadline?localNow.AddHours(4):latestDeadline;}
<div class="section-head"><div><span class="eyebrow">ĐỀ XUẤT, THỐNG NHẤT, CÙNG TRẢI NGHIỆM</span><h2>Lịch chung & bình chọn</h2><p>Lịch chung được xây riêng cho nhóm. Quyết định của nhóm không tự thay lịch hoặc yêu cầu dịch vụ cá nhân.</p></div>@if(Model.Writable){<a class="btn btn-outline" href="#poll-form">Tạo bình chọn</a>}</div>
<div class="together-columns"><section><article class="panel"><h2>Lịch đã thống nhất</h2>@if(Model.Activities.Count==0){<p>Chưa có hoạt động trong lịch chung. Người tổ chức có thể thêm trực tiếp hoặc chốt từ bình chọn.</p>}@foreach(var a in Model.Activities){<div class="together-schedule-row"><time>@a.Ngay.ToString("dd/MM")<strong>@(a.Gio?.ToString("HH:mm")??"Chưa chốt giờ")</strong></time><div><h3>@a.NoiDung</h3>@if(a.MaBinhChon!=null){<small>Từ kết quả bình chọn</small>}@if(Model.Host&&Model.Writable){<details><summary>Sửa hoặc hủy hoạt động</summary><form action="/Together/Activity" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@a.MaHoatDong"/><input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Version" value="@TravelService.Token(a.RowVersion)"/><input type="hidden" name="Tab" value="schedule"/><div class="field"><label for="activity-content-@a.MaHoatDong">Nội dung</label><input class="form-control" id="activity-content-@a.MaHoatDong" name="Content" value="@a.NoiDung" maxlength="200" required/></div><div class="field"><label for="activity-date-@a.MaHoatDong">Ngày</label><input class="form-control" id="activity-date-@a.MaHoatDong" name="Date" type="date" value="@a.Ngay.ToString("yyyy-MM-dd")" min="@g.NgayBatDau.ToString("yyyy-MM-dd")" max="@g.NgayKetThuc.ToString("yyyy-MM-dd")" required/></div><div class="field"><label for="activity-time-@a.MaHoatDong">Giờ</label><input class="form-control" id="activity-time-@a.MaHoatDong" name="Time" type="time" value="@a.Gio?.ToString("HH:mm")"/></div><button class="btn btn-outline" type="submit">Lưu hoạt động</button></form><form action="/Together/CancelActivity" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@a.MaHoatDong"/><input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Version" value="@TravelService.Token(a.RowVersion)"/><input type="hidden" name="Tab" value="schedule"/><button class="quiet-button" type="submit">Hủy hoạt động trong lịch chung</button></form></details>}</div></div>}</article>
@foreach(var item in Model.Polls){var poll=item.Poll;var open=poll.TrangThai=="Mo"&&poll.HanChot>DateTime.UtcNow;<article class="panel together-poll" id="poll-@poll.MaBinhChon"><div class="section-head"><div><span class="eyebrow">@(poll.TrangThai=="DaChot"?"ĐÃ CHỐT KẾT QUẢ":poll.TrangThai=="DaHuy"?"ĐÃ HỦY":open?"ĐANG BÌNH CHỌN":"ĐÃ HẾT HẠN")</span><h3>@poll.TieuDe</h3></div><small>Đến @TimeZoneInfo.ConvertTimeBySystemTimeZoneId(poll.HanChot,"SE Asia Standard Time").ToString("dd/MM HH:mm")</small></div>
<form action="/Together/Vote" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@poll.MaBinhChon"/><input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Version" value="@item.VoteVersion"/><input type="hidden" name="Tab" value="schedule"/><fieldset><legend class="sr-only">Lựa chọn cho @poll.TieuDe</legend>@foreach(var option in item.Options){<label class="together-poll-option"><input type="radio" name="Choice" value="@option.ThuTu" checked="@(item.MyChoice==option.ThuTu)" disabled="@(!open||!Model.Writable)" required/><span>@option.NoiDung @if(poll.LuaChonChot==option.ThuTu){<strong>· Được chốt</strong>}</span><small>@item.Counts.GetValueOrDefault(option.ThuTu) phiếu</small></label>}</fieldset>@if(open&&Model.Writable){<button class="btn btn-outline" type="submit">@(item.MyChoice==null?"Gửi lựa chọn":"Đổi lựa chọn")</button>}</form>
@if(Model.Host&&Model.Writable&&poll.TrangThai=="Mo"){<details><summary>Chốt quyết định của nhóm</summary><form action="/Together/ClosePoll" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@poll.MaBinhChon"/><input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Version" value="@TravelService.Token(poll.RowVersion)"/><input type="hidden" name="Tab" value="schedule"/><div class="field"><label for="close-choice-@poll.MaBinhChon">Kết quả được thống nhất</label><select class="form-control" id="close-choice-@poll.MaBinhChon" name="Choice">@foreach(var o in item.Options){<option value="@o.ThuTu">@o.NoiDung (@item.Counts.GetValueOrDefault(o.ThuTu) phiếu)</option>}</select></div><label class="product-checkbox"><input type="checkbox" name="AddToSchedule" value="true"/> Đưa lựa chọn được chốt vào lịch chung</label><div class="together-form-grid"><div class="field"><label for="close-date-@poll.MaBinhChon">Ngày thực hiện</label><input class="form-control" id="close-date-@poll.MaBinhChon" name="Date" type="date" value="@g.NgayBatDau.ToString("yyyy-MM-dd")" min="@g.NgayBatDau.ToString("yyyy-MM-dd")" max="@g.NgayKetThuc.ToString("yyyy-MM-dd")"/></div><div class="field"><label for="close-time-@poll.MaBinhChon">Giờ (tùy chọn)</label><input class="form-control" id="close-time-@poll.MaBinhChon" name="Time" type="time"/></div></div><div class="actions"><button class="btn btn-dark" name="Decision" value="Close" type="submit">Xác nhận chốt kết quả</button><button class="btn btn-outline" name="Decision" value="Cancel" type="submit">Hủy bình chọn</button></div></form></details>}</article>}
</section><aside>@if(Model.Writable){<section class="panel" id="poll-form"><h2>Hỏi ý kiến cả nhóm</h2><form action="/Together/Poll" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Tab" value="schedule"/><div class="field"><label for="Title">Câu hỏi</label><input class="form-control" id="Title" name="Title" maxlength="200" required placeholder="Chiều thứ Bảy mình đi đâu?"/></div><div class="field"><label for="Options">Các lựa chọn, mỗi dòng một lựa chọn</label><textarea class="form-control" id="Options" name="Options" rows="4" maxlength="1100" required placeholder="Đi bộ quanh hồ&#10;Ghé quán cà phê&#10;Tham quan bảo tàng"></textarea><small>Từ 2 đến 5 lựa chọn, mỗi lựa chọn tối đa 200 ký tự.</small></div><div class="field"><label for="Deadline">Hạn bình chọn (giờ Việt Nam)</label><input class="form-control" id="Deadline" name="Deadline" type="datetime-local" value="@defaultDeadline.ToString("yyyy-MM-ddTHH:mm")" max="@latestDeadline.ToString("yyyy-MM-ddTHH:mm")" aria-describedby="deadline-help" required/><small id="deadline-help">Chọn thời hạn trước khi nhóm kết thúc để mọi người kịp thống nhất.</small></div><button class="btn btn-dark" type="submit">Mở bình chọn</button></form></section>}
@if(Model.Host&&Model.Writable){<section class="panel"><h2>Thêm hoạt động chung</h2><form action="/Together/Activity" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Tab" value="schedule"/><div class="field"><label for="Content">Nội dung hoạt động</label><input class="form-control" id="Content" name="Content" maxlength="200" required/></div><div class="field"><label for="Date">Ngày</label><input class="form-control" id="Date" name="Date" type="date" value="@g.NgayBatDau.ToString("yyyy-MM-dd")" min="@g.NgayBatDau.ToString("yyyy-MM-dd")" max="@g.NgayKetThuc.ToString("yyyy-MM-dd")" required/></div><div class="field"><label for="Time">Giờ (tùy chọn)</label><input class="form-control" id="Time" name="Time" type="time"/></div><button class="btn btn-outline" type="submit">Thêm vào lịch chung</button></form></section>
@if(Model.Importable.Count>0){<section class="panel"><h2>Chọn từ lịch riêng của bạn</h2><form action="/Together/Activity" method="post">@Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@g.MaNhom"/><input type="hidden" name="Tab" value="schedule"/><input type="hidden" name="Content" value="Hoạt động được chọn"/><input type="hidden" name="Date" value="@g.NgayBatDau.ToString("yyyy-MM-dd")"/><div class="field"><label for="SourceActivityId">Hoạt động muốn chia sẻ</label><select class="form-control" id="SourceActivityId" name="SourceActivityId">@foreach(var a in Model.Importable){<option value="@a.MaHoatDong">@a.Ngay.ToString("dd/MM") · @a.NoiDung</option>}</select></div><label class="product-checkbox"><input type="checkbox" name="AgreeToShare" value="true" required/> Tôi đồng ý sao chép nội dung, ngày và giờ của hoạt động đã chọn vào nhóm</label><p class="help">Giá, dịch vụ đã đặt, ghi chú chi tiêu và các hoạt động khác không được sao chép.</p><button class="btn btn-outline" type="submit">Chia sẻ hoạt động đã chọn</button></form></section>}}
</aside></div>
