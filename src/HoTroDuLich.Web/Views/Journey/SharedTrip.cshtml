@model SharedTrip
@{Layout=null;var privatePrint=(ViewData["PrivatePrint"] as bool?)==true;}
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="referrer" content="no-referrer"/><title>@Model.Name · Hành Trình</title><link rel="stylesheet" href="~/css/journey-features.css" asp-append-version="true"/></head><body class="trip-document"><header class="document-toolbar"><a href="/">Hành Trình</a><div>@if(privatePrint){<a href="/Journey/Share?planId=@ViewData["PlanId"]">← Chia sẻ / in</a>}<button type="button" data-trip-print>In / lưu PDF</button></div></header><main><header class="document-title"><span class="document-eyebrow">@(privatePrint?"LỊCH TRÌNH CỦA BẠN":"BẢN CHIA SẺ CHỈ XEM")</span><h1>@Model.Name</h1><p>@Model.Destination · @Model.Start.ToString("dd/MM/yyyy") – @Model.End.ToString("dd/MM/yyyy")</p>@if(Model.IncludeBudget){<p>Ngân sách dự kiến: @Labels.Money(Model.Budget)</p>}<p class="document-note">Bản lịch trình tại @Ui.LocalTime(Model.Created).ToString("dd/MM/yyyy HH:mm"). Thông tin có thể thay đổi; kiểm tra lại với chủ chuyến trước khi đi.</p></header>
@if(Model.Activities.Count==0){<p>Chưa có hoạt động trong bản lịch trình này.</p>}@foreach(var day in Model.Activities.GroupBy(x=>x.Date)){<section class="document-day"><h2>Ngày @(day.Key.DayNumber-Model.Start.DayNumber+1) · @day.Key.ToString("dd/MM/yyyy")</h2>@foreach(var item in day){<article><time>@(item.Time??"Chưa đặt giờ")</time><div><h3>@item.Content</h3><p>@(item.Duration is int duration?duration+" phút hoạt động":"Chưa nhập thời lượng") @(item.Transfer is int transfer?" · "+transfer+" phút di chuyển trước điểm dừng":"")</p></div></article>}</section>}
@if(Model.IncludeServices){<section class="document-day"><h2>Dịch vụ cho chuyến đi</h2>@if(Model.Services.Count==0){<p>Chưa có dịch vụ trong bản này.</p>}@foreach(var service in Model.Services){<article><time>@service.Start.ToString("dd/MM")@(service.End is DateOnly end?" – "+end.ToString("dd/MM"):"")</time><div><h3>@service.Service</h3><p>@service.Status</p></div></article>}</section>}
<footer class="document-note">Hành Trình · Đi theo cách của bạn. Bản chia sẻ không thay thế xác nhận đặt dịch vụ.</footer></main><script src="~/js/journey-features.js" asp-append-version="true" defer></script></body></html>
