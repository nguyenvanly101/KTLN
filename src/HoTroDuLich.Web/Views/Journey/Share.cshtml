@model ShareTripPage
@{ViewData["Title"]="Chia sẻ và in lịch trình";var path=TempData["NewSharePath"] as string;var p=Model.Plan;}
<div class="container-wide journey-page"><a class="back" href="/Plans/Detail/@p.MaKeHoach">← @p.TenKeHoach</a><header class="product-heading"><div><span class="eyebrow">CÙNG XEM MỘT HÀNH TRÌNH</span><h1>Chia sẻ chuyến đi, theo cách bạn chọn.</h1><p>Gửi một bản chỉ xem cho người đồng hành, hoặc lưu lịch trình để mang theo.</p></div></header>
@if(path!=null){<section class="share-created panel" role="status"><h2>Liên kết mới của bạn</h2><label for="new-share-url">Liên kết chỉ xem</label><input class="form-control" id="new-share-url" value="@path" readonly/><div class="actions"><button class="btn btn-dark" type="button" data-copy-trip="new-share-url">Sao chép liên kết</button><button class="btn btn-outline" type="button" data-native-trip-share="new-share-url">Chia sẻ</button><a class="text-link" href="@path" target="_blank" rel="noopener noreferrer">Xem bản chia sẻ<span class="sr-only"> (mở tab mới)</span></a></div><p class="help" data-share-status aria-live="polite">Liên kết chỉ được hiển thị đầy đủ một lần. Hãy sao chép ngay; bạn có thể thu hồi và tạo bản mới nếu làm mất.</p></section>}
<div class="journey-day-grid"><section><div class="panel"><h2>Chọn nội dung được chia sẻ</h2><p>Người có liên kết xem được tên chuyến, nơi đến, ngày và nội dung hoạt động. Bản chia sẻ chụp tại thời điểm tạo; sửa lịch trình sau đó không tự cập nhật bản đã gửi.</p><form action="/Journey/Share" method="post">@Html.AntiForgeryToken()<partial name="/Views/Shared/_JourneyErrors.cshtml"/><input type="hidden" name="PlanId" value="@p.MaKeHoach"/><label class="product-checkbox"><input type="checkbox" name="IncludeBudget" value="true" checked="@Model.Input.IncludeBudget"/> Kèm ngân sách dự kiến của chuyến đi</label><label class="product-checkbox"><input type="checkbox" name="IncludeServices" value="true" checked="@Model.Input.IncludeServices"/> Kèm tên, ngày và trạng thái yêu cầu dịch vụ</label><div class="field"><label for="Days">Liên kết có hiệu lực</label><select class="form-control" id="Days" name="Days">@foreach(var day in new[]{1,7,14,30}){<option value="@day" selected="@(Model.Input.Days==day)">@day ngày</option>}</select></div><div class="notice">Chi tiêu thực tế, checklist, liên hệ, tin nhắn, mã yêu cầu và sự cố riêng không được đưa vào bản chia sẻ. Kiểm tra lại nội dung bạn tự nhập trong tên hoạt động.</div><label class="product-checkbox"><input type="checkbox" id="AgreeToShare" name="AgreeToShare" value="true" checked="@Model.Input.AgreeToShare"/> Tôi đồng ý để người có liên kết xem các nội dung đã chọn.</label><button class="btn btn-dark" type="submit">Tạo liên kết chỉ xem @Ui.Icon("arrow")</button></form></div>
<h2>Liên kết đã tạo</h2>@if(Model.Links.Count==0){<div class="empty"><h3>Chưa có liên kết chia sẻ</h3><p>Bạn chủ động tạo và thu hồi từng liên kết.</p></div>}@foreach(var link in Model.Links){<article class="share-link-row"><div><h3>Bản chia sẻ #@link.MaChiaSe</h3><p class="help">Tạo @Ui.LocalTime(link.ThoiDiemTao).ToString("dd/MM/yyyy HH:mm") · Hết hạn @Ui.LocalTime(link.HanSuDung).ToString("dd/MM/yyyy HH:mm")</p><p class="help">@(link.ChiaSeNganSach?"Có ngân sách":"Không kèm ngân sách") · @(link.ChiaSeDichVu?"Có thông tin dịch vụ":"Không kèm yêu cầu dịch vụ")</p><span class="badge journey-status">@(link.DaThuHoi?"Đã thu hồi":link.HanSuDung<=DateTime.UtcNow?"Đã hết hạn":"Còn hiệu lực")</span></div>@if(!link.DaThuHoi&&link.HanSuDung>DateTime.UtcNow){<form action="/Journey/Revoke" method="post" data-confirm="Thu hồi liên kết? Người nhận sẽ không mở được bản này nữa.">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@p.MaKeHoach"/><input type="hidden" name="Id" value="@link.MaChiaSe"/><input type="hidden" name="Version" value="@TravelService.Token(link.RowVersion)"/><button class="btn btn-outline btn-small" type="submit">Thu hồi<span class="sr-only"> bản chia sẻ #@link.MaChiaSe</span></button></form>}</article>}</section>
<aside class="panel"><span class="eyebrow">MANG THEO KHI LÊN ĐƯỜNG</span><h2>In hoặc lưu PDF</h2><p>Mở bản dành cho in, sau đó chọn máy in hoặc “Lưu dưới dạng PDF” trong hộp thoại của trình duyệt.</p><form action="/Journey/Print" method="get" target="_blank"><input type="hidden" name="planId" value="@p.MaKeHoach"/><label class="product-checkbox"><input type="checkbox" name="includeBudget" value="true"/> Kèm ngân sách</label><label class="product-checkbox"><input type="checkbox" name="includeServices" value="true"/> Kèm dịch vụ</label><button class="btn btn-outline" type="submit">Mở bản để in<span class="sr-only"> (mở tab mới)</span></button></form></aside></div></div>
