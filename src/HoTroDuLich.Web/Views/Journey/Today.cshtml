@model TripDayPage
@{ViewData["Title"]="Hôm nay đi đâu?";ViewData["ScheduleWarnings"]=Model.Warnings;var p=Model.Trip.Plan;var next=Model.Items.FirstOrDefault(x=>x.HoanThanhLuc==null);var done=Model.Items.Count(x=>x.HoanThanhLuc!=null);}
<div class="container-wide journey-page"><a class="back" href="/Plans/Detail/@p.MaKeHoach">← @p.TenKeHoach</a>
<header class="journey-day-hero"><div><span class="eyebrow">CHUYẾN ĐI / TỪNG NGÀY</span><h1>@(Model.Day==TravelService.Today?"Hôm nay đi đâu?":"Một ngày trong hành trình")</h1><p>@p.NoiDen · @Model.Day.ToString("dd/MM/yyyy")</p></div><div class="day-progress"><strong>@done / @Model.Items.Count</strong><span>hoạt động đã hoàn thành</span></div></header>
<nav class="tabs" aria-label="Trong chuyến đi"><a class="active" aria-current="page" href="/Journey/Today?planId=@p.MaKeHoach">Hôm nay</a><a href="/Plans/Detail/@p.MaKeHoach#itinerary">Lịch trình</a><a href="/Preparation?planId=@p.MaKeHoach">Chuẩn bị</a><a href="/Expenses?planId=@p.MaKeHoach">Chi tiêu</a><a href="/Journey/Share?planId=@p.MaKeHoach">Chia sẻ / in</a></nav>
<form action="/Journey/Today" method="get" class="day-picker"><input type="hidden" name="planId" value="@p.MaKeHoach"/><label for="trip-day">Xem ngày trong chuyến đi</label><input class="form-control" id="trip-day" name="date" type="date" value="@((Model.Day>=p.NgayBatDau&&Model.Day<=p.NgayKetThuc?Model.Day:p.NgayBatDau).ToString("yyyy-MM-dd"))" min="@p.NgayBatDau.ToString("yyyy-MM-dd")" max="@p.NgayKetThuc.ToString("yyyy-MM-dd")" required/><button class="btn btn-outline" type="submit">Xem ngày</button></form>
@if(Model.Day<p.NgayBatDau||Model.Day>p.NgayKetThuc){<div class="notice">@(Model.Day<p.NgayBatDau?"Chuyến đi bắt đầu ngày "+p.NgayBatDau.ToString("dd/MM/yyyy")+". Bạn có thể xem trước lịch trình hoặc chuẩn bị hành lý.":"Chuyến đi đã qua ngày kết thúc. Bạn vẫn có thể xem lại lịch trình và tổng kết chi tiêu.")</div>}
<div class="journey-day-grid"><section><div class="next-stop"><span class="eyebrow">@(next!=null?"ĐIỂM DỪNG TIẾP THEO":"NHỊP ĐI CỦA BẠN")</span><h2>@(next?.NoiDung??(Model.Items.Count>0?"Bạn đã hoàn thành lịch hôm nay":"Một ngày còn để ngỏ"))</h2>@if(next!=null){<p>@(next.Gio?.ToString("HH:mm")??"Chưa đặt giờ") · @(next.ThoiLuongPhut is int n?n+" phút":"Chưa nhập thời lượng")</p>@if(Model.Trip.Locations.TryGetValue(next.MaHoatDong,out var nextLocation)){<a class="btn btn-lime" href="@(nextLocation.HasAddress?Ui.Directions(nextLocation.Query):Ui.MapSearch(nextLocation.Query))" target="_blank" rel="noopener noreferrer">@Ui.Icon("pin") @(nextLocation.HasAddress?"Chỉ đường đến đây":"Tìm khu vực trên bản đồ")<span class="sr-only"> (mở tab mới)</span></a>}}else{<p>Xem ngày khác hoặc thêm một trải nghiệm khi bạn muốn.</p>}</div>
<div class="section-head"><h2>Những việc trong ngày</h2><a class="text-link" href="/Plans/Activity/@p.MaKeHoach">Thêm hoạt động</a></div>
@if(Model.Items.Count==0){<div class="empty"><h3>Chưa có hoạt động trong ngày này</h3><p>Lịch trình theo ngày sẽ xuất hiện tại đây sau khi bạn thêm hoạt động.</p></div>}
@foreach(var a in Model.Items){<article class="day-activity @(a.HoanThanhLuc!=null?"is-complete":"")" id="activity-@a.MaHoatDong"><div class="day-time"><time>@(a.Gio?.ToString("HH:mm")??"Chưa đặt giờ")</time><small>@(a.ThoiLuongPhut is int duration?duration+" phút":"Chưa nhập thời lượng")</small></div><div class="day-activity-copy"><h3>@a.NoiDung</h3><p class="help">@(a.DiChuyenTruocPhut is int transfer?"Dành "+transfer+" phút di chuyển trước hoạt động":"Chưa nhập thời gian di chuyển")</p>@if(a.HoanThanhLuc!=null){<span class="badge journey-status">Đã hoàn thành</span>}<div class="actions"><a class="text-link" href="/Plans/Activity/@p.MaKeHoach?activityId=@a.MaHoatDong">Sửa hoạt động</a>@if(Model.Trip.Locations.TryGetValue(a.MaHoatDong,out var location)){<a class="text-link" href="@(location.HasAddress?Ui.Directions(location.Query):Ui.MapSearch(location.Query))" target="_blank" rel="noopener noreferrer">Mở bản đồ<span class="sr-only"> (mở tab mới)</span></a>}</div></div>@if(a.Ngay<=TravelService.Today){<form action="/Journey/Complete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@p.MaKeHoach"/><input type="hidden" name="Id" value="@a.MaHoatDong"/><input type="hidden" name="Version" value="@TravelService.Token(p.RowVersion)"/><button class="btn btn-outline btn-small" name="Decision" value="@(a.HoanThanhLuc==null?"Done":"Undo")" type="submit">@(a.HoanThanhLuc==null?"Đánh dấu xong":"Mở lại")<span class="sr-only"> @a.NoiDung</span></button></form>}</article>}
</section><aside><partial name="/Views/Plans/_ScheduleWarnings.cshtml" model="Model.Items"/><div class="panel"><h2>Dịch vụ trong ngày</h2>@{var bookings=Model.Trip.Bookings.Where(x=>x.NgayBatDau<=Model.Day&&(x.NgayKetThuc??x.NgayBatDau)>=Model.Day).ToList();}@if(bookings.Count==0){<p class="help">Chưa có yêu cầu dịch vụ gắn với ngày này.</p>}@foreach(var booking in bookings){<div class="day-booking"><strong>@Model.Trip.ServiceNames[booking.MaDichVu]</strong><span class="badge @Labels.Badge(booking.TrangThai.ToString())">@Labels.Status(booking.TrangThai.ToString())</span><a class="text-link" href="/Bookings/Detail/@booking.MaYeuCau">Xem yêu cầu #@booking.MaYeuCau</a></div>}</div><a class="journey-help-link" href="/Support/Create?planId=@p.MaKeHoach">@Ui.Icon("help") Cần xử lý một tình huống? @Ui.Icon("arrow")</a></aside></div></div>
