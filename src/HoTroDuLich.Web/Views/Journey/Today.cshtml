@model TripDayPage
@inject TravelService Travel
@{ViewData["Title"]="Hôm nay đi đâu?";ViewData["ScheduleWarnings"]=Model.Warnings;var p=Model.Trip.Plan;var next=Model.Items.FirstOrDefault(x=>x.HoanThanhLuc==null&&x.BoQuaLuc==null);var done=Model.Items.Count(x=>x.HoanThanhLuc!=null);var skipped=Model.Items.Count(x=>x.BoQuaLuc!=null);var prog=Model.Progress;}
<div class="container-wide journey-page"><a class="back" href="/Plans/Detail/@p.MaKeHoach">← @p.TenKeHoach</a>
<header class="journey-day-hero"><div><span class="eyebrow">CHUYẾN ĐI / TỪNG NGÀY</span><h1>@(Model.Day==TravelService.Today?"Hôm nay đi đâu?":"Một ngày trong hành trình")</h1><p>@p.NoiDen · @Model.Day.ToString("dd/MM/yyyy")</p></div><div class="day-progress"><strong>@done / @Model.Items.Count</strong><span>hoạt động đã hoàn thành@(skipped>0?" · "+skipped+" bỏ qua":"")</span></div></header>
<nav class="tabs" aria-label="Trong chuyến đi"><a class="active" aria-current="page" href="/Journey/Today?planId=@p.MaKeHoach">Hôm nay</a><a href="/Plans/Detail/@p.MaKeHoach#itinerary">Lịch trình</a><a href="/Preparation?planId=@p.MaKeHoach">Chuẩn bị</a><a href="/Expenses?planId=@p.MaKeHoach">Chi tiêu</a><a href="/Journey/Share?planId=@p.MaKeHoach">Chia sẻ / in</a></nav>
@if(prog?.FinishedAt!=null){<div class="depart-card is-finished" id="depart"><div><strong>Chuyến đi đã kết thúc</strong><span>Kết thúc lúc @Ui.LocalTime(prog.FinishedAt.Value).ToString("HH:mm dd/MM/yyyy")@(prog.DepartedAt!=null?" · khởi hành lúc "+Ui.LocalTime(prog.DepartedAt.Value).ToString("HH:mm"):"")</span></div></div>}
else if(prog?.DepartedAt!=null){<div class="depart-card is-on" id="depart"><div><strong>Đang trên đường</strong><span>Khởi hành lúc @Ui.LocalTime(prog.DepartedAt.Value).ToString("HH:mm dd/MM/yyyy")</span></div>@if(Model.IsOwner){<form action="/Journey/Finish" method="post" onsubmit="return confirm('Kết thúc chuyến đi này?')">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@p.MaKeHoach"/><button class="btn btn-outline" type="submit">Kết thúc chuyến</button></form>}</div>}
else if(Model.IsOwner&&TravelService.Today>=p.NgayBatDau.AddDays(-1)&&TravelService.Today<=p.NgayKetThuc){<div class="depart-card" id="depart"><div><strong>Sẵn sàng khởi hành?</strong><span>@(string.IsNullOrWhiteSpace(Model.OriginName)?"Chưa đặt điểm xuất phát (thêm trong Sửa kế hoạch). ":"Xuất phát từ "+Model.OriginName+". ")@(next!=null?"Điểm dừng đầu tiên: "+next.NoiDung+".":"")</span></div><form action="/Journey/Depart" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@p.MaKeHoach"/><button class="btn btn-lime" type="submit">Khởi hành</button></form></div>}
<form action="/Journey/Today" method="get" class="day-picker"><input type="hidden" name="planId" value="@p.MaKeHoach"/><label for="trip-day">Xem ngày trong chuyến đi</label><input class="form-control" id="trip-day" name="date" type="date" value="@((Model.Day>=p.NgayBatDau&&Model.Day<=p.NgayKetThuc?Model.Day:p.NgayBatDau).ToString("yyyy-MM-dd"))" min="@p.NgayBatDau.ToString("yyyy-MM-dd")" max="@p.NgayKetThuc.ToString("yyyy-MM-dd")" required/><button class="btn btn-outline" type="submit">Xem ngày</button></form>
@if(Model.Day<p.NgayBatDau||Model.Day>p.NgayKetThuc){<div class="notice">@(Model.Day<p.NgayBatDau?"Chuyến đi bắt đầu ngày "+p.NgayBatDau.ToString("dd/MM/yyyy")+". Bạn có thể xem trước lịch trình hoặc chuẩn bị hành lý.":"Chuyến đi đã qua ngày kết thúc. Bạn vẫn có thể xem lại lịch trình và tổng kết chi tiêu.")</div>}
<div class="journey-day-grid"><section><div class="next-stop"><span class="eyebrow">@(next!=null?"ĐIỂM DỪNG TIẾP THEO":"NHỊP ĐI CỦA BẠN")</span><h2>@(next?.NoiDung??(Model.Items.Count>0?"Bạn đã hoàn thành lịch hôm nay":"Một ngày còn để ngỏ"))</h2>@if(next!=null){<p>@(next.Gio?.ToString("HH:mm")??"Chưa đặt giờ") · @(next.ThoiLuongPhut is int n?n+" phút":"Chưa nhập thời lượng")</p>@if(Model.Trip.Locations.TryGetValue(next.MaHoatDong,out var nextLocation)){<a class="btn btn-lime" href="@(nextLocation.HasAddress?Ui.Directions(nextLocation.Query):Ui.MapSearch(nextLocation.Query))" target="_blank" rel="noopener noreferrer">@Ui.Icon("pin") @(nextLocation.HasAddress?"Chỉ đường đến đây":"Tìm khu vực trên bản đồ")<span class="sr-only"> (mở tab mới)</span></a>}@if(Model.IsOwner&&next.Ngay<=TravelService.Today){<div class="next-actions"><form action="/Journey/Complete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@p.MaKeHoach"/><input type="hidden" name="Id" value="@next.MaHoatDong"/><input type="hidden" name="Version" value="@TravelService.Token(p.RowVersion)"/><button class="btn btn-lime" name="Decision" value="Done" type="submit">Xong, đến điểm tiếp theo</button></form><form action="/Journey/Complete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@p.MaKeHoach"/><input type="hidden" name="Id" value="@next.MaHoatDong"/><input type="hidden" name="Version" value="@TravelService.Token(p.RowVersion)"/><button class="btn btn-outline-light" name="Decision" value="Skip" type="submit">Bỏ qua</button></form></div>}}else{<p>Xem ngày khác hoặc thêm một trải nghiệm khi bạn muốn.</p>}</div>
<div class="section-head"><h2>Những việc trong ngày</h2><a class="text-link" href="/Plans/Activity/@p.MaKeHoach">Thêm hoạt động</a></div>
@if(Model.Items.Count==0){<div class="empty"><h3>Chưa có hoạt động trong ngày này</h3><p>Lịch trình theo ngày sẽ xuất hiện tại đây sau khi bạn thêm hoạt động.</p></div>}
@foreach(var a in Model.Items){<article class="day-activity @(a.HoanThanhLuc!=null?"is-complete":a.BoQuaLuc!=null?"is-skipped":"")" id="activity-@a.MaHoatDong"><div class="day-time"><time>@(a.Gio?.ToString("HH:mm")??"Chưa đặt giờ")</time><small>@(a.ThoiLuongPhut is int duration?duration+" phút":"Chưa nhập thời lượng")</small></div><div class="day-activity-copy"><h3>@a.NoiDung</h3><p class="help">@(a.DiChuyenTruocPhut is int transfer?"Dành "+transfer+" phút di chuyển trước hoạt động":"Chưa nhập thời gian di chuyển")</p>@if(a.HoanThanhLuc!=null){<span class="badge journey-status">Đã hoàn thành</span>}@if(a.BoQuaLuc!=null){<span class="badge journey-status is-skipped">Đã bỏ qua</span>}<div class="actions"><a class="text-link" href="/Plans/Activity/@p.MaKeHoach?activityId=@a.MaHoatDong">Sửa hoạt động</a>@if(a.MaDichVu!=null){var contact=await Travel.ServiceProvider(a.MaDichVu.Value);<a class="text-link" href="tel:@contact.SoDienThoai">Gọi @contact.TenDonVi</a><a class="text-link" href="/tin-nhan/dich-vu/@a.MaDichVu">Nhắn tin</a>}@if(Model.Trip.Locations.TryGetValue(a.MaHoatDong,out var location)){<a class="text-link" href="@(location.HasAddress?Ui.Directions(location.Query):Ui.MapSearch(location.Query))" target="_blank" rel="noopener noreferrer">Mở bản đồ<span class="sr-only"> (mở tab mới)</span></a>}</div></div>@if(a.Ngay<=TravelService.Today){<form action="/Journey/Complete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@p.MaKeHoach"/><input type="hidden" name="Id" value="@a.MaHoatDong"/><input type="hidden" name="Version" value="@TravelService.Token(p.RowVersion)"/>@{var pendingAct=a.HoanThanhLuc==null&&a.BoQuaLuc==null;}<button class="btn btn-outline btn-small" name="Decision" value="@(pendingAct?"Done":"Undo")" type="submit">@(pendingAct?"Đánh dấu xong":"Mở lại")<span class="sr-only"> @a.NoiDung</span></button>@if(pendingAct){<button class="btn btn-outline btn-small" name="Decision" value="Skip" type="submit">Bỏ qua<span class="sr-only"> @a.NoiDung</span></button>}</form>}</article>}
</section><aside><partial name="/Views/Plans/_ScheduleWarnings.cshtml" model="Model.Items"/>@if(Model.Day>=p.NgayBatDau&&Model.Day<=p.NgayKetThuc){<div class="panel" id="today-route" data-plan="@p.MaKeHoach" data-day="@(Model.Day.DayNumber-p.NgayBatDau.DayNumber+1)" data-next="@next?.MaHoatDong"><h2>Đường đi hôm nay</h2><p class="help">Khoảng cách và thời gian đi từ điểm xuất phát qua từng điểm dừng đến lúc kết thúc.</p><div class="route-bar"><button type="button" class="btn btn-sm btn-outline-secondary" data-route>Xem đường đi</button><label class="route-mode">Đi bằng <select data-mode><option value="bike">Xe máy</option><option value="car">Ô tô</option><option value="foot">Đi bộ</option></select></label></div><div class="route-out"></div></div>}<div class="panel around-me"><h2>Xung quanh bạn</h2><p class="help">Mở bản đồ tìm nhanh quanh @(next!=null&&Model.Trip.Locations.TryGetValue(next.MaHoatDong,out var aroundLoc)?"điểm dừng kế tiếp":p.NoiDen).</p> @{var around=next!=null&&Model.Trip.Locations.TryGetValue(next.MaHoatDong,out var al2)?al2.Query:p.NoiDen+", Việt Nam";} <div class="chips">@foreach(var (label,term) in new[]{("ATM","ATM"),("Hiệu thuốc","hiệu thuốc"),("Bệnh viện","bệnh viện"),("Nhà vệ sinh","nhà vệ sinh công cộng"),("Quán cà phê","quán cà phê"),("Quán ăn","quán ăn"),("Trạm xăng","trạm xăng")}){<a class="chip" href="@Ui.MapSearch(term+" gần "+around)" target="_blank" rel="noopener noreferrer">@label<span class="sr-only"> (mở tab mới)</span></a>}</div></div><div class="panel emergency-card"><h2>Khẩn cấp</h2><p><a href="tel:113"><strong>113</strong></a> Công an · <a href="tel:114"><strong>114</strong></a> Cứu hỏa · <a href="tel:115"><strong>115</strong></a> Cấp cứu</p><div data-share-location><button class="btn btn-outline" type="button" data-share-btn>Chia sẻ vị trí của tôi</button><p class="help" data-share-status role="status"></p><div data-share-result hidden><input class="form-control" readonly data-share-link aria-label="Liên kết vị trí"/><div class="actions"><button class="btn btn-outline" type="button" data-share-copy>Sao chép</button><a class="btn btn-outline" data-share-sms href="#">Gửi tin nhắn</a></div></div></div><a class="text-link" href="/khan-cap">Danh bạ khẩn cấp đầy đủ</a></div><div class="panel"><h2>Dịch vụ trong ngày</h2>@{var bookings=Model.Trip.Bookings.Where(x=>x.NgayBatDau<=Model.Day&&(x.NgayKetThuc??x.NgayBatDau)>=Model.Day).ToList();}@if(bookings.Count==0){<p class="help">Chưa có yêu cầu dịch vụ gắn với ngày này.</p>}@foreach(var booking in bookings){<div class="day-booking"><strong>@Model.Trip.ServiceNames[booking.MaDichVu]</strong><span class="badge @Labels.Badge(booking.TrangThai.ToString())">@Labels.Status(booking.TrangThai.ToString())</span><a class="text-link" href="/Bookings/Detail/@booking.MaYeuCau">Xem yêu cầu #@booking.MaYeuCau</a></div>}</div><a class="journey-help-link" href="/Support/Create?planId=@p.MaKeHoach">@Ui.Icon("help") Cần xử lý một tình huống? @Ui.Icon("arrow")</a></aside></div></div>
@section Scripts{<script src="~/js/guide.js" asp-append-version="true"></script><script src="~/js/today-route.js" asp-append-version="true"></script>}
