@model List<SavedChoice>
@{ViewData["Title"]="So sánh dịch vụ";}
<div class="container-wide product-page"><a class="back" href="/Saved">← Lựa chọn đã lưu</a><header class="product-heading"><div><span class="eyebrow">CÂN NHẮC TRƯỚC KHI CHỌN</span><h1>Đặt các lựa chọn cạnh nhau</h1><p>Giá tham khảo cần được đối chiếu cùng đơn vị tính, loại hình và điều kiện phục vụ.</p></div></header><div class="compare-grid">@foreach(var row in Model){var service=row.Service!;<article class="panel compare-card"><img src="@Ui.ServiceImage(service)" alt="@Ui.ServiceImageLabel(service)" width="600" height="400"/><h2>@service.TenDichVu</h2><dl><dt>Loại hình</dt><dd>@DanhMuc.Ten(service.LoaiDichVu)</dd><dt>Giá tham khảo</dt><dd><strong>@Labels.Money(service.GiaThamKhao)</strong> / @(service.DonViGia??"chưa công bố đơn vị")</dd><dt>Vị trí</dt><dd>@(service.DiaChiPhucVu??service.KhuVucPhucVu)</dd><dt>Thời gian phục vụ</dt><dd>@(service.ThoiGianPhucVu??"Chưa công bố")</dd><dt>Tiếp nhận yêu cầu</dt><dd>@Labels.Status(service.TrangThaiTiepNhan.ToString())</dd><dt>Điều kiện phục vụ</dt><dd class="prose">@(service.DieuKienPhucVu??"Chưa công bố")</dd><dt>Thay đổi / hủy</dt><dd class="prose">@(service.ChinhSachHuy??"Xem điều kiện phục vụ và trao đổi với nhà cung cấp")</dd></dl><a class="btn btn-dark" href="/Explore/Detail/@service.MaDichVu">Xem dịch vụ @Ui.Icon("arrow")</a><a class="text-link" href="/Plans/Select?serviceId=@service.MaDichVu">Thêm vào lịch trình</a></article>}</div></div>
