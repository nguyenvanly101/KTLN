@model List<SavedChoice>
@{ViewData["Title"]="Lựa chọn đã lưu";}
<div class="container-wide product-page">
 <header class="product-heading"><div><span class="eyebrow">KHÁM PHÁ / BỘ SƯU TẬP CỦA BẠN</span><h1>Thích thì lưu.<br/>Sẵn sàng thì lên đường.</h1><p>Gom những nơi muốn đến và dịch vụ đang cân nhắc. Chọn chuyến đi khi bạn đã sẵn sàng.</p></div><a class="btn btn-dark" href="/">@Ui.Icon("search") Khám phá thêm</a></header>
 <div asp-validation-summary="All" role="alert" tabindex="-1"></div>
 @if(Model.Count==0){<div class="empty">@Ui.Icon("compass")<h2>Điều bạn thích sẽ ở đây</h2><p>Mở một địa điểm hoặc dịch vụ và chọn “Lưu lựa chọn”. Bạn chưa cần chọn ngày đi.</p><a class="btn btn-dark" href="/">Tìm cảm hứng đầu tiên</a></div>}
 else {
  <form id="compare-form" action="/Saved/Compare" method="get" class="compare-toolbar" data-compare-form><div><strong>@Model.Count lựa chọn đã lưu</strong><p>Đánh dấu 2–3 dịch vụ để xem cạnh nhau. Giá có thể dùng đơn vị tính khác nhau.</p><span class="field-validation-error" id="compare-error" role="status"></span></div><button class="btn btn-dark" type="submit">So sánh dịch vụ @Ui.Icon("arrow")</button></form>
  <div class="saved-grid">@foreach(var item in Model){var live=item.Service!=null||item.Place!=null;var savedTitle=item.Service?.TenDichVu??item.Place?.TenDiaDiem??item.Entry.TenMuc;var region=item.Service?.KhuVucPhucVu??item.Place?.KhuVuc;var image=item.Service!=null?Ui.ServiceImage(item.Service):Ui.DestinationImage(region??"");<article class="saved-card"><div class="saved-photo">@if(live){<img src="@image" alt="@(item.Service!=null?Ui.ServiceImageLabel(item.Service):"Ảnh minh họa")" loading="lazy" width="600" height="400"/>}else{<span>Mục đã ngừng công bố</span>}@if(item.Service!=null){<label class="compare-check"><input type="checkbox" form="compare-form" name="ids" value="@item.Entry.MaLuaChon"/> So sánh<span class="sr-only"> @savedTitle</span></label>}</div><div class="saved-body"><span class="eyebrow">@(item.Service!=null?DanhMuc.Ten(item.Service.LoaiDichVu):item.Place?.LoaiDiaDiem??"ĐÃ LƯU TRƯỚC ĐÂY")</span><h2>@savedTitle</h2><p>@region</p>@if(item.Service!=null){<strong>@Labels.Money(item.Service.GiaThamKhao)</strong><small>@(item.Service.DonViGia??"Đơn vị giá chưa công bố")</small>}<div class="saved-actions">@if(live){<a class="btn btn-dark btn-small" href="@(item.Service!=null?"/Explore/Detail/"+item.Entry.MaDichVu:"/Explore/Place/"+item.Entry.MaDiaDiem)">Xem chi tiết</a><a class="text-link" href="@(item.Service!=null?"/Plans/Select?serviceId="+item.Entry.MaDichVu:"/Plans/Select?placeId="+item.Entry.MaDiaDiem)">Xếp vào chuyến đi @Ui.Icon("arrow")</a>}else{<p class="help">Thông tin này hiện không còn công khai. Bạn có thể giữ tên đã lưu hoặc bỏ khỏi danh sách.</p>}</div><form action="/Saved/Remove" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@item.Entry.MaLuaChon"/><button class="quiet-button" type="submit">Bỏ lưu<span class="sr-only"> @savedTitle</span></button></form></div></article>}</div>
 }
</div>
