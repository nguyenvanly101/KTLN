@if(!ViewData.ModelState.IsValid){<div class="validation-summary-errors" data-product-errors role="alert" tabindex="-1"><strong>Kiểm tra thông tin để tiếp tục</strong><ul>@foreach(var entry in ViewData.ModelState.Where(x=>x.Value?.Errors.Count>0)){var field=entry.Key.Split('.').Last();foreach(var error in entry.Value!.Errors){<li>@if(new[]{"Title","Amount","Category","Due","SpentOn","Notes"}.Contains(field)){<a href="#@field">@error.ErrorMessage</a>}else{@error.ErrorMessage}</li>}}</ul></div>}
