@if(!ViewData.ModelState.IsValid){<div class="validation-summary-errors" data-product-errors role="alert" tabindex="-1"><strong>Kiểm tra thông tin để tiếp tục</strong><ul>@foreach(var entry in ViewData.ModelState.Where(x=>x.Value?.Errors.Count>0)){var field=entry.Key.Split('.').Last();string? target=new[]{"Days","AgreeToShare","Stars","Content","Date","Capacity","Note"}.Contains(field)?field:null;if(field=="Reason"&&ViewData["ModerationInput"] is ReviewModerationInput moderation){target="reason-"+(moderation.Part=="Reply"?"reply":"review")+"-"+moderation.Id;}if(field=="Text"&&ViewData["ReplyInput"] is ReviewReplyInput reply){target="reply-"+reply.Id;}foreach(var error in entry.Value!.Errors){<li>@if(target!=null){<a href="#@target">@error.ErrorMessage</a>}else{@error.ErrorMessage}</li>}}</ul></div>}
