@{var currentPage=ViewBag.SimplePage is int n?n:1;var next=ViewBag.SimpleNext is bool b&&b;string Link(int target){var q=Context.Request.Query.ToDictionary(x=>x.Key,x=>(string?)x.Value.ToString());q["trang"]=target.ToString();q.Remove("page");return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path,q);}}
@if(currentPage>1||next){<nav class="simple-pager" aria-label="Phân trang">@if(currentPage>1){<a class="btn btn-outline" href="@Link(currentPage-1)">← Trang trước</a>}<span aria-current="page">Trang @currentPage</span>@if(next){<a class="btn btn-outline" href="@Link(currentPage+1)">Trang tiếp theo →</a>}</nav>}
