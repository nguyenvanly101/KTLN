@model ErrorViewModel
@{
 var (title,text)=Model.Status switch
 {
  403=>("Bạn không có quyền xem trang này","Trang này dành cho vai trò khác hoặc thuộc về tài khoản khác. Nếu bạn nghĩ đây là nhầm lẫn, hãy đăng nhập đúng tài khoản."),
  404=>("Không tìm thấy trang","Đường dẫn có thể đã thay đổi, hoặc nội dung đã bị gỡ."),
  _=>("Đã có lỗi xảy ra","Hệ thống chưa xử lý được yêu cầu này. Bạn thử lại sau ít phút; nếu vẫn lỗi, gửi mã lỗi bên dưới cho quản trị viên.")
 };
 ViewData["Title"]=title;
}
<div class="container-narrow error-page">
 <span class="error-code" aria-hidden="true">@Model.Status</span>
 <h1>@title</h1>
 <p>@text</p>
 <div class="actions"><a class="btn btn-dark" href="/">Về trang chính</a><button type="button" class="btn btn-outline" data-history-back>Quay lại</button>@if(Model.Status==403&&User.Identity?.IsAuthenticated!=true){<a class="btn btn-outline" href="/Account/Login">Đăng nhập</a>}</div>
 @if(Model.Status>=500&&Model.ShowRequestId){<p class="help">Mã lỗi: <code>@Model.RequestId</code></p>}
</div>
