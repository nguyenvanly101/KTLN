@using System.Text.Json
@model (KindInfo Kind,Dictionary<string,JsonElement> Current,string Selected,string Intro)
@{var kind=Model.Kind;}
<fieldset class="pv-typefields" data-kind-fields="@kind.Code" hidden>
 <legend>@(string.IsNullOrEmpty(Model.Intro)?kind.Label:Model.Intro+" "+kind.Label.ToLowerInvariant())</legend>
 <div class="form-grid">
 @foreach(var f in kind.Fields)
 {
  var name=BranchTemplates.Name(kind.Code,f.Key);var values=kind.Code==Model.Selected?BranchTemplates.Current(Model.Current,f):new List<string>();
  <div class="field@(f.Kind is "multi" or "list"?" field-wide":"")">
   @switch(f.Kind)
   {
    case "select":
     <label for="@name">@f.Label</label><select class="form-select" id="@name" name="@name"><option value="">Chưa công bố</option>@foreach(var o in f.Options!){<option value="@o" selected="@(values.Contains(o))">@o</option>}</select>
     break;
    case "multi":
     <span class="pv-label">@f.Label</span><div class="pv-checks">@foreach(var o in f.Options!){<label><input type="checkbox" name="@name" value="@o" checked="@(values.Contains(o))"/> @o</label>}</div>
     break;
    case "number":
     <label for="@name">@f.Label</label><input class="form-control" id="@name" name="@name" type="number" min="1" max="@f.Max" value="@(values.FirstOrDefault())"/>
     break;
    case "time":
     <label for="@name">@f.Label</label><input class="form-control" id="@name" name="@name" type="time" value="@(values.FirstOrDefault())"/>
     break;
    case "date":
     <label for="@name">@f.Label</label><input class="form-control" id="@name" name="@name" type="date" value="@(values.FirstOrDefault())"/>
     break;
    case "list":
     <label for="@name">@f.Label</label><textarea class="form-control" id="@name" name="@name" rows="4">@string.Join("\n",values)</textarea><small>@f.Hint (tối đa @f.Max dòng)</small>
     break;
    default:
     <label for="@name">@f.Label</label><input class="form-control" id="@name" name="@name" maxlength="@f.Max" value="@(values.FirstOrDefault())"/>
     break;
   }
  </div>
 }
 </div>
</fieldset>
