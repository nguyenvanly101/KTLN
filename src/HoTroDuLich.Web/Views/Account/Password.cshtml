@model PasswordChangeInput
@{ViewData["Title"]="Đổi mật khẩu";}
<div class="auth-shell"><div class="auth-panel"><span class="eyebrow">BẢO VỆ TÀI KHOẢN</span><h1>Đổi mật khẩu</h1><p>Mật khẩu có 8–100 ký tự, gồm chữ và số, không chứa email. Sau khi đổi, các phiên đăng nhập cũ sẽ kết thúc.</p>
<form action="/tai-khoan/doi-mat-khau" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div>
<div class="field"><label asp-for="OldPassword">Mật khẩu hiện tại</label><input class="form-control" asp-for="OldPassword" autocomplete="current-password" required/><span asp-validation-for="OldPassword"></span></div>
<div class="field"><label asp-for="NewPassword">Mật khẩu mới</label><input class="form-control" asp-for="NewPassword" autocomplete="new-password" minlength="8" maxlength="100" required/><span asp-validation-for="NewPassword"></span></div>
<div class="field"><label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" required/><span asp-validation-for="ConfirmPassword"></span></div>
<div class="form-actions"><button class="btn btn-dark" type="submit">Lưu mật khẩu mới</button></div></form></div></div>
