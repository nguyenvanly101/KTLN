@model LoginInput
@{ViewData["Title"]="Đăng nhập";}
<div class="auth-wrap"><div class="auth-art"><div><span class="auth-image-kicker">HÀNH TRÌNH CỦA BẠN BẮT ĐẦU TẠI ĐÂY</span><h2>Lên kế hoạch cho<br/>những trải nghiệm mới.</h2><p>Lưu lịch trình, tìm dịch vụ và kết nối bạn đồng hành trong một nơi.</p></div></div><div class="auth-content"><span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span><h1>Đăng nhập</h1><p class="help">Tiếp tục quản lý những chuyến đi của bạn.</p>
<form action="/tai-khoan/dang-nhap/dang-nhap" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" asp-for="ReturnUrl"/><div class="form-grid mt-4"><div class="field full"><label asp-for="Email">Email hoặc số điện thoại</label><input class="form-control" asp-for="Email" type="text" autocomplete="username" autocapitalize="off" spellcheck="false" maxlength="256" placeholder="Email hoặc số điện thoại đã đăng ký" required/><span asp-validation-for="Email"></span></div><div class="field full"><label asp-for="Password">Mật khẩu</label><div class="password-field"><input class="form-control" asp-for="Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required/><button type="button" class="password-toggle" data-password-target="Password" aria-label="Hiển thị mật khẩu">Hiện</button></div><span asp-validation-for="Password"></span></div></div><div class="form-actions"><button class="btn btn-dark" type="submit">Đăng nhập @Ui.Icon("arrow")</button></div></form><p class="help mt-4">Chưa có tài khoản? <a class="text-link" href="/Account/Register">Đăng ký</a></p>
@if(ViewBag.Demo==true){<details class="demo-accounts" open><summary>Trải nghiệm với tài khoản mẫu</summary><p class="help">Chọn vai trò để điền thông tin đăng nhập.<br/>Mật khẩu chung: <code>HanhTrinh@@2026</code></p><button class="demo-account" data-email="khach@@hanhtrinh.vn">Khách du lịch</button><button class="demo-account" data-email="nhacungcap@@hanhtrinh.vn">Nhà cung cấp</button><button class="demo-account" data-email="admin@@hanhtrinh.vn">Quản trị viên</button><button class="demo-account" data-email="linh@@hanhtrinh.vn">Khách thứ hai</button></details>}
</div></div>
