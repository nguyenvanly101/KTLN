@model ProfileInput
@{ViewData["Title"]="Hồ sơ cá nhân";var account=ViewBag.Account as TaiKhoan;var provider=ViewBag.Provider as NhaCungCapDichVu;}
<div class="container-narrow"><div class="page-head"><div><span class="eyebrow">KHÔNG GIAN CÁ NHÂN</span><h1>Hồ sơ của bạn</h1><p>Cập nhật thông tin và chọn những gì bạn muốn chia sẻ.</p></div><a class="btn btn-outline" href="/tai-khoan/doi-mat-khau">Đổi mật khẩu</a></div>
<div class="panel"><dl class="facts"><div><dt>Email đăng nhập</dt><dd>@account?.Email</dd></div><div><dt>Vai trò</dt><dd>@Labels.Status(account?.VaiTro.ToString())</dd></div>@if(provider!=null){<div><dt>Đơn vị · Loại hình</dt><dd>@provider.TenDonVi · @provider.LoaiHinh</dd></div><div><dt>Xác minh · Quyền hoạt động</dt><dd>@Labels.Status(provider.TrangThaiXacMinh.ToString()) · @Labels.Status(provider.TrangThaiQuyenHoatDong.ToString())</dd></div>}</dl></div>
<div class="panel"><form action="/ho-so/luu-thay-doi" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" asp-for="Version"/><input type="hidden" asp-for="ProviderVersion"/>
<div class="form-grid"><div class="field"><label asp-for="Name">Tên hiển thị</label><input class="form-control" asp-for="Name" maxlength="100" required/><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Phone">Số điện thoại tài khoản</label><input class="form-control" asp-for="Phone" type="tel"/><span asp-validation-for="Phone"></span></div><div class="field"><label asp-for="City">Nơi sinh sống</label><input class="form-control" asp-for="City" maxlength="200"/><span asp-validation-for="City"></span></div><div class="field"><label asp-for="Privacy">Phạm vi chia sẻ hồ sơ</label><select class="form-select" asp-for="Privacy"><option value="RiengTu">Riêng tư</option><option value="KhiKetNoi">Khi đã kết nối</option><option value="CongKhai">Công khai</option></select></div><div class="field full"><label asp-for="Avatar">Ảnh đại diện</label><input class="form-control" asp-for="Avatar" type="file" accept=".jpg,.jpeg,.png"/><small>JPG hoặc PNG, tối đa 5 MB.</small><span asp-validation-for="Avatar"></span></div><div class="field full"><label asp-for="Bio">Giới thiệu</label><textarea class="form-control" asp-for="Bio" maxlength="1000"></textarea><span asp-validation-for="Bio"></span></div><div class="field full"><label asp-for="Interests">Sở thích</label><textarea class="form-control" asp-for="Interests" maxlength="500"></textarea><span asp-validation-for="Interests"></span></div></div>
@if(provider!=null){<h2 class="mt-3">Thông tin liên hệ đơn vị</h2><div class="form-grid"><div class="field"><label asp-for="ContactName">Người liên hệ</label><input class="form-control" asp-for="ContactName" maxlength="100" required/></div><div class="field"><label asp-for="Address">Địa chỉ</label><input class="form-control" asp-for="Address" maxlength="300" required/></div><div class="field"><label asp-for="ContactPhone">Điện thoại liên hệ</label><input class="form-control" asp-for="ContactPhone" type="tel" required/></div><div class="field"><label asp-for="ContactEmail">Email liên hệ</label><input class="form-control" asp-for="ContactEmail" type="email" required/></div></div>}
<div class="form-actions"><button class="btn btn-dark" type="submit">Lưu thay đổi</button><a class="btn btn-outline" href="/ho-so/xem-ho-so">Hủy thay đổi</a></div></form></div>
@if(!User.IsInRole(TravelService.AdminRole)){<div class="panel danger-zone"><h2>Ngừng sử dụng tài khoản</h2><p class="help">Xem các nghĩa vụ còn lại và hệ quả trước khi xác nhận.</p><a href="/tai-khoan/ngung-su-dung/mo-ngung" class="btn btn-outline">Kiểm tra điều kiện ngừng tài khoản</a></div>}</div>
