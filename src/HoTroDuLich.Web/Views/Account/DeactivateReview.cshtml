@model DeactivationReview
@{ViewData["Title"]="Kiểm tra trước khi ngừng tài khoản";}
<div class="container-narrow"><a class="back" href="/ho-so/xem-ho-so">← Hồ sơ cá nhân</a><div class="page-head"><div><h1>@(Model.Obligations.Count>0?"Hoàn tất các nghĩa vụ còn lại":"Xác nhận ngừng tài khoản")</h1><p>@(Model.Obligations.Count>0?"Mở từng mục bên dưới để xử lý, sau đó kiểm tra lại.":"Phiên xác nhận có hiệu lực trong 5 phút. Lịch sử sử dụng được lưu giữ.")</p></div></div>
@if(Model.Obligations.Count>0){<div class="panel"><ul class="obligation-list">@foreach(var item in Model.Obligations){<li><a href="@item.Url">@item.Name @Ui.Icon("arrow")</a></li>}</ul><a class="btn btn-outline" href="/tai-khoan/ngung-su-dung/mo-ngung">Kiểm tra lại sau khi xử lý</a></div>}
else{<div class="panel"><h2>Những thay đổi sẽ có hiệu lực</h2><dl class="facts"><div><dt>Nhu cầu dừng công bố</dt><dd>@Model.Needs</dd></div><div><dt>Đề nghị kết nối hết hiệu lực</dt><dd>@Model.Connections</dd></div><div><dt>Dịch vụ ngừng nhận yêu cầu mới</dt><dd>@Model.Services</dd></div></dl><p>Bạn sẽ đăng xuất và tài khoản sẽ ngừng hoạt động sau khi xác nhận.</p><form action="/tai-khoan/ngung-su-dung/ngung-tai-khoan" method="post">@Html.AntiForgeryToken()<input type="hidden" name="confirmationToken" value="@Model.ConfirmationToken"/><div class="form-actions"><button class="btn btn-danger" type="submit">Xác nhận ngừng tài khoản</button><a class="btn btn-outline" href="/ho-so/xem-ho-so">Hủy, tiếp tục sử dụng</a></div></form></div>}</div>
