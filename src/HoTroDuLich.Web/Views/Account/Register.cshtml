@model RegisterInput
@{ViewData["Title"]="Tạo tài khoản";}
<div class="container-narrow registration-page"><a class="back" href="/Account/Login">← Đăng nhập</a><div class="page-head"><div><span class="eyebrow">THAM GIA HÀNH TRÌNH</span><h1>Tạo tài khoản</h1><p>Lưu chuyến đi, tìm bạn đồng hành hoặc giới thiệu dịch vụ của bạn.</p></div></div>
<div class="panel"><form action="/Account/Register" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div>
 <h2>Thông tin tài khoản</h2><div class="form-grid"><div class="field"><label asp-for="Role">Bạn muốn sử dụng Hành Trình với vai trò nào?</label><select class="form-select" asp-for="Role" data-account-role><option value="KHACH_DU_LICH">Khách du lịch</option><option value="NHA_CUNG_CAP">Nhà cung cấp dịch vụ</option></select></div><div class="field"><label asp-for="Name">Tên hiển thị</label><input class="form-control" asp-for="Name" placeholder="Nhập họ tên của bạn" required autocomplete="name"/><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Email">Email</label><input class="form-control" asp-for="Email" type="email" placeholder="Email dùng để đăng nhập" required autocomplete="email"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Phone">Số điện thoại</label><input class="form-control" asp-for="Phone" type="tel" placeholder="Nhập số điện thoại" autocomplete="tel"/><span asp-validation-for="Phone"></span></div><div class="field"><label asp-for="Password">Mật khẩu</label><input class="form-control" asp-for="Password" type="password" placeholder="Tối thiểu 8 ký tự" minlength="8" required autocomplete="new-password"/><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="ConfirmPassword">Xác nhận mật khẩu</label><input class="form-control" asp-for="ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu" required autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span></div></div>
 <section class="provider-registration" data-provider-fields hidden><h2>Thông tin nhà cung cấp</h2><p class="help">Thông tin và tài liệu sẽ được quản trị viên xét duyệt trước khi bạn có thể đăng dịch vụ.</p><div class="form-grid"><div class="field"><label asp-for="Organization">Tên đơn vị</label><input class="form-control" asp-for="Organization" placeholder="Tên cơ sở hoặc doanh nghiệp"/><span asp-validation-for="Organization"></span></div><div class="field"><label asp-for="Address">Địa chỉ</label><input class="form-control" asp-for="Address" placeholder="Địa chỉ liên hệ của đơn vị"/><span asp-validation-for="Address"></span></div><div class="field full"><label for="Documents">Tài liệu xác minh</label><input class="form-control" type="file" name="Documents" id="Documents" multiple accept=".pdf,.jpg,.jpeg,.png"/><small>Chấp nhận PDF, JPG hoặc PNG. Tối đa 5 tệp, mỗi tệp không quá 5 MB.</small></div></div></section>
 <section data-provider-fields hidden><h2>Hồ sơ đơn vị và người đại diện</h2><div class="form-grid">
 <div class="field"><label asp-for="OrganizationType">Loại hình đơn vị</label><input class="form-control" asp-for="OrganizationType" maxlength="50"/><span asp-validation-for="OrganizationType"></span></div>
 <div class="field"><label asp-for="ContactName">Người liên hệ</label><input class="form-control" asp-for="ContactName" maxlength="100"/><span asp-validation-for="ContactName"></span></div>
 <div class="field"><label asp-for="ContactPhone">Số điện thoại liên hệ đơn vị</label><input class="form-control" asp-for="ContactPhone" type="tel"/><span asp-validation-for="ContactPhone"></span></div>
 <div class="field"><label asp-for="ContactEmail">Email liên hệ đơn vị</label><input class="form-control" asp-for="ContactEmail" type="email"/><span asp-validation-for="ContactEmail"></span></div>
 <div class="field"><label asp-for="Representative">Người đại diện hồ sơ</label><input class="form-control" asp-for="Representative" maxlength="100"/><span asp-validation-for="Representative"></span></div>
 <div class="field full"><label asp-for="RegistrationDescription">Nội dung đăng ký cung cấp dịch vụ</label><textarea class="form-control" asp-for="RegistrationDescription" maxlength="2000"></textarea><span asp-validation-for="RegistrationDescription"></span></div>
 </div></section><p class="help">Mật khẩu cần có chữ và số, không chứa email. Hồ sơ cá nhân ban đầu được đặt ở chế độ riêng tư.</p>
 <div class="form-actions"><button class="btn btn-dark" type="submit">Tạo tài khoản @Ui.Icon("arrow")</button><span class="help">Đã có tài khoản? <a class="text-link" href="/Account/Login">Đăng nhập</a></span></div>
</form></div></div>
