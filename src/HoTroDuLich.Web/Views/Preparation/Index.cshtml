@model PreparationPage
@{ViewData["Title"]="Chuẩn bị chuyến đi";var done=Model.Items.Count(x=>x.DaHoanThanh);var overdue=Model.Items.Count(x=>!x.DaHoanThanh&&x.HanHoanThanh<TravelService.Today);}
<div class="container-wide product-page"><a class="back" href="/Plans/Detail/@Model.Plan.MaKeHoach">← @Model.Plan.TenKeHoach</a><header class="product-heading"><div><span class="eyebrow">CHUYẾN ĐI / CHUẨN BỊ</span><h1>Nhẹ hành lý.<br/>Vững hành trình.</h1><p>@Model.Plan.NoiDen · @Model.Plan.NgayBatDau.ToString("dd/MM/yyyy") – @Model.Plan.NgayKetThuc.ToString("dd/MM/yyyy")</p></div><div class="preparation-count"><strong>@done / @Model.Items.Count</strong><span>việc đã hoàn thành</span></div><a class="btn btn-dark" href="#preparation-form">@Ui.Icon("plus") Thêm công việc</a></header>
 <nav class="tabs" aria-label="Chuẩn bị và chi tiêu"><a class="active" aria-current="page" href="/Preparation?planId=@Model.Plan.MaKeHoach">Chuẩn bị</a><a href="/Expenses?planId=@Model.Plan.MaKeHoach">Chi tiêu thực tế</a><a href="/Plans/Detail/@Model.Plan.MaKeHoach">Lịch trình & dịch vụ</a></nav>
 @if(overdue>0){<div class="notice warning">@overdue việc đã qua hạn và chưa hoàn thành. Kiểm tra lại trước khi lên đường.</div>}
 <div class="product-workspace-grid"><section><div class="section-head"><div><h2>Danh sách của bạn</h2><p>Đánh dấu xong hoặc mở lại khi cần.</p></div><form action="/Preparation/Defaults" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@Model.Plan.MaKeHoach"/><button class="btn btn-outline btn-small" type="submit">@Ui.Icon("plus") Thêm bộ gợi ý</button></form></div>
 @if(Model.Items.Count==0){<div class="empty">@Ui.Icon("check")<h3>Khởi đầu bằng những việc nhỏ</h3><p>Thêm giấy tờ, hành lý, phương tiện hoặc sử dụng bộ gợi ý để bắt đầu.</p></div>}
 @foreach(var group in Model.Items.GroupBy(x=>x.Nhom)){<section class="checklist-group"><h3>@ProductCategories.Preparation[group.Key]</h3>@foreach(var item in group){<article class="checklist-item @(item.DaHoanThanh?"is-done":"")"><form action="/Preparation/Action" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@Model.Plan.MaKeHoach"/><input type="hidden" name="Id" value="@item.MaMuc"/><input type="hidden" name="Version" value="@TravelService.Token(item.RowVersion)"/><button class="check-action" type="submit" name="Decision" value="@(item.DaHoanThanh?"Undo":"Done")" aria-label="@(item.DaHoanThanh?"Mở lại":"Hoàn thành") @item.NoiDung">@Ui.Icon(item.DaHoanThanh?"check":"plus")</button></form><div class="checklist-copy"><strong>@item.NoiDung</strong><small>@(item.HanHoanThanh is DateOnly due?"Hạn "+due.ToString("dd/MM/yyyy"):"Chưa đặt hạn") @(item.NhacHan?"· Có lời nhắc trong ứng dụng":"")</small></div><a class="text-link" href="/Preparation?planId=@Model.Plan.MaKeHoach&edit=@item.MaMuc#preparation-form">Sửa<span class="sr-only"> @item.NoiDung</span></a><form action="/Preparation/Action" method="post" data-confirm="Bỏ công việc này khỏi danh sách?">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@Model.Plan.MaKeHoach"/><input type="hidden" name="Id" value="@item.MaMuc"/><input type="hidden" name="Version" value="@TravelService.Token(item.RowVersion)"/><button class="quiet-button" type="submit" name="Decision" value="Delete">Bỏ<span class="sr-only"> @item.NoiDung</span></button></form></article>}</section>}
 </section><aside class="panel product-form-panel" id="preparation-form"><h2>@(Model.Input.Id==0?"Thêm việc cần chuẩn bị":"Chỉnh sửa công việc")</h2><partial name="_ChecklistForm" model="Model.Input"/></aside></div></div>
