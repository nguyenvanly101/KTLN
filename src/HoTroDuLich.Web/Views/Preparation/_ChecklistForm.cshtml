@model ChecklistInput
<form action="/Preparation/Save" method="post">@Html.AntiForgeryToken()<partial name="/Views/Shared/_ProductValidation.cshtml"/><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="PlanId"/>@if(Model.Id>0){<input type="hidden" asp-for="Version"/>}<div class="field"><label asp-for="Title">Việc cần làm</label><input class="form-control" asp-for="Title" maxlength="200" required aria-describedby="title-error"/><span id="title-error" asp-validation-for="Title"></span></div><div class="field"><label asp-for="Category">Nhóm chuẩn bị</label><select class="form-control" asp-for="Category">@foreach(var category in ProductCategories.Preparation){<option value="@category.Key">@category.Value</option>}</select><span asp-validation-for="Category"></span></div><div class="field"><label asp-for="Due">Hạn hoàn thành (tùy chọn)</label><input class="form-control" asp-for="Due" type="date"/><span asp-validation-for="Due"></span></div><label class="product-checkbox"><input asp-for="Remind"/> Nhắc khi đến hạn trong ứng dụng</label><p class="help">Lời nhắc xuất hiện ở mục Thông báo khi công việc đến hạn và chưa hoàn thành.</p><div class="form-actions"><button class="btn btn-dark" type="submit">@(Model.Id==0?"Thêm công việc":"Lưu công việc")</button>@if(Model.Id>0){<a class="text-link" href="/Preparation?planId=@Model.PlanId">Hủy chỉnh sửa</a>}</div></form>
