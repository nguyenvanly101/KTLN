@model ExpensesPage
@{ViewData["Title"]="Chi tiêu chuyến đi";var actual=Model.Items.Sum(x=>x.SoTien);}
<div class="container-wide product-page"><a class="back" href="/Plans/Detail/@Model.Plan.MaKeHoach">← @Model.Plan.TenKeHoach</a><header class="product-heading"><div><span class="eyebrow">CHUYẾN ĐI / CHI TIÊU THỰC TẾ</span><h1>Biết mình đã chi.<br/>Chủ động phần còn lại.</h1><p>@Model.Plan.TenKeHoach · Ghi các khoản đã thanh toán, kể cả tiền đặt trước chuyến đi.</p></div><a class="btn btn-dark" href="#expense-form">@Ui.Icon("plus") Ghi khoản chi</a></header><nav class="tabs" aria-label="Chuẩn bị và chi tiêu"><a href="/Preparation?planId=@Model.Plan.MaKeHoach">Chuẩn bị</a><a class="active" aria-current="page" href="/Expenses?planId=@Model.Plan.MaKeHoach">Chi tiêu thực tế</a><a href="/Plans/Detail/@Model.Plan.MaKeHoach">Lịch trình & dịch vụ</a></nav>
 <div class="expense-stats"><div><small>ĐÃ CHI THỰC TẾ</small><strong>@Ui.ActualMoney(actual)</strong><span>@Model.Items.Count khoản đã ghi</span></div><div><small>DỰ TRÙ HOẠT ĐỘNG</small><strong>@Labels.Money(Model.Estimated)</strong><span>Dữ liệu từ lịch trình</span></div><div><small>@(Model.Plan.NganSachDuKien is decimal b && actual>b?"ĐÃ VƯỢT NGÂN SÁCH":"NGÂN SÁCH CÒN LẠI")</small><strong>@(Model.Plan.NganSachDuKien is decimal budget?Ui.ActualMoney(Math.Abs(budget-actual)):"Chưa thiết lập")</strong><a class="text-link" href="/Plans/Edit/@Model.Plan.MaKeHoach">Điều chỉnh ngân sách</a></div></div><p class="help">Thực chi được tính từ các khoản bạn ghi tại đây; giá dự kiến của lịch trình và yêu cầu đặt không tự cộng vào để tránh tính hai lần.</p>
 <div class="product-workspace-grid"><section><div class="section-head"><div><h2>Các khoản đã chi</h2><p>Chọn sửa khi số tiền hoặc nội dung thay đổi.</p></div></div>
 @if(Model.Items.Count==0){<div class="empty">@Ui.Icon("wallet")<h3>Khoản chi đầu tiên của chuyến đi</h3><p>Ghi tiền phòng, vé xe, một bữa ăn hoặc khoản đặt cọc bạn đã trả.</p></div>}
 else {<div class="expense-categories">@foreach(var group in Model.Items.GroupBy(x=>x.LoaiChi)){<div><span>@ProductCategories.Expenses[group.Key]</span><strong>@Ui.ActualMoney(group.Sum(x=>x.SoTien))</strong></div>}</div>@foreach(var day in Model.Items.GroupBy(x=>x.NgayChi)){<section class="expense-day"><h3>@day.Key.ToString("dd/MM/yyyy")</h3>@foreach(var item in day){<article class="expense-row"><div><small>@ProductCategories.Expenses[item.LoaiChi]</small><h3>@item.NoiDung</h3>@if(!string.IsNullOrWhiteSpace(item.GhiChu)){<p class="help">@item.GhiChu</p>}</div><strong>@Ui.ActualMoney(item.SoTien)</strong><a class="text-link" href="/Expenses?planId=@Model.Plan.MaKeHoach&edit=@item.MaKhoanChi#expense-form">Sửa<span class="sr-only"> @item.NoiDung</span></a><form action="/Expenses/Delete" method="post" data-confirm="Xóa khoản chi này? Tổng thực chi sẽ được tính lại.">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@Model.Plan.MaKeHoach"/><input type="hidden" name="Id" value="@item.MaKhoanChi"/><input type="hidden" name="Version" value="@TravelService.Token(item.RowVersion)"/><button class="quiet-button" type="submit">Xóa<span class="sr-only"> @item.NoiDung</span></button></form></article>}</section>}}
 </section><aside class="panel product-form-panel" id="expense-form"><h2>@(Model.Input.Id==0?"Ghi một khoản chi":"Chỉnh sửa khoản chi")</h2><partial name="_ExpenseForm" model="Model.Input"/></aside></div></div>
