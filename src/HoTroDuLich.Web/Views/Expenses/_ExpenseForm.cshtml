@model ExpenseInput
<form action="/Expenses/Save" method="post">@Html.AntiForgeryToken()<partial name="/Views/Shared/_ProductValidation.cshtml"/><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="PlanId"/>@if(Model.Id>0){<input type="hidden" asp-for="Version"/>}<input type="hidden" asp-for="SubmissionId"/><div class="field"><label asp-for="Title">Nội dung khoản chi</label><input class="form-control" asp-for="Title" maxlength="200" required aria-describedby="expense-title-error"/><span id="expense-title-error" asp-validation-for="Title"></span></div><div class="field"><label asp-for="Amount">Số tiền đã trả (₫)</label><input class="form-control" asp-for="Amount" type="number" min="0.01" max="1000000000" step="0.01" required aria-describedby="expense-amount-error"/><span id="expense-amount-error" asp-validation-for="Amount"></span></div><div class="field"><label asp-for="Category">Loại chi tiêu</label><select class="form-control" asp-for="Category">@foreach(var category in ProductCategories.Expenses){<option value="@category.Key">@category.Value</option>}</select><span asp-validation-for="Category"></span></div><div class="field"><label asp-for="SpentOn">Ngày đã chi</label><input class="form-control" asp-for="SpentOn" type="date" max="@TravelService.Today.ToString("yyyy-MM-dd")" required/><span asp-validation-for="SpentOn"></span></div><div class="field"><label asp-for="Notes">Ghi chú (tùy chọn)</label><textarea class="form-control" asp-for="Notes" maxlength="500"></textarea><span asp-validation-for="Notes"></span></div><div class="form-actions"><button class="btn btn-dark" type="submit">@(Model.Id==0?"Ghi khoản chi":"Lưu khoản chi")</button>@if(Model.Id>0){<a class="text-link" href="/Expenses?planId=@Model.PlanId">Hủy chỉnh sửa</a>}</div></form>
