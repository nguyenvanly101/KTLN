@model BookingInput
<partial name="/Views/Branches/_BookingBranchPreview.cshtml" model="Model"/>
@inject TravelService BookingTravel
@{ var bookingTrip = Model.PlanId is long tripId ? await BookingTravel.OwnPlan(tripId) : null; }
@{ViewData["Title"]="Kiểm tra trước khi gửi";var warnings=ViewBag.Warnings as List<string>??[];}
<div class="container-narrow"><a class="back" href="#revise-booking">↓ Sửa lại thông tin yêu cầu</a><div class="page-head"><div><span class="eyebrow">BƯỚC 2 / 2</span><h1>Kiểm tra yêu cầu của bạn</h1><p>@ViewBag.ServiceName</p></div></div>
@foreach(var warning in warnings){<div class="notice warning">@warning</div>}
@if(bookingTrip != null){<div class="trip-context">@Ui.Icon("calendar")<span>Trong chuyến đi <strong>@bookingTrip.TenKeHoach</strong></span></div>}
<div class="panel"><dl class="facts"><div><dt>Thời gian</dt><dd>@Model.Start.ToString("dd/MM/yyyy") — @Model.End?.ToString("dd/MM/yyyy")</dd></div><div><dt>Số người · Số lượng</dt><dd>@Model.People người · @Model.Quantity đơn vị</dd></div><div><dt>Đến / đi</dt><dd>@Model.ArrivalDeparture</dd></div><div><dt>Chi phí dự kiến</dt><dd>@Labels.Money(Model.Cost)</dd></div></dl><h2>Hạng mục chọn thêm</h2><p class="prose">@(Model.Selections??"Không có")</p><h2>Ghi chú</h2><p class="prose">@(Model.Notes??"Không có")</p>
<form action="/yeu-cau/gui-yeu-cau" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="ServiceId"/><input type="hidden" asp-for="BranchId"/><input type="hidden" asp-for="BranchVersion"/><input type="hidden" asp-for="PlanId"/><input type="hidden" asp-for="Version"/><input type="hidden" asp-for="SubmissionId"/><input type="hidden" name="Start" value="@Model.Start.ToString("yyyy-MM-dd")"/><input type="hidden" name="End" value="@Model.End?.ToString("yyyy-MM-dd")"/><input type="hidden" asp-for="People"/><input type="hidden" asp-for="Quantity"/><input type="hidden" asp-for="ArrivalDeparture"/><input type="hidden" asp-for="Cost"/><input type="hidden" asp-for="Selections"/><input type="hidden" asp-for="Notes"/><div class="form-actions"><button class="btn btn-dark" type="submit">Gửi yêu cầu, chờ phản hồi @Ui.Icon("arrow")</button><button class="btn btn-outline" type="submit" id="revise-booking" formaction="/Bookings/Revise">Sửa lại thông tin</button></div></form></div></div>
