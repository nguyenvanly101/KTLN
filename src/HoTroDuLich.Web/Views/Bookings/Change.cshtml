@model ChangeInput
@{ViewData["Title"]="Đề nghị thay đổi / hủy";}
<div class="container-narrow"><a class="back" href="/Bookings/Changes/@Model.Id">← Đề nghị thay đổi / hủy</a><div class="page-head"><div><h1>Thay đổi dịch vụ đã xác nhận</h1><p>Nhà cung cấp sẽ xem xét và phản hồi đề nghị của bạn.</p></div></div><div class="notice warning">Điều kiện đã xác nhận tiếp tục có hiệu lực trong lúc chờ phản hồi. Các trường mới để trống sẽ giữ giá trị hiện tại.</div><div class="panel"><form action="/yeu-cau/@Model.Id/dieu-chinh/gui-de-nghi" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><div class="form-grid"><div class="field"><label asp-for="Kind">Bạn muốn làm gì?</label><select class="form-select" asp-for="Kind"><option value="ThayDoi">Thay đổi điều kiện</option><option value="Huy">Hủy dịch vụ</option></select></div><div class="field"><label asp-for="Start">Ngày bắt đầu mới</label><input class="form-control" asp-for="Start" type="date"/><span asp-validation-for="Start"></span></div><div class="field"><label asp-for="End">Ngày kết thúc mới</label><input class="form-control" asp-for="End" type="date"/><span asp-validation-for="End"></span></div><div class="field"><label asp-for="People">Số người mới</label><input class="form-control" asp-for="People" type="number" min="1" max="100"/><span asp-validation-for="People"></span></div><div class="field"><label asp-for="Quantity">Số lượng mới</label><input class="form-control" asp-for="Quantity" type="number" min="1" max="100"/><span asp-validation-for="Quantity"></span></div><div class="field full"><label asp-for="Terms">Điều kiện mới</label><textarea class="form-control" asp-for="Terms" maxlength="2000"></textarea><span asp-validation-for="Terms"></span></div><div class="field full"><label asp-for="Reason">Lý do thay đổi / hủy</label><textarea class="form-control" asp-for="Reason" maxlength="500" required></textarea><span asp-validation-for="Reason"></span></div></div><div class="form-actions"><button class="btn btn-dark" type="submit">Gửi đề nghị @Ui.Icon("arrow")</button></div></form></div></div>
