@model BookingInput
@{ViewData["Title"]="Gửi yêu cầu dịch vụ";var service=ViewBag.Service as DichVuDuLich;}
<div class="container-narrow"><a class="back" asp-controller="Explore" asp-action="Detail" asp-route-id="@Model.ServiceId" asp-route-planId="@Model.PlanId">← Chi tiết dịch vụ</a><div class="page-head"><div><span class="eyebrow">BƯỚC 1 / 2</span><h1>Yêu cầu sử dụng dịch vụ</h1><p>@service?.TenDichVu · @Labels.Money(service?.GiaThamKhao) / @(service?.DonViGia??"đơn vị chưa công bố")</p></div></div><div class="notice">Nhà cung cấp sẽ xác nhận khả năng phục vụ và điều kiện. Bạn được kiểm tra lại thông tin trước khi gửi.</div><div class="panel"><form action="/yeu-cau/kiem-tra-truoc-gui" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><partial name="/Views/Bookings/_BookingFields.cshtml" model="Model"/><div class="form-actions"><button class="btn btn-dark" type="submit">Kiểm tra trước khi gửi @Ui.Icon("arrow")</button></div></form></div></div>
