@model List<YeuCauDatDichVu>
@inject TravelService Travel
@{ViewData["Title"]="Quản lý đặt dịch vụ";var names=(Dictionary<long,string>)ViewBag.ServiceNames;var provider=Travel.Role==TravelService.ProviderRole;}
<div class="container-wide"><div class="page-head"><div><h1>@(provider?"Yêu cầu đặt dịch vụ":"Đặt dịch vụ của tôi")</h1><p>@(provider?"Tiếp nhận yêu cầu của khách và theo dõi quá trình cung cấp dịch vụ.":"Theo dõi trạng thái đặt dịch vụ và quản lý các thay đổi trong chuyến đi.")</p></div>@if(!provider){<a class="btn btn-dark" href="/">@Ui.Icon("search") Tìm dịch vụ</a>}</div>
<partial name="_BookingWorkspaceTabs"/>
<div class="workflow-ribbon" aria-label="Quy trình đặt dịch vụ"><span><b>01</b> Gửi yêu cầu</span>@Ui.Icon("arrow")<span><b>02</b> Nhà cung cấp phản hồi</span>@Ui.Icon("arrow")<span><b>03</b> Xác nhận & theo dõi</span></div>
<div class="stats compact-stats"><div class="stat">@Ui.Icon("ticket")<small>Tất cả yêu cầu</small><strong>@Model.Count</strong></div><div class="stat">@Ui.Icon("clock")<small>Chờ phản hồi</small><strong>@Model.Count(x=>new[]{"ChoPhanHoi","DeXuatKhac"}.Contains(x.TrangThai.ToString()))</strong></div><div class="stat">@Ui.Icon("check")<small>Đã xác nhận</small><strong>@Model.Count(x=>x.TrangThai.ToString()=="DaXacNhan")</strong></div></div>
@if(Model.Count==0){<div class="empty">@Ui.Icon("ticket")<h3>Chưa có yêu cầu đặt dịch vụ</h3><p>@(provider?"Các yêu cầu mới của khách sẽ xuất hiện tại đây.":"Tìm dịch vụ phù hợp và gửi yêu cầu cho chuyến đi của bạn.")</p>@if(!provider){<a class="btn btn-dark" href="/">Khám phá dịch vụ</a>}</div>}else{
 <div class="panel table-wrap"><table class="table booking-table" role="table"><caption class="visually-hidden">Các yêu cầu đặt dịch vụ và trạng thái xử lý</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Dịch vụ</th><th scope="col" role="columnheader">Ngày sử dụng</th><th scope="col" role="columnheader">Số người / số lượng</th><th scope="col" role="columnheader">Chi phí dự kiến</th><th scope="col" role="columnheader">Trạng thái</th><th scope="col" role="columnheader"><span class="visually-hidden">Thao tác</span></th></tr></thead><tbody role="rowgroup">
 @foreach(var y in Model){<tr role="row"><td role="cell"><b>@names.GetValueOrDefault(y.MaYeuCau,"Dịch vụ du lịch")</b><span class="help">Yêu cầu #@y.MaYeuCau</span></td><td role="cell"><span class="mobile-cell-label" aria-hidden="true">Ngày sử dụng</span>@y.NgayBatDau.ToString("dd/MM/yyyy")</td><td role="cell"><span class="mobile-cell-label" aria-hidden="true">Số lượng</span>@y.SoNguoi người · @y.SoLuong đơn vị</td><td role="cell"><span class="mobile-cell-label" aria-hidden="true">Chi phí dự kiến</span>@Labels.Money(y.ChiPhiDuKien)</td><td role="cell"><span class="mobile-cell-label" aria-hidden="true">Trạng thái</span><span class="badge @Labels.Badge(y.TrangThai.ToString())">@Labels.Status(y.TrangThai.ToString())</span></td><td role="cell"><a class="booking-detail-link" href="/Bookings/Detail/@y.MaYeuCau" aria-label="Chi tiết yêu cầu @y.MaYeuCau">Xem chi tiết @Ui.Icon("arrow")</a></td></tr>}
 </tbody></table></div>
}
</div>
