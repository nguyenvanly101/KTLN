@model List<YeuCauDatDichVu>
@inject TravelService Travel
@inject HoTroDuLich.Web.Data.AppDbContext BookingDb
@using Microsoft.EntityFrameworkCore
@{
 ViewData["Title"]="Yêu cầu đặt dịch vụ";
 var names=(Dictionary<long,string>)ViewBag.ServiceNames;
 var provider=Travel.Role==TravelService.ProviderRole;
 var today=TravelService.Today;
 var ids=Model.Select(x=>x.MaYeuCau).ToList();
 var branches=ids.Count==0?new Dictionary<long,string>():await BookingDb.Set<YeuCauDatCoSo>().AsNoTracking().Where(x=>ids.Contains(x.RequestId)).ToDictionaryAsync(x=>x.RequestId,x=>x.BranchName);
 var people=new Dictionary<long,string>();
 if(provider){var acc=Model.Select(x=>x.MaTaiKhoan).Distinct().ToList();people=await BookingDb.Set<HoSoNguoiDung>().AsNoTracking().Where(x=>acc.Contains(x.MaTaiKhoan)).ToDictionaryAsync(x=>x.MaTaiKhoan,x=>x.TenHienThi??"");}
 var byFilter=Model.GroupBy(x=>BookingUi.Filter(x,provider,today)).ToDictionary(g=>g.Key,g=>g.ToList());
 var requested=Context.Request.Query["loc"].ToString();
 var current=BookingUi.Filters.Any(f=>f.Key==requested)?requested:BookingUi.Filters.FirstOrDefault(f=>byFilter.ContainsKey(f.Key)).Key??"can-tra-loi";
 // Yeu cau moi can tra loi len dau, roi theo ngay dung gan nhat; muc da xong xep moi nhat truoc.
 var open=current is "can-tra-loi" or "sap-toi";
 var shown=open
  ?(byFilter.GetValueOrDefault(current)??[]).OrderBy(x=>x.TrangThai is TrangThaiYeuCau.ChoPhanHoi or TrangThaiYeuCau.DeXuatKhac?0:1).ThenBy(x=>x.NgayBatDau).ThenByDescending(x=>x.MaYeuCau).ToList()
  :(byFilter.GetValueOrDefault(current)??[]).OrderByDescending(x=>x.ThoiDiemPhanHoi??x.ThoiDiemGui).ThenByDescending(x=>x.MaYeuCau).ToList();
}
<div class="container-narrow bk-page">
 <div class="page-head"><div><h1>@(provider?"Yêu cầu đặt dịch vụ":"Đặt dịch vụ của tôi")</h1><p>@(provider?"Yêu cầu của khách ở cơ sở "+(ViewBag.BranchName??"đang chọn")+". Đổi cơ sở ở thanh bên để xem cơ sở khác.":"Theo dõi yêu cầu bạn đã gửi cho các cơ sở.")</p></div>@if(!provider){<a class="btn btn-outline" href="/Discovery">@Ui.Icon("search") Tìm dịch vụ</a>}</div>
 <nav class="bk-chips" aria-label="Lọc yêu cầu">@foreach(var f in BookingUi.Filters){<a class="@(f.Key==current?"on":"")" aria-current="@(f.Key==current?"page":null)" href="?loc=@f.Key">@f.Label<em>@(byFilter.GetValueOrDefault(f.Key)?.Count??0)</em></a>}</nav>
 @if(shown.Count==0)
 {
  <div class="empty">@Ui.Icon("ticket")<h2>@(Model.Count==0?"Chưa có yêu cầu nào":"Không có yêu cầu ở mục này")</h2><p>@(provider?"Yêu cầu mới của khách sẽ hiện ở “Cần trả lời”.":Model.Count==0?"Mở một dịch vụ và bấm “Đặt dịch vụ” để gửi yêu cầu cho cơ sở.":"Chọn mục khác ở trên.")</p></div>
 }
 else
 {
  <ul class="bk-list">
  @foreach(var y in shown.Take(60))
  {
   var group=BookingUi.Group(y.TrangThai);
   <li class="bk-item">
    <a class="bk-item-main" href="/Bookings/Detail/@y.MaYeuCau"><b>@names.GetValueOrDefault(y.MaYeuCau,"Dịch vụ du lịch") · @BookingUi.Dates(y) · @y.SoNguoi người</b>
     <span class="help">@string.Join(" · ",new[]{provider?(people.GetValueOrDefault(y.MaTaiKhoan) is string n&&n.Length>0?n:"Khách #"+y.MaTaiKhoan):null,branches.GetValueOrDefault(y.MaYeuCau),y.ChiPhiDuKien!=null?Labels.Money(y.ChiPhiDuKien):null,"#"+y.MaYeuCau}.Where(s=>!string.IsNullOrEmpty(s)))</span></a>
    <div class="bk-item-side"><span class="bk-pill bk-@group">@BookingUi.Label(y.TrangThai)</span>
     @if(provider&&y.TrangThai==TrangThaiYeuCau.ChoPhanHoi){<form action="/Bookings/Respond" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@y.MaYeuCau"/><input type="hidden" name="Version" value="@TravelService.Token(y.RowVersion)"/><input type="hidden" name="BusinessVersion" value="@y.PhienBan"/><button class="btn btn-dark btn-small" name="Decision" value="DaXacNhan" type="submit">Xác nhận</button></form>}
     <a class="btn btn-outline btn-small" href="/Bookings/Detail/@y.MaYeuCau">Mở</a></div>
   </li>
  }
  </ul>
  @if(shown.Count>60){<p class="help">Đang hiện 60 yêu cầu gần nhất trong mục này.</p>}
 }
</div>
