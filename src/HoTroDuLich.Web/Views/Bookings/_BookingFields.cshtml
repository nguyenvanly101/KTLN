@model BookingInput
@if(Model.Id==0){<partial name="/Views/Branches/_BookingBranchSelector.cshtml" model="Model"/>}
@inject TravelService BookingTravel
@{ var tripOptions = Model.Id == 0 ? await BookingTravel.Plans() : new List<KeHoachChuyenDi>(); }
@if(Model.Id == 0){<div class="field booking-trip-field"><label asp-for="PlanId">Chuyến đi của bạn (tùy chọn)</label><select class="form-control" asp-for="PlanId"><option value="">Yêu cầu riêng, chưa gắn chuyến đi</option>@foreach(var trip in tripOptions){<option value="@trip.MaKeHoach">@trip.TenKeHoach · @trip.NgayBatDau.ToString("dd/MM") – @trip.NgayKetThuc.ToString("dd/MM")</option>}</select><span asp-validation-for="PlanId"></span><small>Yêu cầu sẽ hiện trong chuyến đi đã chọn. Kiểm tra ngày phục vụ bên dưới.</small></div>}
<input type="hidden" asp-for="Id"/><input type="hidden" asp-for="ServiceId"/><input type="hidden" asp-for="Version"/><input type="hidden" asp-for="SubmissionId"/>
<div class="form-grid"><div class="field"><label asp-for="Start">Ngày bắt đầu</label><input class="form-control" asp-for="Start" type="date" required/><span asp-validation-for="Start"></span></div><div class="field"><label asp-for="End">Ngày kết thúc (nếu có)</label><input class="form-control" asp-for="End" type="date"/><span asp-validation-for="End"></span></div><div class="field"><label asp-for="People">Số người</label><input class="form-control" asp-for="People" type="number" min="1" max="100" required/><span asp-validation-for="People"></span></div><div class="field"><label asp-for="Quantity">Số lượng</label><input class="form-control" asp-for="Quantity" type="number" min="1" max="100" required/><span asp-validation-for="Quantity"></span></div><div class="field"><label asp-for="ArrivalDeparture">Thời gian đến / đi</label><input class="form-control" asp-for="ArrivalDeparture" maxlength="100" placeholder="Ví dụ: nhận phòng khoảng 14:00"/><span asp-validation-for="ArrivalDeparture"></span></div><div class="field"><label asp-for="Cost">Chi phí dự kiến (₫, tùy chọn)</label><input class="form-control" asp-for="Cost" type="number" min="0" max="1000000000"/><span asp-validation-for="Cost"></span></div><div class="field full"><label asp-for="Selections">Hạng mục chọn thêm</label><textarea class="form-control" asp-for="Selections" maxlength="1000" placeholder="Mỗi dòng một hạng mục"></textarea><small>Tối đa 10 hạng mục khác nhau, mỗi dòng không quá 150 ký tự.</small><span asp-validation-for="Selections"></span></div><div class="field full"><label asp-for="Notes">Ghi chú cho nhà cung cấp</label><textarea class="form-control" asp-for="Notes" maxlength="1000"></textarea><span asp-validation-for="Notes"></span></div></div>
