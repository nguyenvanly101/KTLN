@model YeuCauDatDichVu
<partial name="/Views/Branches/_BookingBranchSnapshot.cshtml" model="Model"/>
@inject TravelService Travel
@{ViewData["Title"]="Yêu cầu #"+Model.MaYeuCau;ViewData["BookingSection"]="request";var customer=Model.MaTaiKhoan==Travel.UserId;var items=await Travel.BookingItems(Model.MaYeuCau);var canReceive=false;if(!customer){try{await Travel.BookableService(Model.MaDichVu);canReceive=true;}catch(BusinessException){}}}
<div class="container-narrow"><a class="back" href="/Bookings">← Yêu cầu dịch vụ</a><div class="page-head"><div><h1>@ViewBag.ServiceName</h1><p>Yêu cầu #@Model.MaYeuCau · Phiên bản @Model.PhienBan</p></div></div><partial name="/Views/Bookings/_BookingTabs.cshtml" model="Model"/>
<div class="panel"><span class="badge @Labels.Badge(Model.TrangThai.ToString())">@Labels.Status(Model.TrangThai.ToString())</span><dl class="facts"><div><dt>Thời gian phục vụ</dt><dd>@Model.NgayBatDau.ToString("dd/MM/yyyy") — @Model.NgayKetThuc?.ToString("dd/MM/yyyy")</dd></div><div><dt>Quy mô</dt><dd>@Model.SoNguoi người · @Model.SoLuong đơn vị</dd></div><div><dt>Thời gian đến / đi</dt><dd>@(Model.ThoiGianDenDi??"Chưa có")</dd></div><div><dt>Chi phí dự kiến</dt><dd>@Labels.Money(Model.ChiPhiDuKien)</dd></div></dl><h2>Hạng mục thống nhất</h2><ul>@foreach(var item in items){<li>@item</li>}</ul><p class="prose">@Model.GhiChu</p>
@if(Model.DieuKienDeXuat!=null){<div class="notice warning">Điều kiện nhà cung cấp đề xuất: @Model.DieuKienDeXuat</div>}@if(Model.LyDo!=null){<p>Lý do: @Model.LyDo</p>}
@if(customer&&new[]{"ChoPhanHoi","DeXuatKhac"}.Contains(Model.TrangThai.ToString())){<form action="/Bookings/Respond" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" name="Id" value="@Model.MaYeuCau"/><input type="hidden" name="Version" value="@TravelService.Token(Model.RowVersion)"/><input type="hidden" name="BusinessVersion" value="@Model.PhienBan"/><div class="form-actions">@if(Model.TrangThai.ToString()=="ChoPhanHoi"){<a href="/Bookings/Edit/@Model.MaYeuCau" class="btn btn-outline">Sửa yêu cầu</a>}else{<button class="btn btn-dark" name="Decision" value="KhachDongY" type="submit">Đồng ý đúng điều kiện trên</button><button class="btn btn-outline" name="Decision" value="KhachKhongDongY" type="submit">Không đồng ý đề xuất</button>}<button class="btn btn-outline" name="Decision" value="Rut" type="submit">Rút yêu cầu</button></div></form>}
@if(!customer&&Model.TrangThai.ToString()=="ChoPhanHoi"){<form action="/yeu-cau/chap-nhan" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" name="Id" value="@Model.MaYeuCau"/><input type="hidden" name="Version" value="@TravelService.Token(Model.RowVersion)"/><input type="hidden" name="BusinessVersion" value="@Model.PhienBan"/><div class="field"><label for="booking-reason">Lý do từ chối</label><input id="booking-reason" class="form-control" name="Reason" maxlength="500"/></div>
@if(canReceive){<details class="mt-3"><summary>Đề xuất điều kiện khác</summary><p class="help">Điền các giá trị muốn thay đổi; trường để trống giữ điều kiện hiện tại.</p><div class="form-grid"><div class="field"><label for="proposal-start">Ngày bắt đầu</label><input id="proposal-start" class="form-control" name="Start" type="date"/></div><div class="field"><label for="proposal-end">Ngày kết thúc</label><input id="proposal-end" class="form-control" name="End" type="date"/></div><div class="field"><label for="proposal-people">Số người</label><input id="proposal-people" class="form-control" name="People" type="number" min="1" max="100"/></div><div class="field"><label for="proposal-quantity">Số lượng</label><input id="proposal-quantity" class="form-control" name="Quantity" type="number" min="1" max="100"/></div><div class="field"><label for="proposal-cost">Chi phí dự kiến (₫)</label><input id="proposal-cost" class="form-control" name="Cost" type="number" min="0" max="1000000000"/></div><div class="field"><label for="proposal-arrival">Thời gian đến / đi</label><input id="proposal-arrival" class="form-control" name="ArrivalDeparture" maxlength="100"/></div><div class="field full"><label for="proposal-explanation">Giải thích điều kiện đề xuất</label><textarea id="proposal-explanation" class="form-control" name="Text" maxlength="2000"></textarea></div></div><button class="btn btn-outline" name="Decision" value="DeXuatKhac" type="submit">Gửi đề xuất để khách xác nhận</button></details>}
<div class="form-actions">@if(canReceive){<button class="btn btn-dark" name="Decision" value="DaXacNhan" type="submit">Chấp nhận đúng yêu cầu</button>}<button class="btn btn-outline" name="Decision" value="TuChoi" type="submit">Từ chối yêu cầu</button></div></form>}
@if(!customer&&Model.TrangThai.ToString()=="DeXuatKhac"){<div class="notice">Đã gửi điều kiện khác. Yêu cầu đang chờ khách chấp thuận đúng phiên bản này.</div>}
<partial name="/Views/Bookings/_TripAssignment.cshtml" model="Model"/>
</div></div>
