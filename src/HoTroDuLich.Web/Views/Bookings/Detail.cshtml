@model YeuCauDatDichVu
@inject TravelService Travel
@inject ChatService Chat
@inject IDatDichVuService BookingDiff
@inject HoTroDuLich.Web.Data.AppDbContext BookingDb
@using Microsoft.EntityFrameworkCore
@{
 ViewData["Title"]="Yêu cầu #"+Model.MaYeuCau;
 var customer=Model.MaTaiKhoan==Travel.UserId;
 var today=TravelService.Today;
 var group=BookingUi.Group(Model.TrangThai);var step=BookingUi.Step(Model.TrangThai);
 var before=Model.NgayBatDau>today;
 var chatId=await Chat.ConversationOfBooking(Model.MaYeuCau);var canChat=chatId!=null||await Chat.BookingHasBranch(Model.MaYeuCau);
 var proposed=await BookingDiff.ThayDoiDeXuatAsync(Model.MaYeuCau);
 var branch=await BookingDb.Set<YeuCauDatCoSo>().AsNoTracking().SingleOrDefaultAsync(x=>x.RequestId==Model.MaYeuCau);
 var extras=(Model.NoiDungLuaChon??"").Replace("\r","").Split('\n',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);
 var version=TravelService.Token(Model.RowVersion);
 string[] steps=["Đã gửi","Cơ sở phản hồi","Đã xác nhận","Đã dùng"];
}
<div class="container-narrow bk-page">
 <a class="back" href="/Bookings">← Yêu cầu đặt dịch vụ</a>
 <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1"></div>
 <section class="panel bk-main">
  <div class="bk-title"><div><span class="help">Yêu cầu #@Model.MaYeuCau</span><h1>@ViewBag.ServiceName</h1></div><span class="bk-pill bk-@group">@BookingUi.Label(Model.TrangThai)</span></div>
  @if(step>=0){<ol class="bk-steps" aria-label="Tiến trình">@for(var n=0;n<steps.Length;n++){<li class="@(n<step?"done":n==step?"now":"")">@(n==3&&group=="noshow"?"Khách không đến":steps[n])</li>}</ol>}
  <dl class="bk-facts">
   @if(branch!=null){<dt>Cơ sở</dt><dd>@branch.BranchName<small>@branch.Address</small></dd>}
   @if(!customer){<dt>Khách</dt><dd id="booking-customer">@(await Chat.NameOf(Model.MaTaiKhoan))</dd>}
   <dt>Ngày</dt><dd>@BookingUi.Dates(Model)@if(Model.ThoiGianDenDi!=null){<small>@Model.ThoiGianDenDi</small>}</dd>
   <dt>Số người</dt><dd>@Model.SoNguoi người@(Model.SoLuong>1?" · "+Model.SoLuong+" đơn vị":"")</dd>
   <dt>Giá</dt><dd>@(Model.ChiPhiDuKien!=null?Labels.Money(Model.ChiPhiDuKien):"Cơ sở báo giá khi xác nhận")</dd>
   @if(!string.IsNullOrWhiteSpace(Model.GhiChu)){<dt>Ghi chú của khách</dt><dd>@Model.GhiChu</dd>}
   @if(extras.Length>0){<dt>Chọn thêm</dt><dd>@string.Join(", ",extras)</dd>}
   @if(group=="off"&&Model.LyDo!=null){<dt>Lý do</dt><dd>@Model.LyDo</dd>}
  </dl>
  @if(group=="prop")
  {
   @if(proposed.Count>0){<div class="bk-changes" id="proposal-changes"><strong>Cơ sở đã đổi so với yêu cầu ban đầu</strong><ul>@foreach(var change in proposed){<li><b>@change.Label:</b> <s>@change.Old</s> → <strong>@change.New</strong></li>}</ul></div>}
   @if(Model.DieuKienDeXuat!=null){<p class="bk-note">Cơ sở: “@Model.DieuKienDeXuat”</p>}
  }

  @* Viec can lam: nut hien dung luc *@
  <div class="bk-actions">
   @if(customer&&group=="prop"){
    <form action="/Bookings/Respond" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.MaYeuCau"/><input type="hidden" name="Version" value="@version"/><input type="hidden" name="BusinessVersion" value="@Model.PhienBan"/><button class="btn btn-dark" name="Decision" value="KhachDongY" type="submit">Đồng ý đề xuất</button> <button class="btn btn-outline" name="Decision" value="KhachKhongDongY" type="submit">Không đồng ý</button></form>
   }
   @if(!customer&&group=="wait"&&Model.TrangThai==TrangThaiYeuCau.ChoPhanHoi){
    <form action="/Bookings/Respond" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.MaYeuCau"/><input type="hidden" name="Version" value="@version"/><input type="hidden" name="BusinessVersion" value="@Model.PhienBan"/><button class="btn btn-dark" name="Decision" value="DaXacNhan" type="submit">Xác nhận yêu cầu</button></form>
   }
   @if(!customer&&Model.TrangThai==TrangThaiYeuCau.DaXacNhan&&!before){
    <form action="/Bookings/Respond" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.MaYeuCau"/><input type="hidden" name="Version" value="@version"/><input type="hidden" name="BusinessVersion" value="@Model.PhienBan"/><button class="btn btn-dark" name="Decision" value="DaPhucVu" type="submit">Đã phục vụ</button> <button class="btn btn-outline" name="Decision" value="KhachKhongDen" type="submit">Khách không đến</button></form>
   }
   @if(customer&&BookingUi.CanReview(Model,TravelService.Today)){<a class="btn btn-dark" href="/Reviews/Write?bookingId=@Model.MaYeuCau">Đánh giá dịch vụ</a>}
   @if(canChat){<a class="btn btn-outline" id="booking-chat" href="/tin-nhan/dat-cho/@Model.MaYeuCau">@Ui.Icon("chat") @(customer?"Nhắn tin với cơ sở":"Nhắn tin với khách")</a>}
  </div>
  @if(customer&&Model.TrangThai==TrangThaiYeuCau.DaXacNhan&&!before){<p class="help">Cơ sở sẽ ghi nhận đã phục vụ sau ngày sử dụng; khi đó bạn đánh giá được dịch vụ.</p>}
  @if(!customer&&group=="prop"){<p class="help">Đã gửi đề xuất. Đang chờ khách đồng ý đúng điều kiện trên.</p>}

  @* Sua (khach): khi cho phan hoi, hoac da xac nhan truoc ngay dung -> quay lai cho co so xac nhan lai *@
  @if(customer&&(Model.TrangThai==TrangThaiYeuCau.ChoPhanHoi||(Model.TrangThai==TrangThaiYeuCau.DaXacNhan&&before)))
  {
   <details class="bk-more"><summary>Đổi ngày hoặc số người</summary>
    <form action="/Bookings/Edit" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.MaYeuCau"/><input type="hidden" name="ServiceId" value="@Model.MaDichVu"/><input type="hidden" name="Version" value="@version"/><input type="hidden" name="Quantity" value="@Model.SoLuong"/><input type="hidden" name="Cost" value="@Model.ChiPhiDuKien"/><input type="hidden" name="Selections" value="@Model.NoiDungLuaChon"/><input type="hidden" name="ArrivalDeparture" value="@Model.ThoiGianDenDi"/>
     <div class="book-fields"><label>Ngày<input class="form-control" type="date" name="Start" value="@Model.NgayBatDau.ToString("yyyy-MM-dd")" min="@today.ToString("yyyy-MM-dd")" required/></label><label>Đến ngày (nếu có)<input class="form-control" type="date" name="End" value="@Model.NgayKetThuc?.ToString("yyyy-MM-dd")"/></label><label>Số người<input class="form-control" type="number" name="People" value="@Model.SoNguoi" min="1" max="100" required/></label><label class="full">Ghi chú<textarea class="form-control" name="Notes" maxlength="1000" rows="2">@Model.GhiChu</textarea></label></div>
     @if(Model.TrangThai==TrangThaiYeuCau.DaXacNhan){<p class="help">Yêu cầu đã xác nhận sẽ quay lại "Chờ phản hồi" để cơ sở xác nhận lại.</p>}
     <button class="btn btn-dark" type="submit">Lưu thay đổi</button>
    </form>
   </details>
  }
  @* De xuat khac (co so) *@
  @if(!customer&&Model.TrangThai==TrangThaiYeuCau.ChoPhanHoi)
  {
   <details class="bk-more"><summary>Đề xuất điều kiện khác</summary>
    <form action="/Bookings/Respond" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.MaYeuCau"/><input type="hidden" name="Version" value="@version"/><input type="hidden" name="BusinessVersion" value="@Model.PhienBan"/><input type="hidden" name="Decision" value="DeXuatKhac"/>
     <p class="help">Chỉ điền ô muốn đổi; ô trống giữ như yêu cầu của khách.</p>
     <div class="book-fields"><label>Ngày<input id="proposal-start" class="form-control" name="Start" type="date"/></label><label>Đến ngày<input id="proposal-end" class="form-control" name="End" type="date"/></label><label>Số người<input id="proposal-people" class="form-control" name="People" type="number" min="1" max="100"/></label><label>Giá (₫)<input id="proposal-cost" class="form-control" name="Cost" type="number" min="0" max="1000000000"/></label><label class="full">Nhắn khách vì sao đổi<textarea id="proposal-explanation" class="form-control" name="Text" maxlength="2000" rows="2" required></textarea></label></div>
     <button class="btn btn-dark" type="submit">Gửi đề xuất</button>
    </form>
   </details>
  }
  @* Huy / tu choi / rut: kem ly do *@
  @{
   string? stopLabel=null;string? stopDecision=null;
   if(customer&&Model.TrangThai is TrangThaiYeuCau.ChoPhanHoi or TrangThaiYeuCau.DeXuatKhac){stopLabel="Rút yêu cầu";stopDecision="Rut";}
   else if(!customer&&Model.TrangThai==TrangThaiYeuCau.ChoPhanHoi){stopLabel="Từ chối yêu cầu";stopDecision="TuChoi";}
   else if(Model.TrangThai==TrangThaiYeuCau.DaXacNhan&&before){stopLabel="Hủy đặt dịch vụ";stopDecision="Huy";}
  }
  @if(stopDecision!=null)
  {
   <details class="bk-more bk-stop"><summary>@stopLabel</summary>
    <form action="/Bookings/Respond" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.MaYeuCau"/><input type="hidden" name="Version" value="@version"/><input type="hidden" name="BusinessVersion" value="@Model.PhienBan"/><input type="hidden" name="Decision" value="@stopDecision"/>
     <label class="bk-reason">Lý do@(stopDecision=="Rut"?" (tùy chọn)":"")<textarea id="booking-reason" class="form-control" name="Reason" maxlength="480" rows="2" @(stopDecision=="Rut"?"":"required")></textarea></label>
     @if(stopDecision=="Huy"){<p class="help">Hủy có hiệu lực ngay, bên kia nhận thông báo. Khoản cọc (nếu có) hai bên tự thỏa thuận.</p>}
     <button class="btn btn-outline" type="submit">@stopLabel</button>
    </form>
   </details>
  }
 </section>
 <partial name="/Views/Bookings/_TripAssignment.cshtml" model="Model"/>
</div>
