@model YeuCauDatDichVu
@inject TravelService Travel
@{ViewData["Title"]="Kết quả phục vụ #"+Model.MaYeuCau;ViewData["BookingSection"]="outcome";var results=(List<KetQuaCungCapDichVu>)ViewBag.Results;var customer=Model.MaTaiKhoan==Travel.UserId;var items=ViewBag.Items as List<string>??[];var pending=items.Where(item=>!results.Any(r=>r.HangMuc==item&&r.KetQuaThucHien.ToString()!="ChuaXacDinh"&&r.TrangThaiKiemTra.ToString()!="ChoKiemTra")).ToList();}
<div class="container-narrow"><a class="back" href="/Bookings/Results">← Kết quả phục vụ</a><div class="page-head"><div><h1>Kết quả từng hạng mục</h1><p>@ViewBag.ServiceName · Yêu cầu #@Model.MaYeuCau</p></div></div><partial name="/Views/Bookings/_BookingTabs.cshtml" model="Model"/>
@if(!customer&&new[]{"DaXacNhan","ChoKiemTra"}.Contains(Model.TrangThai.ToString())&&Model.NgayBatDau<=TravelService.Today&&pending.Count>0){<div class="panel"><h2>Ghi nhận và đối chiếu kết quả</h2><p class="help">Chọn kết quả cho từng hạng mục bên dưới. Các hạng mục đã chốt được giữ trong lịch sử.</p><form action="/yeu-cau/@Model.MaYeuCau/ket-qua/luu-ket-qua" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" name="Id" value="@Model.MaYeuCau"/><input type="hidden" name="Version" value="@TravelService.Token(Model.RowVersion)"/>
@for(var index=0;index<pending.Count;index++){var item=pending[index];<fieldset class="result-item"><legend>@item</legend><input type="hidden" name="Items[@index].Item" value="@item"/><div class="form-grid"><div class="field"><label for="result-@index">Kết quả thực hiện</label><select id="result-@index" name="Items[@index].Result" class="form-select" required><option value="">Chọn kết quả</option>@foreach(var value in new[]{"DayDu","MotPhan","KhongThucHien","KhachKhongDen","ChuaXacDinh"}){<option value="@value">@Labels.Status(value)</option>}</select></div><div class="field"><label for="result-note-@index">Ghi chú thực tế</label><textarea id="result-note-@index" class="form-control" name="Items[@index].Notes" maxlength="1000">@results.FirstOrDefault(r=>r.HangMuc==item)?.GhiChu</textarea></div></div></fieldset>}
<div class="form-actions"><button class="btn btn-dark" type="submit">Lưu kết quả các hạng mục</button></div></form></div>}
@if(results.Count==0){<div class="empty">@Ui.Icon("check")<h2>Chưa có kết quả phục vụ</h2><p>Kết quả được ghi nhận từ ngày bắt đầu của dịch vụ đã xác nhận.</p></div>}
@foreach(var r in results){<div class="panel"><span class="eyebrow">KẾT QUẢ HẠNG MỤC</span><h2>@r.HangMuc</h2><span class="badge @Labels.Badge(r.KetQuaThucHien.ToString())">@Labels.Status(r.KetQuaThucHien.ToString())</span> <span class="badge @Labels.Badge(r.TrangThaiKiemTra.ToString())">@Labels.Status(r.TrangThaiKiemTra.ToString())</span><p class="prose mt-3">@r.GhiChu</p>@if(r.NoiDungPhanAnh!=null){<div class="notice warning">Phản ánh của khách: @r.NoiDungPhanAnh</div>}
@if(customer&&r.NoiDungPhanAnh==null&&DateTime.UtcNow<=r.ThoiDiemGhi.AddDays(30)){<details><summary>Phản ánh kết quả không đúng thực tế</summary><form action="/yeu-cau/@Model.MaYeuCau/ket-qua/gui-phan-anh" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.MaKetQua"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><input type="hidden" name="bookingId" value="@Model.MaYeuCau"/><input type="hidden" name="Decision" value="PhanAnh"/><div class="field"><label for="complaint-@r.MaKetQua">Nội dung phản ánh</label><textarea id="complaint-@r.MaKetQua" class="form-control" name="Text" maxlength="1000" required></textarea></div><div class="form-actions"><button class="btn btn-outline" type="submit">Gửi phản ánh</button></div></form></details>}</div>}
</div>

@if(User.IsInRole(TravelService.Traveler)){<div class="container-wide"><a class="text-link" href="/Reviews/Mine">Đánh giá trải nghiệm sau khi kết quả hoàn tất @Ui.Icon("arrow")</a></div>}
