@model List<BranchPublicPage>
@{ViewData["Title"]="So sánh cơ sở";var planId=(ViewBag.TripPlan as KeHoachChuyenDi)?.MaKeHoach;}
<div class="container-wide pl-public-detail"><a class="back" asp-controller="Places" asp-action="Index" asp-route-planId="@planId">← Tìm địa điểm & dịch vụ</a><div class="page-head"><div><h1>So sánh cơ sở</h1><p>Đối chiếu thông tin được công bố tại từng địa chỉ. Chưa công bố có nghĩa là cần xác nhận thêm.</p></div></div><partial name="_TripContext"/><div class="pl-comparison">@foreach(var item in Model){var b=item.Branch;<article class="panel"><span class="eyebrow">@DanhMuc.Ten(b.Type)</span><h2><a asp-controller="Places" asp-action="Branch" asp-route-id="@b.Id" asp-route-planId="@planId">@b.Name</a></h2><p>@b.Address</p><dl class="facts"><div><dt>Nhà cung cấp</dt><dd>@item.Provider.TenDonVi</dd></div><div><dt>Giờ phục vụ</dt><dd>@(b.Hours??"Chưa công bố")</dd></div><div><dt>Chỗ đỗ ô tô</dt><dd>@PlaceText.Known(b.Parking)</dd></div><div><dt>Có món chay</dt><dd>@PlaceText.Known(b.VegetarianOptions)</dd></div><div><dt>Thuần chay</dt><dd>@PlaceText.Known(b.VeganOnly)</dd></div><div><dt>Lối vào không bậc</dt><dd>@PlaceText.Known(b.AccessibleEntrance)</dd></div></dl><h3>Dịch vụ & giá tham khảo</h3>@foreach(var s in item.Services){<p><a asp-controller="Explore" asp-action="Detail" asp-route-id="@s.MaDichVu" asp-route-branchId="@b.Id" asp-route-planId="@planId">@s.TenDichVu</a><br/>@Labels.Money(s.GiaThamKhao) / @(s.DonViGia??"chưa công bố đơn vị")</p>}<p class="help">Giữ nguyên đơn vị giá; không quy đổi các dịch vụ khác loại thành cùng tổng tiền.</p><a href="@PlaceText.GoogleUrl(b.Name,b.GooglePlaceId,item.Position)" target="_blank" rel="noopener noreferrer">Xem vị trí Google Maps @Ui.Icon("arrow")</a></article>}</div></div>
