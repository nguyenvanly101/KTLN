@model MapPosition
<div class="pl-map pl-point-map" data-point-map data-lat="@Model.Lat.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-lng="@Model.Lng.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Vị trí trên bản đồ"><div class="pl-map-fallback"><strong>Vị trí trên bản đồ</strong><p>Đang tải bản đồ địa điểm.</p></div></div>
<p class="pl-map-status" role="status"></p>
