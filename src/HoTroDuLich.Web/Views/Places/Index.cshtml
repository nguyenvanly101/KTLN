@model PlaceSearchPage
@using System.Text.Json
@{ViewData["Title"]="Địa điểm & dịch vụ quanh đây";var f=Model.Filter;var planId=(ViewBag.TripPlan as KeHoachChuyenDi)?.MaKeHoach;var mapName=Model.MapsReady?"Google Maps":"OpenStreetMap";var jsonOptions=new JsonSerializerOptions{PropertyNamingPolicy=JsonNamingPolicy.CamelCase};}
<div class="pl-page" data-place-search>
 <section class="pl-hero"><div><span class="eyebrow">ĐỊA ĐIỂM · CƠ SỞ · DỊCH VỤ</span><h1>Chọn một mốc.<br/><em>Tìm điều bạn cần quanh đó.</em></h1><p>Tìm đúng cửa vào, quán ăn, khách sạn và điểm phục vụ. Xem vị trí cùng thông tin của từng cơ sở.</p></div><div class="pl-hero-note">@Ui.Icon("pin")<span><strong>Mốc tìm kiếm luôn rõ ràng</strong><small>Địa điểm đang xem hoặc vị trí bạn chủ động chọn.</small></span></div></section>
 <partial name="_TripContext"/>
 <div class="pl-search-panel"><form method="get" action="/kham-pha" data-place-search-form>
  @if(planId!=null){<input type="hidden" name="PlanId" value="@planId"/>}
  <input type="hidden" name="AnchorKind" value="@f.AnchorKind"/><input type="hidden" name="AnchorId" value="@f.AnchorId"/><input type="hidden" name="GooglePlaceId" value="@f.GooglePlaceId"/><input type="hidden" name="AnchorName" value="@f.AnchorName"/><input type="hidden" name="Lat" value="@f.Lat?.ToString(System.Globalization.CultureInfo.InvariantCulture)"/><input type="hidden" name="Lng" value="@f.Lng?.ToString(System.Globalization.CultureInfo.InvariantCulture)"/>
  <div class="pl-search-grid"><div class="pl-autocomplete" data-autocomplete="anchor"><label for="anchor-query">Bạn muốn tìm gần đâu?</label><div class="pl-input-icon">@Ui.Icon("pin")<input id="anchor-query" class="form-control" type="search" value="@Model.Anchor?.Name" maxlength="200" placeholder="Tên điểm tham quan, cửa vào, khách sạn…" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list"/></div><div class="pl-suggestions" role="listbox" hidden></div><p class="help" data-autocomplete-status role="status"></p></div>
   <div><label for="place-category">Bạn đang cần gì?</label><select class="form-select" name="Category" id="place-category">@foreach(var category in PlaceText.Categories){<option value="@category.Key" selected="@(category.Key==f.Category)">@category.Value</option>}</select></div>
   <div><label for="place-query">Tên, khu vực hoặc dịch vụ</label><input class="form-control" type="search" name="Q" id="place-query" value="@f.Q" maxlength="200" placeholder="Có thể để trống"/></div><button class="btn btn-dark" type="submit">@Ui.Icon("search") Tìm quanh mốc</button>
  </div>
  <div class="pl-search-tools"><button class="btn btn-outline" type="button" data-use-my-location>@Ui.Icon("pin") Gần tôi</button><button class="pl-quiet" type="button" data-clear-anchor>Bỏ mốc tìm kiếm</button><span data-search-location-status role="status"></span></div>
  <details class="pl-filter-details" open="@(f.Parking||f.VegetarianOptions||f.VeganOnly||f.AccessibleEntrance||f.RadiusKm!=3)"><summary>@Ui.Icon("grid") Phạm vi & điều kiện</summary><div class="pl-filter-grid"><div><label for="search-radius">Phạm vi quanh mốc (km)</label><input class="form-control" id="search-radius" name="RadiusKm" type="number" min="0.1" max="50" step="0.1" value="@f.RadiusKm.ToString(System.Globalization.CultureInfo.InvariantCulture)"/><small>Phạm vi theo khoảng cách đường thẳng.</small></div><div><label for="search-mode">Cách di chuyển khi xem đường</label><select class="form-select" id="search-mode" name="Mode"><option value="walk" selected="@(f.Mode=="walk")">Đi bộ</option><option value="drive" selected="@(f.Mode=="drive")">Ô tô</option><option value="bike" selected="@(f.Mode=="bike")">Xe đạp</option></select></div><div><label for="search-sort">Sắp xếp</label><select class="form-select" id="search-sort" name="Sort"><option value="distance" selected="@(f.Sort=="distance")">Gần mốc trước (đường thẳng)</option><option value="name" selected="@(f.Sort=="name")">Tên cơ sở</option></select></div></div>
  <div class="pl-filter-checks">@foreach(var feature in new[]{("Parking","Có chỗ đỗ ô tô",f.Parking),("VegetarianOptions","Có lựa chọn món chay",f.VegetarianOptions),("VeganOnly","Quán thuần chay",f.VeganOnly),("AccessibleEntrance","Lối vào không bậc thang",f.AccessibleEntrance)}){<label><input type="checkbox" name="@feature.Item1" value="true" checked="@feature.Item3"/> @feature.Item2</label><input type="hidden" name="@feature.Item1" value="false"/>}</div><p class="help">Chỉ nhận cơ sở đã công bố đáp ứng những điều kiện bạn chọn.</p>
  <label class="pl-check"><input type="checkbox" name="IncludeGoogle" value="true" checked="@f.IncludeGoogle"/> Xem thêm địa điểm từ @mapName</label><input type="hidden" name="IncludeGoogle" value="false"/><button class="btn btn-dark" type="submit">Áp dụng điều kiện</button></details>
 </form></div>
 @if(Model.Anchor!=null){<div class="pl-anchor-summary">@Ui.Icon("pin")<div><span>ĐANG TÌM QUANH</span><strong>@Model.Anchor.Name</strong>@if(Model.Anchor.Kind=="Google"){<span class="pl-google-attribution pl-google-attribution-dark" translate="no">Google Maps</span>@foreach(var attribution in Model.Anchor.Attributions??[]){<small>@if(attribution.Url!=null){<a href="@attribution.Url" target="_blank" rel="noopener noreferrer">@attribution.Name</a>}else{@attribution.Name}</small>}}<small>@Model.Anchor.Address · Trong @f.RadiusKm km · @PlaceText.Mode(f.Mode) khi xem đường</small></div>@if(Model.Anchor.Kind=="Landmark"){<a asp-controller="Places" asp-action="Landmark" asp-route-id="@Model.Anchor.Id" asp-route-planId="@planId">Thông tin mốc @Ui.Icon("arrow")</a>}else if(Model.Anchor.Kind=="Branch"){<a asp-controller="Places" asp-action="Branch" asp-route-id="@Model.Anchor.Id" asp-route-planId="@planId">Thông tin cơ sở @Ui.Icon("arrow")</a>}</div>}
 @if(Model.Landmarks.Count>0){<section class="pl-landmark-strip"><div class="pl-section-title"><h2>@(f.Q!=null?"Mốc địa điểm tìm được":"Bắt đầu từ một địa điểm cụ thể")</h2></div><div class="pl-landmark-links">@foreach(var l in Model.Landmarks){<a href="@PlaceText.Around("Landmark",l.Id,category:f.Category,planId:planId)">@Ui.Icon("pin")<span><strong>@l.Name</strong><small>@(l.Type=="Entrance"?"Cửa vào":"Địa điểm") · @l.Address</small></span>@Ui.Icon("arrow")</a>}</div></section>}
 @foreach(var notice in Model.Notices){<p class="pl-notice">@notice</p>}
 <section class="pl-search-results"><div class="pl-section-title"><div><span class="eyebrow">@(Model.Anchor!=null?"KẾT QUẢ QUANH MỐC":"CƠ SỞ ĐÃ CÔNG BỐ")</span><h2>@Model.Total lựa chọn @(Model.Anchor!=null?"trong phạm vi":"để khám phá")</h2><p class="help">Mỗi cơ sở là một địa chỉ. Các dịch vụ được xem trong cơ sở đó.</p></div><button class="btn btn-outline pl-mobile-toggle" type="button" data-toggle-map aria-expanded="false">@Ui.Icon("pin") Xem bản đồ</button></div>
 <div class="pl-split"><div class="pl-result-list" data-place-results>
 @if(Model.Hits.Count==0){<div class="pl-empty"><span class="pl-empty-symbol">@Ui.Icon("search")</span><h3>Chưa tìm được lựa chọn đáp ứng</h3><p>Thử tăng phạm vi, chọn mốc khác hoặc bỏ một điều kiện bạn thấy có thể thay đổi.</p>@if(Model.Anchor==null){<p>Chọn một điểm trên bản đồ hoặc tìm tên địa điểm để bắt đầu tìm quanh.</p>}<a class="btn btn-outline" asp-controller="Places" asp-action="Index" asp-route-planId="@planId">Tìm lại từ đầu</a>@if(User.IsInRole(TravelService.ProviderRole)){<a class="text-link" href="/nha-cung-cap/co-so">Quản lý cơ sở của bạn</a>}</div>}
 @foreach(var h in Model.Hits){var detailUrl=h.Branch!=null?Url.Action("Branch","Places",new{id=h.Branch.Id,planId}):h.Url;<article class="pl-result-card" id="result-@h.Key.Replace(":","-").Replace("/","-")" data-result-key="@h.Key"><div class="pl-result-art" aria-hidden="true">@Ui.Icon(h.Category=="LuuTru"?"bed":h.Category=="AnUong"?"food":h.Category=="PhuongTien"?"car":"pin")<span>@(h.Branch!=null?"CƠ SỞ":h.Source)</span></div><div class="pl-result-body"><div class="pl-card-top"><span class="eyebrow">@(h.Category.Length==0?"Địa điểm":PlaceText.Categories.GetValueOrDefault(h.Category,"Địa điểm"))</span>@if(h.DistanceKm!=null){<span class="pl-distance">@h.DistanceKm.Value.ToString("0.0") km<small>đường thẳng</small></span>}</div><h3><a href="@detailUrl" target="@(h.Branch==null?"_blank":null)" rel="@(h.Branch==null?"noopener noreferrer":null)">@h.Name</a></h3>@if(!string.IsNullOrWhiteSpace(h.Address)){<p class="pl-address">@h.Address</p>}
 @if(h.Branch is {} b){<p class="pl-source">Thông tin cơ sở do nhà cung cấp công bố</p>@if(!string.IsNullOrWhiteSpace(b.Hours)){<p class="pl-hours">Giờ phục vụ: @b.Hours</p>}<div class="pl-fact-tags">@if(b.Parking==true){<span>Chỗ đỗ ô tô</span>}@if(b.VeganOnly==true){<span>Quán thuần chay</span>}else if(b.VegetarianOptions==true){<span>Có món chay</span>}@if(b.AccessibleEntrance==true){<span>Lối vào không bậc</span>}</div><div class="pl-offer-preview">@if(h.Services.Count>0){@foreach(var offer in h.Services.Take(2)){<a asp-controller="Explore" asp-action="Detail" asp-route-id="@offer.MaDichVu" asp-route-branchId="@b.Id" asp-route-planId="@planId"><span>@offer.TenDichVu</span><strong>@Labels.Money(offer.GiaThamKhao)<small> / @(offer.DonViGia??"chưa công bố đơn vị")</small></strong></a>}@if(h.Services.Count>2){<small>Và @(h.Services.Count-2) dịch vụ tại cơ sở này</small>}}else{<p class="help">Cơ sở đã công bố; chưa có dịch vụ được duyệt.</p>}</div>}
 else{<p class="pl-source">@if(h.Google!=null){<span class="pl-google-attribution" translate="no">Google Maps</span>}else{<a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap</a>} · Chưa có dịch vụ do nhà cung cấp đăng trên Hành Trình</p>@if(h.Google?.BusinessStatus=="CLOSED_TEMPORARILY"){<p class="notice warning">Google ghi nhận đang tạm đóng.</p>}@foreach(var attribution in h.Google?.Attributions??[]){<small>@if(attribution.Url!=null){<a href="@attribution.Url" target="_blank" rel="noopener noreferrer">@attribution.Name</a>}else{@attribution.Name}</small>}}
 <div class="pl-card-actions">@if(h.Position!=null){<button class="pl-quiet" type="button" data-show-on-map="@h.Key">@Ui.Icon("pin") Trên bản đồ</button>@if(Model.Anchor!=null){<button class="pl-quiet" type="button" data-route-to="@h.Key">Xem đường đến</button>}}@if(h.Branch!=null){<a href="@detailUrl">Xem cơ sở @Ui.Icon("arrow")</a><label class="pl-compare-check"><input type="checkbox" form="compare-branches" name="ids" value="@h.Branch.Id" data-compare-branch/> So sánh</label>}else{<a href="@(h.Google!=null?PlaceText.Around("Google",googleId:h.Google.Id,planId:planId):PlaceText.Around("OpenStreetMap",position:h.Position,name:h.Name,planId:planId))">Tìm quanh nơi này @Ui.Icon("arrow")</a>}</div></div></article>}
 <div class="pl-results-bottom"><form id="compare-branches" method="get" action="/kham-pha/so-sanh">@if(planId!=null){<input type="hidden" name="PlanId" value="@planId"/>}<button class="btn btn-outline" type="submit">So sánh cơ sở <span data-compare-count>đã chọn</span></button><small>Tối đa 3 cơ sở</small></form><p data-compare-status role="status"></p></div>
 @if(Model.Total>20){<nav class="pl-pagination" aria-label="Trang kết quả">@if(f.Page>1){<a class="btn btn-outline" href="@PlaceText.SearchUrl(f,f.Page-1)">← Trước</a>}<span>Trang @f.Page / @((int)Math.Ceiling(Model.Total/20d))</span>@if(f.Page*20<Model.Total){<a class="btn btn-outline" href="@PlaceText.SearchUrl(f,f.Page+1)">Tiếp →</a>}</nav>}
 </div><aside class="pl-map-column"><div class="pl-map-sticky"><div class="pl-map-header"><span>@Ui.Icon("pin") @mapName</span><button class="pl-quiet" type="button" data-search-map-center>Tìm quanh tâm bản đồ</button></div><div class="pl-map pl-search-map" data-search-map aria-label="Bản đồ địa điểm và cơ sở"><div class="pl-map-fallback"><strong>Bản đồ địa điểm</strong><p>Đang tải bản đồ. Bạn có thể xem thông tin cơ sở trong danh sách.</p></div></div><p class="pl-map-status" data-search-map-status role="status"></p><div class="pl-route-panel" data-route-panel hidden role="status"></div><p class="help">Chọn ghim để xem địa điểm. Chạm vào vùng trống để đặt mốc tìm quanh.</p></div></aside></div></section>
 <div hidden data-route-token>@Html.AntiForgeryToken()</div>
 <script type="application/json" data-places-payload>@Html.Raw(JsonSerializer.Serialize(new{anchor=Model.Anchor,mode=f.Mode,hits=Model.Hits.Select(h=>new{h.Key,h.Name,h.Address,h.Position,h.Source})},jsonOptions))</script>
</div>
