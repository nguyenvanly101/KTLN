@model BranchPublicPage
@inject ChatService Chat
@inject PostService BranchPosts
@{var viewerTraveler=User.IsInRole(TravelService.Traveler);var signedIn=User.Identity?.IsAuthenticated==true;var b=Model.Branch;var planId=(ViewBag.TripPlan as KeHoachChuyenDi)?.MaKeHoach;ViewData["Title"]=b.Name;var returnUrl=Context.Request.Query["returnUrl"].ToString();}
<div class="container-wide pl-public-detail"><a class="back" href="@(Url.IsLocalUrl(returnUrl)?returnUrl:Url.Action("Index","Places",new{planId}))">← Quay lại tìm kiếm</a><div class="pl-detail-heading"><div><span class="eyebrow">@DanhMuc.Ten(b.Type) · CƠ SỞ ĐƯỢC CÔNG BỐ</span><h1>@b.Name</h1><p>@Ui.Icon("pin") @b.Address</p><small>Nhà cung cấp: @Model.Provider.TenDonVi · Phiên bản cơ sở được duyệt @b.PublishedVersion</small></div><a class="btn btn-dark" href="@PlaceText.GoogleUrl(b.Name,b.GooglePlaceId,Model.Position)" target="_blank" rel="noopener noreferrer">Mở Google Maps @Ui.Icon("arrow")</a></div>
 <partial name="_TripContext"/>
 <div class="pl-detail-grid"><div class="pl-detail-main"><article><section class="panel"><h2>Thông tin của đúng cơ sở này</h2><partial name="/Views/Branches/_BranchFacts.cshtml" model="BranchFactsModel.From(b)"/><p class="prose">@b.Summary</p><dl class="facts"><div><dt>Số liên hệ cơ sở</dt><dd>@(b.Phone??"Chưa công bố")</dd></div><div><dt>Chỗ đỗ ô tô</dt><dd>@PlaceText.Known(b.Parking)</dd></div><div><dt>Có lựa chọn món chay</dt><dd>@PlaceText.Known(b.VegetarianOptions)</dd></div><div><dt>Quán thuần chay</dt><dd>@PlaceText.Known(b.VeganOnly)</dd></div><div><dt>Lối vào không bậc thang</dt><dd>@PlaceText.Known(b.AccessibleEntrance)</dd></div></dl>@if(b.Website!=null){<a href="@b.Website" target="_blank" rel="noopener noreferrer">Website cơ sở @Ui.Icon("arrow")</a>}<p class="help">Thông tin do nhà cung cấp công bố và được duyệt trên website. Liên kết Google Maps xác định địa điểm; thông tin giá và dịch vụ được công bố riêng bên dưới.</p></section>
 <section class="pl-branch-services"><div class="pl-section-title"><div><span class="eyebrow">ÁP DỤNG TẠI @b.Name</span><h2>@Model.Services.Count dịch vụ tại cơ sở</h2></div></div>@if(Model.Services.Count==0){<div class="panel"><p>Nhà cung cấp chưa có dịch vụ được duyệt tại cơ sở này.</p></div>}@foreach(var service in Model.Services){<article class="panel pl-service-row"><div><span class="eyebrow">@DanhMuc.Ten(service.LoaiDichVu)</span><h3><a asp-controller="Explore" asp-action="Detail" asp-route-id="@service.MaDichVu" asp-route-branchId="@b.Id" asp-route-planId="@planId">@service.TenDichVu</a></h3><partial name="/Views/Shared/_Rating.cshtml" model="(long?)service.MaDichVu"/><p class="prose">@service.MoTa</p><small>Thời gian phục vụ dịch vụ: @(service.ThoiGianPhucVu??"Cần xác nhận")</small></div><div><strong class="pl-service-price">@Labels.Money(service.GiaThamKhao)</strong><small>/ @(service.DonViGia??"chưa công bố đơn vị")</small><a class="btn btn-outline" asp-controller="Explore" asp-action="Detail" asp-route-id="@service.MaDichVu" asp-route-branchId="@b.Id" asp-route-planId="@planId">Xem dịch vụ @Ui.Icon("arrow")</a>@if(!signedIn||viewerTraveler){<a class="btn btn-dark" href="/tin-nhan/co-so/@b.Id?dichVu=@service.MaDichVu">@Ui.Icon("chat") Nhắn tin để đặt</a>}</div></article>}</section></article>
 @{var news=await BranchPosts.PublicBranchPosts(b.Id,3);}
 @if(news.Count>0){<section class="panel pl-branch-news"><h2>Tin mới từ cơ sở</h2>@foreach(var n in news){<article><small class="soc-meta">@Ui.LocalTime(n.CreatedAt).ToString("dd/MM/yyyy")</small><p>@(n.Content.Length>300?n.Content[..300]+"…":n.Content)</p></article>}</section>}
 @if(viewerTraveler)
 {
  <details class="panel wrong-info"><summary>Thông tin chưa đúng? Báo cho cơ sở</summary>
   <form action="/co-so/@b.Id/bao-sai" method="post">@Html.AntiForgeryToken()<div class="field"><label for="wi-field">Thông tin nào chưa đúng</label><select class="form-select" id="wi-field" name="field">@foreach(var f in QaService.WrongFields){<option value="@f.Key">@f.Label</option>}</select></div><div class="field"><label for="wi-detail">Mô tả</label><textarea class="form-control" id="wi-detail" name="detail" rows="3" minlength="5" maxlength="500" required placeholder="Ví dụ: Quán đã đổi giờ mở cửa thành 8:00"></textarea></div><button class="btn btn-outline" type="submit">Gửi báo cáo</button></form></details>
 }
 </div><aside><div class="panel pl-sticky"><h2>Vị trí & dịch vụ quanh cơ sở</h2>@if(Model.Position!=null){<partial name="/Views/Places/_PointMap.cshtml" model="Model.Position"/>}@if(Model.Warning!=null){<p class="notice">@Model.Warning</p>}<p>@b.Address</p>@{var chatInfo=await Chat.PublicInfo(b.Id);}
 @if(!signedIn||viewerTraveler){<div class="chat-cta"><a class="btn btn-dark" href="@(signedIn?"/tin-nhan/co-so/"+b.Id:"/Account/Login?returnUrl="+Uri.EscapeDataString("/tin-nhan/co-so/"+b.Id))" data-branch-chat>@Ui.Icon("chat") Nhắn tin cho cơ sở</a><small>@(chatInfo.Accepting?chatInfo.Eta+(chatInfo.Actual!=null?" · "+chatInfo.Actual:""):"Cơ sở đang tạm ngưng nhận tin nhắn")</small></div>}
 <div class="pl-action-stack"><a class="btn btn-dark" href="@PlaceText.Around("Branch",b.Id,planId:planId)">Tìm quanh cơ sở này</a><a href="@PlaceText.Around("Branch",b.Id,category:"AnUong",planId:planId)">Quán ăn gần đây @Ui.Icon("arrow")</a><a href="@PlaceText.Around("Branch",b.Id,category:"LuuTru",planId:planId)">Khách sạn gần đây @Ui.Icon("arrow")</a><a href="@PlaceText.Around("Branch",b.Id,category:"PhuongTien",planId:planId)">Thuê xe gần đây @Ui.Icon("arrow")</a></div></div></aside></div>
</div>
