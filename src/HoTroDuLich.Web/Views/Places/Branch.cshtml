@model BranchPublicPage
@{var b=Model.Branch;var planId=(ViewBag.TripPlan as KeHoachChuyenDi)?.MaKeHoach;ViewData["Title"]=b.Name;var returnUrl=Context.Request.Query["returnUrl"].ToString();}
<div class="container-wide pl-public-detail"><a class="back" href="@(Url.IsLocalUrl(returnUrl)?returnUrl:Url.Action("Index","Places",new{planId}))">← Quay lại tìm kiếm</a><div class="pl-detail-heading"><div><span class="eyebrow">@DanhMuc.Ten(b.Type) · CƠ SỞ ĐƯỢC CÔNG BỐ</span><h1>@b.Name</h1><p>@Ui.Icon("pin") @b.Address</p><small>Nhà cung cấp: @Model.Provider.TenDonVi · Phiên bản cơ sở được duyệt @b.PublishedVersion</small></div><a class="btn btn-dark" href="@PlaceText.GoogleUrl(b.Name,b.GooglePlaceId,Model.Position)" target="_blank" rel="noopener noreferrer">Mở Google Maps @Ui.Icon("arrow")</a></div>
 <partial name="_TripContext"/>
 <div class="pl-detail-grid"><article><section class="panel"><h2>Thông tin của đúng cơ sở này</h2><p class="prose">@b.Summary</p><dl class="facts"><div><dt>Giờ phục vụ</dt><dd>@(b.Hours??"Chưa công bố")</dd></div><div><dt>Số liên hệ cơ sở</dt><dd>@(b.Phone??"Chưa công bố")</dd></div><div><dt>Chỗ đỗ ô tô</dt><dd>@PlaceText.Known(b.Parking)</dd></div><div><dt>Có lựa chọn món chay</dt><dd>@PlaceText.Known(b.VegetarianOptions)</dd></div><div><dt>Quán thuần chay</dt><dd>@PlaceText.Known(b.VeganOnly)</dd></div><div><dt>Lối vào không bậc thang</dt><dd>@PlaceText.Known(b.AccessibleEntrance)</dd></div></dl>@if(b.Website!=null){<a href="@b.Website" target="_blank" rel="noopener noreferrer">Website cơ sở @Ui.Icon("arrow")</a>}<p class="help">Thông tin do nhà cung cấp công bố và được duyệt trên website. Liên kết Google Maps xác định địa điểm; thông tin giá và dịch vụ được công bố riêng bên dưới.</p></section>
 <section class="pl-branch-services"><div class="pl-section-title"><div><span class="eyebrow">ÁP DỤNG TẠI @b.Name</span><h2>@Model.Services.Count dịch vụ tại cơ sở</h2></div></div>@if(Model.Services.Count==0){<div class="panel"><p>Nhà cung cấp chưa có dịch vụ được duyệt tại cơ sở này.</p></div>}@foreach(var service in Model.Services){<article class="panel pl-service-row"><div><span class="eyebrow">@DanhMuc.Ten(service.LoaiDichVu)</span><h3><a asp-controller="Explore" asp-action="Detail" asp-route-id="@service.MaDichVu" asp-route-branchId="@b.Id" asp-route-planId="@planId">@service.TenDichVu</a></h3><p class="prose">@service.MoTa</p><small>Thời gian phục vụ dịch vụ: @(service.ThoiGianPhucVu??"Cần xác nhận")</small></div><div><strong class="pl-service-price">@Labels.Money(service.GiaThamKhao)</strong><small>/ @(service.DonViGia??"chưa công bố đơn vị")</small><a class="btn btn-outline" asp-controller="Explore" asp-action="Detail" asp-route-id="@service.MaDichVu" asp-route-branchId="@b.Id" asp-route-planId="@planId">Xem dịch vụ @Ui.Icon("arrow")</a></div></article>}</section></article>
 <aside><div class="panel pl-sticky"><h2>Vị trí & dịch vụ quanh cơ sở</h2>@if(Model.Position!=null){<partial name="/Views/Places/_PointMap.cshtml" model="Model.Position"/>}@if(Model.Warning!=null){<p class="notice">@Model.Warning</p>}<p>@b.Address</p><div class="pl-action-stack"><a class="btn btn-dark" href="@PlaceText.Around("Branch",b.Id,planId:planId)">Tìm quanh cơ sở này</a><a href="@PlaceText.Around("Branch",b.Id,category:"AnUong",planId:planId)">Quán ăn gần đây @Ui.Icon("arrow")</a><a href="@PlaceText.Around("Branch",b.Id,category:"LuuTru",planId:planId)">Khách sạn gần đây @Ui.Icon("arrow")</a><a href="@PlaceText.Around("Branch",b.Id,category:"PhuongTien",planId:planId)">Thuê xe gần đây @Ui.Icon("arrow")</a></div></div></aside></div>
</div>
