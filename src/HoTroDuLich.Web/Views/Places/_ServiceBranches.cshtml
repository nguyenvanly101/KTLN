@model DichVuDuLich
@inject HoTroDuLich.Web.Data.AppDbContext BranchDb
@inject BranchService Branches
@using Microsoft.EntityFrameworkCore
@{var planId=(ViewBag.TripPlan as KeHoachChuyenDi)?.MaKeHoach;var ids=BranchDb.Set<DichVuCoSo>().Where(x=>x.ServiceId==Model.MaDichVu).Select(x=>x.BranchId);var rows=await Branches.PublicBranches().AsNoTracking().Where(x=>ids.Contains(x.Id)&&x.ProviderId==Model.MaNhaCungCap).OrderBy(x=>x.Name).ToListAsync();var selected=long.TryParse(Context.Request.Query["branchId"],out var branchId)?branchId:0;}
@if(rows.Count>0){<section class="panel pl-service-branches"><span class="eyebrow">CƠ SỞ ÁP DỤNG DỊCH VỤ</span><h2>Đúng chi nhánh, đúng địa chỉ</h2>@foreach(var b in rows){<div class="pl-service-branch @(b.Id==selected?"selected":"")"><div><strong><a asp-controller="Places" asp-action="Branch" asp-route-id="@b.Id" asp-route-planId="@planId">@b.Name</a></strong><p>@b.Address</p>@if(b.Id==selected){<span class="badge">Cơ sở bạn đang xem</span>}</div><div><a asp-controller="Places" asp-action="Branch" asp-route-id="@b.Id" asp-route-planId="@planId">Thông tin cơ sở @Ui.Icon("arrow")</a><a href="@PlaceText.GoogleUrl(b.Name,b.GooglePlaceId,b.LocationSource=="Provider"&&b.Latitude!=null&&b.Longitude!=null?new(b.Latitude.Value,b.Longitude.Value):null)" target="_blank" rel="noopener noreferrer">Google Maps</a></div></div>}<p class="help">Dịch vụ này áp dụng tại các cơ sở trên. Kiểm tra chi nhánh cụ thể khi gửi yêu cầu.</p></section>}
