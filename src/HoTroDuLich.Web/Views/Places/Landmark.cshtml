@model MocDiaDiem
@{ViewData["Title"]=Model.Name;var planId=(ViewBag.TripPlan as KeHoachChuyenDi)?.MaKeHoach;var children=ViewBag.Children as List<MocDiaDiem>??[];var parent=ViewBag.Parent as MocDiaDiem;var pos=ViewBag.Position as MapPosition;}
<div class="container-wide pl-public-detail"><a class="back" asp-controller="Places" asp-action="Index" asp-route-planId="@planId">← Địa điểm & dịch vụ</a><div class="pl-detail-heading"><div><span class="eyebrow">@(Model.Type=="Entrance"?"CỬA VÀO / ĐIỂM TIẾP CẬN":"ĐỊA ĐIỂM")</span><h1>@Model.Name</h1><p>@Ui.Icon("pin") @Model.Address</p>@if(parent!=null){<a asp-controller="Places" asp-action="Landmark" asp-route-id="@parent.Id" asp-route-planId="@planId">Thuộc @parent.Name @Ui.Icon("arrow")</a>}</div><a class="btn btn-dark" href="@PlaceText.Around("Landmark",Model.Id,planId:planId)">Tìm quanh địa điểm này @Ui.Icon("arrow")</a></div>
 <partial name="_TripContext"/>
 <div class="pl-detail-grid"><article><section class="panel"><h2>Thông tin cần biết</h2><p class="prose">@Model.Summary</p><dl class="facts"><div><dt>Giờ hoạt động</dt><dd>@(Model.Hours??"Chưa công bố — cần xác nhận trước khi đến")</dd></div><div><dt>Thông tin chi phí</dt><dd>@(Model.Fees??"Chưa có thông tin giá được kiểm tra")</dd></div></dl><p class="help">Nguồn: @Model.SourceName · Kiểm tra @Model.CheckedOn.ToString("dd/MM/yyyy")</p>@if(Model.SourceUrl!=null){<a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer">Đối chiếu nguồn thông tin @Ui.Icon("arrow")</a>}</section>
 @if(children.Count>0){<section class="panel"><h2>Cửa vào & các mốc thuộc địa điểm</h2><div class="pl-landmark-links">@foreach(var l in children){<a asp-controller="Places" asp-action="Landmark" asp-route-id="@l.Id" asp-route-planId="@planId">@Ui.Icon("pin")<span><strong>@l.Name</strong><small>@l.Address</small></span>@Ui.Icon("arrow")</a>}</div><p class="help">Chọn đúng cửa vào hoặc mốc bạn muốn đến để tìm dịch vụ và đường đi quanh vị trí đó.</p></section>}</article>
 <aside><div class="panel pl-sticky">@if(pos!=null){<partial name="/Views/Places/_PointMap.cshtml" model="pos"/>}@if(ViewData["MapWarning"]!=null){<p class="notice">@ViewData["MapWarning"]</p>}<a href="@PlaceText.GoogleUrl(Model.Name,Model.GooglePlaceId,pos)" target="_blank" rel="noopener noreferrer">Mở vị trí Google Maps @Ui.Icon("arrow")</a><h2>Tìm quanh @Model.Name</h2><div class="pl-action-stack"><a href="@PlaceText.Around("Landmark",Model.Id,category:"AnUong",planId:planId)">Quán ăn gần đây @Ui.Icon("arrow")</a><a href="@PlaceText.Around("Landmark",Model.Id,category:"LuuTru",planId:planId)">Khách sạn gần đây @Ui.Icon("arrow")</a><a href="@PlaceText.Around("Landmark",Model.Id,category:"PhuongTien",planId:planId)">Thuê xe gần đây @Ui.Icon("arrow")</a><a href="@PlaceText.Around("Landmark",Model.Id,category:"Parking",planId:planId)">Bãi đỗ xe gần đây @Ui.Icon("arrow")</a></div></div></aside></div>
</div>
