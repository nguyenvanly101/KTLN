@model LandmarkInput
@{ViewData["Title"]=Model.Id==0?"Thêm mốc địa điểm":"Cập nhật mốc địa điểm";var landmarks=(ViewBag.Landmarks as List<MocDiaDiem>??[]).Where(x=>x.Type=="Point"&&x.ParentId==null).ToList();}
<div class="container-wide pl-manage"><a class="back" href="/quan-tri/moc-dia-diem">← Địa điểm & cửa vào</a><div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Ghi đúng vị trí mốc hoặc cửa vào. Thông tin được công bố kèm nguồn kiểm tra.</p></div></div>
 <form method="post" action="/quan-tri/moc-dia-diem/luu" class="panel pl-editor">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><partial name="/Views/Branches/_MapLocationForm.cshtml" model="Model"/>
 <div class="form-grid"><div class="field"><label asp-for="Type">Loại mốc</label><select class="form-select" asp-for="Type"><option value="Point">Điểm tham quan / địa điểm</option><option value="Entrance">Cửa vào / điểm tiếp cận</option></select></div><div class="field"><label asp-for="ParentId">Thuộc địa điểm chính (nếu có)</label><select class="form-select" asp-for="ParentId"><option value="">Mốc độc lập</option>@foreach(var l in landmarks.Where(x=>x.Id!=Model.Id)){<option value="@l.Id">@l.Name</option>}</select><span asp-validation-for="ParentId"></span></div><div class="field full"><label asp-for="Summary">Thông tin giới thiệu và lưu ý tại mốc</label><textarea class="form-control" asp-for="Summary" maxlength="2000"></textarea></div><div class="field"><label asp-for="Hours">Giờ mở cửa / giờ nhận khách cuối</label><input class="form-control" asp-for="Hours" maxlength="300"/></div><div class="field"><label asp-for="Fees">Thông tin vé / chi phí và đơn vị</label><textarea class="form-control" asp-for="Fees" maxlength="1000"></textarea></div><div class="field"><label asp-for="SourceName">Nguồn đã đối chiếu</label><input class="form-control" asp-for="SourceName" maxlength="200"/><span asp-validation-for="SourceName"></span></div><div class="field"><label asp-for="SourceUrl">Đường dẫn nguồn (HTTPS)</label><input class="form-control" asp-for="SourceUrl" maxlength="500" type="url"/><span asp-validation-for="SourceUrl"></span></div><div class="field"><label asp-for="CheckedOn">Ngày kiểm tra thông tin</label><input class="form-control" asp-for="CheckedOn" type="date"/><span asp-validation-for="CheckedOn"></span></div><label class="pl-check"><input asp-for="IsPublished"/> Công bố mốc địa điểm</label></div><div class="form-actions"><button class="btn btn-dark" type="submit">Lưu mốc địa điểm @Ui.Icon("arrow")</button></div>
 </form>
</div>
