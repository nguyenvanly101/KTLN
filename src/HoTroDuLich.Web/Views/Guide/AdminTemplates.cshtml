@model List<TemplateCard>
@{ViewData["Title"]="Lịch trình mẫu (quản trị)";}
<div class="container-wide">
 <div class="page-head"><div><span class="eyebrow">NỘI DUNG</span><h1>Lịch trình mẫu</h1><p>Soạn lịch trình cho khách chép về kế hoạch.</p></div><a class="btn btn-dark" href="/quan-tri/lich-mau/soan">+ Soạn lịch mới</a></div>
 @if(Model.Count==0){<div class="empty"><h2>Chưa có lịch trình mẫu</h2></div>}
 else{<div class="panel table-wrap"><table class="table"><thead><tr><th>Lịch trình</th><th>Điểm đến</th><th>Ngày</th><th>Trạng thái</th><th>Lượt dùng</th><th></th></tr></thead><tbody>
 @foreach(var c in Model){<tr><td><b>@c.Template.Title</b></td><td>@c.Destination</td><td>@c.Template.Days</td><td><span class="badge">@(c.Template.Status=="Published"?"Đã công bố":"Bản nháp")</span></td><td>@c.Template.Uses</td>
  <td class="actions"><a class="btn btn-outline" href="/quan-tri/lich-mau/soan?id=@c.Template.Id">Sửa</a>@if(c.Template.Status=="Published"){<a class="text-link" href="/lich-mau/@c.Template.Id">Xem</a>}
  <form action="/quan-tri/lich-mau/xoa" method="post" onsubmit="return confirm('Xóa lịch trình mẫu này?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Template.Id"/><button class="btn btn-outline" type="submit">Xóa</button></form></td></tr>}
 </tbody></table></div>}
</div>
