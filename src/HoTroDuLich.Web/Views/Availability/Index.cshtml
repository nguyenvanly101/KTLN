@model AvailabilityPage
@{ViewData["Title"]="Lịch phục vụ · "+Model.Service.TenDichVu;var service=Model.Service;var trip=ViewBag.TripPlan as KeHoachChuyenDi;var canRequest=(User.Identity?.IsAuthenticated!=true||User.IsInRole(TravelService.Traveler))&&service.TrangThaiTiepNhan==TrangThaiTiepNhan.TiepNhan;var route=Model.Manage?"/Availability/Manage":"/Availability";var count=DateTime.DaysInMonth(Model.Month.Year,Model.Month.Month);var byDay=Model.Days.ToDictionary(x=>x.Ngay);}
<div class="container-wide journey-page"><a class="back" href="@(Model.Manage?"/Provider":"/Explore/Detail/"+service.MaDichVu+(trip!=null?"?planId="+trip.MaKeHoach:""))">← @(Model.Manage?"Dịch vụ của tôi":service.TenDichVu)</a><partial name="/Views/Shared/_TripContext.cshtml"/><header class="product-heading"><div><span class="eyebrow">@(Model.Manage?"ĐỐI TÁC / LỊCH PHỤC VỤ":"CHỌN NGÀY CHO TRẢI NGHIỆM")</span><h1>@service.TenDichVu</h1><p>Lịch phục vụ theo ngày · Giá tham khảo @Labels.Money(service.GiaThamKhao) / @(service.DonViGia??"đơn vị chưa công bố")</p></div>@if(Model.Manage){<a class="btn btn-dark" href="#calendar-form">@Ui.Icon("calendar") Cập nhật ngày phục vụ</a>}else if(canRequest){<a class="btn btn-dark" asp-controller="Bookings" asp-action="Create" asp-route-id="@service.MaDichVu" asp-route-planId="@trip?.MaKeHoach">Chọn ngày và gửi yêu cầu</a>}</header><form class="day-picker" action="@route" method="get"><input type="hidden" name="serviceId" value="@service.MaDichVu"/>@if(trip!=null){<input type="hidden" name="planId" value="@trip.MaKeHoach"/>}<label for="calendar-month">Tháng muốn xem</label><input class="form-control" type="month" name="month" id="calendar-month" value="@Model.Month.ToString("yyyy-MM")" required/><button class="btn btn-outline" type="submit">Xem tháng</button></form><div class="calendar-legend"><span class="calendar-open">Đang tiếp nhận</span><span class="calendar-closed">Tạm ngừng</span><span>Chưa cập nhật</span></div><p class="help">Ngày chưa cập nhật không có nghĩa là còn chỗ. Số lượng là tham khảo; yêu cầu chỉ được xác nhận theo điều kiện hai bên đồng ý. Lưu trú tính các đêm, không tính ngày trả phòng nếu ngày trả sau ngày nhận.</p>
@if(service.TrangThaiTiepNhan!=TrangThaiTiepNhan.TiepNhan){<div class="notice warning">Dịch vụ hiện không tiếp nhận yêu cầu mới.</div>}
<div class="@(Model.Manage?"journey-calendar-layout":"")"><section><h2>Tháng @Model.Month.ToString("MM/yyyy")</h2><div class="service-calendar">@for(var n=0;n<count;n++){var date=Model.Month.AddDays(n);var entry=byDay.GetValueOrDefault(date);var state=entry==null?"Chưa cập nhật":entry.TiepNhan?"Đang tiếp nhận":"Tạm ngừng";<article class="calendar-day @(entry==null?"":entry.TiepNhan?"calendar-open":"calendar-closed")"><div><strong>@date.ToString("dd")</strong><span>@date.ToString("ddd",System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</span></div><p>@state</p>@if(entry?.SoLuongThamKhao is int quantity&&entry.TiepNhan){<small>@quantity @(service.DonViGia??"đơn vị") (tham khảo)</small>}@if(!string.IsNullOrWhiteSpace(entry?.GhiChu)){<small>@entry.GhiChu</small>}@if(Model.Manage){<small>@Model.Confirmed.GetValueOrDefault(date) yêu cầu đã xác nhận</small>@if(date>=TravelService.Today&&date<=TravelService.Today.AddYears(1)){<a class="text-link" href="/Availability/Manage?serviceId=@service.MaDichVu&month=@Model.Month.ToString("yyyy-MM")&edit=@date.ToString("yyyy-MM-dd")#calendar-form">Cập nhật<span class="sr-only"> ngày @date.ToString("dd/MM/yyyy")</span></a>}}</article>}</div></section>
@if(Model.Manage&&Model.Input is AvailabilityInput input){<aside class="panel product-form-panel" id="calendar-form"><h2>Cập nhật một ngày</h2><form action="/Availability/Save" method="post">@Html.AntiForgeryToken()<partial name="/Views/Shared/_JourneyErrors.cshtml"/><input type="hidden" name="Id" value="@input.Id"/><input type="hidden" name="ServiceId" value="@service.MaDichVu"/>@if(input.Id>0){<input type="hidden" name="Version" value="@input.Version"/>}<div class="field"><label for="Date">Ngày phục vụ</label><input class="form-control" name="Date" id="Date" type="date" value="@input.Date.ToString("yyyy-MM-dd")" min="@TravelService.Today.ToString("yyyy-MM-dd")" max="@TravelService.Today.AddYears(1).ToString("yyyy-MM-dd")" readonly="@(input.Id>0)" required/></div><label class="product-checkbox"><input name="IsOpen" type="checkbox" value="true" checked="@input.IsOpen"/> Tiếp nhận yêu cầu trong ngày này</label><input type="hidden" name="IsOpen" value="false"/><div class="field"><label for="Capacity">Số lượng tham khảo (tùy chọn)</label><input class="form-control" id="Capacity" name="Capacity" type="number" min="1" max="10000" value="@input.Capacity"/></div><div class="field"><label for="Note">Ghi chú hiển thị cho khách (tùy chọn)</label><textarea class="form-control" name="Note" id="Note" maxlength="300">@input.Note</textarea></div><p class="help">Bỏ chọn tiếp nhận để tạm ngừng nhận yêu cầu mới. Những yêu cầu đã xác nhận vẫn giữ nguyên.</p><button class="btn btn-dark" type="submit">Lưu lịch phục vụ</button></form>@if(input.Id>0){<form class="calendar-reset" action="/Availability/Remove" method="post" data-confirm="Đưa ngày này về chưa cập nhật?">@Html.AntiForgeryToken()<input type="hidden" name="serviceId" value="@service.MaDichVu"/><input type="hidden" name="Id" value="@input.Id"/><input type="hidden" name="Version" value="@input.Version"/><button class="quiet-button" type="submit">Đưa về chưa cập nhật</button></form>}</aside>}
</div>@if(!Model.Manage){<div class="calendar-book-action">@if(canRequest){<a class="btn btn-dark" asp-controller="Bookings" asp-action="Create" asp-route-id="@service.MaDichVu" asp-route-planId="@trip?.MaKeHoach">Chọn ngày và gửi yêu cầu</a>}<a class="text-link" asp-controller="Explore" asp-action="Detail" asp-route-id="@service.MaDichVu" asp-route-planId="@trip?.MaKeHoach">Xem thông tin dịch vụ</a></div>}</div>
