@model ServiceInput
@{ViewData["Title"]=Model.Id==0?"Thêm dịch vụ":"Cập nhật dịch vụ";var canSubmit=(bool)ViewBag.CanSubmit;var history=ViewBag.History as List<BanCapNhatDichVu>??[];}<div class="container-narrow"><a class="back" href="/Provider">← Dịch vụ của tôi</a><div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Gửi thông tin mới để quản trị viên xét duyệt. Nội dung hiện tại vẫn hiển thị trong thời gian chờ.</p></div><div class="actions"></div></div>@if(!canSubmit){<div class="notice warning">Bạn chỉ có thể gửi đăng hoặc cập nhật dịch vụ sau khi đã được xác minh và đang có quyền hoạt động. <a href="/Provider/Verification">Xem hồ sơ nhà cung cấp</a></div>}else{<div class="panel"><form action="/Provider/Edit" method="post" enctype="multipart/form-data" >@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" asp-for="Id"/>@if(Model.Id>0){<input type="hidden" asp-for="Version"/>}<partial name="/Views/Branches/_ServiceBranchSelector.cshtml" model="Model"/><div class="form-grid"><div class="field"><label asp-for="Name">Tên dịch vụ</label><input class="form-control" asp-for="Name" type="text" /><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Type">Loại dịch vụ</label><select class="form-select" asp-for="Type">@foreach(var type in DanhMuc.LoaiDichVu){<option value="@type">@DanhMuc.Ten(type)</option>}</select></div><input type="hidden" name="Region" value="@(string.IsNullOrWhiteSpace(Model.Region)?"Theo cơ sở áp dụng":Model.Region)"/><input type="hidden" asp-for="PlaceId"/><div class="field"><label asp-for="Price">Giá tham khảo (₫)</label><input class="form-control" asp-for="Price" type="number" min="0"/><span asp-validation-for="Price"></span></div><div class="field"><label asp-for="Hours">Thời gian phục vụ</label><input class="form-control" asp-for="Hours" type="text" /><span asp-validation-for="Hours"></span></div><div class="field full"><label asp-for="Description">Mô tả dịch vụ</label><textarea class="form-control" asp-for="Description"></textarea><span asp-validation-for="Description"></span></div><div class="field full"><label asp-for="Terms">Điều kiện phục vụ</label><textarea class="form-control" asp-for="Terms"></textarea><span asp-validation-for="Terms"></span></div><div class="full"><h3>Tạm ngừng phục vụ (nếu có)</h3></div><div class="field"><label asp-for="PauseFrom">Tạm ngừng từ</label><input class="form-control" asp-for="PauseFrom" type="date" /><span asp-validation-for="PauseFrom"></span></div><div class="field"><label asp-for="PauseTo">Tạm ngừng đến</label><input class="form-control" asp-for="PauseTo" type="date" /><span asp-validation-for="PauseTo"></span></div><div class="field full"><label asp-for="PauseReason">Lý do tạm ngừng</label><textarea class="form-control" asp-for="PauseReason"></textarea><span asp-validation-for="PauseReason"></span></div></div><partial name="/Views/Provider/_ServiceDetailsForm.cshtml" model="Model"/><div class="form-actions"><button class="btn btn-dark" type="submit" name="Operation" value="GuiDang" disabled="@(history.Any(x=>x.TrangThaiDuyet.ToString()=="ChoDuyet"))">Gửi xét duyệt ↗</button>@if(history.Count==0){<button class="btn btn-outline" type="submit" name="Operation" value="LuuNhap">Lưu bản nháp</button>}</div></form></div>}@if(history.Count>0){<h2>Lịch sử phiên bản</h2>@foreach(var v in history){<div class="panel"><span class="eyebrow">PHIÊN BẢN @v.SoPhienBan · @Ui.LocalTime(v.ThoiDiemGui).ToString("dd/MM/yyyy")</span><h3>@v.TenDichVu</h3><span class="badge @Labels.Badge(v.TrangThaiDuyet.ToString())">@Labels.Status(v.TrangThaiDuyet.ToString())</span><p class="help mt-3">@v.LyDo</p><details><summary>Xem nội dung phiên bản</summary><p class="prose">@v.MoTa</p><p>@Labels.Money(v.GiaThamKhao) · @v.KhuVucPhucVu</p><p class="prose">@v.DieuKienPhucVu</p><partial name="/Views/Provider/_ServiceRevisionDetails.cshtml" model="v"/></details></div>}}</div>