@model List<(HoSoXacMinhNhaCungCap Profile,NhaCungCapDichVu Provider,List<TaiLieuXacMinh> Files,List<QuyetDinhXacMinh> Decisions)>
@{ViewData["Title"]="Hồ sơ xác minh";var p=(NhaCungCapDichVu)ViewBag.Provider;}
<div class="container-narrow"><div class="page-head"><div><span class="eyebrow">HỒ SƠ NHÀ CUNG CẤP</span><h1>Hồ sơ xác minh</h1><p>@p.TenDonVi · @p.EmailLienHe</p></div></div>
<div class="notice">Trạng thái xác minh: <b>@Labels.Status(p.TrangThaiXacMinh.ToString())</b>. Theo dõi kết quả kiểm tra hồ sơ và bổ sung tài liệu tại đây.</div>
<h2 class="workspace-section-title mb-4">Hồ sơ và kết quả xác minh</h2>
@if(Model.Count==0){<div class="empty"><h3>Chưa có hồ sơ xác minh</h3><p>Hồ sơ đăng ký nhà cung cấp sẽ xuất hiện tại đây.</p></div>}
@if(p.TrangThaiXacMinh.ToString()=="DaThuHoi"){<div class="panel"><h3>Nộp hồ sơ xác minh lại</h3><form action="/Provider/Reapply" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@TravelService.Token(p.RowVersion)"/><div class="field"><label for="reapply-text">Nội dung hồ sơ mới</label><textarea id="reapply-text" name="Text" class="form-control" required maxlength="2000"></textarea></div><div class="field mt-3"><label for="reapply-files">Tài liệu xác minh</label><input id="reapply-files" name="Documents" class="form-control" type="file" multiple accept=".pdf,.jpg,.png"/></div><button class="btn btn-dark mt-3">Gửi xác minh lại</button></form></div>}@foreach(var item in Model){var h=item.Profile;<div class="panel"><span class="eyebrow">HỒ SƠ #@h.MaHoSo · LẦN BỔ SUNG @h.SoLanBoSung</span><span class="badge @Labels.Badge(h.TrangThaiXuLy.ToString())">@Labels.Status(h.TrangThaiXuLy.ToString())</span><p class="prose mt-3">@h.NoiDungDangKy</p>@foreach(var f in item.Files){<a class="help" href="/Account/Download?kind=verification&id=@f.MaTaiLieu">↓ @f.TenTepGoc</a>}@foreach(var d in item.Decisions){<div class="notice">@Labels.Status(d.KetQua.ToString()) · @d.LyDo @d.KetQuaXacMinh</div>}@if(new[]{"CanBoSung","TuChoi"}.Contains(h.TrangThaiXuLy.ToString())){<form action="/Provider/Supplement" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" name="Id" value="@h.MaHoSo"/><input type="hidden" name="Version" value="@TravelService.Token(h.RowVersion)"/><div class="field full"><label for="field-Text-1">Nội dung bổ sung / hồ sơ nộp lại</label><textarea id="field-Text-1" name="Text" class="form-control" maxlength="2000"></textarea></div><div class="field full mt-3"><label for="field-Documents-2">Tài liệu đính kèm</label><input id="field-Documents-2" class="form-control" type="file" name="Documents" multiple accept=".pdf,.png,.jpg,.jpeg"/><small>Tối đa 5 tệp · 5 MB/tệp · PDF/JPG/PNG</small></div><div class="field"><label for="representative-new">Người đại diện (khi nộp hồ sơ mới)</label><input id="representative-new" class="form-control" name="Representative" maxlength="100" value="@p.NguoiLienHe"/></div><div class="form-actions"><button class="btn btn-dark" type="submit">Gửi hồ sơ để xác minh lại</button></div></form>}</div>}</div>