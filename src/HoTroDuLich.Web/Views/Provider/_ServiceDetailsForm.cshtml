@model ServiceInput
<fieldset class="service-detail-fields"><legend>Thông tin để khách dễ lựa chọn</legend><div class="form-grid"><input type="hidden" asp-for="Address"/><p class="help full">Địa chỉ và vị trí bản đồ lấy theo cơ sở áp dụng đã chọn.</p><div class="field"><label asp-for="PriceUnit">Đơn vị của giá tham khảo</label><input class="form-control" asp-for="PriceUnit" maxlength="50" placeholder="Ví dụ: phòng/đêm, người/lượt, xe/ngày"/><span asp-validation-for="PriceUnit"></span></div><div class="field full"><label asp-for="CancellationPolicy">Chính sách thay đổi / hủy</label><textarea class="form-control" asp-for="CancellationPolicy" maxlength="2000" placeholder="Thời hạn báo trước, chi phí hoặc điều kiện hoàn tiền nếu có"></textarea><span asp-validation-for="CancellationPolicy"></span></div><div class="field full"><label asp-for="Photos">Ảnh thực tế của dịch vụ</label><input class="form-control" asp-for="Photos" type="file" multiple accept="image/jpeg,image/png"/><span asp-validation-for="Photos"></span><small>Tối đa 5 ảnh JPG/PNG, mỗi ảnh 5 MB. Chỉ tải ảnh bạn có quyền sử dụng. Bộ ảnh mới thay bộ ảnh của bản cập nhật và được công bố sau khi duyệt.</small></div></div>
@if(Ui.ServicePhotos(Model.PhotoPaths).Length>0){<p class="help">Đã có @Ui.ServicePhotos(Model.PhotoPaths).Length ảnh. Không chọn ảnh mới sẽ giữ bộ ảnh này.</p><label class="product-checkbox"><input asp-for="RemovePhotos"/> Gỡ bộ ảnh trong bản cập nhật này</label>}
<p class="help">Nếu biểu mẫu báo lỗi, các trường văn bản được giữ; chọn lại tệp ảnh trước khi gửi.</p></fieldset>
