@model List<DichVuDuLich>
@{
 ViewData["Title"]="Quản lý dịch vụ";
 var p=(NhaCungCapDichVu)ViewBag.Provider;
 var canSubmit=(bool)ViewBag.CanSubmit;
}
<div class="container-wide">
 <header class="prov-head"><div><h1>Dịch vụ của cơ sở</h1><p class="prov-head-meta">@p.TenDonVi · Xác minh: <b>@Labels.Status(p.TrangThaiXacMinh.ToString())</b> · Quyền hoạt động: <b>@Labels.Status(p.TrangThaiQuyenHoatDong.ToString())</b> · <a href="/Provider/Verification">Hồ sơ xác minh</a> · <a href="/Provider/Rights">Quyền hoạt động</a></p></div>@if(canSubmit){<a class="btn btn-dark" href="/Provider/Edit">@Ui.Icon("plus") Thêm dịch vụ</a>}</header>


 @if(Model.Count>0){<div class="stats compact-stats"><div class="stat">@Ui.Icon("grid")<small>Tất cả dịch vụ</small><strong>@Model.Count</strong></div><div class="stat">@Ui.Icon("compass")<small>Đang công bố</small><strong>@Model.Count(s=>s.TrangThaiCongBo.ToString()=="DaDuyet")</strong></div><div class="stat">@Ui.Icon("clock")<small>Chưa từng được duyệt</small><strong>@Model.Count(s=>s.PhienBanCongBo==null)</strong></div></div>}
 @if((int)(ViewBag.Unlinked??0)>0){<div class="notice warning">Có @ViewBag.Unlinked dịch vụ chưa thuộc cơ sở nào nên không hiện ở đâu cả. <form action="/Provider/AttachUnlinked" method="post" class="inline-form">@Html.AntiForgeryToken()<button class="btn btn-outline" type="submit">Gắn vào cơ sở đang chọn</button></form></div>}
 <div class="section-head"><div><h2 class="workspace-section-title">Danh mục dịch vụ của bạn</h2><p>Thêm, sửa, gỡ dịch vụ ở một nơi. Giá, giờ và điều kiện có hiệu lực ngay; tên, mô tả, ảnh cần quản trị viên duyệt.</p></div></div>
 @if(Model.Count==0){<div class="empty">@Ui.Icon("grid")<h3>Chưa có dịch vụ nào</h3><p>@(canSubmit?"Giới thiệu dịch vụ đầu tiên để khách bắt đầu khám phá.":"Hoàn tất xác minh nhà cung cấp để gửi dịch vụ đầu tiên.")</p><a class="btn btn-dark" href="@(canSubmit?"/Provider/Edit":"/Provider/Verification")">@(canSubmit?"Thêm dịch vụ":"Xem hồ sơ xác minh")</a></div>}
 @foreach(var s in Model){
  <div class="list-card managed-service"><div class="managed-service-main"><img class="managed-service-thumb" src="@Ui.ProviderImage(s)" alt="@Ui.ServiceImageLabel(s) · @s.TenDichVu" loading="lazy" width="196" height="176"/><div><span class="badge @Labels.Badge(s.TrangThaiCongBo.ToString())">@Labels.Status(s.TrangThaiCongBo.ToString())</span>@if(s.TrangThaiCongBo.ToString()=="DaDuyet"&&ViewBag.PublicIds is HashSet<long> pub&&!pub.Contains(s.MaDichVu)){<span class="badge badge-warning" title="Cơ sở của dịch vụ chưa được duyệt hoặc đang ẩn">Khách chưa thấy: cơ sở chưa công khai</span>}<h3>@s.TenDichVu</h3><p>@s.KhuVucPhucVu · @DanhMuc.Ten(s.LoaiDichVu) · @Labels.Money(s.GiaThamKhao)</p><span class="help">@Labels.Status(s.TrangThaiTiepNhan.ToString()) · Phiên bản công bố @(s.PhienBanCongBo?.ToString()??"chưa có")</span></div></div><div class="actions managed-actions"><a href="/Provider/Edit/@s.MaDichVu" class="btn btn-dark">@(canSubmit?"Chỉnh sửa":"Xem lịch sử")</a><a class="btn btn-outline" href="/Availability/Manage?serviceId=@s.MaDichVu">Lịch phục vụ</a><a class="btn btn-outline" href="/Reviews/Partner?serviceId=@s.MaDichVu">Đánh giá</a><form action="/Provider/Delete" method="post" onsubmit="return confirm('Gỡ dịch vụ này khỏi danh mục?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@s.MaDichVu"/><button class="managed-remove" type="submit">Gỡ dịch vụ</button></form></div></div>
 }
</div>
