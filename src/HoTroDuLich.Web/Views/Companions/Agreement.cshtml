@model List<ThoaThuanDongHanh>
@inject TravelService Travel
@{ViewData["Title"]="Thỏa thuận đồng hành";var c=(DeNghiKetNoiDongHanh)ViewBag.Connection;var form=ViewBag.Form as AgreementInput;var active=Model.SingleOrDefault(x=>x.TrangThai.ToString()=="DaXacNhan");var pending=Model.SingleOrDefault(x=>x.TrangThai.ToString()=="ChoXacNhan");var ended=Model.Any(x=>x.TrangThai.ToString() is "DaNgung" or "MotBenDaRut");}
<div class="container-narrow"><a class="back" href="/dong-hanh/de-nghi">← Kết nối của tôi</a><div class="page-head"><div><span class="eyebrow">LÊN KẾ HOẠCH CÙNG NHAU</span><h1>Thỏa thuận đồng hành</h1><p>Mỗi đề xuất có phiên bản riêng. Nội dung đã thống nhất tiếp tục có hiệu lực trong lúc chờ sửa đổi.</p></div>@if(form!=null){<a class="btn btn-dark" href="/dong-hanh/thoa-thuan/mo-tao-thoa-thuan?maKetNoi=@c.MaDeNghi">@(pending!=null?"Đề xuất nội dung khác":active!=null?"Đề nghị sửa thỏa thuận":"Tạo thỏa thuận")</a>}</div>
@if(ended){<div class="notice">Thỏa thuận đã kết thúc. Bạn có thể xem lại toàn bộ lịch sử bên dưới.</div>}
@if(active!=null&&!ended){<div class="panel"><h2>Thao tác với thỏa thuận đang hiệu lực</h2><form action="/dong-hanh/thoa-thuan/rut" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@active.MaThoaThuan"/><input type="hidden" name="ConnectionId" value="@c.MaDeNghi"/><input type="hidden" name="Version" value="@TravelService.Token(active.RowVersion)"/><div class="field"><label for="withdraw-reason">Lý do rút (tùy chọn)</label><input id="withdraw-reason" class="form-control" name="Reason" maxlength="500"/></div><div class="form-actions"><button class="btn btn-danger" type="submit">Rút khỏi đồng hành</button></div></form>@if(pending==null){<form action="/dong-hanh/thoa-thuan/de-nghi-ngung" method="post">@Html.AntiForgeryToken()<input type="hidden" name="ConnectionId" value="@c.MaDeNghi"/><input type="hidden" name="BaseVersion" value="@(Model.FirstOrDefault()?.PhienBan??0)"/><div class="form-actions"><button class="btn btn-outline" type="submit">Đề nghị hai bên cùng ngừng</button></div></form>}<p class="help">Rút có hiệu lực ngay. Cùng ngừng cần bên còn lại xác nhận.</p></div>}
@if(Model.Count==0){<div class="empty">@Ui.Icon("compass")<h2>Bắt đầu bằng một đề xuất</h2><p>Thống nhất điểm đến, thời gian, ngân sách và phạm vi đi cùng.</p></div>}
@foreach(var t in Model){<article class="panel"><span class="eyebrow">PHIÊN BẢN @t.PhienBan · @Labels.Status(t.LoaiPhienBan.ToString())</span><h2>@t.NoiDen</h2><span class="badge @Labels.Badge(t.TrangThai.ToString())">@Labels.Status(t.TrangThai.ToString())</span><dl class="facts"><div><dt>Thời gian</dt><dd>@t.NgayDi.ToString("dd/MM/yyyy") — @t.NgayVe.ToString("dd/MM/yyyy")</dd></div><div><dt>Ngân sách</dt><dd>@Labels.Money(t.NganSach)</dd></div></dl><p class="prose">@t.PhamViDiCung</p>@if(t.LyDo!=null){<p class="help">Lý do: @t.LyDo</p>}
@if(t.TrangThai.ToString()=="ChoXacNhan"&&t.MaNguoiDeXuat!=Travel.UserId){<form action="/dong-hanh/thoa-thuan/xac-nhan" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" name="Id" value="@t.MaThoaThuan"/><input type="hidden" name="Version" value="@TravelService.Token(t.RowVersion)"/><input type="hidden" name="BusinessVersion" value="@t.PhienBan"/><input type="hidden" name="connectionId" value="@c.MaDeNghi"/><div class="field"><label for="agreement-reason-@t.MaThoaThuan">Lý do khi từ chối</label><input id="agreement-reason-@t.MaThoaThuan" class="form-control" name="Reason" maxlength="500"/></div><div class="form-actions"><button class="btn btn-dark" name="Decision" value="DaXacNhan" type="submit">@(t.LoaiPhienBan.ToString()=="DeNghiNgung"?"Đồng ý cùng ngừng":"Xác nhận phiên bản này")</button><button class="btn btn-outline" name="Decision" value="TuChoi" type="submit">Từ chối</button></div></form>}</article>}
<div class="notice">Thỏa thuận đồng hành và yêu cầu đặt dịch vụ được xử lý riêng. Khi kết thúc đồng hành, hãy kiểm tra các dịch vụ bạn đã đặt.</div></div>
