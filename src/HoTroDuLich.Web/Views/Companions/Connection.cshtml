@model DeNghiKetNoiDongHanh
@inject TravelService Travel
@{ViewData["Title"]="Đề nghị kết nối";var sender=(SharedPerson)ViewBag.Sender;var owner=(SharedPerson)ViewBag.Owner;var other=sender.Id==Travel.UserId?owner:sender;var incoming=Model.MaNguoiGui!=Travel.UserId;}
<div class="container-narrow"><a class="back" href="/dong-hanh/de-nghi">← Đề nghị kết nối</a><div class="page-head"><div><span class="eyebrow">KẾT NỐI ĐỒNG HÀNH</span><h1>@other.Name</h1><p>Chuyến đi đến @ViewBag.Destination</p></div><span class="badge @Labels.Badge(Model.TrangThai.ToString())">@Labels.Status(Model.TrangThai.ToString())</span></div><div class="panel"><h2>Lời giới thiệu</h2><p class="prose">@(Model.LoiGioiThieu??"Người gửi chưa thêm lời giới thiệu.")</p>@if(other.Bio!=null){<p class="prose">@other.Bio</p>}@if(Model.TrangThai.ToString()=="DaChapNhan"){<h2>Liên hệ sau kết nối</h2><p>@other.Email · @other.Phone</p><a class="btn btn-dark" href="/Companions/Agreement/@Model.MaDeNghi">Thỏa thuận đồng hành @Ui.Icon("arrow")</a><a class="btn btn-outline" href="/Together/Edit?connectionId=@Model.MaDeNghi">Mở nhóm đồng hành từ kết nối</a>}
@if(Model.TrangThai.ToString()=="ChoPhanHoi"){<form action="/dong-hanh/de-nghi/phan-hoi" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" name="Id" value="@Model.MaDeNghi"/><input type="hidden" name="Version" value="@TravelService.Token(Model.RowVersion)"/><div class="form-actions">@if(incoming){<button class="btn btn-dark" name="Decision" value="DaChapNhan" type="submit">Chấp nhận kết nối</button><button class="btn btn-outline" name="Decision" value="TuChoi" type="submit">Từ chối</button>}else{<button class="btn btn-outline" name="Decision" value="DaRut" type="submit">Rút đề nghị</button>}</div></form>}</div></div>
