@model AgreementInput
@{ViewData["Title"]="Đề xuất thỏa thuận";}
<div class="container-narrow"><a class="back" href="/Companions/Agreement/@Model.ConnectionId">← Thỏa thuận và lịch sử</a><div class="page-head"><div><h1>Đề xuất thỏa thuận đồng hành</h1><p>Đề xuất mới sẽ được gửi cho bên còn lại xem và xác nhận.</p></div></div><div class="panel"><form action="/dong-hanh/thoa-thuan/gui-de-nghi-thoa-thuan" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" asp-for="ConnectionId"/><input type="hidden" asp-for="BaseVersion"/><input type="hidden" asp-for="Version"/><input type="hidden" name="Kind" value="NoiDung"/><div class="form-grid"><div class="field"><label asp-for="Destination">Nơi đến</label><input class="form-control" asp-for="Destination" maxlength="200" required/><span asp-validation-for="Destination"></span></div><div class="field"><label asp-for="Budget">Ngân sách dự kiến (₫)</label><input class="form-control" asp-for="Budget" type="number" min="0" max="1000000000"/><span asp-validation-for="Budget"></span></div><div class="field"><label asp-for="Start">Ngày đi</label><input class="form-control" asp-for="Start" type="date" required/><span asp-validation-for="Start"></span></div><div class="field"><label asp-for="End">Ngày về</label><input class="form-control" asp-for="End" type="date" required/><span asp-validation-for="End"></span></div><div class="field full"><label asp-for="Scope">Phạm vi và nội dung đi cùng</label><textarea class="form-control" asp-for="Scope" maxlength="1000"></textarea><span asp-validation-for="Scope"></span></div></div><div class="form-actions"><button class="btn btn-dark" type="submit">Gửi đề xuất @Ui.Icon("arrow")</button></div></form></div></div>
