@model NhuCauDongHanh
@inject TravelService Travel
@{ViewData["Title"]="Đồng hành đến "+Model.DiemDen;var person=ViewBag.Person as SharedPerson;var hidden=string.IsNullOrEmpty(Model.NoiDung);}
<div class="container-narrow"><a class="back" href="/Companions">← Tìm người đồng hành</a><span class="eyebrow">@Model.DiemDen · @DanhMuc.Ten(Model.HinhThucDi)</span><h1>@(hidden?"Cùng khám phá "+Model.DiemDen:Model.NoiDung)</h1><div class="panel mt-4"><div class="person-head">@if(person?.Avatar!=null){<img class="avatar-large" src="@person.Avatar" alt="Ảnh đại diện @person.Name"/>}else{<span class="avatar-large">@Ui.Icon("user")</span>}<div><h2>@person?.Name</h2><small>@Labels.Status(Model.PhamViChiaSe.ToString())</small></div></div><dl class="facts"><div><dt>Thời gian</dt><dd>@Model.NgayBatDau.ToString("dd/MM/yyyy") — @Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd></div>@if(!hidden){<div><dt>Ngân sách dự kiến</dt><dd>@Labels.Money(Model.NganSachDuKien)</dd></div>}</dl>
@if(hidden){<div class="notice">Nội dung chi tiết và ngân sách được chia sẻ khi hai bạn đã kết nối.</div>}else{<h3>Mong muốn đồng hành</h3><p class="prose">@Model.MongMuonDongHanh</p>}
@if(person?.Bio!=null){<p class="prose">@person.Bio</p>}@if(person?.City!=null){<p>Nơi sinh sống: @person.City</p>}@if(person?.Interests!=null){<p>Sở thích: @person.Interests</p>}@if(person?.Connected==true){<h3>Liên hệ sau kết nối</h3><p>@person.Email · @person.Phone</p>}
</div>
@if(Travel.Role==TravelService.Traveler&&Travel.UserId!=Model.MaTaiKhoan&&person?.Connected!=true){<div class="panel"><h2>Gửi lời mời kết nối</h2><form action="/dong-hanh/de-nghi/gui-de-nghi" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" name="Id" value="@Model.MaNhuCau"/><div class="field"><label for="connect-intro">Lời giới thiệu (tùy chọn)</label><textarea id="connect-intro" class="form-control" name="Text" maxlength="1000"></textarea></div><div class="form-actions"><button class="btn btn-dark" type="submit">Gửi lời mời kết nối @Ui.Icon("arrow")</button></div></form><p class="help mt-3">Thông tin liên hệ được chia sẻ sau khi người nhận chấp nhận kết nối.</p></div>}
else if(Travel.UserId==0){<div class="panel"><h2>Gặp người bạn đồng hành phù hợp</h2><p>Đăng nhập bằng tài khoản khách du lịch để gửi lời mời kết nối.</p><a class="btn btn-dark" href="/tai-khoan/dang-nhap/mo-dang-nhap?returnUrl=@Uri.EscapeDataString(Context.Request.Path)">Đăng nhập để kết nối</a></div>}
</div>
