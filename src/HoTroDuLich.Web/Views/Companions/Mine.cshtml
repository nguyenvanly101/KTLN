@model List<NhuCauDongHanh>
@{ViewData["Title"]="Bài đăng của tôi";}<div class="container-wide"><div class="page-head"><div><h1>Bài đăng của tôi</h1><p>Quản lý những bài đăng tìm bạn đồng hành của bạn.</p></div><div class="actions"><a class="btn btn-dark" href="/Companions/Edit">＋ Đăng tin</a></div></div><nav class="tabs"><a href="/Companions">Tìm người đồng hành</a><a href="/Companions/Mine">Bài đăng của tôi</a><a href="/Companions/Connections">Kết nối của tôi</a></nav>@if(Model.Count==0){<div class="empty"><span class="eyebrow">Thông tin</span><h3>Bạn chưa có bài đăng nào</h3><p>Đăng thông tin chuyến đi để tìm người đồng hành phù hợp.</p><a class="btn btn-dark" href="/Companions/Edit">Đăng tin đầu tiên</a></div>}@foreach(var n in Model){<div class="list-card"><div><span class="badge @Labels.Badge(n.TrangThaiCongBo.ToString())">@Labels.Status(n.TrangThaiCongBo.ToString())</span><h3>@n.NoiDung</h3><p>@n.DiemDen · @n.NgayBatDau — @n.NgayKetThuc · @Labels.Status(n.PhamViChiaSe.ToString())</p></div><div class="actions"><a class="btn btn-outline" href="/Companions/Edit/@n.MaNhuCau">Sửa</a>@if(n.TrangThaiCongBo.ToString()=="DangCongBo"){<form action="/Companions/Stop" method="post" >@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" name="Id" value="@n.MaNhuCau"/><input type="hidden" name="Version" value="@TravelService.Token(n.RowVersion)"/><button class="btn btn-outline" type="submit">Ẩn bài đăng</button></form>}</div></div>}</div>