@model NeedInput
@{ViewData["Title"]="Đăng tin tìm bạn đồng hành";}<div class="container-narrow"><a class="back" href="/Companions/Mine">← Bài đăng của tôi</a><div class="page-head"><div><h1>Đăng tin tìm bạn đồng hành</h1><p>Giới thiệu chuyến đi và chọn ai có thể xem bài đăng của bạn.</p></div><div class="actions"></div></div><div class="panel"><form action="/Companions/Edit" method="post" >@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><div class="form-grid"><div class="field"><label asp-for="Destination">Điểm đến</label><input class="form-control" asp-for="Destination" type="text" /><span asp-validation-for="Destination"></span></div><div class="field"><label asp-for="Style">Hình thức đi</label><select class="form-select" asp-for="Style"><option value="">Chưa chọn</option>@foreach(var style in DanhMuc.HinhThucDi){<option value="@style">@DanhMuc.Ten(style)</option>}</select></div><div class="field"><label asp-for="Start">Ngày bắt đầu</label><input class="form-control" asp-for="Start" type="date" /><span asp-validation-for="Start"></span></div><div class="field"><label asp-for="End">Ngày kết thúc</label><input class="form-control" asp-for="End" type="date" /><span asp-validation-for="End"></span></div><div class="field"><label asp-for="Budget">Ngân sách dự kiến (₫)</label><input class="form-control" asp-for="Budget" type="number" min="0"/><span asp-validation-for="Budget"></span></div><div class="field"><label asp-for="Privacy">Ai có thể xem bài đăng?</label><select class="form-select" asp-for="Privacy"><option value="CongKhai">Công khai</option><option value="DaDangNhap">Người đã đăng nhập</option><option value="KhiKetNoi">Chỉ khi đã kết nối</option></select></div><div class="field full"><label asp-for="Content">Giới thiệu chuyến đi</label><textarea class="form-control" asp-for="Content"></textarea><span asp-validation-for="Content"></span></div><div class="field full"><label asp-for="Wishes">Bạn muốn tìm người đồng hành như thế nào?</label><textarea class="form-control" asp-for="Wishes"></textarea><span asp-validation-for="Wishes"></span></div></div><div class="form-actions"><button class="btn btn-dark" type="submit">Xem trước bài đăng ↗</button></div></form></div></div>