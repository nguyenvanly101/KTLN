@model List<NhuCauDongHanh>
@{
 ViewData["Title"]="Tìm người đồng hành";
 var names=(Dictionary<long,string>)ViewBag.Names;
 var canPost=User.Identity?.IsAuthenticated!=true||User.IsInRole(TravelService.Traveler);
 string Filter(string canonical,string legacy)=>Context.Request.Query.ContainsKey(canonical)?Context.Request.Query[canonical].ToString():Context.Request.Query[legacy].ToString();
 var selectedStyle=Filter("hinhThucDi","style");
 var extraFilters=!string.IsNullOrEmpty(selectedStyle)||!string.IsNullOrEmpty(Filter("nganSachToiDa","budget"));
 var hasFilters=Context.Request.Query.Any(x=>!string.IsNullOrWhiteSpace(x.Value));
}
@if(!hasFilters){<div class="container-wide"><div class="together-legacy-promo"><div><span class="eyebrow">CÙNG MỘT SỞ THÍCH, THÊM MỘT CUỘC HẸN</span><h2>Từ lời rủ đến một nhóm cùng đi</h2><p>Khám phá hoạt động ngắn, xin tham gia nhóm, trao đổi và thống nhất lịch chung.</p></div><a class="btn btn-dark" href="/Together">Khám phá lời rủ đi cùng @Ui.Icon("arrow")</a></div></div>}
<div class="container-wide community-page">
 @if(!hasFilters){
 <section class="community-intro" aria-labelledby="community-title"><div><span class="eyebrow">ĐỒNG HÀNH / NHỮNG LỜI RỦ LÊN ĐƯỜNG</span><h1 id="community-title">Cùng một điểm đến.<br/>Thêm một <em>người bạn.</em></h1><p>Tìm người có cùng điểm đến và thời gian. Bắt đầu bằng một lời chào, rồi cùng nhau lên kế hoạch cho những trải nghiệm mới.</p><div class="hero-actions"><a class="btn btn-dark" href="#companion-search">@Ui.Icon("search") Tìm người cùng đi</a>@if(canPost){<a class="hero-secondary" href="/Companions/Edit">Đăng lời rủ @Ui.Icon("plus")</a>}</div></div><div class="community-visual"><img src="~/images/hoian.jpg" alt="Một góc phố Hội An, cảm hứng cho chuyến đi cùng bạn bè" width="720" height="540"/><div class="community-note">@Ui.Icon("users")<span>Đi cùng người hợp gu.<br/><b>Kể thêm những chuyện hay.</b></span></div><span>@Ui.Icon("shield") Bạn chủ động kết nối và chọn thông tin chia sẻ.</span></div></section>
 }else{<div class="page-head"><div><span class="eyebrow">ĐỒNG HÀNH / KẾT QUẢ TÌM KIẾM</span><h1>Những người bạn cùng đi</h1><p>Điều chỉnh lịch trình và ngân sách để tìm một lời rủ phù hợp.</p></div>@if(canPost){<a class="btn btn-outline" href="/Companions/Edit">@Ui.Icon("plus") Đăng lời rủ</a>}</div>}
 <nav class="tabs" aria-label="Đồng hành"><a class="active" aria-current="page" href="/dong-hanh/tim-kiem/mo-tim-kiem">@Ui.Icon("search") Tìm người đồng hành</a>@if(canPost){<a href="/Companions/Mine">@Ui.Icon("grid") Bài đăng của tôi</a><a href="/Companions/Connections">@Ui.Icon("users") Kết nối của tôi</a>}</nav>
 <form id="companion-search" tabindex="-1" action="/dong-hanh/tim-kiem/tim-nhu-cau" method="get" class="companion-search" aria-label="Tìm bạn đồng hành">
  <div class="companion-primary-filters"><div class="field"><label for="companion-destination">Bạn muốn đi đâu?</label><input id="companion-destination" class="form-control" name="noiDen" value="@Filter("noiDen","q")" maxlength="200" placeholder="Nhập điểm đến…"/></div><div class="field"><label for="companion-start">Từ ngày</label><input id="companion-start" class="form-control" name="tuNgay" type="date" value="@Filter("tuNgay","start")"/></div><div class="field"><label for="companion-end">Đến ngày</label><input id="companion-end" class="form-control" name="denNgay" type="date" value="@Filter("denNgay","end")"/></div><button class="btn btn-dark" type="submit">@Ui.Icon("search") Tìm bạn cùng đi</button></div>
  <details class="companion-extra" open="@extraFilters"><summary>Thêm bộ lọc: ngân sách & hình thức đi</summary><div class="form-grid"><div class="field"><label for="companion-budget">Ngân sách tối đa (₫)</label><input id="companion-budget" class="form-control" name="nganSachToiDa" type="number" min="0" max="1000000000" value="@Filter("nganSachToiDa","budget")" placeholder="Không giới hạn"/></div><div class="field"><label for="companion-style">Hình thức đi</label><select id="companion-style" class="form-select" name="hinhThucDi"><option value="">Tất cả hình thức</option>@foreach(var style in DanhMuc.HinhThucDi){<option value="@style" selected="@(selectedStyle==style)">@DanhMuc.Ten(style)</option>}</select></div></div></details>
  <div class="companion-filter-footer"><span>Tìm người phù hợp với lịch trình của bạn.</span><a href="/Companions" class="text-link">Xóa bộ lọc</a></div>
 </form>
 <div class="section-head community-results-heading"><div><span class="eyebrow">MỘT KẾT NỐI, MỘT HÀNH TRÌNH MỚI</span><h2>Có người cũng muốn lên đường.</h2><p>Đang hiển thị @Model.Count lời rủ phù hợp với tiêu chí của bạn.</p></div></div>
 @if(Model.Count==0){<div class="empty">@Ui.Icon("users")<h3>Chưa tìm thấy người bạn phù hợp</h3><p>Thử mở rộng ngày đi hoặc bỏ giới hạn ngân sách. Bạn cũng có thể bắt đầu bằng lời rủ của chính mình.</p><div class="empty-actions">@if(canPost){<a class="btn btn-dark" href="/Companions/Edit">Đăng tin tìm bạn</a>}<a class="btn btn-outline" href="/Companions">Xem các lời rủ khác</a></div></div>}
 <div class="cards companion-results">
 @foreach(var n in Model){
  var displayName=names.GetValueOrDefault(n.MaTaiKhoan)??"Bạn đồng hành";
  <a class="card-trip" href="/Companions/Detail/@n.MaNhuCau"><div class="companion-card-cover"><img src="@Ui.DestinationImage(n.DiemDen)" alt="Ảnh minh họa @n.DiemDen" loading="lazy" width="600" height="320"/><div class="location">@Ui.Icon("pin") @n.DiemDen @if(!string.IsNullOrWhiteSpace(n.HinhThucDi)){<span class="travel-style">@DanhMuc.Ten(n.HinhThucDi)</span>}</div></div><div class="card-content"><div class="person-head"><span class="avatar-large" aria-hidden="true">@Ui.Initial(displayName)</span><div><h3>@displayName</h3><small>@Labels.Status(n.PhamViChiaSe.ToString())</small></div></div><h3 class="companion-card-title">@(string.IsNullOrEmpty(n.NoiDung)?"Cùng khám phá "+n.DiemDen:n.NoiDung)</h3><p class="companion-wishes">@n.MongMuonDongHanh</p><p class="companion-dates">@Ui.Icon("calendar") @n.NgayBatDau.ToString("dd/MM/yyyy") – @n.NgayKetThuc.ToString("dd/MM/yyyy")</p><div class="card-bottom"><div class="price"><small>NGÂN SÁCH DỰ KIẾN</small>@(string.IsNullOrEmpty(n.NoiDung)?"Chia sẻ sau kết nối":Labels.Money(n.NganSachDuKien))</div><span class="companion-card-cta" aria-hidden="true">@Ui.Icon("arrow")</span></div></div></a>
 }
 </div><div class="notice">Gửi lời mời để trao đổi thêm. Hai bên cần thống nhất kế hoạch trước khi đồng ý đi cùng.</div>
</div>
