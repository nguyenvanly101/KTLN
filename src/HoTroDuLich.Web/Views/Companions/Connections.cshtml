@model List<DeNghiKetNoiDongHanh>
@inject TravelService Travel
@{ViewData["Title"]="Kết nối của tôi";var names=(Dictionary<long,string>)ViewBag.Names;var owners=(Dictionary<long,long>)ViewBag.Owners;var destinations=(Dictionary<long,string>)ViewBag.Destinations;}<div class="container-wide"><div class="page-head"><div><h1>Kết nối của tôi</h1><p>Quản lý lời mời đã gửi, đã nhận và thỏa thuận đi cùng.</p></div><div class="actions"></div></div><nav class="tabs"><a href="/Companions">Tìm người đồng hành</a><a href="/Companions/Mine">Bài đăng của tôi</a><a href="/Companions/Connections">Kết nối của tôi</a></nav>@if(Model.Count==0){<div class="empty"><span class="eyebrow">Thông tin</span><h3>Chưa có kết nối nào</h3><p>Xem các bài đăng và gửi lời mời cho người có kế hoạch phù hợp.</p><a class="btn btn-dark" href="/Companions">Tìm người đồng hành</a></div>}@foreach(var c in Model){var other=c.MaNguoiGui==Travel.UserId?owners[c.MaDeNghi]:c.MaNguoiGui;<div class="panel"><div class="page-head"><div><span class="eyebrow">@(c.MaNguoiGui==Travel.UserId?"ĐÃ GỬI":"ĐÃ NHẬN") · @destinations[c.MaDeNghi]</span><h3>@(names.GetValueOrDefault(other)??"Bạn đồng hành")</h3><p>@c.LoiGioiThieu</p></div><span class="badge @Labels.Badge(c.TrangThai.ToString())">@Labels.Status(c.TrangThai.ToString())</span></div>@if(c.TrangThai.ToString()=="ChoPhanHoi"){<form action="/Companions/Respond" method="post" >@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" name="Id" value="@c.MaDeNghi"/><input type="hidden" name="Version" value="@TravelService.Token(c.RowVersion)"/>@if(c.MaNguoiGui==Travel.UserId){<div class="form-actions"><button class="btn btn-outline" name="Decision" value="DaRut" type="submit">Rút đề nghị</button></div>}else{<div class="form-actions"><button class="btn btn-dark" name="Decision" value="DaChapNhan" type="submit">Chấp nhận kết nối</button><button class="btn btn-outline" name="Decision" value="TuChoi" type="submit">Từ chối</button></div>}</form>}@if(c.TrangThai.ToString()=="DaChapNhan"){<a class="btn btn-dark" href="/Companions/Agreement/@c.MaDeNghi">Xem & lập thỏa thuận ↗</a><p class="help mt-3">Bạn đã kết nối thành công. Hãy trao đổi và xác nhận thỏa thuận trước khi đi cùng.</p>}</div>}</div>