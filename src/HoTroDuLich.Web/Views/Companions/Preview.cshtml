@model NeedInput
@{ViewData["Title"]="Xem trước nhu cầu đồng hành";}
<div class="container-narrow"><div class="page-head"><div><span class="eyebrow">KIỂM TRA PHẠM VI CHIA SẺ</span><h1>Bài đăng sẽ hiển thị thế nào?</h1><p>Phạm vi bạn chọn: @Labels.Status(Model.Privacy). Kiểm tra hai góc nhìn trước khi công bố.</p></div></div>
@foreach(var audience in new[]{"Khách chưa đăng nhập","Khách du lịch đã đăng nhập, chưa kết nối"}){var guest=audience.StartsWith("Khách chưa");var visible=!guest||Model.Privacy=="CongKhai";var full=visible&&(guest||Model.Privacy!="KhiKetNoi");<div class="panel"><span class="eyebrow">@audience</span>@if(!visible){<h2>Bài đăng được giới hạn hiển thị</h2><p>Người này cần đăng nhập bằng tài khoản khách du lịch để thấy nhu cầu.</p>}else{<h2>@(full?Model.Content:"Cùng khám phá "+Model.Destination)</h2><p>@Model.Destination · @Model.Start.ToString("dd/MM/yyyy") — @Model.End.ToString("dd/MM/yyyy") · @DanhMuc.Ten(Model.Style)</p>@if(full){<p>Ngân sách: @Labels.Money(Model.Budget)</p><p class="prose">@Model.Wishes</p>}else{<p class="help">Nội dung, ngân sách và mong muốn chỉ được chia sẻ sau kết nối.</p>}}</div>}
<div class="panel"><form action="/dong-hanh/nhu-cau/cong-bo" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><input type="hidden" asp-for="Destination"/><input type="hidden" asp-for="Content"/><input type="hidden" name="Start" value="@Model.Start.ToString("yyyy-MM-dd")"/><input type="hidden" name="End" value="@Model.End.ToString("yyyy-MM-dd")"/><input type="hidden" asp-for="Budget"/><input type="hidden" asp-for="Style"/><input type="hidden" asp-for="Wishes"/><input type="hidden" asp-for="Privacy"/><div class="form-actions"><button class="btn btn-dark" type="submit">Công bố với phạm vi này</button><button class="btn btn-outline" type="submit" formaction="/Companions/Revise">Sửa lại bài đăng</button></div></form></div></div>
