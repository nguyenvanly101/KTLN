@model DiscoveryEditInput
@{ViewData["Title"]=Model.Id>0?"Bổ sung thông tin tra cứu":"Tạo thông tin tra cứu";var admin=User.IsInRole(TravelService.AdminRole);var parents=ViewBag.DsParents as List<DiscoveryEntry>??[];}
<div class="ds-page ds-editor" data-discovery-editor><a class="back" href="/Discovery/Manage">← Quản lý thông tin</a><header class="ds-section-head"><div><span class="eyebrow">THÔNG TIN RÕ RÀNG. LỰA CHỌN DỄ HƠN.</span><h1>@ViewData["Title"]</h1><p>@(admin?"Kiểm tra nguồn, vị trí và thời gian áp dụng trước khi công bố.":"Đề nghị được quản trị viên kiểm tra trước khi công bố. Thông tin dịch vụ gốc được cập nhật ở mục quản lý dịch vụ.")</p></div></header>
<form method="post" action="@(admin?"/Discovery/Save":"/Discovery/Propose")" class="ds-form">
 @Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input asp-for="EntryId" type="hidden"/><input asp-for="Version" type="hidden"/><input asp-for="SubmissionId" type="hidden"/><div asp-validation-summary="All" class="ds-errors" tabindex="-1" role="alert"></div>
 <section class="ds-panel"><h2>Nội dung chính</h2>@if(Model.LinkedKind!=null){<p class="ds-note">Các trường gốc chỉ đọc. Đổi tên/mô tả/giá/giờ dịch vụ tại Quản lý dịch vụ theo luồng công bố hiện có. Tại đây bổ sung hướng dẫn, vị trí, tiện ích, bảng giá chi tiết và nguồn.</p>}<div class="ds-pair"><div><label asp-for="Kind">Loại thông tin</label><select asp-for="Kind">@foreach(var x in DiscoveryText.Kinds){<option value="@x.Key">@x.Value</option>}</select></div><div><label asp-for="Region">Khu vực</label><input asp-for="Region" readonly="@(!string.IsNullOrEmpty(Model.LinkedKind))" maxlength="100" required/></div></div><label asp-for="Title">Tiêu đề</label><input asp-for="Title" readonly="@(!string.IsNullOrEmpty(Model.LinkedKind))" maxlength="200" required/><label asp-for="ParentId">Thuộc điểm đến / khu vực</label><select asp-for="ParentId"><option value="">Không gắn mục cha</option>@foreach(var p in parents.Where(p=>p.Id!=Model.Id)){<option value="@p.Id">@p.Title · @DiscoveryText.Kind(p.Kind)</option>}</select><label asp-for="Summary">Tóm tắt giúp khách quyết định</label><textarea asp-for="Summary" readonly="@(!string.IsNullOrEmpty(Model.LinkedKind))" rows="3" maxlength="700"></textarea><label asp-for="Content">Thông tin thực tế / hướng dẫn</label><textarea asp-for="Content" rows="8" maxlength="20000"></textarea><label asp-for="Tags">Chủ đề và tên gọi khác</label><input asp-for="Tags" maxlength="500"/><p class="help">Ví dụ: đi bộ, trong nhà, cà phê, di sản. Chỉ mô tả đúng dữ liệu có nguồn.</p></section>
 <section class="ds-panel"><h2>Vị trí và nguồn kiểm tra</h2><label asp-for="Address">Địa chỉ / điểm tiếp cận</label><input asp-for="Address" maxlength="400"/><div class="ds-pair"><div><label asp-for="Latitude">Vĩ độ</label><input asp-for="Latitude" type="number" step="0.000001" min="-90" max="90"/></div><div><label asp-for="Longitude">Kinh độ</label><input asp-for="Longitude" type="number" step="0.000001" min="-180" max="180"/></div></div><div id="discovery-map" class="ds-map ds-map-small" aria-label="Chọn vị trí thông tin"></div><p class="help">Bấm bản đồ để chọn mốc. Xác nhận đúng lối tiếp cận; nếu là mốc cả khu vực, ghi rõ bên dưới.</p><label asp-for="LocationNote">Giải thích độ chính xác của vị trí</label><input asp-for="LocationNote" maxlength="300"/><div class="ds-pair"><div><label asp-for="SourceName">Nguồn thông tin</label><input asp-for="SourceName" maxlength="200" required/></div><div><label asp-for="CheckedOn">Ngày kiểm tra nguồn</label><input asp-for="CheckedOn" type="date" max="@TravelService.Today.ToString("yyyy-MM-dd")"/></div></div><label asp-for="SourceUrl">Đường dẫn nguồn (HTTPS)</label><input asp-for="SourceUrl" type="url" maxlength="1000"/><label asp-for="Contact">Liên hệ được phép công bố</label><input asp-for="Contact" maxlength="300"/></section>
 <details class="ds-panel" open><summary>Giá, thời gian và điều kiện</summary><div class="ds-pair"><div><label asp-for="PriceFrom">Giá tham khảo từ (₫)</label><input asp-for="PriceFrom" readonly="@(Model.LinkedKind=="Service")" type="number" min="0" max="1000000000" step="0.01"/></div><div><label asp-for="PriceTo">Giá tham khảo đến (₫)</label><input asp-for="PriceTo" readonly="@(Model.LinkedKind=="Service")" type="number" min="0" max="1000000000" step="0.01"/></div></div><label asp-for="PriceUnit">Đơn vị giá</label><input asp-for="PriceUnit" readonly="@(Model.LinkedKind=="Service")" placeholder="người, phòng/đêm, lượt…" maxlength="100"/><label asp-for="Includes">Khoản đã bao gồm</label><textarea asp-for="Includes" readonly="@(Model.LinkedKind=="Service")" maxlength="1000"></textarea><label asp-for="Excludes">Khoản trả thêm / chưa bao gồm</label><textarea asp-for="Excludes" maxlength="1000"></textarea><label asp-for="Hours">Giờ phục vụ và ghi chú ngoại lệ</label><textarea asp-for="Hours" readonly="@(Model.LinkedKind=="Service")" maxlength="700"></textarea><div class="ds-pair"><div><label asp-for="OpenDays">Ngày mở cửa xác nhận (1 = thứ Hai, 7 = Chủ nhật)</label><input asp-for="OpenDays" maxlength="7" placeholder="Ví dụ: 1234567"/></div><div><label asp-for="DurationMinutes">Thời lượng tham khảo (phút)</label><input asp-for="DurationMinutes" type="number" min="1" max="1440"/></div></div><div class="ds-pair"><div><label asp-for="OpenTime">Giờ mở</label><input asp-for="OpenTime" type="time"/></div><div><label asp-for="CloseTime">Giờ đóng</label><input asp-for="CloseTime" type="time"/></div></div><p class="help">Để trống cả ngày và giờ khi chưa xác nhận. Giờ đóng nhỏ hơn giờ mở được hiểu là qua ngày hôm sau.</p><div class="ds-pair"><div><label asp-for="ValidFrom">Áp dụng từ ngày / ngày bắt đầu sự kiện</label><input asp-for="ValidFrom" type="date"/></div><div><label asp-for="ValidTo">Đến ngày / ngày kết thúc sự kiện</label><input asp-for="ValidTo" type="date"/></div></div>
 <h3>Bảng giá theo hạng mục</h3><p class="help">Để trống tên để bỏ dòng. Các dòng giá cũ được giữ trong lịch sử cập nhật.</p><div data-ds-price-rows>@for(var n=0;n<Model.Prices.Count;n++){<fieldset class="ds-price-row"><legend>Hạng mục @(n+1)</legend><div class="ds-pair"><div><label asp-for="Prices[n].Label">Tên / đối tượng áp dụng</label><input asp-for="Prices[n].Label" maxlength="100"/></div><div><label asp-for="Prices[n].Amount">Số tiền (₫; trống nếu chưa biết)</label><input asp-for="Prices[n].Amount" type="number" min="0" max="1000000000" step="0.01"/></div></div><label asp-for="Prices[n].Unit">Đơn vị</label><input asp-for="Prices[n].Unit" maxlength="100"/><label asp-for="Prices[n].Conditions">Điều kiện áp dụng</label><textarea asp-for="Prices[n].Conditions" maxlength="1000"></textarea><label asp-for="Prices[n].Included">Bao gồm</label><input asp-for="Prices[n].Included" maxlength="1000"/><label asp-for="Prices[n].Extra">Trả thêm</label><input asp-for="Prices[n].Extra" maxlength="1000"/><div class="ds-pair"><div><label asp-for="Prices[n].From">Áp dụng từ</label><input asp-for="Prices[n].From" type="date"/></div><div><label asp-for="Prices[n].Until">Áp dụng đến</label><input asp-for="Prices[n].Until" type="date"/></div></div></fieldset>}</div><button type="button" class="btn btn-outline" data-ds-add-price>Thêm dòng giá</button></details>
 <details class="ds-panel"><summary>Điều kiện tiếp cận và tiện ích</summary>@for(var n=0;n<Model.FeatureRows.Count;n++){<div class="ds-feature-editor"><input asp-for="FeatureRows[n].Code" type="hidden"/><label asp-for="FeatureRows[n].State">@DiscoveryText.Features.GetValueOrDefault(Model.FeatureRows[n].Code)</label><select asp-for="FeatureRows[n].State"><option value="Unknown">Chưa có thông tin</option><option value="Yes">Đã xác nhận có</option><option value="No">Đã xác nhận không có</option></select><label asp-for="FeatureRows[n].Note">Giải thích / nguồn cụ thể</label><input asp-for="FeatureRows[n].Note" maxlength="500"/></div>}</details>
 <details class="ds-panel"><summary>Thông tin di chuyển (nếu có)</summary><label asp-for="Origin">Nơi xuất phát / điểm đón</label><input asp-for="Origin" maxlength="200"/><label asp-for="Destination">Điểm đến / điểm trả</label><input asp-for="Destination" maxlength="200"/><label asp-for="TransportMode">Phương tiện</label><input asp-for="TransportMode" maxlength="25" placeholder="Xe buýt, tàu, ô tô…"/></details>
 <section class="ds-panel"><h2>@(admin?"Lưu và công bố":"Gửi đề nghị bổ sung")</h2>@if(admin){<label asp-for="Status">Trạng thái</label><select asp-for="Status"><option value="Draft">Bản nháp</option><option value="Published">Công bố</option><option value="Hidden">Ẩn</option></select>}else{<input asp-for="Status" type="hidden"/>}<label asp-for="Reason">Nội dung thay đổi / lý do</label><textarea asp-for="Reason" maxlength="500" required></textarea><button class="btn btn-dark">@(admin?"Lưu thông tin":"Gửi quản trị viên kiểm tra")</button><a class="btn btn-outline" href="/Discovery/Manage">Quay lại</a></section>
</form></div>
@section Scripts{<script src="~/lib/leaflet/leaflet.js"></script><script src="~/js/discovery.js" asp-append-version="true"></script>}
