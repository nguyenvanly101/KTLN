@model DiscoverySearchPage
@using System.Text.Json
@{ViewData["Title"]="Khám phá & tra cứu";var f=Model.Filter;var landing=string.IsNullOrWhiteSpace(f.Q)&&string.IsNullOrWhiteSpace(f.Kind)&&string.IsNullOrWhiteSpace(f.Region)&&f.Lat==null&&f.Page==1;var features=(f.Features??"").Split(',');}
<div class="ds-page" data-discovery-search>
 <section class="ds-hero @(landing?"":"ds-hero-compact")"><div class="ds-hero-copy"><span class="eyebrow">TÌM HIỂU TRƯỚC. KHÁM PHÁ THEO CÁCH CỦA BẠN.</span><h1>@(landing?"Một nơi muốn đến.":"Bạn muốn tìm hiểu gì?")@if(landing){<br/><em>Nhiều điều muốn biết.</em>}</h1><p>Tìm điểm đến, cách đi và trải nghiệm phù hợp. Xem thông tin có nguồn, đặt câu hỏi và khám phá ngay trên bản đồ.</p><div class="ds-shortcuts"><a href="/Discovery?kind=Destination">Chưa biết đi đâu @Ui.Icon("arrow")</a><a href="/Discovery?kind=Transport">Tìm cách di chuyển @Ui.Icon("car")</a><a href="/Discovery/Library">Thư viện của tôi @Ui.Icon("plus")</a></div></div>@if(landing){<div class="ds-hero-art"><img src="/images/hoian.jpg" alt="Ảnh minh họa phố cổ Hội An" width="720" height="540" fetchpriority="high"/><span class="ds-postcard">HỘI AN<br/><b>Đi chậm. Biết thêm.</b><small>Ảnh minh họa</small></span></div>}</section>
 <div class="ds-search-wrap"><form method="get" action="/Discovery" id="discovery-search-form" class="ds-search-form" data-ds-search-form>
  @if(f.PlanId!=null){<input type="hidden" name="PlanId" value="@f.PlanId"/>}<input type="hidden" name="Kind" value="@f.Kind"/><input type="hidden" name="Type" value="@f.Type"/>
  @if(f.South!=null){<input type="hidden" name="South" value="@f.South.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"/><input type="hidden" name="North" value="@f.North!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"/><input type="hidden" name="West" value="@f.West!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"/><input type="hidden" name="East" value="@f.East!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"/>}
  <div class="ds-query"><label for="ds-q">Tên nơi, dịch vụ hoặc câu hỏi của bạn</label><div class="ds-query-row">@Ui.Icon("search")<input id="ds-q" name="Q" value="@f.Q" maxlength="200" placeholder="Ví dụ: đi lại ở Hội An, nơi tham quan trong nhà…" autocomplete="off" aria-controls="ds-suggestions" aria-expanded="false" role="combobox" aria-autocomplete="list"/></div><div id="ds-suggestions" class="ds-suggestions" role="listbox" hidden></div></div>
  <div><label for="ds-region">Bạn muốn tìm ở đâu?</label><select id="ds-region" name="Region"><option value="">Tất cả khu vực</option>@foreach(var r in Model.Regions){<option value="@r" selected="@(r==f.Region)">@r</option>}</select></div><button class="btn btn-dark" type="submit">Tìm thông tin @Ui.Icon("arrow")</button>
  <details class="ds-filter-panel" open="@(f.Min!=null||f.Max!=null||f.Date!=null||features.Any(x=>x!="")||f.Lat!=null)"><summary>@Ui.Icon("grid") Điều kiện phù hợp <span>Ngày, mức giá, tiện ích và vị trí</span></summary><div class="ds-filters">
   <div><label for="ds-date">Ngày dự định đến</label><input id="ds-date" type="date" name="Date" value="@f.Date?.ToString("yyyy-MM-dd")"/></div><div><label for="ds-at">Giờ mở cửa đã xác nhận</label><input id="ds-at" type="time" name="At" value="@f.At?.ToString("HH:mm")"/><small>Cần chọn ngày; nơi chưa có giờ xác nhận không được tính.</small></div>
   <div><label for="ds-min">Giá từ (₫)</label><input id="ds-min" name="Min" type="number" min="0" max="1000000000" value="@f.Min"/></div><div><label for="ds-max">Giá đến (₫)</label><input id="ds-max" name="Max" type="number" min="0" max="1000000000" value="@f.Max"/></div><div><label for="ds-unit">Đơn vị giá</label><input id="ds-unit" name="Unit" value="@f.Unit" placeholder="Ví dụ: người, phòng/đêm" maxlength="100"/></div>
   <div><label for="ds-sort">Sắp xếp</label><select name="Sort" id="ds-sort"><option value="relevance" selected="@(f.Sort=="relevance")">Phù hợp từ khóa</option><option value="updated" selected="@(f.Sort=="updated")">Ngày kiểm tra gần đây</option><option value="distance" selected="@(f.Sort=="distance")">Khoảng cách theo vị trí</option><option value="price" selected="@(f.Sort=="price")">Giá tăng dần (cùng đơn vị)</option></select></div>
   <fieldset class="ds-feature-options"><legend>Điều kiện bạn cần — chỉ lọc những mục đã xác nhận có</legend>@foreach(var x in DiscoveryText.Features){<label><input type="checkbox" value="@x.Key" data-ds-feature checked="@features.Contains(x.Key)"/> @x.Value</label>}<input type="hidden" name="Features" value="@f.Features" data-ds-features/></fieldset>
   <div><label for="ds-lat">Vĩ độ mốc tìm quanh đây</label><input id="ds-lat" type="number" step="any" min="-90" max="90" name="Lat" value="@f.Lat?.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></div><div><label for="ds-lng">Kinh độ mốc</label><input id="ds-lng" type="number" step="any" min="-180" max="180" name="Lng" value="@f.Lng?.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></div><div><label for="ds-radius">Phạm vi theo vị trí (km)</label><input id="ds-radius" type="number" min="0.1" max="200" step="0.1" name="RadiusKm" value="@f.RadiusKm.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></div><button type="button" class="btn btn-outline" data-ds-locate>Dùng vị trí của tôi</button><button class="btn btn-dark" type="submit">Áp dụng điều kiện</button><a href="/Discovery" class="ds-quiet">Bỏ các điều kiện</a>
  </div></details>
 </form><p class="ds-inline-status" data-ds-location-status role="status"></p></div>
 <partial name="_TripContext"/>
 <nav class="ds-kind-nav" aria-label="Loại thông tin"><a class="@(string.IsNullOrEmpty(f.Kind)?"active":"")" href="@DiscoveryText.SearchUrl(f,"All")">Tất cả</a>@foreach(var k in DiscoveryText.Kinds){<a class="@(f.Kind==k.Key?"active":"")" href="@DiscoveryText.SearchUrl(f,k.Key)">@k.Value</a>}</nav>
 <div class="ds-filter-chips" aria-label="Bỏ từng điều kiện">@if(!string.IsNullOrWhiteSpace(f.Region)){<a href="@DiscoveryText.Without(f,"Region")">@f.Region ×<span class="sr-only"> Bỏ khu vực</span></a>}@if(f.Date!=null){<a href="@DiscoveryText.Without(f,"Date")">Ngày @f.Date.Value.ToString("dd/MM/yyyy") ×<span class="sr-only"> Bỏ ngày và giờ</span></a>}@if(f.Min!=null){<a href="@DiscoveryText.Without(f,"Min")">Từ @Labels.Money(f.Min) ×</a>}@if(f.Max!=null){<a href="@DiscoveryText.Without(f,"Max")">Đến @Labels.Money(f.Max) ×</a>}@if(f.Lat!=null){<a href="@DiscoveryText.Without(f,"Lat")">Quanh mốc đã chọn ×</a>}@if(f.South!=null){<a href="@DiscoveryText.Without(f,"South")">Trong vùng bản đồ ×</a>}@foreach(var code in features.Where(DiscoveryText.Features.ContainsKey)){<a href="@DiscoveryText.Without(f,"Features",code)">@DiscoveryText.Features[code] ×<span class="sr-only"> Bỏ tiện ích</span></a>}</div>
 @if(Model.Terms.Count>0||Model.Intent!=null){<div class="ds-understood"><b>Từ khóa đang tra cứu:</b> @string.Join(" · ",Model.Terms)<span>@(Model.Intent!=null?"Đang tra cứu "+(Model.Intent=="Price"?"giá và điều kiện":Model.Intent=="Hours"?"giờ phục vụ":Model.Intent=="Address"?"địa chỉ":DiscoveryText.Features.GetValueOrDefault(Model.Intent))+" từ thông tin đã công bố.":"Kết quả dựa trên nội dung đã công bố.")</span></div>}
 @if(Model.Snippets?.Count>0){<section class="ds-answer-preview"><span class="eyebrow">THÔNG TIN CÓ THỂ TRẢ LỜI CÂU HỎI CỦA BẠN</span>@foreach(var answer in Model.Snippets){<article><h2>@answer.Title</h2><p>@answer.Answer</p><small>Nguồn: @answer.Source @(answer.CheckedOn!=null?"· Kiểm tra "+answer.CheckedOn.Value.ToString("dd/MM/yyyy"):"· Chưa có ngày kiểm tra nguồn riêng")</small><a class="ds-source-link" href="@DiscoveryText.Link(answer.EntryId)#practical">Xem đầy đủ thông tin và nguồn @Ui.Icon("arrow")</a></article>}</section>}
 @if(Model.Answers.Count>0){<section class="ds-answer-preview"><span class="eyebrow">CÂU TRẢ LỜI ĐÃ ĐƯỢC KIỂM TRA</span>@foreach(var a in Model.Answers){<article><h2>@a.Question</h2><p>@a.Answer</p><a href="@DiscoveryText.Link(a.EntryId)#questions">Xem nguồn và hỏi đáp @Ui.Icon("arrow")</a></article>}</section>}
 @if(landing&&Model.Destinations.Count>0){<section class="ds-destinations"><div class="ds-section-head"><div><span class="eyebrow">BẮT ĐẦU TỪ MỘT ĐIỂM ĐẾN</span><h2>Chọn nơi bạn muốn hiểu thêm.</h2></div></div><div class="ds-destination-grid">@foreach(var e in Model.Destinations){<a href="@DiscoveryText.Link(e.Id)"><img src="@Ui.DestinationImage(e.Region)" alt="Ảnh minh họa @e.Region" width="600" height="400" loading="lazy"/><span><small>KHÁM PHÁ KHU VỰC</small><strong>@e.Title</strong><b>Thông tin, cách đi và trải nghiệm @Ui.Icon("arrow")</b></span></a>}</div></section>}
 <section class="ds-results" id="ds-results"><div class="ds-section-head"><div><span class="eyebrow">THÔNG TIN CHO LỰA CHỌN CỦA BẠN</span><h2>@Model.Total kết quả@(Model.Total==1500?" (tối đa 1.500 mục)":"")</h2></div><button class="btn btn-outline" type="button" data-ds-map-toggle aria-expanded="true" aria-controls="discovery-map-area">@Ui.Icon("pin") Bản đồ / danh sách</button></div>
 @if(Model.PriceUnitsMixed){<p class="ds-note">Các mức giá có đơn vị khác nhau. Chọn cùng đơn vị trước khi sắp xếp giá; đối chiếu điều kiện ở trang chi tiết.</p>}
 <div class="ds-results-grid"><div><div class="ds-card-grid">@foreach(var card in Model.Items){<partial name="/Views/Discovery/_Card.cshtml" model="card"/>}</div>@if(Model.Items.Count==0){<div class="ds-empty">@Ui.Icon("search")<h3>Chưa có thông tin đáp ứng các điều kiện này.</h3><p>Thử bỏ một điều kiện, đổi từ khóa hoặc mở rộng khu vực. Những mục chưa được xác nhận tiện ích hay giờ mở cửa sẽ không xuất hiện trong bộ lọc tương ứng.</p><a class="btn btn-dark" href="/Discovery">Khám phá thông tin hiện có</a>@if(Model.HelpGuides?.Count>0){<h3>Hướng dẫn tổng quát để tham khảo</h3>@foreach(var guide in Model.HelpGuides){<p><a href="@DiscoveryText.Link(guide.Id)">@guide.Title</a></p>}}</div>}
 <nav class="ds-pagination" aria-label="Phân trang">@if(f.Page>1){<a class="btn btn-outline" href="@DiscoveryText.SearchUrl(f,page:f.Page-1)">Trang trước</a>}<span>Trang @f.Page</span>@if(f.Page*20<Model.Total){<a class="btn btn-outline" href="@DiscoveryText.SearchUrl(f,page:f.Page+1)">Trang tiếp</a>}</nav></div>
 <aside class="ds-map-area" id="discovery-map-area"><div class="ds-map-head"><strong>@Ui.Icon("pin") Nhìn thấy nơi bạn muốn đến</strong><p>Chọn ghim để xem thông tin; bấm trên bản đồ để đặt mốc tìm quanh đây.</p></div><div id="discovery-map" class="ds-map" aria-label="Bản đồ thông tin du lịch"></div><noscript><p>Bật JavaScript để dùng bản đồ. Danh sách và bộ lọc vẫn dùng được.</p></noscript><p class="ds-map-status" data-ds-map-status role="status">Đang tải các vị trí đã công bố…</p><button type="button" class="btn btn-outline" data-ds-map-search>Tìm trong khu vực đang xem</button>
 <details class="ds-route-panel"><summary>@Ui.Icon("car") Tìm dịch vụ dọc tuyến</summary><p>Chọn điểm đầu và cuối trên bản đồ, hoặc tìm tên trong dữ liệu hệ thống. Có thể thêm tối đa 8 điểm theo thứ tự bạn chọn.</p><label for="ds-route-target">Vị trí ghim tiếp theo</label><select id="ds-route-target"><option value="start">Điểm xuất phát</option><option value="end">Điểm đến</option><option value="stop">Thêm điểm dừng trước điểm đến</option></select><label for="ds-route-find">Tìm địa điểm cho tuyến</label><input id="ds-route-find" autocomplete="off" placeholder="Nhập tên rồi chọn gợi ý"/><div data-ds-route-suggestions></div><ol class="ds-route-points" data-ds-route-points></ol><button type="button" class="ds-quiet" data-ds-route-clear>Xóa các điểm đã chọn</button><label for="ds-mode">Phương tiện</label><select id="ds-mode"><option value="car">Ô tô</option><option value="foot">Đi bộ</option><option value="bike">Xe đạp</option></select><div class="ds-pair"><div><label for="ds-corridor">Gần tuyến (km)</label><input id="ds-corridor" type="number" min="0.1" max="20" step="0.1" value="2"/></div><div><label for="ds-detour">Đi thêm tối đa (phút)</label><input id="ds-detour" type="number" min="0" max="120" placeholder="Không giới hạn"/></div></div><p class="help">Khi tính tuyến, tọa độ các điểm được gửi đến OSRM/OpenStreetMap. Thời gian chưa gồm dừng, chờ và giao thông hiện tại.</p><button type="button" class="btn btn-dark" data-ds-route-compute>Xem tuyến & nơi có thể ghé</button><div data-ds-route-result role="status"></div><div data-ds-route-nearby></div><div data-ds-save-route hidden><label for="ds-route-name">Tên tuyến muốn lưu</label><input id="ds-route-name" maxlength="100" placeholder="Ví dụ: Một vòng khám phá Hội An"/><button type="button" class="btn btn-outline" data-ds-route-save>Lưu tuyến vào thư viện</button></div></details>
 <a class="ds-map-credit" href="https://www.openstreetmap.org/fixthemap" target="_blank" rel="noopener noreferrer">Báo lỗi dữ liệu nền bản đồ (mở tab mới)</a></aside></div></section>
 <div class="ds-selection-bar" data-ds-selection hidden role="status"><span data-ds-selection-count></span><a class="btn btn-dark" data-ds-compare-link href="/Discovery/Compare">So sánh lựa chọn</a><button type="button" class="ds-quiet" data-ds-clear-compare>Xóa lựa chọn</button></div>
 <div hidden data-ds-csrf>@Html.AntiForgeryToken()</div><script type="application/json" id="ds-filter-data">@Html.Raw(JsonSerializer.Serialize(f))</script>
</div>
@section Scripts{<script src="~/lib/leaflet/leaflet.js"></script><script src="~/js/discovery.js" asp-append-version="true"></script>}
