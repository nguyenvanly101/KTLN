@model DiscoveryManagePage
@using System.Text.Json
@{ViewData["Title"]="Quản lý thông tin tra cứu";var admin=User.IsInRole(TravelService.AdminRole);var tabs=new Dictionary<string,string>{{"entries","Nội dung"},{"questions","Hỏi đáp"},{"experiences","Kinh nghiệm"},{"reports","Phản ánh"},{"proposals","Đề nghị bổ sung"}};}
<div class="ds-page ds-manage"><header class="ds-section-head"><div><span class="eyebrow">THÔNG TIN CÓ NGUỒN. THAY ĐỔI CÓ LỊCH SỬ.</span><h1>Quản lý thông tin tra cứu</h1><p>@(admin?"Kiểm tra nội dung và phản hồi trước khi công bố.":"Bổ sung dữ liệu thực tế, trả lời câu hỏi cho dịch vụ thuộc đơn vị của bạn.")</p></div>@if(admin){<a class="btn btn-dark" href="/Discovery/Edit">@Ui.Icon("plus") Tạo thông tin</a>}</header><div asp-validation-summary="All" class="ds-errors" tabindex="-1" role="alert"></div>
<nav class="ds-kind-nav" aria-label="Nhóm công việc">@foreach(var t in tabs.Where(t=>admin||new[]{"entries","questions","proposals"}.Contains(t.Key))){<a class="@(Model.Tab==t.Key?"active":"")" href="/Discovery/Manage?tab=@t.Key">@t.Value</a>}</nav>
@if(Model.Tab=="entries"){<p>Hiển thị tối đa 200 nội dung cập nhật gần đây. Dịch vụ mới được đưa vào tra cứu sau khi công bố, trong khoảng một phút.</p><div class="ds-table-wrap"><table class="ds-table"><caption>Nội dung thuộc phạm vi quản lý</caption><thead><tr><th>Nội dung</th><th>Trạng thái</th><th>Nguồn / kiểm tra</th><th>Thao tác</th></tr></thead><tbody>@foreach(var e in Model.Entries){<tr><td><strong>@e.Title</strong><small>@DiscoveryText.Kind(e.Kind) · @e.Region</small></td><td>@DiscoveryText.State(e.Status)</td><td>@e.SourceName<small>@(e.CheckedOn?.ToString("dd/MM/yyyy")??"Chưa ghi ngày kiểm tra")</small></td><td><a href="/Discovery/Edit/@e.Id">@(admin?"Chỉnh sửa":"Đề nghị bổ sung")</a>@if(e.Status=="Published"){<a href="@DiscoveryText.Link(e.Id)">Xem trang công bố</a>}</td></tr>}</tbody></table></div>}
else if(Model.Tab=="questions"){@foreach(var q in Model.Questions){<section class="ds-panel"><a href="@DiscoveryText.Link(q.EntryId)">@Model.References.GetValueOrDefault(q.EntryId)?.Title</a><h2>@q.Question</h2><p>@Model.Names.GetValueOrDefault(q.OwnerId,"Người hỏi") · @DiscoveryText.State(q.Status)</p><form method="post" action="/Discovery/Answer" class="ds-form">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@q.Id"/><input type="hidden" name="Version" value="@TravelService.Token(q.RowVersion)"/><label for="answer-@q.Id">Câu trả lời</label><textarea id="answer-@q.Id" name="Text" maxlength="4000" rows="4">@q.Answer</textarea><label for="answer-source-@q.Id">Nguồn HTTPS (nếu có)</label><input id="answer-source-@q.Id" name="Source" type="url" value="@q.AnswerSource" maxlength="1000"/>@if(admin){<label for="answer-reason-@q.Id">Lý do (khi ẩn)</label><input id="answer-reason-@q.Id" name="Reason" maxlength="500"/>}<div><button class="btn btn-dark" name="Decision" value="Answer">@(admin?"Công bố câu trả lời":"Gửi câu trả lời để kiểm tra")</button>@if(admin){<button class="btn btn-outline" name="Decision" value="Hide">Ẩn câu hỏi</button>}</div></form></section>}}
else if(Model.Tab=="experiences"){@foreach(var x in Model.Experiences){<section class="ds-panel"><a href="@DiscoveryText.Link(x.EntryId)">@Model.References.GetValueOrDefault(x.EntryId)?.Title</a><h2>@x.Title</h2><p>@Model.Names.GetValueOrDefault(x.OwnerId,"Người chia sẻ") · @x.VisitedOn.ToString("dd/MM/yyyy") · @x.Rating/5 · @DiscoveryText.State(x.Status)</p><p class="ds-prose">@x.Body</p><p>@x.Topics</p><form method="post" action="/Discovery/ModerateExperience" class="ds-form">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"/><input type="hidden" name="Version" value="@TravelService.Token(x.RowVersion)"/><label for="moderation-@x.Id">Lý do kiểm duyệt</label><input id="moderation-@x.Id" name="Reason" maxlength="500" value="@x.ModerationNote" required/><div><button class="btn btn-dark" name="Decision" value="Published">Công bố</button><button class="btn btn-outline" name="Decision" value="Hidden">Ẩn</button></div></form></section>}}
else if(Model.Tab=="reports"){@foreach(var x in Model.Reports){<section class="ds-panel"><a href="@DiscoveryText.Link(x.EntryId)">@Model.References.GetValueOrDefault(x.EntryId)?.Title</a><h2>Phản ánh cần kiểm tra</h2><p class="ds-prose">@x.Body</p><p>@DiscoveryText.State(x.Status) · @Ui.LocalTime(x.CreatedAt).ToString("dd/MM/yyyy HH:mm")</p>@if(!string.IsNullOrEmpty(x.EvidenceUrl)){<a href="@x.EvidenceUrl" target="_blank" rel="noopener noreferrer">Xem nguồn phản ánh (mở tab mới)</a>}<p>@x.Response</p>@if(x.Status is "Pending" or "Checking"){<form method="post" action="/Discovery/HandleReport" class="ds-form">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"/><input type="hidden" name="Version" value="@TravelService.Token(x.RowVersion)"/><label for="report-response-@x.Id">Phản hồi / kết quả đã xác minh</label><textarea id="report-response-@x.Id" name="Text" maxlength="1000" required></textarea><div>@if(x.Status=="Pending"){<button class="btn btn-dark" name="Decision" value="Checking">Tiếp nhận xác minh</button>}else{<button class="btn btn-dark" name="Decision" value="Resolved">Ghi kết quả đã xử lý</button><button class="btn btn-outline" name="Decision" value="Rejected">Không chấp thuận phản ánh</button>}</div><p class="help">Cập nhật nội dung tại trang chỉnh sửa sau khi xác minh. Đóng phản ánh không tự thay đổi thông tin đang công bố.</p></form>}</section>}}
else if(Model.Tab=="proposals"){@foreach(var x in Model.Proposals){var input=JsonSerializer.Deserialize<DiscoveryEditInput>(x.Payload);<section class="ds-panel"><h2>@Model.References.GetValueOrDefault(x.EntryId)?.Title</h2><p>@DiscoveryText.State(x.Status) · @Ui.LocalTime(x.CreatedAt).ToString("dd/MM/yyyy HH:mm")</p><p>@x.Reason</p>@if(input!=null){<details><summary>Xem đầy đủ nội dung đề nghị trước khi quyết định</summary><dl class="ds-facts">@foreach(var p in typeof(DiscoveryEditInput).GetProperties().Where(p=>new[]{"Title","Kind","Region","Summary","Content","Address","Latitude","Longitude","LocationNote","SourceName","SourceUrl","CheckedOn","ValidFrom","ValidTo","PriceFrom","PriceTo","PriceUnit","Includes","Excludes","Hours","OpenDays","OpenTime","CloseTime","DurationMinutes","Tags","TransportMode","Origin","Destination","Contact","Reason","ParentId","Status"}.Contains(p.Name))){<div><dt>@DiscoveryText.FieldLabel(p.Name)</dt><dd class="ds-prose">@(p.GetValue(input)?.ToString()??"Chưa cung cấp")</dd></div>}</dl><h3>Tiện ích</h3>@foreach(var f in input.FeatureRows){<p>@DiscoveryText.Features.GetValueOrDefault(f.Code): @DiscoveryText.State(f.State) · @f.Note</p>}<h3>Bảng giá</h3>@foreach(var p in input.Prices.Where(p=>!string.IsNullOrWhiteSpace(p.Label))){<p>@p.Label · @Labels.Money(p.Amount) / @p.Unit · @p.Conditions · @p.Included · @p.Extra · @p.From – @p.Until</p>}</details>}@if(admin&&x.Status=="Pending"){<form method="post" action="/Discovery/ReviewProposal" class="ds-form">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"/><input type="hidden" name="Version" value="@TravelService.Token(x.RowVersion)"/><label for="proposal-reason-@x.Id">Lý do quyết định</label><input id="proposal-reason-@x.Id" name="Reason" maxlength="500" required/><div><button class="btn btn-dark" name="Decision" value="Accepted">Chấp thuận nội dung trên</button><button class="btn btn-outline" name="Decision" value="Rejected">Không chấp thuận</button></div><p class="help">Nếu thông tin gốc đã đổi, đề nghị sẽ không được áp dụng; nhà cung cấp cần gửi lại trên phiên bản mới.</p></form>}</section>}}
@if(Model.Tab!="entries"){<p class="help">Hiển thị tối đa 100 mục gần đây, ưu tiên các mục đang chờ.</p>}
</div>
@section Scripts{<script src="~/js/discovery.js" asp-append-version="true"></script>}
