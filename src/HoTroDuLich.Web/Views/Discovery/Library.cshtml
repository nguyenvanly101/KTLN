@model DiscoveryLibraryPage
@using System.Text.Json
@{ViewData["Title"]="Thư viện tra cứu";}
<div class="ds-page" data-discovery-library><header class="ds-section-head"><div><span class="eyebrow">NHỮNG ĐIỀU BẠN MUỐN NHỚ</span><h1>Thư viện tra cứu</h1><p>Danh sách và tuyến đã lưu là riêng tư. Bạn có thể tìm hiểu trước khi tạo chuyến đi.</p></div><a class="btn btn-dark" href="/Discovery">Tiếp tục khám phá @Ui.Icon("arrow")</a></header><div asp-validation-summary="All" class="ds-errors" tabindex="-1" role="alert"></div>
<section class="ds-panel" data-ds-local-library><h2>Đã lưu trên thiết bị này</h2><p>Chọn những mục muốn đồng bộ vào tài khoản. Thông tin đã ẩn sẽ không được đồng bộ.</p><form method="post" action="/Discovery/Collection">@Html.AntiForgeryToken()<input type="hidden" name="Decision" value="Import"/><div data-ds-local-items></div><label for="ds-import-name">Tên danh sách nhận lựa chọn</label><input id="ds-import-name" name="Name" maxlength="100" value="Đã lưu trên thiết bị" required/><button class="btn btn-dark">Đồng bộ những mục đã chọn</button></form><div data-ds-local-route-import></div></section>
<section class="ds-panel"><h2>Tạo danh sách thông tin</h2><form method="post" action="/Discovery/Collection" class="ds-inline-form">@Html.AntiForgeryToken()<input type="hidden" name="Decision" value="Create"/><label for="ds-collection-name">Tên danh sách</label><input id="ds-collection-name" name="Name" maxlength="100" placeholder="Ví dụ: Những nơi muốn ghé ở Hội An" required/><button class="btn btn-outline">Tạo danh sách</button></form></section>
<div class="ds-library-grid">@foreach(var c in Model.Collections){<section class="ds-panel"><header class="ds-section-head"><h2>@c.Name</h2><small>@Model.Items.Count(x=>x.CollectionId==c.Id) lựa chọn</small></header>@foreach(var item in Model.Items.Where(x=>x.CollectionId==c.Id)){var e=Model.Entries.GetValueOrDefault(item.EntryId);<article class="ds-library-item"><div>@if(e!=null){<a href="@DiscoveryText.Link(e.Id)"><strong>@e.Title</strong></a><small>@DiscoveryText.Kind(e.Kind) · @e.Region</small>}else{<strong>Thông tin không còn được công bố</strong>}<p>@item.Note</p><details><summary>Ghi chú riêng</summary><form method="post" action="/Discovery/Collection" class="ds-form">@Html.AntiForgeryToken()<input type="hidden" name="CollectionId" value="@c.Id"/><input type="hidden" name="EntryId" value="@item.EntryId"/><input type="hidden" name="Version" value="@TravelService.Token(item.RowVersion)"/><input type="hidden" name="Decision" value="Note"/><label for="item-note-@c.Id-@item.EntryId">Ghi chú</label><textarea id="item-note-@c.Id-@item.EntryId" name="Body" maxlength="500">@item.Note</textarea><button class="btn btn-outline">Lưu ghi chú</button></form></details></div><form method="post" action="/Discovery/Collection">@Html.AntiForgeryToken()<input type="hidden" name="CollectionId" value="@c.Id"/><input type="hidden" name="EntryId" value="@item.EntryId"/><input type="hidden" name="Version" value="@TravelService.Token(item.RowVersion)"/><input type="hidden" name="Decision" value="Remove"/><button class="ds-quiet">Bỏ khỏi danh sách</button></form></article>}
<details><summary>Đổi tên / lưu trữ danh sách</summary><form method="post" action="/Discovery/Collection" class="ds-form">@Html.AntiForgeryToken()<input type="hidden" name="CollectionId" value="@c.Id"/><input type="hidden" name="Version" value="@TravelService.Token(c.RowVersion)"/><label for="collection-name-@c.Id">Tên</label><input id="collection-name-@c.Id" name="Name" value="@c.Name" maxlength="100"/><label for="collection-note-@c.Id">Ghi chú</label><textarea id="collection-note-@c.Id" name="Body" maxlength="500">@c.Note</textarea><button class="btn btn-outline" name="Decision" value="Rename">Lưu tên và ghi chú</button><button class="ds-quiet" name="Decision" value="Archive">Lưu trữ danh sách</button></form></details></section>}</div>
<section class="ds-panel"><h2>Đang theo dõi</h2>@if(Model.Followed.Count==0){<p>Chọn Theo dõi thay đổi tại thông tin bạn quan tâm.</p>}@foreach(var e in Model.Followed){<div class="ds-library-item"><a href="@DiscoveryText.Link(e.Id)">@e.Title</a><form method="post" action="/Discovery/Follow">@Html.AntiForgeryToken()<input type="hidden" name="EntryId" value="@e.Id"/><input type="hidden" name="Decision" value="Unfollow"/><input type="hidden" name="ReturnUrl" value="/Discovery/Library"/><button class="ds-quiet">Bỏ theo dõi</button></form></div>}</section>
@foreach(var hiddenId in Model.UnavailableFollowed??[]){<div class="ds-panel"><p>Một mục đang theo dõi không còn được công bố.</p><form method="post" action="/Discovery/Follow">@Html.AntiForgeryToken()<input type="hidden" name="EntryId" value="@hiddenId"/><input type="hidden" name="Decision" value="Unfollow"/><input type="hidden" name="ReturnUrl" value="/Discovery/Library"/><button class="ds-quiet">Bỏ theo dõi mục đã ẩn</button></form></div>}
<section class="ds-panel"><h2>Tuyến đã lưu</h2><p>Thời gian di chuyển được tính lại khi mở tuyến. Các điểm giữ nguyên thứ tự đã lưu.</p>@foreach(var r in Model.Routes){var points=JsonSerializer.Deserialize<List<DiscoveryPoint>>(r.PointsJson)??[];<article class="ds-library-item"><div><h3>@r.Name</h3><p>@string.Join(" → ",points.Select(p=>p.Name??"Điểm đã chọn"))</p><button class="btn btn-outline" type="button" data-ds-open-route="@r.Id">Mở tuyến trên bản đồ</button><script type="application/json" id="ds-saved-route-@r.Id">@Html.Raw(JsonSerializer.Serialize(new{points,mode=r.Mode}))</script></div><form method="post" action="/Discovery/ArchiveRoute">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.Id"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><button class="ds-quiet">Lưu trữ tuyến</button></form></article>}</section>
<section class="ds-panel"><h2>Câu hỏi của bạn</h2>@foreach(var q in Model.Questions){<article class="ds-discussion"><a href="@DiscoveryText.Link(q.EntryId)#questions">@q.Question</a><span class="ds-state">@DiscoveryText.State(q.Status)</span>@if(q.Status=="Answered"){<p>@q.Answer</p>}</article>}</section>
<section class="ds-panel" id="reports"><h2>Phản ánh và kết quả kiểm tra</h2>@foreach(var r in Model.Reports){<article class="ds-discussion"><p>@r.Body</p><span class="ds-state">@DiscoveryText.State(r.Status)</span><p>@(r.Response??"Chưa có người tiếp nhận xác minh.")</p><small>@Ui.LocalTime(r.UpdatedAt).ToString("dd/MM/yyyy HH:mm")</small></article>}</section>
</div>
@section Scripts{<script src="~/js/discovery.js" asp-append-version="true"></script>}
