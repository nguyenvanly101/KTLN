@model List<DiscoveryDetailPage>
@{ViewData["Title"]="So sánh thông tin";}
<div class="ds-page"><a class="back" href="/Discovery" data-ds-back>← Trở lại tra cứu</a><header class="ds-section-head"><div><span class="eyebrow">ĐẶT CÁC LỰA CHỌN CẠNH NHAU</span><h1>Điều gì phù hợp với bạn?</h1><p>Đối chiếu giá cùng đơn vị, điều kiện và thời điểm kiểm tra nguồn.</p></div></header><div class="ds-compare-grid">@foreach(var p in Model){var e=p.Entry;<article class="ds-panel"><span class="eyebrow">@DiscoveryText.Kind(e.Kind) · @e.Region</span><h2><a href="@DiscoveryText.Link(e.Id)">@e.Title</a></h2><p>@e.Summary</p><dl class="ds-facts"><div><dt>Vị trí</dt><dd>@(e.Address??"Chưa có địa chỉ chi tiết")</dd></div><div><dt>Giá tham khảo</dt><dd>@(e.PriceFrom==null?"Chưa công bố":Labels.Money(e.PriceFrom)) / @(e.PriceUnit??"chưa công bố đơn vị")</dd></div><div><dt>Giờ phục vụ</dt><dd>@(e.Hours??"Chưa xác nhận")</dd></div><div><dt>Bao gồm</dt><dd>@(e.Includes??"Chưa công bố")</dd></div><div><dt>Khoản trả thêm</dt><dd>@(e.Excludes??"Chưa công bố")</dd></div><div><dt>Nguồn</dt><dd>@e.SourceName · @(e.CheckedOn?.ToString("dd/MM/yyyy")??"chưa có ngày kiểm tra")</dd></div></dl><h3>Điều kiện tiếp cận</h3>@foreach(var f in DiscoveryText.Features){var value=p.Features.SingleOrDefault(x=>x.Code==f.Key);<p><strong>@f.Value:</strong> @DiscoveryText.State(value?.State??"Unknown")</p>}<a class="btn btn-dark" href="@DiscoveryText.Link(e.Id)">Xem đầy đủ</a></article>}</div></div>
