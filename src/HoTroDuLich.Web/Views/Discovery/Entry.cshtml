@model DiscoveryDetailPage
@using System.Text.Json
@{var e=Model.Entry;var signed=User.Identity?.IsAuthenticated==true;var traveler=User.IsInRole(TravelService.Traveler);ViewData["Title"]=e.Title;var sourceOld=e.CheckedOn!=null&&e.CheckedOn<TravelService.Today.AddDays(-180);}
<div class="ds-page ds-detail" data-discovery-entry>
 <nav class="ds-breadcrumb" aria-label="Đường dẫn"><a href="/Discovery" data-ds-back>Khám phá</a><span>/</span><a href="/Discovery?region=@Uri.EscapeDataString(e.Region)">@e.Region</a><span>/</span><span>@DiscoveryText.Kind(e.Kind)</span></nav>
 <div asp-validation-summary="All" class="ds-errors" tabindex="-1" role="alert"></div>
 <header class="ds-entry-header"><div><span class="eyebrow">@DiscoveryText.Kind(e.Kind).ToUpperInvariant() · @e.Region</span><h1>@e.Title</h1><p>@e.Summary</p><div class="ds-entry-actions"><button type="button" class="btn btn-dark" data-ds-save="@e.Id" data-title="@e.Title">@Ui.Icon("plus") Lưu để xem lại</button><label class="btn btn-outline"><input type="checkbox" data-ds-compare="@e.Id" data-kind="@e.Kind"/> Thêm vào so sánh</label>@if(signed){<form method="post" action="/Discovery/Follow">@Html.AntiForgeryToken()<input type="hidden" name="EntryId" value="@e.Id"/><input type="hidden" name="Decision" value="@(Model.Following?"Unfollow":"Follow")"/><button class="btn btn-outline">@(Model.Following?"Đang theo dõi · Bỏ theo dõi":"Theo dõi thay đổi")</button></form>}else{<a class="btn btn-outline" href="/Account/Login?returnUrl=@Uri.EscapeDataString(DiscoveryText.Link(e.Id))">Đăng nhập để theo dõi</a>}</div></div><figure><img src="@Ui.DestinationImage(e.Region)" alt="Ảnh minh họa khu vực @e.Region" width="640" height="480"/><figcaption>Ảnh minh họa khu vực</figcaption></figure></header>
 <nav class="ds-entry-nav" aria-label="Thông tin trên trang"><a href="#overview">Tổng quan</a><a href="#location">Vị trí</a><a href="#practical">Giá & điều kiện</a><a href="#accessibility">Tiện ích</a><a href="#nearby">Xung quanh</a><a href="#questions">Hỏi đáp</a><a href="#experiences">Kinh nghiệm</a></nav>
 <div class="ds-detail-grid"><article>
 <section class="ds-panel" id="overview"><span class="eyebrow">TÌM HIỂU TRƯỚC KHI CHỌN</span><h2>Thông tin cần biết</h2><div class="ds-prose">@(string.IsNullOrWhiteSpace(e.Body)?"Mục này chưa có hướng dẫn bổ sung. Xem các thông tin đã công bố bên dưới hoặc gửi câu hỏi để được làm rõ.":e.Body)</div>
 @if(e.Kind=="Transport"){<dl class="ds-facts"><div><dt>Xuất phát</dt><dd>@(e.Origin??"Chưa công bố")</dd></div><div><dt>Điểm đến</dt><dd>@(e.Destination??"Chưa công bố")</dd></div><div><dt>Phương tiện / cách đi</dt><dd>@(e.TransportMode??"Xem hướng dẫn")</dd></div></dl><p class="ds-note">Kiểm tra lịch vận hành, điểm đón trả, chuyển chặng và hành lý tại nguồn trước khi mua vé.</p>}
 @if(e.ValidFrom!=null||e.ValidTo!=null){<p class="ds-note">Thời gian áp dụng: @(e.ValidFrom?.ToString("dd/MM/yyyy")??"chưa xác định ngày bắt đầu") – @(e.ValidTo?.ToString("dd/MM/yyyy")??"chưa xác định ngày kết thúc"). @if(e.ValidTo<TravelService.Today){<b>Thời gian công bố đã kết thúc.</b>}</p>}
 </section>
 <section class="ds-panel" id="practical"><h2>Giá, giờ phục vụ và điều kiện</h2><dl class="ds-facts"><div><dt>Giá tham khảo</dt><dd>@(e.PriceFrom!=null?Labels.Money(e.PriceFrom):"Chưa công bố")@(e.PriceTo!=null?" – "+Labels.Money(e.PriceTo):"")@if(e.PriceFrom!=null){<small> / @(e.PriceUnit??"chưa công bố đơn vị")</small>}</dd></div><div><dt>Thời gian phục vụ</dt><dd>@(e.Hours??"Chưa có thông tin xác nhận")</dd></div><div><dt>Thời lượng tham khảo</dt><dd>@(e.DurationMinutes!=null?e.DurationMinutes+" phút":"Chưa công bố")</dd></div><div><dt>Bao gồm</dt><dd>@(e.Includes??"Chưa công bố")</dd></div><div><dt>Khoản trả thêm / chưa bao gồm</dt><dd>@(e.Excludes??"Chưa công bố — cần kiểm tra trước khi chọn")</dd></div></dl>
 @if(Model.Prices.Count>0){<div class="ds-table-wrap"><table class="ds-table"><caption>Các mức giá và điều kiện được công bố</caption><thead><tr><th>Đối tượng / hạng mục</th><th>Mức giá</th><th>Điều kiện, thời gian</th></tr></thead><tbody>@foreach(var p in Model.Prices){<tr><td>@p.Label</td><td>@(p.Amount==null?"Chưa xác nhận":Labels.Money(p.Amount)) / @p.Unit</td><td><p>@p.Conditions</p><p>Bao gồm: @p.Included</p><p>Trả thêm: @p.Extra</p>@if(p.From!=null||p.Until!=null){<small>@p.From?.ToString("dd/MM/yyyy") – @p.Until?.ToString("dd/MM/yyyy") @(p.Until<TravelService.Today?"· Đã hết hiệu lực":"")</small>}</td></tr>}</tbody></table></div>}
 @if(e.ServiceId!=null){<a class="btn btn-dark" href="/Explore/Detail/@e.ServiceId">Thông tin nhà cung cấp & yêu cầu đặt @Ui.Icon("arrow")</a><p class="help">Giá và trạng thái tiếp nhận lấy từ thông tin dịch vụ hiện hành. Còn chỗ và điều kiện cuối cùng được nhà cung cấp xác nhận khi phản hồi.</p>}else if(e.Kind=="Service"){<p class="ds-note">Dịch vụ từ nguồn tham khảo bên ngoài. Hệ thống chưa tiếp nhận yêu cầu đặt cho mục này.</p>}
 @if(e.PlaceId!=null&&(!signed||traveler)){<a class="btn btn-outline" href="/Plans/Select?placeId=@e.PlaceId">Thêm địa điểm vào kế hoạch</a>}
 </section>
 <section class="ds-panel" id="accessibility"><h2>Điều kiện tiếp cận và tiện ích</h2><p>“Chưa có thông tin” cần được hỏi thêm trước khi quyết định.</p><div class="ds-feature-grid">@foreach(var f in DiscoveryText.Features){var value=Model.Features.SingleOrDefault(x=>x.Code==f.Key);<div><strong>@f.Value</strong><span class="ds-state state-@(value?.State??"Unknown")">@DiscoveryText.State(value?.State??"Unknown")</span>@if(!string.IsNullOrEmpty(value?.Note)){<small>@value.Note</small>}</div>}</div></section>
 <section class="ds-panel" id="questions"><div class="ds-section-head"><div><span class="eyebrow">LÀM RÕ TRƯỚC KHI ĐẾN</span><h2>Hỏi đáp tại đây</h2></div></div>@if(Model.Questions.Count==0){<p>Chưa có câu trả lời được công bố. Bạn có thể gửi câu hỏi cụ thể bên dưới.</p>}
 @foreach(var q in Model.Questions){<article class="ds-discussion"><h3>@q.Question</h3><small>@Model.Names.GetValueOrDefault(q.OwnerId,"Người dùng") · @Ui.LocalTime(q.CreatedAt).ToString("dd/MM/yyyy") · @DiscoveryText.State(q.Status)</small>@if(q.Status=="Answered"){<p class="ds-prose">@q.Answer</p><small>Trả lời bởi @Model.Names.GetValueOrDefault(q.AnsweredBy??0,"Đơn vị quản lý") · @Ui.LocalTime(q.AnsweredAt!.Value).ToString("dd/MM/yyyy")</small>@if(!string.IsNullOrEmpty(q.AnswerSource)){<a class="ds-source-link" href="@q.AnswerSource" target="_blank" rel="noopener noreferrer">Nguồn câu trả lời (mở tab mới)</a>}}else{<p class="help">Câu hỏi của bạn đang chờ kiểm tra hoặc trả lời.</p>}</article>}
 @if(signed){<form method="post" action="/Discovery/Ask" class="ds-form">@Html.AntiForgeryToken()<input type="hidden" name="EntryId" value="@e.Id"/><input type="hidden" name="SubmissionId" value="@Model.Input.SubmissionId"/><label for="ds-question">Bạn cần biết thêm điều gì?</label><textarea id="ds-question" name="Body" rows="3" maxlength="1000" required>@(ViewContext.RouteData.Values["action"]?.ToString()=="Ask"?Model.Input.Body:"")</textarea><p class="help">Câu hỏi và tên hiển thị được công khai sau khi kiểm tra. Tránh ghi số điện thoại hay thông tin riêng tư.</p><button class="btn btn-dark">Gửi câu hỏi</button></form>}else{<a href="/Account/Login?returnUrl=@Uri.EscapeDataString(DiscoveryText.Link(e.Id)+"#questions")">Đăng nhập để gửi câu hỏi</a>}</section>
 <section class="ds-panel" id="experiences"><h2>Kinh nghiệm theo điều bạn quan tâm</h2><nav class="ds-topic-nav" aria-label="Chủ đề kinh nghiệm"><a href="@DiscoveryText.Link(e.Id)#experiences">Tất cả</a>@foreach(var t in DiscoveryText.Topics){<a href="@DiscoveryText.Link(e.Id)?topic=@t.Key#experiences">@t.Value</a>}</nav>@if(Model.Experiences.Count==0){<p>Chưa có kinh nghiệm được công bố cho lựa chọn này.</p>}
 @foreach(var x in Model.Experiences){<article class="ds-discussion"><h3>@x.Title <small>@x.Rating/5</small></h3><small>@Model.Names.GetValueOrDefault(x.OwnerId,"Người chia sẻ") · Trải nghiệm @x.VisitedOn.ToString("dd/MM/yyyy") · @DiscoveryText.State(x.Status)</small><p class="ds-prose">@x.Body</p><small>Chia sẻ cá nhân; ngày trải nghiệm do người viết cung cấp.</small></article>}
 @if(traveler&&e.ServiceId==null){<details><summary>Chia sẻ kinh nghiệm của bạn</summary><form method="post" action="/Discovery/Experience" class="ds-form">@Html.AntiForgeryToken()<input type="hidden" name="EntryId" value="@e.Id"/><input type="hidden" name="SubmissionId" value="@Model.Input.SubmissionId"/><label for="ds-exp-title">Tiêu đề</label><input id="ds-exp-title" name="Name" maxlength="150" required/><div class="ds-pair"><div><label for="ds-visited">Ngày trải nghiệm</label><input id="ds-visited" name="VisitedOn" type="date" max="@TravelService.Today.ToString("yyyy-MM-dd")" required/></div><div><label for="ds-rating">Đánh giá</label><select id="ds-rating" name="Rating">@for(var n=5;n>=1;n--){<option value="@n">@n/5</option>}</select></div></div><label for="ds-exp-topic">Chủ đề</label><select id="ds-exp-topic" name="Topics">@foreach(var t in DiscoveryText.Topics){<option value="@t.Key">@t.Value</option>}</select><label for="ds-exp-body">Điều bạn muốn chia sẻ</label><textarea id="ds-exp-body" name="Body" maxlength="2000" rows="4" required></textarea><p class="help">Nội dung và tên hiển thị được công khai sau kiểm duyệt. Đây là chia sẻ cá nhân; không tự tạo nhãn đã xác minh chuyến đi.</p><button class="btn btn-dark">Gửi để kiểm duyệt</button></form></details>}else if(e.ServiceId!=null){<a href="/Explore/Detail/@e.ServiceId">Xem đánh giá dịch vụ; viết đánh giá từ yêu cầu đặt đã sử dụng.</a>}</section>
 <section class="ds-panel" id="nearby"><h2>Tiếp tục tìm hiểu quanh đây</h2><div class="ds-shortcuts">@foreach(var k in new[]{"Service","Place","Transport","Amenity","Area"}){<a href="/Discovery?kind=@k&region=@Uri.EscapeDataString(e.Region)@(e.Latitude!=null?"&Lat="+e.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)+"&Lng="+e.Longitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture):"")">@DiscoveryText.Kind(k) @Ui.Icon("arrow")</a>}</div><div class="ds-card-grid">@foreach(var card in Model.Related){<partial name="/Views/Discovery/_Card.cshtml" model="card"/>}</div></section>
 </article><aside><div class="ds-panel ds-detail-location" id="location"><h2>@Ui.Icon("pin") Vị trí và nguồn</h2><p>@(e.Address??"Chưa công bố địa chỉ chi tiết")</p>@if(e.Latitude!=null){<div id="discovery-map" class="ds-map ds-map-small" aria-label="Bản đồ khu vực"></div><p class="help">@e.LocationNote</p><a class="btn btn-outline" href="/Discovery?Lat=@e.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)&Lng=@e.Longitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)&RadiusKm=5">Tìm quanh vị trí này</a>}else{<p class="ds-note">Chưa có tọa độ đã kiểm tra. Bạn có thể tìm khu vực trên bản đồ và chọn ghim.</p><a href="/Discovery?region=@Uri.EscapeDataString(e.Region)">Mở bản đồ khu vực</a>}<hr/><strong>Nguồn thông tin</strong><p>@e.SourceName</p>@if(!string.IsNullOrEmpty(e.SourceUrl)){<a class="ds-source-link" href="@e.SourceUrl" target="_blank" rel="noopener noreferrer">Đối chiếu nguồn (mở tab mới)</a>}<p>Ngày kiểm tra: @(e.CheckedOn?.ToString("dd/MM/yyyy")??"Chưa được ghi nhận")</p>@if(sourceOld){<p class="ds-note">Nguồn được kiểm tra cách đây hơn 6 tháng. Đối chiếu lại thông tin trước khi đến.</p>}@if(!string.IsNullOrEmpty(e.Contact)){<p>Liên hệ công bố: @e.Contact</p>}<a href="#report">Báo thông tin cần kiểm tra</a></div>
 <section class="ds-panel"><h2>Cập nhật gần đây</h2>@if(Model.Updates.Count==0){<p>Chưa có bản cập nhật bổ sung được công bố.</p>}@foreach(var r in Model.Updates){<p><small>@Ui.LocalTime(r.CreatedAt).ToString("dd/MM/yyyy HH:mm")</small><br/>@r.Summary</p>}</section>
 <section class="ds-panel" id="report"><h2>Thông tin chưa đúng?</h2>@if(signed){<form method="post" action="/Discovery/Report" class="ds-form">@Html.AntiForgeryToken()<input type="hidden" name="EntryId" value="@e.Id"/><input type="hidden" name="SubmissionId" value="@Model.Input.SubmissionId"/><label for="ds-report-type">Phần cần kiểm tra</label><select id="ds-report-type" name="Decision"><option value="Price">Giá</option><option value="Hours">Giờ phục vụ</option><option value="Address">Địa chỉ / vị trí</option><option value="Accessibility">Điều kiện tiếp cận</option><option value="Closed">Tạm đóng cửa</option><option value="Content">Nội dung</option><option value="Other">Khác</option></select><label for="ds-report-body">Mô tả cụ thể</label><textarea id="ds-report-body" name="Body" maxlength="2000" required></textarea><label for="ds-report-source">Nguồn / bằng chứng (HTTPS, tùy chọn)</label><input id="ds-report-source" name="Source" type="url" maxlength="1000"/><button class="btn btn-outline">Gửi phản ánh</button></form>}else{<a href="/Account/Login?returnUrl=@Uri.EscapeDataString(DiscoveryText.Link(e.Id)+"#report")">Đăng nhập để phản ánh</a>}</section></aside></div>
 <div class="ds-selection-bar" data-ds-selection hidden role="status"><span data-ds-selection-count></span><a class="btn btn-dark" data-ds-compare-link href="/Discovery/Compare">So sánh</a><button class="ds-quiet" type="button" data-ds-clear-compare>Xóa lựa chọn</button></div>
 <script type="application/json" id="ds-entry-data">@Html.Raw(JsonSerializer.Serialize(new{id=e.Id,title=e.Title,kind=e.Kind,lat=e.Latitude,lng=e.Longitude,url=DiscoveryText.Link(e.Id)}))</script>
</div>
@section Scripts{<script src="~/lib/leaflet/leaflet.js"></script><script src="~/js/discovery.js" asp-append-version="true"></script>}
