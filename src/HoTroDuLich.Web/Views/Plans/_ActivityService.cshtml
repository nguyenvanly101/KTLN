@model ActivityInput
@{
 var plan=(KeHoachChuyenDi)ViewBag.Plan;var activityId=(long)(ViewBag.ActivityId??0L);
 var saved=ViewBag.SavedServices as List<DichVuDuLich>??[];
 var service=ViewBag.SourceService as DichVuDuLich;var provider=ViewBag.ServiceProvider as NhaCungCapDichVu;
 string Pick(long id)=>"/Plans/Activity/"+plan.MaKeHoach+"?serviceId="+id+(activityId>0?"&activityId="+activityId:"");
}
<section class="panel activity-service" aria-labelledby="activity-service-title">
 <span class="eyebrow">DỊCH VỤ CHO HẠNG MỤC NÀY</span><h2 id="activity-service-title">Thêm dịch vụ</h2>
 @if(service!=null)
 {
  <div class="activity-service-card">
   <div><strong>@service.TenDichVu</strong><p class="help">@service.KhuVucPhucVu · @DanhMuc.Ten(service.LoaiDichVu) · @Labels.Money(service.GiaThamKhao)</p>
   @if(provider!=null){<p class="help">@provider.TenDonVi · @provider.SoDienThoai · @provider.EmailLienHe</p>}</div>
   <div class="actions">
    <a class="btn btn-outline" href="/tin-nhan/dich-vu/@service.MaDichVu">@Ui.Icon("chat") Nhắn tin nhà cung cấp</a>
    @if((bool)(ViewBag.Requestable??false)&&activityId>0){<a class="btn btn-dark" href="/Bookings/Create/@service.MaDichVu?planId=@plan.MaKeHoach&activityId=@activityId">@Ui.Icon("ticket") Gửi yêu cầu đặt tới nhà cung cấp</a>}
    <a class="text-link" href="/Explore/Detail/@service.MaDichVu?planId=@plan.MaKeHoach">Xem dịch vụ @Ui.Icon("arrow")</a>
   </div>
   @if(activityId==0){<p class="help">Lưu hoạt động trước, sau đó gửi yêu cầu đặt để nhà cung cấp xác nhận.</p>}
  </div>
 }
 else if(ViewBag.ServiceGone==true){<div class="notice warning">Dịch vụ gắn với hạng mục này không còn được công bố. Hãy chọn dịch vụ khác.</div>}
 <div class="activity-service-options">
  @if(saved.Count>0)
  {
   <details @(service==null?"open":"")><summary>@Ui.Icon("check") Chọn từ dịch vụ đã lưu (@saved.Count)</summary>
    <div class="activity-saved-list">@foreach(var sv in saved){<a href="@Pick(sv.MaDichVu)"><strong>@sv.TenDichVu</strong><small>@sv.KhuVucPhucVu · @Labels.Money(sv.GiaThamKhao)</small></a>}</div></details>
  }
  else{<p class="help">Chưa có dịch vụ nào được lưu. Bạn có thể tìm dịch vụ rồi lưu lại, hoặc thêm trực tiếp từ kết quả tìm kiếm.</p>}
  <div class="actions"><a class="btn btn-outline" href="/Discovery?planId=@plan.MaKeHoach">@Ui.Icon("compass") Tìm dịch vụ</a><a class="btn btn-outline" href="/kham-pha?planId=@plan.MaKeHoach">@Ui.Icon("pin") Tìm trên bản đồ</a>
  @if(service!=null){<a class="text-link" href="/Plans/Activity/@plan.MaKeHoach@(activityId>0?"?activityId="+activityId:"")">Bỏ chọn dịch vụ</a>}</div>
 </div>
</section>
