@model List<KeHoachChuyenDi>
@{
 ViewData["Title"]="Chuyến đi của tôi";
 var drafts=Model.Count(x=>x.TrangThai.ToString()=="Nhap");
 var confirmed=Model.Count(x=>x.TrangThai.ToString()=="DaChapNhan");
 var next=Model.Where(x=>x.NgayKetThuc>=TravelService.Today).OrderBy(x=>x.NgayBatDau).FirstOrDefault();
}
<div class="container-wide" data-plans>
 @{var invites=ViewBag.Invites as List<TripInviteDto>??[];var shared=ViewBag.Shared as List<KeHoachChuyenDi>??[];}
 @if(invites.Count>0)
 {
  <section class="panel trip-invites" aria-label="Lời mời vào chuyến đi"><h2>Lời mời vào chuyến đi</h2>
   @foreach(var iv in invites){<div class="trip-invite"><span><strong>@iv.Inviter</strong> mời bạn cùng lên kế hoạch <strong>@iv.PlanName</strong> · @iv.Destination · @iv.Start.ToString("dd/MM") – @iv.End.ToString("dd/MM/yyyy")</span>
    <form action="/Plans/RespondInvite" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@iv.PlanId"/><input type="hidden" name="accept" value="true"/><button class="btn btn-dark" type="submit">Tham gia</button></form>
    <form action="/Plans/RespondInvite" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@iv.PlanId"/><input type="hidden" name="accept" value="false"/><button class="btn btn-outline" type="submit">Từ chối</button></form></div>}
  </section>
 }
 <div class="page-head plans-head"><div><h1 id="plans-title">Chuyến đi của tôi</h1><p>@Model.Count chuyến đi@(next!=null?" · sắp tới: "+next.TenKeHoach+" ("+next.NgayBatDau.ToString("dd/MM")+")":"")</p></div><nav class="plans-links" aria-label="Liên quan"><a href="/Bookings">@Ui.Icon("ticket") Đặt dịch vụ</a><a href="/Support">@Ui.Icon("help") Hỗ trợ chuyến đi</a></nav></div>
 @if(next!=null){var left=next.NgayBatDau.DayNumber-TravelService.Today.DayNumber;<a class="plans-next" href="/Plans/Detail/@next.MaKeHoach"><span class="plans-next-date"><small>THÁNG @next.NgayBatDau.ToString("MM")</small><b>@next.NgayBatDau.ToString("dd")</b></span><span><strong>@next.TenKeHoach</strong><small>@next.NoiDen · @(left>0?"còn "+left+" ngày":"đang diễn ra")</small></span>@Ui.Icon("arrow")</a>}
 @if(Model.Count>0){
  <div class="plan-toolbar" data-plan-tools hidden><div class="plan-filters" role="group" aria-label="Lọc chuyến đi theo trạng thái"><button type="button" data-plan-filter="all" aria-pressed="true">Tất cả <span>@Model.Count</span></button><button type="button" data-plan-filter="Nhap" aria-pressed="false">Bản nháp <span>@drafts</span></button><button type="button" data-plan-filter="DaChapNhan" aria-pressed="false">Đã xác nhận <span>@confirmed</span></button></div><label class="plan-search" for="plan-query">@Ui.Icon("search")<span class="visually-hidden">Tìm theo tên hoặc điểm đến</span><input id="plan-query" type="search" placeholder="Tìm tên hoặc điểm đến…" data-plan-query autocomplete="off"/></label></div>
  <p class="plan-results-count" role="status" aria-live="polite" aria-atomic="true" data-plan-count>@Model.Count chuyến đi trong danh sách.</p>
 }
 <div class="cards plan-grid">
 @foreach(var p in Model){
  var days=p.NgayKetThuc.DayNumber-p.NgayBatDau.DayNumber+1;
  <article class="card-trip plan-card" data-plan-card data-status="@p.TrangThai" data-search="@p.TenKeHoach @p.NoiDen">
   <div class="plan-card-visual">@if(Ui.DestinationPhoto(p.NoiDen) is string photo){<img src="@photo" alt="" loading="lazy" width="600" height="360"/>}else{<span class="plan-card-blank" aria-hidden="true">@Ui.Icon("pin")</span>}<span class="badge">@Labels.PlanStatus(p.TrangThai.ToString())</span><span class="plan-date-tile" aria-hidden="true"><small>THÁNG @p.NgayBatDau.ToString("MM")</small><b>@p.NgayBatDau.ToString("dd")</b></span></div>
   <div class="card-content"><div class="location">@Ui.Icon("pin") @p.NoiDen</div><h3>@p.TenKeHoach</h3><p>@Ui.Icon("calendar") @p.NgayBatDau.ToString("dd/MM") – @p.NgayKetThuc.ToString("dd/MM/yyyy") <span class="dot-divider">·</span> @days ngày</p><div class="card-bottom"><div class="price"><small>NGÂN SÁCH DỰ KIẾN</small>@Labels.Money(p.NganSachDuKien)</div></div>
    <div class="plan-card-actions"><a class="btn btn-dark" href="/Plans/Detail/@p.MaKeHoach">Xem chi tiết</a><a class="btn btn-outline" href="/lapkehoach/@p.MaKeHoach">Sửa</a><form action="/Plans/Delete" method="post" data-confirm="Xóa chuyến đi “@p.TenKeHoach” cùng toàn bộ lịch trình? Không hoàn tác được.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.MaKeHoach"/><button class="btn btn-outline" type="submit">Xóa</button></form></div></div>
  </article>
 }
 <a class="plan-create-tile" href="/lapkehoach">@Ui.Icon("plus")<strong>@(Model.Count==0?"Chuyến đi đầu tiên bắt đầu từ đây":"Lên ý tưởng cho chuyến tiếp theo")</strong><span>Chọn nơi muốn đến. Sắp xếp ngày đi, hoạt động và ngân sách theo cách của bạn.</span></a>
 </div>
 @if(shared.Count>0)
 {
  <div class="section-head"><div><span class="eyebrow">CÙNG BẠN BÈ</span><h2 class="workspace-section-title">Chuyến đi chung</h2></div></div>
  <div class="cards plan-grid">@foreach(var p in shared){var days=p.NgayKetThuc.DayNumber-p.NgayBatDau.DayNumber+1;<article class="card-trip plan-card"><div class="card-content"><div class="location">@Ui.Icon("pin") @p.NoiDen</div><h3>@p.TenKeHoach</h3><p>@Ui.Icon("calendar") @p.NgayBatDau.ToString("dd/MM") – @p.NgayKetThuc.ToString("dd/MM/yyyy") <span class="dot-divider">·</span> @days ngày</p><div class="plan-card-actions"><a class="btn btn-dark" href="/Plans/Detail/@p.MaKeHoach">Xem chi tiết</a><a class="btn btn-outline" href="/lapkehoach/@p.MaKeHoach">Sửa</a></div></div></article>}</div>
 }
 <div class="empty" data-plan-empty hidden>@Ui.Icon("search")<h3>Chưa có chuyến đi phù hợp</h3><p>Thử tên khác hoặc chọn tất cả trạng thái để xem lại các lịch trình.</p><button class="btn btn-outline" type="button" data-plan-reset>Xóa bộ lọc</button></div>
</div>
