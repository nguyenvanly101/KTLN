@model List<KeHoachChuyenDi>
@{
 ViewData["Title"]="Chuyến đi của tôi";
 var drafts=Model.Count(x=>x.TrangThai.ToString()=="Nhap");
 var confirmed=Model.Count(x=>x.TrangThai.ToString()=="DaChapNhan");
 var next=Model.Where(x=>x.NgayKetThuc>=TravelService.Today).OrderBy(x=>x.NgayBatDau).FirstOrDefault();
}
<div class="container-wide" data-plans>
 <section class="workspace-hero" aria-labelledby="plans-title"><div><span class="eyebrow">CHUYẾN ĐI / LỊCH TRÌNH CÁ NHÂN</span><h1 id="plans-title">Chuyến đi của tôi</h1><p>Những nơi bạn muốn đến, những điều bạn muốn thử.<br/>Gom tất cả thành một hành trình của riêng bạn.</p><a class="btn btn-dark" href="/Plans/Edit">@Ui.Icon("plus") Tạo chuyến đi</a></div><div class="workspace-hero-image"><img src="@(next!=null?Ui.DestinationImage(next.NoiDen):"/images/vietnam-bay.jpg")" alt="Ảnh minh họa cảm hứng cho chuyến đi" width="600" height="440"/></div><span class="workspace-hero-label">@Ui.Icon("compass") ĐI THEO CÁCH CỦA BẠN</span></section>
 <nav class="workspace-shortcuts" aria-label="Các phần của chuyến đi"><a href="/Bookings">@Ui.Icon("ticket") Đặt dịch vụ @Ui.Icon("arrow")</a><a href="/Companions/Connections">@Ui.Icon("users") Kết nối đồng hành @Ui.Icon("arrow")</a><a href="/Support">@Ui.Icon("help") Hỗ trợ chuyến đi @Ui.Icon("arrow")</a></nav>
 <div class="stats"><div class="stat">@Ui.Icon("calendar")<small>Tổng số chuyến đi</small><strong>@Model.Count</strong></div><div class="stat">@Ui.Icon("compass")<small>Đang lên kế hoạch</small><strong>@drafts</strong></div><div class="stat">@Ui.Icon("check")<small>Đã xác nhận lịch trình</small><strong>@confirmed</strong></div></div>
 <div class="section-head"><div><span class="eyebrow">TỪ Ý TƯỞNG ĐẾN LÊN ĐƯỜNG</span><h2 class="workspace-section-title">Những hành trình của bạn</h2></div></div>
 @if(Model.Count>0){
  <div class="plan-toolbar" data-plan-tools hidden><div class="plan-filters" role="group" aria-label="Lọc chuyến đi theo trạng thái"><button type="button" data-plan-filter="all" aria-pressed="true">Tất cả <span>@Model.Count</span></button><button type="button" data-plan-filter="Nhap" aria-pressed="false">Bản nháp <span>@drafts</span></button><button type="button" data-plan-filter="DaChapNhan" aria-pressed="false">Đã xác nhận <span>@confirmed</span></button></div><label class="plan-search" for="plan-query">@Ui.Icon("search")<span class="visually-hidden">Tìm theo tên hoặc điểm đến</span><input id="plan-query" type="search" placeholder="Tìm tên hoặc điểm đến…" data-plan-query autocomplete="off"/></label></div>
  <p class="plan-results-count" role="status" aria-live="polite" aria-atomic="true" data-plan-count>@Model.Count chuyến đi trong danh sách.</p>
 }
 <div class="cards plan-grid">
 @foreach(var p in Model){
  var days=p.NgayKetThuc.DayNumber-p.NgayBatDau.DayNumber+1;
  <a class="card-trip plan-card" href="/Plans/Detail/@p.MaKeHoach" data-plan-card data-status="@p.TrangThai" data-search="@p.TenKeHoach @p.NoiDen">
   <div class="plan-card-visual"><img src="@Ui.DestinationImage(p.NoiDen)" alt="Ảnh minh họa @p.NoiDen" loading="lazy" width="600" height="360"/><span class="badge">@Labels.PlanStatus(p.TrangThai.ToString())</span><span class="plan-date-tile" aria-hidden="true"><small>THÁNG @p.NgayBatDau.ToString("MM")</small><b>@p.NgayBatDau.ToString("dd")</b></span></div>
   <div class="card-content"><div class="location">@Ui.Icon("pin") @p.NoiDen</div><h3>@p.TenKeHoach</h3><p>@Ui.Icon("calendar") @p.NgayBatDau.ToString("dd/MM") – @p.NgayKetThuc.ToString("dd/MM/yyyy") <span class="dot-divider">·</span> @days ngày</p><div class="card-bottom"><div class="price"><small>NGÂN SÁCH DỰ KIẾN</small>@Labels.Money(p.NganSachDuKien)</div><span class="arrow">@Ui.Icon("arrow")</span></div></div>
  </a>
 }
 <a class="plan-create-tile" href="/Plans/Edit">@Ui.Icon("plus")<strong>@(Model.Count==0?"Chuyến đi đầu tiên bắt đầu từ đây":"Lên ý tưởng cho chuyến tiếp theo")</strong><span>Chọn nơi muốn đến. Sắp xếp ngày đi, hoạt động và ngân sách theo cách của bạn.</span></a>
 </div>
 <div class="empty" data-plan-empty hidden>@Ui.Icon("search")<h3>Chưa có chuyến đi phù hợp</h3><p>Thử tên khác hoặc chọn tất cả trạng thái để xem lại các lịch trình.</p><button class="btn btn-outline" type="button" data-plan-reset>Xóa bộ lọc</button></div>
 <div class="notice">Lịch trình giúp bạn sắp xếp chuyến đi. Dịch vụ được xác nhận sau khi bạn gửi yêu cầu và nhận được phản hồi từ nhà cung cấp.</div>
</div>
