@model ActivityInput
@{ViewData["Title"]="Hoạt động trong lịch trình";var plan=(KeHoachChuyenDi)ViewBag.Plan;}<div class="container-narrow"><a class="back" href="/Plans/Detail/@Model.PlanId">← @plan.TenKeHoach</a><div class="page-head"><div><h1>@(Model.Id == 0 ? "Xếp một trải nghiệm vào lịch" : "Chỉnh sửa hoạt động")</h1><p>Chọn ngày, giờ và dự trù chi phí cho hoạt động.</p></div><div class="actions"></div></div><div class="panel">@if(ViewBag.SourceService is DichVuDuLich sourceService){<p class="notice">Giá tham khảo: @Labels.Money(sourceService.GiaThamKhao) / @(sourceService.DonViGia??"đơn vị chưa công bố"). Hãy điền tổng chi phí ước tính cho hoạt động dựa trên số người, số đêm hoặc số lượng bạn cần.</p>}<form action="/Plans/Activity" method="post" >@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="PlanId"/><input type="hidden" name="UpdateTiming" value="true"/><input type="hidden" asp-for="Version"/><input type="hidden" asp-for="ServiceId"/><input type="hidden" asp-for="PlaceId"/><div class="form-grid"><div class="field"><label asp-for="Date">Ngày hoạt động</label><input class="form-control" asp-for="Date" type="date" min="@plan.NgayBatDau.ToString("yyyy-MM-dd")" max="@plan.NgayKetThuc.ToString("yyyy-MM-dd")"/><span asp-validation-for="Date"></span></div><div class="field"><label asp-for="Time">Giờ dự kiến</label><input class="form-control" asp-for="Time" type="time" /><span asp-validation-for="Time"></span></div><div class="field full"><label asp-for="Content">Hoạt động</label><textarea class="form-control" asp-for="Content"></textarea><span asp-validation-for="Content"></span></div><div class="field"><label asp-for="Cost">Chi phí dự kiến (₫)</label><input class="form-control" asp-for="Cost" type="number" min="0"/><span asp-validation-for="Cost"></span></div></div><fieldset class="activity-timing"><legend>Thời gian cho trải nghiệm</legend><p class="help">Nhập thời lượng và khoảng di chuyển từ điểm dừng trước đó để kiểm tra lịch có đủ thời gian. Có thể để trống khi chưa biết.</p><div class="form-grid"><div class="field"><label asp-for="DurationMinutes">Thời lượng hoạt động (phút)</label><input class="form-control" asp-for="DurationMinutes" type="number" min="1" max="1440" inputmode="numeric"/><span asp-validation-for="DurationMinutes"></span></div><div class="field"><label asp-for="TravelMinutes">Di chuyển trước hoạt động (phút)</label><input class="form-control" asp-for="TravelMinutes" type="number" min="0" max="720" inputmode="numeric"/><span asp-validation-for="TravelMinutes"></span></div></div></fieldset><div class="form-actions"><button class="btn btn-dark" type="submit">Lưu hoạt động ↗</button></div></form></div></div>