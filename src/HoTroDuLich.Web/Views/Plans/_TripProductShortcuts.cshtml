@model TripWorkspace
<div class="trip-product-shortcuts"><a href="/Preparation?planId=@Model.Plan.MaKeHoach">@Ui.Icon("check")<span><strong>Chuẩn bị chuyến đi</strong><small>@Model.PreparationDone / @Model.PreparationCount việc đã hoàn thành</small></span>@Ui.Icon("arrow")</a><a href="/Expenses?planId=@Model.Plan.MaKeHoach">@Ui.Icon("wallet")<span><strong>@Ui.ActualMoney(Model.ActualSpent)</strong><small>Chi tiêu thực tế đã ghi</small></span>@Ui.Icon("arrow")</a><a href="/Saved">@Ui.Icon("compass")<span><strong>Từ những điều đã lưu</strong><small>Chọn thêm trải nghiệm cho chuyến đi</small></span>@Ui.Icon("arrow")</a><a href="/Together/Edit?planId=@Model.Plan.MaKeHoach">@Ui.Icon("users")<span><strong>Rủ bạn cùng chuyến</strong><small>Tạo nhóm, thống nhất lịch và chuẩn bị cùng nhau</small></span>@Ui.Icon("arrow")</a></div>
