@model TripWorkspace
@{
 var plan = Model.Plan;
 ViewData["Title"] = plan.TenKeHoach;
 var activities = Model.Activities;
 var total = activities.Sum(x => x.ChiPhiDuKien ?? 0);
 var unknownCosts = activities.Count(x => x.ChiPhiDuKien == null);
 var days = plan.NgayKetThuc.DayNumber - plan.NgayBatDau.DayNumber + 1;
 var visibleDays = days <= 31 ? Enumerable.Range(0, days).Select(x => plan.NgayBatDau.AddDays(x))
     : activities.Select(x => x.Ngay).Append(plan.NgayBatDau).Distinct().Order();
 var pending = Model.Bookings.Count(x => x.TrangThai == TrangThaiYeuCau.ChoPhanHoi);
 var confirmed = Model.Bookings.Count(x => x.TrangThai == TrangThaiYeuCau.DaXacNhan);
 var openIssues = Model.Incidents.Count(x => x.TrangThaiXuLy is not (TrangThaiXuLyTinhHuong.DaGiaiQuyet or TrangThaiXuLyTinhHuong.DungXuLy));
 var next = activities.FirstOrDefault(x => x.Ngay >= TravelService.Today);
}
<div class="container-wide trip-workspace">
 <a class="back" href="/Plans">← Chuyến đi của tôi</a>
 <header class="trip-hero">
  <div class="trip-hero-copy"><span class="eyebrow">CHUYẾN ĐI THEO CÁCH CỦA BẠN</span><h1>@plan.TenKeHoach</h1><p class="trip-hero-meta">@Ui.Icon("pin") @plan.NoiDen <span>·</span> @days ngày</p><p>@plan.NgayBatDau.ToString("dd/MM/yyyy") – @plan.NgayKetThuc.ToString("dd/MM/yyyy") <span class="badge @Labels.Badge(plan.TrangThai.ToString())">@Labels.PlanStatus(plan.TrangThai.ToString())</span></p>
   <div class="actions"><a class="btn btn-lime" href="/Plans/Activity/@plan.MaKeHoach">@Ui.Icon("plus") Thêm hoạt động</a><a class="btn trip-hero-secondary" asp-controller="Explore" asp-action="Index" asp-route-region="@plan.NoiDen" asp-route-planId="@plan.MaKeHoach">Tìm trải nghiệm @Ui.Icon("arrow")</a></div>
  </div><div class="trip-hero-photo"><img src="@Ui.DestinationImage(plan.NoiDen)" alt="Ảnh minh họa điểm đến" width="720" height="540"/><span>@Ui.Icon("compass") @plan.NoiDen <small>Ảnh minh họa</small></span></div>
 </header>
 <nav class="trip-section-nav" aria-label="Trong chuyến đi"><a href="/Journey/Today?planId=@plan.MaKeHoach">Hôm nay</a><a href="#trip-overview">Tổng quan</a><a href="#itinerary">Lịch trình <span>@activities.Count</span></a><a href="#trip-bookings">Dịch vụ <span>@Model.Bookings.Count</span></a><a href="/Journey/Share?planId=@plan.MaKeHoach">Chia sẻ / in</a><a href="#trip-help">Hỗ trợ @if(openIssues > 0){<span>@openIssues</span>}</a></nav>
 <partial name="/Views/Plans/_TripProductShortcuts.cshtml" model="Model"/>
 <section id="trip-overview" class="trip-overview-grid" aria-labelledby="trip-overview-title">
  <div class="panel trip-task-panel"><div class="section-head"><div><span class="eyebrow">BƯỚC TIẾP THEO</span><h2 id="trip-overview-title">Sẵn sàng cho hành trình</h2></div><a class="quiet-link" href="/Plans/Edit/@plan.MaKeHoach">Sửa thông tin @Ui.Icon("arrow")</a></div>
   @if(Model.Tasks.Count == 0){<div class="trip-ready">@Ui.Icon("check")<div><h3>Chưa có việc cần bạn xử lý</h3><p>Bạn có thể tiếp tục khám phá hoặc xem lại lịch trình bên dưới.</p></div></div>}
   @foreach(var task in Model.Tasks.Take(4)){<a class="trip-task @(task.Attention ? "needs-attention" : "")" href="@task.Url"><span class="trip-task-icon">@Ui.Icon(task.Attention ? "help" : "compass")</span><span><strong>@task.Title</strong><small>@task.Description</small></span><span class="trip-task-action">@task.Action @Ui.Icon("arrow")</span></a>}
   @if(Model.Tasks.Count > 4){<details class="trip-more-tasks"><summary>Xem thêm @(Model.Tasks.Count - 4) việc cần lưu ý</summary>@foreach(var task in Model.Tasks.Skip(4)){<a class="trip-task" href="@task.Url"><span><strong>@task.Title</strong><small>@task.Description</small></span><span class="trip-task-action">@task.Action @Ui.Icon("arrow")</span></a>}</details>}
   <div class="trip-status-line"><span>@Ui.Icon("ticket") @confirmed dịch vụ đã xác nhận</span><span>@Ui.Icon("clock") @pending yêu cầu chờ phản hồi</span></div>
  </div>
  <aside id="trip-budget" class="trip-budget-card" aria-labelledby="trip-budget-title"><span class="eyebrow">DỰ TRÙ CHUYẾN ĐI</span><h2 id="trip-budget-title">Ngân sách của bạn</h2><span class="trip-cost">@Labels.Money(total)</span><p>Tổng dự kiến của @activities.Count hoạt động</p><dl><div><dt>Ngân sách đặt ra</dt><dd>@(plan.NganSachDuKien == null ? "Chưa thiết lập" : Labels.Money(plan.NganSachDuKien))</dd></div>@if(plan.NganSachDuKien != null){<div><dt>@(total > plan.NganSachDuKien ? "Đang vượt dự trù" : "Còn lại theo dự trù")</dt><dd>@Labels.Money(Math.Abs(plan.NganSachDuKien.Value - total))</dd></div>}</dl>@if(unknownCosts > 0){<p class="trip-budget-note">@unknownCosts hoạt động chưa nhập chi phí.</p>}<p class="trip-budget-note">Chi phí dịch vụ đặt được theo dõi riêng, chưa cộng vào dự trù hoạt động để tránh tính hai lần.</p><a class="text-link" href="/Plans/Edit/@plan.MaKeHoach">Điều chỉnh ngân sách @Ui.Icon("arrow")</a></aside>
 </section>
 <section id="itinerary" aria-labelledby="trip-itinerary-title">
  <div class="section-head"><div><span class="eyebrow">TỪNG NGÀY, TỪNG TRẢI NGHIỆM</span><h2 id="trip-itinerary-title">Lịch trình của bạn</h2></div><a class="quiet-link" asp-controller="Explore" asp-action="Index" asp-route-planId="@plan.MaKeHoach" asp-route-region="@plan.NoiDen">Khám phá thêm @Ui.Icon("arrow")</a></div>
  <partial name="/Views/Plans/_ScheduleWarnings.cshtml" model="activities"/>
  <div class="itinerary-layout"><div class="itinerary-main">
   @if(activities.Count == 0){<div class="empty">@Ui.Icon("calendar")<h3>Điểm dừng đầu tiên đang chờ bạn</h3><p>Thêm một hoạt động hoặc chọn địa điểm khi khám phá. Bạn có thể lên lịch mà không cần đặt dịch vụ.</p><a class="btn btn-dark" href="/Plans/Activity/@plan.MaKeHoach">Thêm hoạt động đầu tiên</a></div>}
   else {
    @if(days > 31){<p class="help">Chuyến đi dài hiển thị những ngày đã có hoạt động và ngày bắt đầu.</p>}
    @foreach(var day in visibleDays){var items = activities.Where(x => x.Ngay == day).ToList();<section class="timeline-day"><div class="day-marker">NGÀY<b>@(day.DayNumber - plan.NgayBatDau.DayNumber + 1)</b>@day.ToString("dd/MM")</div><div class="day-activities">
     @if(items.Count == 0){<p class="help">Một ngày còn để ngỏ. Nghỉ ngơi hoặc thêm điểm dừng khi bạn muốn.</p>}
     @for(var index = 0; index < items.Count; index++){var activity = items[index];<article class="timeline-item" id="activity-@activity.MaHoatDong"><div class="trip-activity-copy"><time>@Ui.Icon("clock") @(activity.Gio?.ToString("HH:mm") ?? "Chưa đặt giờ")</time><h3>@activity.NoiDung</h3><p class="help">@(activity.ThoiLuongPhut is int duration?duration+" phút hoạt động":"Chưa nhập thời lượng") @(activity.DiChuyenTruocPhut is int transfer?" · "+transfer+" phút di chuyển trước điểm dừng":"") @(activity.HoanThanhLuc!=null?" · Đã hoàn thành":"")</p><span class="help">Chi phí dự kiến: @Labels.Money(activity.ChiPhiDuKien)</span><div class="trip-activity-links">
      @if(activity.MaDichVu != null){<a class="text-link" asp-controller="Explore" asp-action="Detail" asp-route-id="@activity.MaDichVu" asp-route-planId="@plan.MaKeHoach">Xem dịch vụ @Ui.Icon("arrow")</a>@if(Model.RequestableServices.Contains(activity.MaDichVu.Value)){<a class="text-link" asp-controller="Bookings" asp-action="Create" asp-route-id="@activity.MaDichVu" asp-route-planId="@plan.MaKeHoach" asp-route-activityId="@activity.MaHoatDong">Yêu cầu đặt @Ui.Icon("ticket")</a>}}
      @if(Model.Locations.TryGetValue(activity.MaHoatDong, out var location)){<a class="text-link" href="@(location.HasAddress ? Ui.Directions(location.Query) : Ui.MapSearch(location.Query))" target="_blank" rel="noopener noreferrer">@Ui.Icon("pin") @(location.HasAddress ? "Chỉ đường" : "Tìm trên bản đồ")<span class="sr-only"> (mở Google Maps ở tab mới)</span></a>}
     </div></div><div class="actions trip-activity-actions"><form action="/Plans/Reorder" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@activity.MaHoatDong"/><input type="hidden" name="planId" value="@plan.MaKeHoach"/><input type="hidden" name="Version" value="@TravelService.Token(plan.RowVersion)"/><button class="btn btn-outline btn-small" name="Decision" value="Len" type="submit" disabled="@(index == 0)" aria-label="Chuyển @activity.NoiDung lên">↑</button><button class="btn btn-outline btn-small" name="Decision" value="Xuong" type="submit" disabled="@(index == items.Count - 1)" aria-label="Chuyển @activity.NoiDung xuống">↓</button></form><a class="btn btn-outline btn-small" href="/Plans/Activity/@plan.MaKeHoach?activityId=@activity.MaHoatDong">Sửa</a><details class="trip-delete"><summary aria-label="Tùy chọn xóa @activity.NoiDung">Xóa</summary><form action="/Plans/DeleteActivity" method="post" data-confirm="Xóa hoạt động này khỏi lịch trình?">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@activity.MaHoatDong"/><input type="hidden" name="Version" value="@TravelService.Token(plan.RowVersion)"/><input type="hidden" name="planId" value="@plan.MaKeHoach"/><button class="btn btn-outline btn-small" type="submit">Xác nhận xóa</button></form></details></div></article>}
    </div></section>}
    <a class="add-activity-row" href="/Plans/Activity/@plan.MaKeHoach">@Ui.Icon("plus") Thêm hoạt động vào lịch trình</a>
   }
   <div id="plan-decision" class="panel trip-decision"><h3>@(plan.TrangThai == TrangThaiKeHoach.Nhap ? "Lịch trình đã vừa ý bạn?" : "Lịch trình đã được xác nhận")</h3><p>Việc xác nhận lịch trình ghi nhận kế hoạch của bạn. Từng yêu cầu dịch vụ có xác nhận riêng từ nhà cung cấp.</p><form action="/Plans/Decision" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@plan.MaKeHoach"/><input type="hidden" name="Version" value="@TravelService.Token(plan.RowVersion)"/><button class="btn btn-outline" name="Decision" value="@(plan.TrangThai == TrangThaiKeHoach.Nhap ? "DaChapNhan" : "Nhap")" type="submit">@(plan.TrangThai == TrangThaiKeHoach.Nhap ? "Xác nhận lịch trình" : "Chuyển về bản nháp")</button></form></div>
  </div><aside class="itinerary-aside trip-tools">
   <div class="panel"><span class="eyebrow">ĐIỂM DỪNG SẮP TỚI</span>@if(next != null){<h3>@next.NoiDung</h3><p>@next.Ngay.ToString("dd/MM/yyyy") · @(next.Gio?.ToString("HH:mm") ?? "Chưa đặt giờ")</p><a class="text-link" href="#activity-@next.MaHoatDong">Xem trong lịch trình @Ui.Icon("arrow")</a>}else{<h3>Nhịp đi do bạn chọn</h3><p>Thêm ngày và hoạt động để dễ theo dõi khi lên đường.</p>}</div>
   <div class="panel"><h3>@Ui.Icon("pin") Định hướng chuyến đi</h3><p>Mở bản đồ theo điểm đến. Kiểm tra vị trí thực tế trước khi di chuyển.</p><a class="text-link" href="@Ui.MapSearch(plan.NoiDen + ", Việt Nam")" target="_blank" rel="noopener noreferrer">Mở Google Maps<span class="sr-only"> ở tab mới</span> @Ui.Icon("arrow")</a></div>
   <div class="panel"><h3>@Ui.Icon("users") Thêm một người bạn</h3><p>Tìm lời rủ cùng điểm đến và thời gian. Bạn chủ động lựa chọn người phù hợp.</p><a class="text-link" asp-controller="Companions" asp-action="Index" asp-route-q="@plan.NoiDen" asp-route-start="@plan.NgayBatDau.ToString("yyyy-MM-dd")" asp-route-end="@plan.NgayKetThuc.ToString("yyyy-MM-dd")">Tìm người đồng hành @Ui.Icon("arrow")</a></div>
  </aside></div>
 </section>
 <section id="trip-bookings" class="trip-bookings-section" aria-labelledby="trip-bookings-title"><div class="section-head"><div><span class="eyebrow">THEO DÕI CÙNG MỘT NƠI</span><h2 id="trip-bookings-title">Dịch vụ cho chuyến đi</h2><p>Chỉ gồm những yêu cầu bạn đã chọn gắn vào chuyến đi này.</p></div><a class="quiet-link" href="/Bookings">Quản lý mọi yêu cầu @Ui.Icon("arrow")</a></div>
  @if(Model.Bookings.Count == 0){<div class="trip-empty-inline">@Ui.Icon("ticket")<div><h3>Chưa có yêu cầu dịch vụ được gắn</h3><p>Tìm dịch vụ từ chuyến đi này hoặc mở một yêu cầu đã có để chọn chuyến đi.</p></div><a class="btn btn-outline" asp-controller="Explore" asp-action="Index" asp-route-region="@plan.NoiDen" asp-route-planId="@plan.MaKeHoach">Tìm dịch vụ</a></div>}
  else {<div class="trip-booking-grid">@foreach(var booking in Model.Bookings){<article class="panel trip-booking-card"><span class="badge @Labels.Badge(booking.TrangThai.ToString())">@Labels.Status(booking.TrangThai.ToString())</span><h3>@Model.ServiceNames[booking.MaDichVu]</h3><p>@booking.NgayBatDau.ToString("dd/MM/yyyy")@(booking.NgayKetThuc is DateOnly end ? " – " + end.ToString("dd/MM/yyyy") : "") · @booking.SoNguoi người</p><p class="help">Chi phí yêu cầu: @Labels.Money(booking.ChiPhiDuKien)</p><a class="text-link" href="/Bookings/Detail/@booking.MaYeuCau">@(booking.TrangThai == TrangThaiYeuCau.DeXuatKhac ? "Xem điều kiện cần xác nhận" : "Xem yêu cầu #" + booking.MaYeuCau) @Ui.Icon("arrow")</a>@if(booking.TrangThai is TrangThaiYeuCau.TuChoi or TrangThaiYeuCau.DaHuy or TrangThaiYeuCau.KhongTiepTuc){<a class="text-link" asp-controller="Explore" asp-action="Index" asp-route-region="@plan.NoiDen" asp-route-planId="@plan.MaKeHoach">Tìm lựa chọn khác @Ui.Icon("search")</a>}</article>}</div>}
 </section>
 <section id="trip-help" class="trip-help-section" aria-labelledby="trip-help-title"><div><span class="eyebrow">LINH HOẠT TRÊN ĐƯỜNG ĐI</span><h2 id="trip-help-title">Khi kế hoạch thay đổi</h2><p>Ghi lại sự cố, chọn hoạt động bị ảnh hưởng và theo dõi cách xử lý.</p><div class="actions"><a class="btn btn-outline" href="/Support/Create?planId=@plan.MaKeHoach">Ghi nhận tình huống</a><a class="text-link" href="/Support?planId=@plan.MaKeHoach">Xem @Model.Incidents.Count tình huống @Ui.Icon("arrow")</a></div></div><span class="trip-help-count"><strong>@openIssues</strong> tình huống đang xử lý</span></section>
</div>
