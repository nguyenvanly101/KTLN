@model TripWorkspace
@{
 var plan = Model.Plan;
 ViewData["Title"] = plan.TenKeHoach;
 var activities = Model.Activities;
 var total = activities.Sum(x => x.ChiPhiDuKien ?? 0);
 var unknownCosts = activities.Count(x => x.ChiPhiDuKien == null);
 var days = plan.NgayKetThuc.DayNumber - plan.NgayBatDau.DayNumber + 1;
 var visibleDays = days <= 31 ? Enumerable.Range(0, days).Select(x => plan.NgayBatDau.AddDays(x))
     : activities.Select(x => x.Ngay).Append(plan.NgayBatDau).Distinct().Order();
 var pending = Model.Bookings.Count(x => x.TrangThai == TrangThaiYeuCau.ChoPhanHoi);
 var confirmed = Model.Bookings.Count(x => x.TrangThai == TrangThaiYeuCau.DaXacNhan);
 var openIssues = Model.Incidents.Count(x => x.TrangThaiXuLy is not (TrangThaiXuLyTinhHuong.DaGiaiQuyet or TrangThaiXuLyTinhHuong.DungXuLy));
 var next = activities.FirstOrDefault(x => x.Ngay >= TravelService.Today);
 var share = await Context.RequestServices.GetRequiredService<TripShareService>().Members(plan.MaKeHoach);
 var isOwner = share.IsOwner;
 var dayNotes = await Context.RequestServices.GetRequiredService<PlanBoardService>().Notes(plan.MaKeHoach);
 var actGroups = await Context.RequestServices.GetRequiredService<PlanBoardService>().ActivityGroups(plan.MaKeHoach);
 var groupId = await Context.RequestServices.GetRequiredService<ChatService>().TripGroupFor(plan.MaKeHoach);
}
<div class="container-wide trip-workspace">
 <a class="back" href="/Plans">← Chuyến đi của tôi</a>
 @if(!isOwner){<div class="notice">Chuyến đi chung của <strong>@share.Members.First(m=>m.IsOwner).Name</strong>. Bạn sửa được lịch trình.</div>}
 <header class="trip-hero trip-hero-compact">
  <div class="trip-hero-copy"><h1>@plan.TenKeHoach</h1><p class="trip-hero-meta">@Ui.Icon("pin") @plan.NoiDen <span>·</span> @days ngày</p><p>@plan.NgayBatDau.ToString("dd/MM/yyyy") – @plan.NgayKetThuc.ToString("dd/MM/yyyy") <span class="badge @Labels.Badge(plan.TrangThai.ToString())">@Labels.PlanStatus(plan.TrangThai.ToString())</span></p><p class="trip-hero-money">Tạm tính <b>@Labels.Money(total)</b>@(plan.NganSachDuKien != null ? " · Ngân sách " + Labels.Money(plan.NganSachDuKien) : "")</p>
   @{var inWindow=TravelService.Today>=plan.NgayBatDau.AddDays(-1)&&TravelService.Today<=plan.NgayKetThuc;}
   <div class="actions trip-actionbar">
    @if(inWindow){<a class="btn btn-lime" href="/Journey/Today?planId=@plan.MaKeHoach#depart">@Ui.Icon("pin") Khởi hành · Hôm nay</a>}
    <a class="btn @(inWindow?"trip-hero-secondary":"btn-lime")" href="/lapkehoach/@plan.MaKeHoach">@Ui.Icon("plus") Sửa lịch trình</a>
    @if(isOwner){<a class="btn trip-hero-secondary" href="#trip-members">Mời bạn</a>}
    @if(groupId != null){<a class="btn trip-hero-secondary" href="/tin-nhan/@groupId">Nhóm chat</a>}
    <details class="trip-more"><summary class="btn trip-hero-secondary">Thêm ▾</summary><div class="trip-more-menu">
     @if(!inWindow){<a href="/Journey/Today?planId=@plan.MaKeHoach">Xem theo từng ngày</a>}
     @if(isOwner){<form action="/Plans/Decision" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@plan.MaKeHoach"/><input type="hidden" name="Version" value="@TravelService.Token(plan.RowVersion)"/><button name="Decision" value="@(plan.TrangThai == TrangThaiKeHoach.Nhap ? "DaChapNhan" : "Nhap")" type="submit">@(plan.TrangThai == TrangThaiKeHoach.Nhap ? "Xác nhận lịch trình" : "Chuyển về bản nháp")</button></form><a href="/Journey/Share?planId=@plan.MaKeHoach">Chia sẻ</a>}
     <a href="/Plans/Split/@plan.MaKeHoach">Chia tiền</a>
     <a href="/Support/Create?planId=@plan.MaKeHoach">Ghi nhận sự cố</a>
    </div></details>
   </div>
  </div>
 </header>
 <div class="trip-scroll" tabindex="0" aria-label="Lịch trình và thành viên">
 <section id="itinerary" aria-labelledby="trip-itinerary-title">
  <h2 id="trip-itinerary-title" class="trip-sec-title">Lịch trình</h2>
  @{ViewData["PlanId"]=plan.MaKeHoach;ViewData["Dest"]=plan.NoiDen;ViewData["GroupId"]=groupId;ViewData["OnTrip"]=TravelService.Today>=plan.NgayBatDau&&TravelService.Today<=plan.NgayKetThuc;ViewData["DayNo"]=TravelService.Today>=plan.NgayBatDau&&TravelService.Today<=plan.NgayKetThuc?(int?)(TravelService.Today.DayNumber-plan.NgayBatDau.DayNumber+1):null;}
  @if((bool)ViewData["OnTrip"]!){<partial name="/Views/Plans/_TripHelp.cshtml"/>}
  <div class="itinerary-layout"><div class="itinerary-main">
   @if(activities.Count == 0){<div class="empty">@Ui.Icon("calendar")<h3>Điểm dừng đầu tiên đang chờ bạn</h3><p>Bấm Sửa để thêm chỗ ở, nơi tham quan, quán ăn và phương tiện vào từng ngày.</p></div>}
   else {
    @if(days > 31){<p class="help">Chuyến đi dài hiển thị những ngày đã có hoạt động và ngày bắt đầu.</p>}
    @foreach(var day in visibleDays){var items = activities.Where(x => x.Ngay == day).ToList();<section class="timeline-day"><div class="day-marker">NGÀY<b>@(day.DayNumber - plan.NgayBatDau.DayNumber + 1)</b>@day.ToString("dd/MM")</div><div class="day-activities">@if(dayNotes.TryGetValue(day.DayNumber - plan.NgayBatDau.DayNumber + 1, out var dayNote)){<p class="trip-day-note">@dayNote</p>}
     @if(items.Count == 0){<p class="help">Một ngày còn để ngỏ. Nghỉ ngơi hoặc thêm điểm dừng khi bạn muốn.</p>}
     @for(var index = 0; index < items.Count; index++){var activity = items[index];<article class="timeline-item" id="activity-@activity.MaHoatDong"><div class="trip-activity-copy"><time>@Ui.Icon("clock") @(activity.Gio?.ToString("HH:mm") ?? "Chưa đặt giờ")</time><h3>@activity.NoiDung</h3>@if(inWindow){<button type="button" class="trip-issue-btn" data-act="@activity.MaHoatDong" data-group="@(actGroups.TryGetValue(activity.MaHoatDong,out var ag)?ag:"")" data-name="@activity.NoiDung" data-service="@activity.MaDichVu" data-booking="@(activity.MaDichVu!=null?Model.Bookings.Where(b=>b.MaDichVu==activity.MaDichVu).OrderByDescending(b=>b.MaYeuCau).Select(b=>(long?)b.MaYeuCau).FirstOrDefault():null)">Có vấn đề</button>}@{var meta=new[]{activity.ThoiLuongPhut is int duration?duration+" phút":null,activity.DiChuyenTruocPhut is int transfer?transfer+" phút di chuyển trước":null,activity.ChiPhiDuKien!=null?Labels.Money(activity.ChiPhiDuKien):null,activity.HoanThanhLuc!=null?"Đã hoàn thành":null}.Where(x=>x!=null).ToList();}@if(meta.Count>0){<p class="help">@string.Join(" · ",meta)</p>}<div class="trip-activity-links">
      @if(activity.MaDichVu != null){var bk=Model.Bookings.Where(b=>b.MaDichVu==activity.MaDichVu).OrderByDescending(b=>b.MaYeuCau).FirstOrDefault();if(bk!=null){<a class="badge @Labels.Badge(bk.TrangThai.ToString())" href="/Bookings/Detail/@bk.MaYeuCau">@Labels.Status(bk.TrangThai.ToString())</a>if(bk.TrangThai is TrangThaiYeuCau.HoanThanh or TrangThaiYeuCau.ThucHienMotPhan){<a class="text-link" href="/Reviews/Write?bookingId=@bk.MaYeuCau">Đánh giá dịch vụ @Ui.Icon("arrow")</a>}}}
      @if(activity.MaDichVu != null){<a class="text-link" asp-controller="Explore" asp-action="Detail" asp-route-id="@activity.MaDichVu" asp-route-planId="@plan.MaKeHoach">Xem dịch vụ @Ui.Icon("arrow")</a>@if(Model.RequestableServices.Contains(activity.MaDichVu.Value)){<a class="text-link" asp-controller="Bookings" asp-action="Create" asp-route-id="@activity.MaDichVu" asp-route-planId="@plan.MaKeHoach" asp-route-activityId="@activity.MaHoatDong">Yêu cầu đặt @Ui.Icon("ticket")</a>}}else{<a class="text-link" href="/Plans/Activity/@plan.MaKeHoach?activityId=@activity.MaHoatDong">@Ui.Icon("plus") Thêm dịch vụ</a>}
      @if(Model.Locations.TryGetValue(activity.MaHoatDong, out var location)){<a class="text-link" href="@(location.HasAddress ? Ui.Directions(location.Query) : Ui.MapSearch(location.Query))" target="_blank" rel="noopener noreferrer">@Ui.Icon("pin") @(location.HasAddress ? "Chỉ đường" : "Tìm trên bản đồ")<span class="sr-only"> (mở Google Maps ở tab mới)</span></a>}
     </div></div></article>}
    </div></section>}
       }
  </div></div>
 </section>
 @{ViewData["PlanId"] = plan.MaKeHoach; ViewData["Me"] = Context.RequestServices.GetRequiredService<TravelService>().UserId;}
 <partial name="/Views/Plans/_TripMembers.cshtml" model="share"/>
 </div>
 <details class="trip-extra"><summary>Dịch vụ đã đặt (@Model.Bookings.Count) và hỗ trợ</summary>
 <section id="trip-bookings" class="trip-bookings-section" aria-labelledby="trip-bookings-title"><div class="section-head"><div><span class="eyebrow">THEO DÕI CÙNG MỘT NƠI</span><h2 id="trip-bookings-title">Dịch vụ cho chuyến đi</h2><p>Chỉ gồm những yêu cầu bạn đã chọn gắn vào chuyến đi này.</p></div><a class="quiet-link" href="/Bookings">Quản lý mọi yêu cầu @Ui.Icon("arrow")</a></div>
  @if(Model.Bookings.Count == 0){<div class="trip-empty-inline">@Ui.Icon("ticket")<div><h3>Chưa có yêu cầu dịch vụ được gắn</h3><p>Tìm dịch vụ từ chuyến đi này hoặc mở một yêu cầu đã có để chọn chuyến đi.</p></div><a class="btn btn-outline" asp-controller="Explore" asp-action="Index" asp-route-region="@plan.NoiDen" asp-route-planId="@plan.MaKeHoach">Tìm dịch vụ</a></div>}
  else {<div class="trip-booking-grid">@foreach(var booking in Model.Bookings){<article class="panel trip-booking-card"><span class="badge @Labels.Badge(booking.TrangThai.ToString())">@Labels.Status(booking.TrangThai.ToString())</span><h3>@Model.ServiceNames[booking.MaDichVu]</h3><p>@booking.NgayBatDau.ToString("dd/MM/yyyy")@(booking.NgayKetThuc is DateOnly end ? " – " + end.ToString("dd/MM/yyyy") : "") · @booking.SoNguoi người</p><p class="help">Chi phí yêu cầu: @Labels.Money(booking.ChiPhiDuKien)</p><a class="text-link" href="/Bookings/Detail/@booking.MaYeuCau">@(booking.TrangThai == TrangThaiYeuCau.DeXuatKhac ? "Xem điều kiện cần xác nhận" : "Xem yêu cầu #" + booking.MaYeuCau) @Ui.Icon("arrow")</a>@if(booking.TrangThai is TrangThaiYeuCau.TuChoi or TrangThaiYeuCau.DaHuy or TrangThaiYeuCau.KhongTiepTuc){<a class="text-link" asp-controller="Explore" asp-action="Index" asp-route-region="@plan.NoiDen" asp-route-planId="@plan.MaKeHoach">Tìm lựa chọn khác @Ui.Icon("search")</a>}</article>}</div>}
 </section>
 <section id="trip-help" class="trip-help-section" aria-labelledby="trip-help-title"><div><span class="eyebrow">LINH HOẠT TRÊN ĐƯỜNG ĐI</span><h2 id="trip-help-title">Khi kế hoạch thay đổi</h2><p>Ghi lại sự cố, chọn hoạt động bị ảnh hưởng và theo dõi cách xử lý.</p><div class="actions"><a class="btn btn-outline" href="/Support/Create?planId=@plan.MaKeHoach">Ghi nhận tình huống</a><a class="text-link" href="/Support?planId=@plan.MaKeHoach">Xem @Model.Incidents.Count tình huống @Ui.Icon("arrow")</a></div></div><span class="trip-help-count"><strong>@openIssues</strong> tình huống đang xử lý</span></section>
 </details>
</div>

@section Scripts{<script src="~/js/trip-help.js" asp-append-version="true"></script><script src="~/js/trip-route.js" asp-append-version="true"></script>}
