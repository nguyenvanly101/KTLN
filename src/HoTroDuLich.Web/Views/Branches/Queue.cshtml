@model List<BranchReviewPage>
@{ViewData["Title"]="Xét duyệt cơ sở";var status=ViewData["BranchStatus"]?.ToString()??"Pending";}
<div class="container-wide pl-manage"><div class="page-head"><div><span class="eyebrow">QUẢN TRỊ</span><h1>Xét duyệt cơ sở</h1><p>Kiểm tra đúng địa chỉ, vị trí và quyền quản lý trước khi công bố.</p></div><a class="btn btn-outline" href="/quan-tri/moc-dia-diem">Địa điểm & cửa vào</a></div><nav class="pl-tabs" aria-label="Trạng thái xét duyệt">@foreach(var state in new[]{"Pending","Approved","ChangesRequested","Rejected","All"}){<a class="@(status==state?"active":"")" href="/quan-tri/co-so?status=@state">@(state=="All"?"Tất cả":PlaceText.State(state))</a>}</nav>
 @if(Model.Count==0){<div class="pl-empty"><h2>Không có phiên bản trong nhóm này</h2><p>Các hồ sơ mới gửi sẽ xuất hiện tại đây.</p></div>}
 <div class="pl-owner-grid">@foreach(var row in Model){<article class="panel"><div class="pl-card-top"><span class="eyebrow">@row.Provider.TenDonVi</span><span class="badge">@PlaceText.State(row.Revision.Status)</span></div><h2><a href="/quan-tri/co-so/@row.Revision.Id">@row.Revision.Name</a></h2><p>@row.Revision.Address</p><p class="help">Phiên bản @row.Revision.Number · @Ui.LocalTime(row.Revision.SubmittedAt).ToString("dd/MM/yyyy HH:mm")</p><a class="btn btn-outline" href="/quan-tri/co-so/@row.Revision.Id">Kiểm tra hồ sơ @Ui.Icon("arrow")</a></article>}</div>
</div>
