@model BranchOwnerPage
@{ViewData["Title"]="Cơ sở & chi nhánh";}
<div class="container-wide pl-manage"><div class="page-head"><div><span class="eyebrow">KHÔNG GIAN ĐỐI TÁC</span><h1>Cơ sở & chi nhánh</h1><p>Mỗi địa chỉ là một cơ sở riêng. Dịch vụ được đăng tại đúng cơ sở bạn quản lý.</p></div><a class="btn btn-dark" href="/nha-cung-cap/co-so/them">@Ui.Icon("plus") Thêm cơ sở</a></div>
 <div asp-validation-summary="All"></div>
 @if(!Model.CanSubmit){<div class="notice warning">Hoàn tất xác minh và quyền hoạt động trước khi gửi cơ sở. <a href="/Provider/Verification">Xem hồ sơ đối tác</a></div>}
 @if(Model.Branches.Count==0){<div class="pl-empty"><span class="pl-empty-symbol">@Ui.Icon("pin")</span><h2>Đặt cơ sở đầu tiên lên bản đồ</h2><p>Thêm quán ăn, khách sạn hoặc điểm cung cấp dịch vụ. Sau khi được duyệt, bạn có thể đăng dịch vụ tại cơ sở đó.</p><a class="btn btn-dark" href="/nha-cung-cap/co-so/them">Thêm cơ sở đầu tiên @Ui.Icon("arrow")</a></div>}
 <div class="pl-owner-grid">@foreach(var b in Model.Branches){var pending=Model.Pending.GetValueOrDefault(b.Id);<article class="panel pl-owner-card"><div class="pl-card-top"><span class="eyebrow">@DanhMuc.Ten(b.Type)</span><span class="badge">@PlaceText.State(b.Status)</span></div><h2><a href="/nha-cung-cap/co-so/@b.Id">@b.Name</a></h2><p>@b.Address</p><p class="help">@Model.ServiceCounts.GetValueOrDefault(b.Id) dịch vụ gắn cơ sở · @(b.GooglePlaceId!=null?"Có liên kết Google Maps":"Ghim do bạn cung cấp")</p>@if(pending!=null){<div class="notice">Phiên bản @pending.Number đang chờ xét duyệt. @(b.PublishedVersion!=null?"Bản đã duyệt vẫn được giữ.":"")</div>}<div class="actions"><a class="btn btn-outline" href="/nha-cung-cap/co-so/@b.Id">Quản lý</a>@if(b.Status=="Approved"){<a class="text-link" href="/co-so/@b.Id">Xem trang khách @Ui.Icon("arrow")</a>}@if(b.PublishedVersion!=null&&pending==null){<form method="post" action="/nha-cung-cap/co-so/hien-thi">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@b.Id"/><input type="hidden" name="Version" value="@TravelService.Token(b.RowVersion)"/><button class="btn btn-outline" type="submit">@(b.Status=="Hidden"?"Hiện lại":"Tạm ẩn cơ sở")</button></form>}</div></article>}</div>
 <a class="text-link" href="/Provider">Quản lý dịch vụ tại các cơ sở @Ui.Icon("arrow")</a>
</div>
