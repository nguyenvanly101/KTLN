@model BranchOwnerPage
@{
 ViewData["Title"]="Cơ sở của tôi";
 var done=Model.Completeness??new Dictionary<long,BranchCompleteness>();
 var hasBranch=Model.Branches.Count>0;
 var approved=Model.Branches.Any(b=>b.Status=="Approved");
 var strong=done.Values.Any(c=>c.Percent>=80);
 var steps=new (string Title,string Hint,bool Done,string Href)[]
 {
  ("Xác minh nhà cung cấp","Quản trị viên cần xác nhận bạn là đơn vị thật trước khi cơ sở được công bố.",Model.Verified&&Model.CanSubmit,"/Provider/Verification"),
  ("Đăng ký cơ sở đầu tiên","Đăng ký nhà cung cấp cũng là đăng ký cơ sở. Mở rộng thêm cơ sở sau này cũng gửi để quản trị viên duyệt.",hasBranch,"/nha-cung-cap/co-so/them"),
  ("Hoàn thiện thông tin","Ảnh thực tế, giờ mở cửa, giá tham khảo và giới thiệu giúp khách quyết định nhanh.",strong,hasBranch?"/nha-cung-cap/co-so":"/nha-cung-cap/co-so/them"),
  ("Gửi duyệt và công bố","Sau khi quản trị viên duyệt, cơ sở xuất hiện trong tìm kiếm, trang điểm đến và bản đồ.",approved,"/nha-cung-cap/co-so")
 };
}
<div class="container-wide pl-manage pv-home">
 <div class="page-head"><div><span class="eyebrow">ĐĂNG THÔNG TIN CHO KHÁCH</span><h1>Cơ sở của tôi</h1><p>Mỗi cơ sở là một trang khách có thể tìm thấy: ảnh, giờ mở cửa, giá và vị trí. Đăng một lần, một lần duyệt.</p></div><a class="btn btn-dark" href="/nha-cung-cap/co-so/them">@Ui.Icon("plus") @(hasBranch?"Đăng ký thêm cơ sở":"Đăng ký cơ sở đầu tiên")</a></div>
 <div asp-validation-summary="All"></div>
 @if(!Model.CanSubmit){<div class="notice warning">Hoàn tất xác minh và quyền hoạt động trước khi gửi cơ sở. <a href="/Provider/Verification">Xem hồ sơ đối tác</a></div>}

 <section class="pv-steps-wrap" aria-labelledby="pv-steps-title">
  <h2 id="pv-steps-title" class="sr-only">Các bước đăng thông tin</h2>
  <ol class="pv-steps">@foreach(var (s,n) in steps.Select((s,n)=>(s,n+1))){<li class="@(s.Done?"done":"")"><span class="pv-step-no" aria-hidden="true">@(s.Done?"✓":n.ToString())</span><div><a href="@s.Href"><strong>@s.Title</strong></a><small>@s.Hint</small></div></li>}</ol>
 </section>

 @if(!hasBranch)
 {
  <div class="pl-empty"><span class="pl-empty-symbol">@Ui.Icon("pin")</span><h2>Đặt cơ sở đầu tiên lên bản đồ</h2><p>Thêm quán ăn, khách sạn hoặc điểm vui chơi. Điền đủ ảnh, giờ mở cửa và giá để khách thấy ngay điều họ cần.</p><a class="btn btn-dark" href="/nha-cung-cap/co-so/them">Thêm cơ sở đầu tiên @Ui.Icon("arrow")</a></div>
 }
 <div class="pv-cards">@foreach(var b in Model.Branches)
 {
  var pending=Model.Pending.GetValueOrDefault(b.Id);var c=done.GetValueOrDefault(b.Id,new BranchCompleteness(0,[]));var hasPhoto=Ui.ServicePhotos(b.PhotosJson).Length>0;
  <article class="panel pv-card">
   <a class="pv-card-photo" href="/nha-cung-cap/co-so/@b.Id" aria-hidden="true" tabindex="-1">@if(hasPhoto){<img src="/co-so/@b.Id/anh/0" alt="" width="320" height="200" loading="lazy"/>}else{<span>@Ui.Icon("pin")<small>Chưa có ảnh</small></span>}</a>
   <div class="pv-card-body">
    <div class="pl-card-top"><span class="eyebrow">@DanhMuc.Ten(b.Type)</span><span class="badge">@PlaceText.State(b.Status)</span></div>
    <h2><a href="/nha-cung-cap/co-so/@b.Id">@b.Name</a></h2>
    <p class="pv-addr">@b.Address</p>
    <div class="pv-meter" role="img" aria-label="Thông tin đã hoàn thiện @c.Percent phần trăm"><div><i style="width:@(c.Percent)%"></i></div><strong>@c.Percent%</strong></div>
    @if(c.Missing.Count>0){<p class="pv-missing">Còn thiếu: @string.Join(" · ",c.Missing.Take(3))@(c.Missing.Count>3?" · …":"")</p>}else{<p class="pv-missing ok">Hồ sơ đầy đủ.</p>}
    @if(pending!=null){<div class="notice">Phiên bản @pending.Number đang chờ xét duyệt. @(b.PublishedVersion!=null?"Bản đã duyệt vẫn được giữ.":"")</div>}
    <div class="pv-actions"><a class="btn btn-outline" href="/nha-cung-cap/co-so/@b.Id">@(c.Percent<100?"Hoàn thiện thông tin":"Chỉnh sửa")</a>@if(b.Status=="Approved"&&b.PublishedVersion!=null){<a class="btn btn-outline" href="/Provider/Edit?coSo=@b.Id">+ Đăng dịch vụ</a><a class="btn btn-outline" href="/nha-cung-cap/co-so/@b.Id/tin">Đăng tin giới thiệu</a><a class="text-link" href="/nha-cung-cap/co-so/@b.Id/bao-sai">Khách báo sai</a><a class="text-link" href="/co-so/@b.Id">Xem như khách @Ui.Icon("arrow")</a>}</div>
    <div class="pv-svc"><strong>Dịch vụ của cơ sở</strong>
     @{var list=Model.BranchServices?.GetValueOrDefault(b.Id)??[];}
     @if(list.Count==0){<p class="help">Chưa có dịch vụ. Cơ sở vẫn hiển thị với khách; thêm dịch vụ nếu khách có thể đặt hoặc hỏi giá.</p>}
     else{<ul>@foreach(var sv in list){<li><a href="/Provider/Edit/@sv.Id">@sv.Name</a> <small>@(sv.Price.HasValue?Labels.Money(sv.Price):"") · @Labels.Status(sv.State)</small></li>}</ul>}
    </div>
   </div>
  </article>
 }</div>
 <section class="pv-optional"><h2>Đăng dịch vụ riêng <small>(tùy chọn)</small></h2><p>Cơ sở chỉ thiết lập một lần. Dịch vụ (món, phòng, tour…) đăng riêng và tự gắn vào cơ sở, không phải nhập lại thông tin cơ sở. Khách vẫn tìm thấy cơ sở và thông tin của bạn mà không cần mục này.</p><a class="text-link" href="/Provider">Quản lý dịch vụ có thể đặt @Ui.Icon("arrow")</a></section>
</div>
