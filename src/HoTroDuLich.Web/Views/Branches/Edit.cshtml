@model BranchEditPage
@{ViewData["Title"]=Model.Input.Id==0?"Thêm cơ sở":"Quản lý cơ sở";var i=Model.Input;var pending=Model.History.Any(x=>x.Status=="Pending");}
<div class="container-wide pl-manage"><a class="back" href="/nha-cung-cap/co-so">← Cơ sở & chi nhánh</a><div class="page-head"><div><span class="eyebrow">MỘT ĐỊA CHỈ. MỘT HỒ SƠ RIÊNG.</span><h1>@ViewData["Title"]</h1><p>Đăng thông tin đúng chi nhánh để khách tìm được dịch vụ và đường đến.</p></div>@if(Model.Current?.Status=="Approved"){<a class="btn btn-outline" href="/co-so/@i.Id">Xem trang công bố @Ui.Icon("arrow")</a>}</div>
 @if(!Model.CanSubmit){<div class="notice warning">Nhà cung cấp cần được xác minh và có quyền hoạt động để gửi cơ sở.</div>}
 @if(pending){<div class="notice">Cơ sở đang có phiên bản chờ duyệt. Bạn có thể xem nội dung đã gửi trong lịch sử bên dưới.</div>}
 <form method="post" action="/nha-cung-cap/co-so/luu" class="panel pl-editor">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" name="Id" value="@i.Id"/><input type="hidden" name="Version" value="@i.Version"/>
 <fieldset disabled="@(pending||!Model.CanSubmit)"><legend class="sr-only">Thông tin cơ sở</legend><partial name="/Views/Branches/_MapLocationForm.cshtml" model="i"/>
 <div class="form-grid"><div class="field"><label for="branch-type">Loại cơ sở chính</label><select class="form-select" id="branch-type" name="Type">@foreach(var type in DanhMuc.LoaiDichVu){<option value="@type" selected="@(type==i.Type)">@DanhMuc.Ten(type)</option>}</select></div><div class="field"><label for="branch-phone">Số liên hệ cơ sở</label><input class="form-control" id="branch-phone" name="Phone" value="@i.Phone" maxlength="30" type="tel"/></div><div class="field"><label for="branch-website">Website cơ sở (HTTPS)</label><input class="form-control" id="branch-website" name="Website" value="@i.Website" maxlength="500" type="url"/></div><div class="field"><label for="branch-hours">Giờ phục vụ do bạn công bố</label><input class="form-control" id="branch-hours" name="Hours" value="@i.Hours" maxlength="300" placeholder="Khung giờ, ngày nghỉ, giờ nhận khách cuối…"/></div><div class="field full"><label for="branch-summary">Giới thiệu cơ sở / chi nhánh</label><textarea class="form-control" id="branch-summary" name="Summary" maxlength="2000">@i.Summary</textarea></div></div>
 <fieldset class="pl-facts-editor"><legend>Tiện ích của đúng cơ sở này</legend><p class="help">Chọn “Chưa công bố” khi chưa có đủ thông tin.</p><div class="form-grid">@foreach(var field in new[]{("Parking","Có chỗ đỗ ô tô",i.Parking),("VegetarianOptions","Có lựa chọn món chay",i.VegetarianOptions),("VeganOnly","Quán thuần chay",i.VeganOnly),("AccessibleEntrance","Lối vào không có bậc thang",i.AccessibleEntrance)}){<div class="field"><label for="@field.Item1">@field.Item2</label><select class="form-select" name="@field.Item1" id="@field.Item1"><option value="" selected="@(field.Item3==null)">Chưa công bố</option><option value="true" selected="@(field.Item3==true)">Có</option><option value="false" selected="@(field.Item3==false)">Không</option></select></div>}</div></fieldset>
 <div class="field"><label for="ownership">Căn cứ bạn được quản lý cơ sở</label><textarea class="form-control" id="ownership" name="OwnershipEvidence" maxlength="2000" placeholder="Vai trò tại cơ sở, cách đối chiếu quyền quản lý, kênh liên hệ để xác nhận…">@i.OwnershipEvidence</textarea><small>Chỉ nhà cung cấp và quản trị viên xem phần này. Liên kết Google Maps không tự xác nhận quyền quản lý.</small></div>
 <div class="form-actions"><button class="btn btn-dark" name="Operation" value="Submit" type="submit">Gửi cơ sở xét duyệt @Ui.Icon("arrow")</button>@if(Model.Current?.PublishedVersion==null){<button class="btn btn-outline" name="Operation" value="Draft" type="submit">Lưu bản nháp</button>}</div></fieldset></form>
 @if(Model.History.Count>0){<section class="pl-history"><h2>Lịch sử xét duyệt</h2>@foreach(var r in Model.History){<details class="panel"><summary>Phiên bản @r.Number · @PlaceText.State(r.Status) · @Ui.LocalTime(r.SubmittedAt).ToString("dd/MM/yyyy HH:mm")</summary><h3>@r.Name</h3><p>@r.Address</p><p class="prose">@r.Summary</p><p>Giờ phục vụ: @(r.Hours??"Chưa công bố")</p><p class="prose">Căn cứ quản lý: @r.OwnershipEvidence</p>@if(r.Reason!=null){<div class="notice">@r.Reason</div>}</details>}</section>}
</div>
