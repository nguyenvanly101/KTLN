@model BranchReviewPage
@{ViewData["Title"]="Kiểm tra cơ sở";var r=Model.Revision;var b=Model.Current;MapPosition? pos=r.Latitude!=null&&r.Longitude!=null&&(r.LocationSource=="Provider"||r.LocationExpiresAt>DateTime.UtcNow)?new(r.Latitude.Value,r.Longitude.Value):null;}
<div class="container-wide pl-manage"><a class="back" href="/quan-tri/co-so">← Xét duyệt cơ sở</a><div class="page-head"><div><span class="eyebrow">@Model.Provider.TenDonVi · PHIÊN BẢN @r.Number</span><h1>@r.Name</h1><p>@PlaceText.State(r.Status)</p></div></div><div asp-validation-summary="All"></div>
 <div class="pl-detail-grid"><article><section class="panel"><h2>Thông tin đề nghị công bố</h2><p><strong>@r.Address</strong></p><p>@r.Region · @DanhMuc.Ten(r.Type)</p><p class="prose">@r.Summary</p><dl class="facts"><div><dt>Liên hệ</dt><dd>@r.Phone</dd></div><div><dt>Giờ phục vụ</dt><dd>@r.Hours</dd></div><div><dt>Chỗ đỗ ô tô</dt><dd>@PlaceText.Known(r.Parking)</dd></div><div><dt>Món chay / thuần chay</dt><dd>@PlaceText.Known(r.VegetarianOptions) / @PlaceText.Known(r.VeganOnly)</dd></div><div><dt>Lối vào không bậc</dt><dd>@PlaceText.Known(r.AccessibleEntrance)</dd></div></dl><a class="btn btn-outline" href="@PlaceText.GoogleUrl(r.Name,r.GooglePlaceId,pos)" target="_blank" rel="noopener noreferrer">Đối chiếu Google Maps @Ui.Icon("arrow")</a></section>
 <section class="panel"><h2>Căn cứ quản lý cơ sở</h2><p class="prose">@r.OwnershipEvidence</p><p>Nhà cung cấp: @Model.Provider.TenDonVi</p><p>Liên hệ hồ sơ đối tác: @Model.Provider.SoDienThoai · @Model.Provider.EmailLienHe</p><p class="help">Đối chiếu quyền quản lý cơ sở độc lập với việc địa điểm xuất hiện trên Google Maps.</p></section>
 @if(b.PublishedVersion!=null){<section class="panel"><h2>Bản đang công bố · phiên bản @b.PublishedVersion</h2><h3>@b.Name</h3><p>@b.Address</p><p class="prose">@b.Summary</p><p>Giờ phục vụ: @b.Hours</p><a href="/co-so/@b.Id">Xem trang khách</a></section>}</article>
 <aside><div class="panel pl-sticky">@if(r.Status=="Pending"){<h2>Quyết định xét duyệt</h2><form method="post" action="/quan-tri/co-so/duyet">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@r.Id"/><input type="hidden" name="Version" value="@TravelService.Token(r.RowVersion)"/><div class="field"><label for="review-reason">Lý do / nội dung cần bổ sung</label><textarea class="form-control" id="review-reason" name="Reason" maxlength="500"></textarea><small>Bắt buộc khi từ chối hoặc yêu cầu bổ sung.</small></div><div class="pl-action-stack"><button class="btn btn-dark" name="Decision" value="Approved">Chấp thuận cơ sở</button><button class="btn btn-outline" name="Decision" value="ChangesRequested">Yêu cầu bổ sung</button><button class="btn btn-outline" name="Decision" value="Rejected">Từ chối</button></div></form>}else{<h2>Đã xử lý</h2><p>@r.Reason</p><p class="help">@Ui.LocalTime(r.ReviewedAt??r.SubmittedAt).ToString("dd/MM/yyyy HH:mm")</p>}</div></aside></div>
</div>
