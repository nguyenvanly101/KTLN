@model BranchReviewPage
@{ViewData["Title"]="Kiểm tra cơ sở";var r=Model.Revision;var b=Model.Current;MapPosition? pos=r.Latitude!=null&&r.Longitude!=null&&(r.LocationSource=="Provider"||r.LocationExpiresAt>DateTime.UtcNow)?new(r.Latitude.Value,r.Longitude.Value):null;}
<div class="container-wide pl-manage"><a class="back" href="/quan-tri/co-so">← Xét duyệt cơ sở</a><div class="page-head"><div><span class="eyebrow">@Model.Provider.TenDonVi · PHIÊN BẢN @r.Number</span><h1>@r.Name</h1><p>@PlaceText.State(r.Status)</p></div></div><div asp-validation-summary="All"></div>
 <div class="pl-detail-grid"><article><section class="panel"><h2>Thông tin đề nghị công bố</h2><p><strong>@r.Address</strong></p><p>@r.Region · @DanhMuc.Ten(r.Type)</p><p class="prose">@r.Summary</p><partial name="/Views/Branches/_BranchFacts.cshtml" model="BranchFactsModel.From(r)"/><dl class="facts"><div><dt>Liên hệ</dt><dd>@r.Phone</dd></div><div><dt>Ghi chú giờ phục vụ</dt><dd>@(string.IsNullOrWhiteSpace(r.Hours)?"Không có":r.Hours)</dd></div><div><dt>Chỗ đỗ ô tô</dt><dd>@PlaceText.Known(r.Parking)</dd></div><div><dt>Món chay / thuần chay</dt><dd>@PlaceText.Known(r.VegetarianOptions) / @PlaceText.Known(r.VeganOnly)</dd></div><div><dt>Lối vào không bậc</dt><dd>@PlaceText.Known(r.AccessibleEntrance)</dd></div></dl><a class="btn btn-outline" href="@PlaceText.GoogleUrl(r.Name,r.GooglePlaceId,pos)" target="_blank" rel="noopener noreferrer">Đối chiếu Google Maps @Ui.Icon("arrow")</a></section>
 @if(Model.Documents!=null&&Model.Documents.Count>0){<section class="panel"><h2>Tài liệu xác minh nhà cung cấp</h2><ul>@foreach(var d in Model.Documents){<li><a href="/Account/Download?kind=verification&id=@d.MaTaiLieu">@d.TenTepGoc</a></li>}</ul></section>}
 <section class="panel"><h2>Căn cứ quản lý cơ sở</h2><p class="prose">@r.OwnershipEvidence</p><p>Nhà cung cấp: @Model.Provider.TenDonVi</p><p>Liên hệ hồ sơ đối tác: @Model.Provider.SoDienThoai · @Model.Provider.EmailLienHe</p><p class="help">Đối chiếu quyền quản lý cơ sở độc lập với việc địa điểm xuất hiện trên Google Maps.</p></section>
 @if(b.PublishedVersion!=null){<section class="panel"><h2>Bản đang công bố · phiên bản @b.PublishedVersion</h2><h3>@b.Name</h3><p>@b.Address</p><p class="prose">@b.Summary</p><p>Giờ phục vụ: @b.Hours</p><a href="/co-so/@b.Id">Xem trang khách</a></section>}</article>
 <aside><div class="panel pl-sticky">@if(r.Status=="Pending"){<h2>Quyết định xét duyệt</h2><partial name="_DecisionForm" model='DecisionFormModel.Review("/quan-tri/co-so/duyet",new Dictionary<string,string>{["Id"]=r.Id.ToString(),["Version"]=TravelService.Token(r.RowVersion)},"Approved","Chấp thuận cơ sở","Cơ sở hiện trong tìm kiếm, trang điểm đến và bản đồ.","ChangesRequested","Yêu cầu bổ sung","Nhà cung cấp sửa rồi gửi lại.","Rejected","Cơ sở không được công bố.")'/>}else{<h2>Đã xử lý</h2><p>@r.Reason</p><p class="help">@Ui.LocalTime(r.ReviewedAt??r.SubmittedAt).ToString("dd/MM/yyyy HH:mm")</p>}</div></aside></div>
</div>
