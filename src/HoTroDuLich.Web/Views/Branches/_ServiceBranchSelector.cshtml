@model ServiceInput
@inject BranchService Branches
@{var choices=await Branches.Choices();var chosen=choices.Where(c=>Model.BranchIds.Contains(c.Id)).ToList();}
<div class="pl-branch-picker">
 @if(choices.Count==0){<div class="notice warning">Bạn chưa có cơ sở được duyệt. Tạo cơ sở ở mục <a href="/nha-cung-cap/co-so">Cơ sở của tôi</a> (đó cũng là bước xác minh), sau đó đăng dịch vụ. Bạn vẫn có thể lưu nháp.</div>}
 else if(Model.Id==0||chosen.Count<=1)
 {
  var one=chosen.FirstOrDefault()??choices[0];
  <input type="hidden" name="BranchIds" value="@one.Id"/><p class="help">Dịch vụ thuộc cơ sở <strong>@one.Name</strong>. Muốn đổi cơ sở, chọn ở đầu thanh bên.</p>
 }
 else
 {
  <fieldset><legend>Dịch vụ này đang áp dụng tại</legend><div class="pl-choice-grid">@foreach(var branch in choices){<label class="pl-branch-option"><input type="checkbox" name="BranchIds" value="@branch.Id" checked="@Model.BranchIds.Contains(branch.Id)"/><span><strong>@branch.Name</strong><small>@branch.Address</small></span></label>}</div></fieldset>
 }
 <span asp-validation-for="BranchIds"></span>
</div>
