@model ProviderAssessment
<div class="panel"><h2>Dịch vụ và nghĩa vụ hiện tại</h2><div class="stats compact-stats"><div class="stat"><small>Dịch vụ</small><strong>@Model.Services.Count</strong></div><div class="stat"><small>Yêu cầu đang chờ</small><strong>@Model.Waiting.Count</strong></div><div class="stat"><small>Thỏa thuận đang thực hiện</small><strong>@Model.Confirmed.Count</strong></div><div class="stat"><small>Kết quả cần đối chiếu</small><strong>@Model.Complaints.Count</strong></div></div>
@foreach(var s in Model.Services){<div class="list-card"><div><h3>@s.TenDichVu</h3><p>@DanhMuc.Ten(s.LoaiDichVu) · @s.KhuVucPhucVu</p></div><div><span class="badge @Labels.Badge(s.TrangThaiCongBo.ToString())">@Labels.Status(s.TrangThaiCongBo.ToString())</span><p class="help">@Labels.Status(s.TrangThaiTiepNhan.ToString())</p></div></div>}
@if(Model.Waiting.Count+Model.Confirmed.Count>0){<details><summary>Xem yêu cầu và thỏa thuận liên quan</summary><div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">Yêu cầu</th><th scope="col">Ngày phục vụ</th><th scope="col">Trạng thái</th></tr></thead><tbody>@foreach(var y in Model.Waiting.Concat(Model.Confirmed)){<tr><td>#@y.MaYeuCau</td><td>@y.NgayBatDau.ToString("dd/MM/yyyy")</td><td>@Labels.Status(y.TrangThai.ToString())</td></tr>}</tbody></table></div></details>}
@foreach(var result in Model.Complaints){<div class="notice warning"><strong>Yêu cầu #@result.MaYeuCau · @result.HangMuc</strong><p>@(result.NoiDungPhanAnh??"Hạng mục chưa xác định được kết quả")</p></div>}
</div>
