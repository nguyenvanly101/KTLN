@model AdminOverview
@inject HoTroDuLich.Web.Data.AppDbContext Db
@using Microsoft.EntityFrameworkCore
@{
 ViewData["Title"]="Tổng quan quản trị";
 // Moi hang viec cho quan tri: so viec dang cho + noi xu ly. Viec nao co so > 0 duoc dua len dau.
 var branchPending=await Db.Set<BanCapNhatCoSo>().CountAsync(x=>x.Status=="Pending");
 var postReports=await Db.Set<BaoCaoBaiViet>().CountAsync(x=>x.Status=="Open");
 var chatReports=await Db.Set<BaoCaoChat>().CountAsync(x=>x.Status=="Open");
 var infoReports=await Db.Set<DiscoveryReport>().CountAsync(x=>x.Status=="Pending")+await Db.Set<DiscoveryExperience>().CountAsync(x=>x.Status=="Pending");
 var tasks=new List<(string Title,string Hint,int Count,string Href,string Icon)>{
  ("Cơ sở chờ duyệt","Kiểm tra địa chỉ, vị trí và quyền quản lý trước khi công bố",branchPending,"/quan-tri/co-so","pin"),
  ("Dịch vụ chờ duyệt","So sánh phiên bản, duyệt hoặc yêu cầu chỉnh sửa",Model.PendingServices,"/Admin/ServiceReviews","check"),
  ("Hồ sơ nhà cung cấp chờ xác minh","Đối chiếu giấy tờ của đơn vị",Model.PendingVerifications,"/Admin/Verifications","shield"),
  ("Giải trình của nhà cung cấp","Xem xét đình chỉ, khôi phục, thu hồi",Model.PendingExplanations,"/Admin/Providers","users"),
  ("Báo cáo bài viết","Bài viết bị người dùng báo cáo",postReports,"/quan-tri/bao-cao-bai-viet","bell"),
  ("Báo cáo tin nhắn","Tin nhắn hoặc cuộc trò chuyện bị báo cáo",chatReports,"/quan-tri/bao-cao-chat","chat"),
  ("Góp ý thông tin tra cứu","Khách báo sai hoặc chia sẻ trải nghiệm chờ duyệt",infoReports,"/Discovery/Manage","compass"),
 };
 var open=tasks.Where(t=>t.Count>0).ToList();var done=tasks.Where(t=>t.Count==0).ToList();
}
<div class="container-wide admin-home">
 <header class="admin-home-head"><div><span class="eyebrow">QUẢN TRỊ</span><h1>Tổng quan</h1><p>@(open.Count==0?"Không có việc nào đang chờ.":"Có "+open.Sum(t=>t.Count)+" việc đang chờ ở "+open.Count+" mục.")</p></div><a class="btn btn-outline" href="/Admin/Audit">@Ui.Icon("clock") Nhật ký hoạt động</a></header>
 @if(open.Count>0)
 {
  <h2 class="admin-home-title">Cần xử lý</h2>
  <div class="admin-tasks">@foreach(var t in open){<a class="admin-task is-open" href="@t.Href"><span class="admin-task-icon">@Ui.Icon(t.Icon)</span><span class="admin-task-copy"><strong>@t.Title</strong><small>@t.Hint</small></span><b class="admin-task-count">@t.Count</b></a>}</div>
 }
 <h2 class="admin-home-title">@(open.Count>0?"Không có việc chờ":"Các hàng việc")</h2>
 <div class="admin-tasks admin-tasks-quiet">@foreach(var t in done){<a class="admin-task" href="@t.Href"><span class="admin-task-icon">@Ui.Icon(t.Icon)</span><span class="admin-task-copy"><strong>@t.Title</strong><small>@t.Hint</small></span><b class="admin-task-count">0</b></a>}</div>
 <p class="admin-home-foot">@Model.Providers nhà cung cấp trên hệ thống · <a href="/Admin/Providers">Quản lý nhà cung cấp</a> · <a href="/quan-tri/khach-du-lich">Khách du lịch</a> · <a href="/quan-tri/loai-dich-vu">Loại dịch vụ</a> · <a href="/quan-tri/lich-mau">Lịch trình mẫu</a> · <a href="/Reviews/Moderation">Đánh giá dịch vụ</a></p>
</div>
