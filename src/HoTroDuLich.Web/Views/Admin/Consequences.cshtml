@model RightsConsequences
@{ViewData["Title"]="Hệ quả quyết định";var action=Model.Operation=="TamDinhChi"?"tam-dinh-chi":Model.Operation=="DangHoatDong"?"khoi-phuc":"thu-hoi";}
<div class="container-narrow"><a class="back" href="/Admin/Provider/@Model.Provider.MaNhaCungCap">← Hồ sơ nhà cung cấp</a><div class="page-head"><div><span class="eyebrow">KIỂM TRA TRƯỚC KHI XÁC NHẬN</span><h1>@Labels.Status(Model.Operation)</h1><p>@Model.Provider.TenDonVi</p></div></div><div class="panel"><h2>Phạm vi ảnh hưởng</h2><dl class="facts"><div><dt>Dịch vụ đổi trạng thái tiếp nhận</dt><dd>@Model.Services</dd></div><div><dt>Dịch vụ ngừng công bố</dt><dd>@Model.Unpublished</dd></div><div><dt>Yêu cầu đang chờ chuyển Không tiếp tục</dt><dd>@Model.StoppedRequests</dd></div><div><dt>Thỏa thuận tiếp tục được thực hiện</dt><dd>@Model.PreservedAgreements</dd></div></dl>
<form action="/quan-tri/quyen-hoat-dong/@action" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" name="Id" value="@Model.Provider.MaNhaCungCap"/><input type="hidden" name="Version" value="@TravelService.Token(Model.Provider.RowVersion)"/><input type="hidden" name="Decision" value="@Model.Operation"/><div class="form-grid"><div class="field full"><label for="rights-reason">Lý do quyết định</label><textarea id="rights-reason" class="form-control" name="Reason" maxlength="500" required></textarea></div><div class="field full"><label for="rights-evidence">Căn cứ quyết định</label><textarea id="rights-evidence" class="form-control" name="Evidence" maxlength="500" required></textarea></div>@if(Model.Operation=="TamDinhChi"){<div class="field"><label for="rights-until">Thời hạn xem xét lại (tùy chọn)</label><input id="rights-until" class="form-control" name="Until" type="date" min="@TravelService.Today.AddDays(1).ToString("yyyy-MM-dd")"/><small>Thời hạn cần sau hôm nay. Đến hạn, hệ thống nhắc quản trị viên xem xét.</small></div>}</div><div class="form-actions"><button class="btn btn-danger" type="submit">Xác nhận áp dụng quyết định</button><a class="btn btn-outline" href="/Admin/Provider/@Model.Provider.MaNhaCungCap">Hủy</a></div></form></div></div>
