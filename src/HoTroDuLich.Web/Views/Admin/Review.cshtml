@model (BanCapNhatDichVu Pending,DichVuDuLich Current,NhaCungCapDichVu Provider)
@{ViewData["Title"]="Xét duyệt dịch vụ";var v=Model.Pending;var s=Model.Current;}<div class="container-wide"><a class="back" href="/Admin/ServiceReviews">← Hàng chờ xét duyệt</a><div class="page-head"><div><h1>Xét duyệt thông tin dịch vụ</h1><p>@Model.Provider.TenDonVi · Phiên bản @v.SoPhienBan</p></div><div class="actions"></div></div><partial name="/Views/Admin/_ServiceDetailsReview.cshtml" model="Model"/><div class="comparison"><div class="panel old"><span class="eyebrow">ĐANG CÔNG BỐ · PHIÊN BẢN @s.PhienBanCongBo</span><h2>@s.TenDichVu</h2><p>@s.KhuVucPhucVu · @DanhMuc.Ten(s.LoaiDichVu) · @Labels.Money(s.GiaThamKhao)</p><p class="prose">@s.MoTa</p><p class="prose">@s.DieuKienPhucVu</p><p>@s.ThoiGianPhucVu</p><p>Địa điểm liên quan: @(s.MaDiaDiem?.ToString()??"Không có")</p><p class="help">Tạm ngừng: @s.TamNgungTu — @s.TamNgungDen · @s.LyDoTamNgung</p></div><div class="panel"><span class="eyebrow">ĐỀ NGHỊ CÔNG BỐ · PHIÊN BẢN @v.SoPhienBan</span><h2>@v.TenDichVu</h2><p>@v.KhuVucPhucVu · @DanhMuc.Ten(v.LoaiDichVu) · @Labels.Money(v.GiaThamKhao)</p><p class="prose">@v.MoTa</p><p class="prose">@v.DieuKienPhucVu</p><p>@v.ThoiGianPhucVu</p><p>Địa điểm liên quan: @(v.MaDiaDiem?.ToString()??"Không có")</p><p class="help">Tạm ngừng: @v.TamNgungTu — @v.TamNgungDen · @v.LyDoTamNgung</p></div></div>@if(v.TrangThaiDuyet.ToString()=="ChoDuyet"){<div class="panel"><h2>Quyết định cho phiên bản @v.SoPhienBan</h2><partial name="_DecisionForm" model='DecisionFormModel.Review("/quan-tri/xet-duyet-dich-vu/duyet",new Dictionary<string,string>{["Id"]=v.MaBanCapNhat.ToString(),["Version"]=v.SoPhienBan.ToString()},"DaDuyet","Duyệt và công bố","Phiên bản này hiện ngay với khách.","CanSua","Yêu cầu sửa","Nhà cung cấp sửa rồi gửi lại. Phiên bản đang công bố giữ nguyên.","TuChoi","Không công bố phiên bản này.")'/></div>}</div>