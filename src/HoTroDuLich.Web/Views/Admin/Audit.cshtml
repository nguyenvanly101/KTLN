@model List<NhatKyThaoTac>
@{ViewData["Title"]="Nhật ký thao tác";}<div class="container-wide"><div class="page-head"><div><h1>Nhật ký hoạt động</h1><p>Xem lịch sử thao tác và các quyết định trên hệ thống.</p></div><div class="actions"></div></div><div class="panel table-wrap"><table class="table"><thead><tr><th>Thời điểm (giờ Việt Nam)</th><th>Người thực hiện</th><th>Sự kiện</th><th>Đối tượng</th><th>Trước → Sau</th><th>Lý do</th></tr></thead><tbody>@foreach(var n in Model){<tr><td>@Ui.LocalTime(n.ThoiDiem).ToString("dd/MM/yyyy HH:mm")</td><td>#@n.MaTaiKhoan</td><td>@n.LoaiSuKien</td><td>@n.DoiTuong #@n.MaDoiTuong</td><td>@Labels.Status(n.TrangThaiTruoc) → @Labels.Status(n.TrangThaiSau)</td><td>@n.LyDo</td></tr>}</tbody></table></div></div>