@model (HoSoXacMinhNhaCungCap Profile,NhaCungCapDichVu Provider,List<TaiLieuXacMinh> Files,List<QuyetDinhXacMinh> Decisions)
@{ViewData["Title"]="Xác minh nhà cung cấp";var h=Model.Profile;var p=Model.Provider;}<div class="container-narrow"><a class="back" href="/Admin/Verifications">← Hồ sơ xác minh</a><div class="page-head"><div><h1>@p.TenDonVi</h1><p>Hồ sơ #@h.MaHoSo · Người đại diện: @h.NguoiDaiDien</p></div><div class="actions"></div></div><div class="panel"><span class="badge @Labels.Badge(h.TrangThaiXuLy.ToString())">@Labels.Status(h.TrangThaiXuLy.ToString())</span><dl class="facts"><div><dt>Địa chỉ</dt><dd>@p.DiaChi</dd></div><div><dt>Liên hệ</dt><dd>@p.SoDienThoai · @p.EmailLienHe</dd></div></dl><p class="prose">@h.NoiDungDangKy</p><h3>Tài liệu xác minh</h3>@foreach(var f in Model.Files){<a class="help" href="/Account/Download?kind=verification&id=@f.MaTaiLieu">↓ @f.TenTepGoc · Lần nộp @f.LanNop</a>}@if(Model.Files.Count==0){<p class="help">Chưa có tệp đính kèm.</p>}@foreach(var d in Model.Decisions){<div class="notice">Lượt @d.LanXuLy · @Labels.Status(d.KetQua.ToString()) · @d.LyDo @d.KetQuaXacMinh</div>}</div>@if(h.TrangThaiXuLy.ToString()=="ChoXacMinh"){<div class="panel"><h2>Quyết định xác minh</h2><form action="/Admin/Verify" method="post" >@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><input type="hidden" name="Id" value="@h.MaHoSo"/><input type="hidden" name="Version" value="@TravelService.Token(h.RowVersion)"/><div class="field"><label for="field-Reason-1">Lý do (bắt buộc khi từ chối)</label><input id="field-Reason-1" class="form-control" name="Reason" type="text" maxlength="500"/></div><div class="field full"><label for="field-Text-2">Kết quả đối chiếu hồ sơ</label><textarea id="field-Text-2" name="Text" class="form-control" maxlength="2000"></textarea></div><div class="form-actions"><button class="btn btn-dark" name="Decision" value="DaXacMinh" type="submit">Xác minh nhà cung cấp</button><button class="btn btn-outline" name="Decision" value="CanBoSung" type="submit">Yêu cầu bổ sung</button><button class="btn btn-outline" name="Decision" value="TuChoi" type="submit">Từ chối</button></div></form></div>}</div>