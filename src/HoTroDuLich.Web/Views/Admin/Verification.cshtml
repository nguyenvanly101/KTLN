@model (HoSoXacMinhNhaCungCap Profile,NhaCungCapDichVu Provider,List<TaiLieuXacMinh> Files,List<QuyetDinhXacMinh> Decisions)
@{ViewData["Title"]="Xác minh nhà cung cấp";var h=Model.Profile;var p=Model.Provider;}<div class="container-narrow"><a class="back" href="/Admin/Verifications">← Hồ sơ xác minh</a><div class="page-head"><div><h1>@p.TenDonVi</h1><p>Hồ sơ #@h.MaHoSo · Người đại diện: @h.NguoiDaiDien</p></div><div class="actions"></div></div><div class="panel"><span class="badge @Labels.Badge(h.TrangThaiXuLy.ToString())">@Labels.Status(h.TrangThaiXuLy.ToString())</span><dl class="facts"><div><dt>Địa chỉ</dt><dd>@p.DiaChi</dd></div><div><dt>Liên hệ</dt><dd>@p.SoDienThoai · @p.EmailLienHe</dd></div></dl><p class="prose">@h.NoiDungDangKy</p><h3>Tài liệu xác minh</h3>@foreach(var f in Model.Files){<a class="help" href="/Account/Download?kind=verification&id=@f.MaTaiLieu">↓ @f.TenTepGoc · Lần nộp @f.LanNop</a>}@if(Model.Files.Count==0){<p class="help">Chưa có tệp đính kèm.</p>}@foreach(var d in Model.Decisions){<div class="notice">Lượt @d.LanXuLy · @Labels.Status(d.KetQua.ToString()) · @d.LyDo @d.KetQuaXacMinh</div>}</div>@if(h.TrangThaiXuLy.ToString()=="ChoXacMinh"){<div class="panel"><h2>Quyết định xác minh</h2><partial name="_DecisionForm" model='new DecisionFormModel("/Admin/Verify",new Dictionary<string,string>{["Id"]=h.MaHoSo.ToString(),["Version"]=TravelService.Token(h.RowVersion)},[new("DaXacMinh","Xác minh","Giấy tờ khớp. Nhà cung cấp được hoạt động và đăng dịch vụ.","Ghi chú cho nhà cung cấp (không bắt buộc)",false,"Ví dụ: Giấy phép kinh doanh khớp tên đơn vị và người đại diện."),new("CanBoSung","Yêu cầu bổ sung","Thiếu hoặc chưa rõ giấy tờ. Nhà cung cấp sửa rồi gửi lại.","Cần bổ sung gì",true,"Ví dụ: Ảnh giấy phép bị mờ, gửi lại bản rõ hơn."),new("TuChoi","Từ chối","Hồ sơ không hợp lệ. Nhà cung cấp không được hoạt động.","Lý do từ chối",true,"Ví dụ: Thông tin đơn vị không khớp với giấy phép.",true)],"Reason","Nhà cung cấp sẽ thấy nội dung này trong thông báo và trang hồ sơ. Tối đa 500 ký tự.")'/></div>}</div>