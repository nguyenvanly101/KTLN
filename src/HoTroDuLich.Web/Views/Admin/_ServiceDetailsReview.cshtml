@model (BanCapNhatDichVu Pending,DichVuDuLich Current,NhaCungCapDichVu Provider)
<partial name="/Views/Branches/_ReviewServiceBranches.cshtml" model="Model"/>
<section class="comparison service-review-details"><div class="panel"><span class="eyebrow">ĐỊA CHỈ, GIÁ, ẢNH ĐANG CÔNG BỐ</span><p>@(Model.Current.DiaChiPhucVu??"Chưa có địa chỉ")</p><p>Đơn vị giá: @(Model.Current.DonViGia??"Chưa có")</p><p class="prose">@(Model.Current.ChinhSachHuy??"Chưa có chính sách riêng")</p><div class="service-photo-grid">@for(var p=0;p<Ui.ServicePhotos(Model.Current.AnhJson).Length;p++){<img src="/service-photos/review/@Model.Current.MaDichVu/@p" alt="Ảnh đang công bố @(p+1)" width="400" height="300"/>}</div></div><div class="panel"><span class="eyebrow">THÔNG TIN ĐỀ NGHỊ CẬP NHẬT</span><p>@(Model.Pending.DiaChiPhucVu??"Chưa có địa chỉ")</p><p>Đơn vị giá: @(Model.Pending.DonViGia??"Chưa có")</p><p class="prose">@(Model.Pending.ChinhSachHuy??"Chưa có chính sách riêng")</p><div class="service-photo-grid">@for(var p=0;p<Ui.ServicePhotos(Model.Pending.AnhJson).Length;p++){<img src="/service-photos/review/@Model.Pending.MaDichVu/@p?revision=@Model.Pending.MaBanCapNhat" alt="Ảnh chờ duyệt @(p+1)" width="400" height="300"/>}</div></div></section>
