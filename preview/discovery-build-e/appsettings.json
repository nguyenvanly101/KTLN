    "Enabled": true
  },
  "Business": {
    "ComplaintDays": 30
  },
  "Discovery": {
    "Map": {
      "TileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
    },
    "Routing": {
      "Car": "https://routing.openstreetmap.de/routed-car/",
      "Bike": "https://routing.openstreetmap.de/routed-bike/",
      "Foot": "https://routing.openstreetmap.de/routed-foot/"
    }
  }
