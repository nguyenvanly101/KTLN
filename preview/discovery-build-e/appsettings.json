{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "HoTroDuLich": "Server=(localdb)\\MSSQLLocalDB;Database=HoTroDuLich;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True"
  },
